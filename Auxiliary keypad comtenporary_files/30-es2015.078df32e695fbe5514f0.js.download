unction"==typeof Reflect.metadata)return Reflect.metadata(t,e)};let C=class{constructor(t,e){this.store=t,this.rewardsService=e,this.destroyed$=new b.a}ngOnInit(){this.store.pipe(Object(m.m)(p.i),Object(f.a)(this.destroyed$),Object(v.a)(t=>(this.buyingGroup=t,t?this.rewardsService.getBuyingGroupGoals(t):Object(g.a)(null)))).subscribe(t=>this.buyingGroupGoals=t)}ngOnDestroy(){this.destroyed$.next()}};C.ctorParameters=()=>[{type:m.b},{type:u.a}],C=G([Object(r.n)({selector:"c4-triad-loyalty-page",template:a("mE2E"),styles:[a("672h")]}),j("design:paramtypes",[m.b,u.a])],C);var E=function(t,e,a,n){var r,s=arguments.length,i=s<3?e:null===n?n=Object.getOwnPropertyDescriptor(e,a):n;if("object"==typeof Reflect&&"function"==typeof Reflect.decorate)i=Reflect.decorate(t,e,a,n);else for(var o=t.length-1;o>=0;o--)(r=t[o])&&(i=(s<3?r(i):s>3?r(e,a,i):r(e,a))||i);return s>3&&i&&Object.defineProperty(e,a,i),i};const I=[{matcher:Object(q.a)("premier-dealer"),canActivate:[A.a],component:k,data:{title:"Premier Dealer Program",hideFlag:T.f.MergedLoyaltyProgram}},{matcher:Object(q.a)("triad-loyalty"),canActivate:[A.a],component:C,data:{title:"Triad Loyalty Program",hideFlag:T.f.MergedLoyaltyProgram}},{matcher:Object(q.a)("rebate"),canActivate:[A.a],component:R,data:{title:"Dealer Rebate Program",hideFlag:T.f.MergedLoyaltyProgram}},{path:"**",component:S.a}];let N=class{};N=E([Object(r.K)({imports:[D.a,x.h.forChild(I)],exports:[x.h]})],N),a.d(e,"ProgramsModule",(function(){return M}));let M=class{};M=function(t,e,a,n){var r,s=arguments.length,i=s<3?e:null===n?n=Object.getOwnPropertyDescriptor(e,a):n;if("object"==typeof Reflect&&"function"==typeof Reflect.decorate)i=Reflect.decorate(t,e,a,n);else for(var o=t.length-1;o>=0;o--)(r=t[o])&&(i=(s<3?r(i):s>3?r(e,a,i):r(e,a))||i);return s>3&&i&&Object.defineProperty(e,a,i),i}([Object(r.K)({imports:[n.b,N,d.a,o.a,i.a,l.a,s.a,c.a],declarations:[k,C,R]})],M)},OKS9:function(t,e){t.exports='<div *ngIf="brandName$ | async as brandName" class="padding">\n\t<div class="widget">\n\t\t<div class="padding">\n\t\t\t<h2>PREMIER DEALER PROGRAM</h2>\n\t\t\t<p *ngIf="brandName === \'Control4\'"> With over 350,000 homes installed with Control4, we recognize the great efforts of our dealers. The continued\n\t\t\t\tsupport of our dealers has made Control4 the automation platform of choice by CEPro 100 Brand Analysis four years in a row! We want to reward\n\t\t\t\tdealers that are delivering delightful smart home experiences to all their customers consistently every quarter by continuing our premier\n\t\t\t\tdealer, rebate, and discount programs into 2020. </p>\n\t\t\t<p *ngIf="brandName === \'Pakedge\'"> It\u2019s the continued support of our dealers that makes Pakedge the networking platform of choice by CEPro 100\n\t\t\t\tBrand Analysis four years in a row! We want to reward dealers that are delivering intelligent networking solutions to all their customers\n\t\t\t\tconsistently every quarter by continuing our premier dealer, rebated and discount programs into 2019. </p>\n\t\t\t<p *ngIf="brandName === \'Triad\'"> We want to reward dealers that are delivering world-class Triad audio experiences to all their customers\n\t\t\t\tconsistently every quarter by continuing our premier dealer, rebate, and discount programs into 2019. </p>\n\t\t\t<c4-rebate-benefits></c4-rebate-benefits>\n\t\t\t<p class="margin-top"><small class="bold">Other Terms and Conditions</small></p>\n\t\t\t<p>\n\t\t\t\t<small>Rebates will be paid in the month following the quarter\u2019s end. Rebates will be paid as an account credit to dealers that achieve minimum\n\t\t\t\t\tpurchase requirements. Dealers must be in good standing with Control4 and abide by all the terms of the Dealer Agreement during the entire\n\t\t\t\t\tquarter for which the rebate calculation is based to qualify for the applicable rebate. If Dealer is not in good standing or has breached\n\t\t\t\t\tthe Dealer Agreement, rebates will be forfeited. This Program cannot be combined with any other program or promotion which may be offered by\n\t\t\t\t\tControl4 from time to time. Only applies to products purchased directly from Control4. Some discounted or promotional products may not\n\t\t\t\t\tqualify as Purchases under the Program. Returned products will not qualify under the Program, unless exchanged for a qualifying product.\n\t\t\t\t\tThis Program is subject to modification, cancellation, or limitation at Control4 discretion, at any time with or without notice. Control4\n\t\t\t\t\thas the sole discretion to interpret and apply the Program, and all questions or disputes regarding these terms and conditions will be\n\t\t\t\t\tresolved by Control4 in its sole discretion. </small> </p>\n\t\t</div>\n\t</div>\n</div>'},mE2E:function(t,e){t.exports='<div class="padding">\n\t<div class="widget">\n\t\t<div class="padding">\n\t\t\t<h2>TRIAD SPEAKER LOYALTY PROGRAMS</h2>\n\t\t\t<h3>Maximize your margins, Maximize your savings!</h3>\n\t\t\t<p>Purchasing any Triad speakers earns you instant discounts of up to 10% on Triad Distributed Audio Series speakers, R-Series speakers and Outdoor\n\t\t\t\tspeakers. Purchase enough and earn a quarterly rebate of up to 10% more. The program lets you earn up to 72% margin on Distributed Audio Series\n\t\t\t\tspeakers, 67% margin on R-Series speakers, and 60% margin on Outdoor speakers.</p>\n\t\t\t<h3>TRIAD SPEAKER REBATE PROGRAM</h3>\n\t\t\t<p>All dealers are eligible to earn a quarterly rebate on any Triad speaker purchase. All Triad speakers are eligible including home theater, soundbars,\n\t\t\t\tsubwoofers, rounds, and outdoors. The more you spend the bigger your rebate. See <a routerLink="/programs/rebate">Dealer Rebate program</a> for details\n\t\t\t\ton how you can earn a rebate on Control4, Pakedge, and other Triad audio purchases. </p>\n\t\t\t<div class="row">\n\t\t\t\t<div class="col-sm-6">\n\t\t\t\t\t<c4-triad-loyalty-reward-info type="rebate"></c4-triad-loyalty-reward-info>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t\t<ul class="no-style">\n\t\t\t\t<li><small><sup>1</sup> \u201cQuarterly Purchases\u201d is the total of all Triad speaker invoices less any credits in a given quarter. </small></li>\n\t\t\t\t<li><small><sup>3</sup> Rebate is a percentage of quarterly purchases and is applied as a credit at the end of the quarter </small></li>\n\t\t\t</ul>\n\t\t\t<h3>TRIAD SPEAKER DISCOUNT PROGRAM</h3>\n\t\t\t<p> All dealers are eligible to earn a discount on Triad Distributed Audio Series speakers, R-Series speakers and Outdoor Speakers. Eligible discounts\n\t\t\t\twill be applied automatically while ordering online. As you meet purchase thresholds, you\u2019ll begin to earn the next discount through the end of the next\n\t\t\t\tquarter. </p>\n\t\t\t<div class="row">\n\t\t\t\t<div class="col-sm-6">\n\t\t\t\t\t<c4-triad-loyalty-reward-info type="discount"></c4-triad-loyalty-reward-info>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t\t<ul class="no-style">\n\t\t\t\t<li><small><sup>1</sup> \u201cQuarterly Purchases\u201d is the total of all Triad speaker invoices less any credits in a given quarter. </small></li>\n\t\t\t\t<li><small><sup>2</sup> An instant discount is applied to Triad Distributed Audio Series speakers, R-Series speakers and Outdoor speakers at time of\n\t\t\t\t\t\tpurchase based on quarterly purchases.</small></li>\n\t\t\t</ul>\n\t\t\t<h3>COMBINE AND SAVE ON TRIAD SPEAKERS</h3>\n\t\t\t<p> Purchase tiers for the Triad Discount and Rebate programs listed above are the same so they\u2019re easy to remember. Watch your combined savings on Triad\n\t\t\t\tDistributed Audio Series speakers, R-Series speakers and Outdoor speakers increase as your overall Triad speakers purchases grow. </p>\n\t\t\t<c4-triad-loyalty-reward-info></c4-triad-loyalty-reward-info>\n\t\t\t<ul class="no-style">\n\t\t\t\t<li><small><sup>1</sup>\u201cQuarterly Purchases\u201d is the total of all Triad speaker invoices less any credits in a given quarter. </small></li>\n\t\t\t\t<li><small><sup>2</sup> An instant discount is applied to Triad Distributed Audio Series speakers, R-Series speakers and Outdoor speakers at time of\n\t\t\t\t\t\tpurchase based on quarterly purchases.</small></li>\n\t\t\t\t<li><small><sup>3</sup> Rebate is a percentage of quarterly purchases and is applied as a credit at the end of the quarter </small></li>\n\t\t\t\t\x3c!--<li><small><sup>4</sup>\n\t\t\t\t\t\tMaximum saving is based on reaching the highest threshold and receiving a 10% instant discount on Triad Round\n\t\t\t\t\t\tand\n\t\t\t\t\t\tOutdoor speakers as well as receiving a 10% rebate at the end of the quarter.\n\t\t\t\t\t</small></li>--\x3e\n\t\t\t</ul>\n\t\t\t<h3 class="top-margin">WHAT TRIAD SPEAKERS ARE INCLUDED?</h3>\n\t\t\t<p>See the summary of eligible products below.</p>\n\t\t\t<div class="table boxed">\n\t\t\t\t<div class="head">\n\t\t\t\t\t<div class="row header text-center">\n\t\t\t\t\t\t<div class="col-sm-2">Speakers</div>\n\t\t\t\t\t\t<div class="col-sm-2">Triad speaker discount<sup>1</sup></div>\n\t\t\t\t\t\t<div class="col-sm-2"></div>\n\t\t\t\t\t\t<div class="col-sm-2">Triad speaker rebate<sup>2</sup></div>\n\t\t\t\t\t\t<div class="col-sm-2"></div>\n\t\t\t\t\t\t<div class="col-sm-2">Maximum saving<sup>3</sup></div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class="body">\n\t\t\t\t\t<div class="row text-center">\n\t\t\t\t\t\t<div class="col-sm-2">Distributed Audio Series</div>\n\t\t\t\t\t\t<div class="col-sm-2"><i class="fal fa-check"></i></div>\n\t\t\t\t\t\t<div class="col-sm-2"><i class="fal fa-plus"></i></div>\n\t\t\t\t\t\t<div class="col-sm-2"><i class="fal fa-check"></i></div>\n\t\t\t\t\t\t<div class="col-sm-2"><i class="fal fa-equals"></i></div>\n\t\t\t\t\t\t<div class="col-sm-2">20%</div>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="row text-center">\n\t\t\t\t\t\t<div class="col-sm-2">R-Series</div>\n\t\t\t\t\t\t<div class="col-sm-2"><i class="fal fa-check"></i></div>\n\t\t\t\t\t\t<div class="col-sm-2"><i class="fal fa-plus"></i></div>\n\t\t\t\t\t\t<div class="col-sm-2"><i class="fal fa-check"></i></div>\n\t\t\t\t\t\t<div class="col-sm-2"><i class="fal fa-equals"></i></div>\n\t\t\t\t\t\t<div class="col-sm-2">20%</div>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="row text-center">\n\t\t\t\t\t\t<div class="col-sm-2">Outdoor</div>\n\t\t\t\t\t\t<div class="col-sm-2"><i class="fal fa-check"></i></div>\n\t\t\t\t\t\t<div class="col-sm-2"><i class="fal fa-plus"></i></div>\n\t\t\t\t\t\t<div class="col-sm-2"><i class="fal fa-check"></i></div>\n\t\t\t\t\t\t<div class="col-sm-2"><i class="fal fa-equals"></i></div>\n\t\t\t\t\t\t<div class="col-sm-2">20%</div>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="row text-center">\n\t\t\t\t\t\t<div class="col-sm-2">Home Theater</div>\n\t\t\t\t\t\t<div class="col-sm-2"></div>\n\t\t\t\t\t\t<div class="col-sm-2"><i class="fal fa-plus"></i></div>\n\t\t\t\t\t\t<div class="col-sm-2"><i class="fal fa-check"></i></div>\n\t\t\t\t\t\t<div class="col-sm-2"><i class="fal fa-equals"></i></div>\n\t\t\t\t\t\t<div class="col-sm-2">10%</div>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="row text-center">\n\t\t\t\t\t\t<div class="col-sm-2">Soundbars</div>\n\t\t\t\t\t\t<div class="col-sm-2"></div>\n\t\t\t\t\t\t<div class="col-sm-2"><i class="fal fa-plus"></i></div>\n\t\t\t\t\t\t<div class="col-sm-2"><i class="fal fa-check"></i></div>\n\t\t\t\t\t\t<div class="col-sm-2"><i class="fal fa-equals"></i></div>\n\t\t\t\t\t\t<div class="col-sm-2">10%</div>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="row text-center">\n\t\t\t\t\t\t<div class="col-sm-2">Subwoofers</div>\n\t\t\t\t\t\t<div class="col-sm-2"></div>\n\t\t\t\t\t\t<div class="col-sm-2"><i class="fal fa-plus"></i></div>\n\t\t\t\t\t\t<div class="col-sm-2"><i class="fal fa-check"></i></div>\n\t\t\t\t\t\t<div class="col-sm-2"><i class="fal fa-equals"></i></div>\n\t\t\t\t\t\t<div class="col-sm-2">10%</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t\t<ul class="no-style">\n\t\t\t\t<li><small><sup>1</sup> An instant discount is applied to Triad Distributed Audio Series speakers, R-Series speakers and Outdoor speakers at time of\n\t\t\t\t\t\tpurchase based on quarterly purchases.</small></li>\n\t\t\t\t<li><small><sup>2</sup> Rebate is a percentage of quarterly purchases and is applied as a credit at the end of the quarter </small></li>\n\t\t\t\t<li><small><sup>3</sup> Maximum saving is based on reaching the highest threshold and receiving a 10% instant discount on Triad Distributed Audio Series\n\t\t\t\t\t\tspeakers, R-Series speakers and Outdoor speakers as well as receiving a 10% rebate at the end of the quarter. </small></li>\n\t\t\t</ul>\n\t\t\t<ng-container *ngIf="buyingGroup && buyingGroupGoals?.length">\n\t\t\t\t<h3>{{buyingGroup | uppercase}} BUYING GROUP DEALERS</h3>\n\t\t\t\t<p>All dealers that are part of the {{buyingGroup}} Buying Group are eligible for a rebate accelerator. The accelerator will only be applied if the\n\t\t\t\t\tdealer met the minimum requirements for any eligible Dealer and/or Triad speaker rebate(s). The accelerator is paid on Control4, Pakedge, Triad audio,\n\t\t\t\t\tand Triad speakers only.</p>\n\t\t\t\t<div class="table boxed">\n\t\t\t\t\t<div class="head">\n\t\t\t\t\t\t<div class="row header text-center">\n\t\t\t\t\t\t\t<div class="col-sm-3">Min. YoY quarterly growth</div>\n\t\t\t\t\t\t\t<div class="col-sm-3" *ngFor="let goal of buyingGroupGoals">{{ goal.minimum | percent }} </div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="body">\n\t\t\t\t\t\t<div class="row text-center">\n\t\t\t\t\t\t\t<div class="col-sm-3">Growth Acceleration</div>\n\t\t\t\t\t\t\t<div class="col-sm-3" *ngFor="let goal of buyingGroupGoals"> {{ goal.reward | percent: \'1.1\' }} </div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</ng-container>\n\t\t\t<p class="margin-top"><small class="bold">Other Terms and Conditions</small></p>\n\t\t\t<p>\n\t\t\t\t<small>Rebates will be paid in the month following the quarter\u2019s end. Rebates will be paid as an account credit to dealers that achieve minimum purchase\n\t\t\t\t\trequirements. Dealers must be in good standing with Control4 and abide by all the terms of the Dealer Agreement during the entire quarter for which\n\t\t\t\t\tthe rebate calculation is based to qualify for the applicable rebate. If Dealer is not in good standing or has breached the Dealer Agreement, rebates\n\t\t\t\t\twill be forfeited. This Program cannot be combined with any other program or promotion which may be offered by Control4 from time to time. Only\n\t\t\t\t\tapplies to products purchased directly from Control4. Some discounted or promotional products may not qualify as Purchases under the Program. Returned\n\t\t\t\t\tproducts will not qualify under the Program, unless exchanged for a qualifying product. This Program is subject to modification, cancellation, or\n\t\t\t\t\tlimitation at Control4 discretion, at any time with or without notice. Control4 has the sole discretion to interpret and apply the Program, and all\n\t\t\t\t\tquestions or disputes regarding these terms and conditions will be resolved by Control4 in its sole discretion. </small> </p>\n\t\t</div>\n\t</div>'},wAlP:function(t,e){t.exports='<div *ngIf="brandName$ | async as brandName" class="padding">\n\t<div class="widget">\n\t\t<div class="padding">\n\t\t\t<h2>DEALER REBATE PROGRAM</h2>\n\t\t\t<c4-rebate-info class="block"></c4-rebate-info>\n\t\t\t<ul class="no-style">\n\t\t\t\t<li><small><sup>1</sup> Spend includes <ng-container *ngIf="brandName === \'Control4\'">Control4,\n\t\t\t\t\t\t</ng-container>\n\t\t\t\t\t\tPakedge, Triad speakers, <ng-container *ngIf="brandName === \'Control4\'">Triad audio,\n\t\t\t\t\t\t</ng-container> and\n\t\t\t\t\t\tthird-party product purchases through Control4\u2019s online store, less any returns or credits.\n\t\t\t\t\t</small></li>\n\t\t\t\t<li><small><sup>2</sup> Excludes Triad speakers and third-party.</small></li>\n\t\t\t</ul>\n\n\t\t\t<ng-container *ngIf="buyingGroup && buyingGroupGoals?.length">\n\t\t\t\t<h3>{{buyingGroup | uppercase}} BUYING GROUP DEALERS</h3>\n\t\t\t\t<p>All dealers that are part of the {{buyingGroup}} Buying Group are eligible for a rebate accelerator.\n\t\t\t\t\tThe\n\t\t\t\t\taccelerator will only be applied if the dealer met the minimum requirements for any eligible Dealer\n\t\t\t\t\tand/or Triad speaker rebate(s). The accelerator is paid on Control4, Pakedge, Triad audio, and Triad\n\t\t\t\t\tspeakers only.</p>\n\t\t\t\t<div class="table boxed">\n\t\t\t\t\t<div class="head">\n\t\t\t\t\t\t<div class="row header text-center">\n\t\t\t\t\t\t\t<div class="col-sm-3">Min. YoY quarterly growth</div>\n\t\t\t\t\t\t\t<div class="col-sm-3" *ngFor="let goal of buyingGroupGoals">{{ goal.minimum | percent }}\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="body">\n\t\t\t\t\t\t<div class="row text-center">\n\t\t\t\t\t\t\t<div class="col-sm-3">Growth Acceleration</div>\n\t\t\t\t\t\t\t<div class="col-sm-3" *ngFor="let goal of buyingGroupGoals">\n\t\t\t\t\t\t\t\t{{ goal.reward | percent: \'1.1\' }}\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</ng-container>\n\n\t\t\t<p class="margin-top"><small class="bold">Other Terms and Conditions</small></p>\n\t\t\t<p>\n\t\t\t\t<small>Rebates will be paid in the month following the quarter\u2019s end. Rebates will be paid as an account\n\t\t\t\t\tcredit to dealers that achieve minimum purchase requirements. Dealers must be in good standing with\n\t\t\t\t\tControl4 and abide by all the terms of the Dealer Agreement during the entire quarter for which the\n\t\t\t\t\trebate calculation is based to qualify for the applicable rebate. If Dealer is not in good standing\n\t\t\t\t\tor has breached the Dealer Agreement, rebates will be forfeited. This Program cannot be combined\n\t\t\t\t\twith any other program or promotion which may be offered by Control4 from time to time. Only applies\n\t\t\t\t\tto products purchased directly from Control4. Some discounted or promotional products may not\n\t\t\t\t\tqualify as Purchases under the Program. Returned products will not qualify under the Program, unless\n\t\t\t\t\texchanged for a qualifying product. This Program is subject to modification, cancellation, or\n\t\t\t\t\tlimitation at Control4 discretion, at any time with or without notice. Control4 has the sole\n\t\t\t\t\tdiscretion to interpret and apply the Program, and all questions or disputes regarding these terms\n\t\t\t\t\tand conditions will be resolved by Control4 in its sole discretion. </small> </p>\n\t\t</div>\n\t</div>'},yDb2:function(t,e){t.exports=""}}]);