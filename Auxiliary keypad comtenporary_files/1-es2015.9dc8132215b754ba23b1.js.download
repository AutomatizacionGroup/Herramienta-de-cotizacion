o place your order. </div>\n\t\t<select\n\t\t\t\ttest-id="selectedBillingAddress"\n\t\t\t\tclass="fs-block"\n\t\t\t\t[(ngModel)]="vm.billing.selectedBillingAddressId"\n\t\t\t\t[disabled]="vm.modifyingCart"\n\t\t\t\t(ngModelChange)="changeAddress($event)">\n\t\t\t<option [ngValue]="undefined">Select Billing Address</option>\n\t\t\t<option *ngFor="let address of vm.addresses" [ngValue]="address.id"> {{ address.displayValue }} </option>\n\t\t</select>\n\t\t<div class="row">\n\t\t\t<div class="col-sm-6 col-12">\n\t\t\t\t<select\n\t\t\t\t\t\ttest-id="selectedPaymentType"\n\t\t\t\t\t\t[(ngModel)]="vm.billing.selectedPaymentMethod"\n\t\t\t\t\t\t(ngModelChange)="paymentMethodChange($event)"\n\t\t\t\t\t\t[disabled]="vm.modifyingCart">\n\t\t\t\t\t<option [ngValue]="undefined" disabled>Select Payment Type</option>\n\t\t\t\t\t<option value="CreditCard">Credit Card</option>\n\t\t\t\t\t<option *ngIf="vm.isEmea && enableShift4CreditCardProcessing" value="ManualCreditCard">Credit Card By Phone</option>\n\t\t\t\t\t<option value="WireTransfer">Wire Transfer</option>\n\t\t\t\t\t<option value="Account" *ngIf="vm.billing.hasTerms"> On Account </option>\n\t\t\t\t</select>\n\t\t\t</div>\n\t\t</div>\n\t\t<p class="no-margin">\n\t\t\t<small>Select the billing address and billing method from the lists above. Please contact the <a href="mailto:International@adiglobal.com">Sales\n\t\t\t\t\tSupport Team</a> for more information or to modify or delete a billing address.</small>\n\t\t</p>\n\t\t<div *ngIf="vm.isEmea && enableShift4CreditCardProcessing">\n\t\t\t<div\n\t\t\t\t class="paymentoption half-padding-top"\n\t\t\t\t *ngIf="vm.billing.selectedPaymentMethod === \'CreditCard\' && vm.isEmea && !isCreditCardApproved() && !creditCardResponse">\n\t\t\t\t<div class="alert alert-warning">\n\t\t\t\t\t<h4>Credit Card</h4>\n\t\t\t\t\t<p>You will be redirected to a secure site to enter your credit card information for this order.</p>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t\t<div\n\t\t\t\t class="paymentoption half-padding-top"\n\t\t\t\t *ngIf="vm.billing.selectedPaymentMethod === \'CreditCard\' && vm.isEmea && !isCreditCardApproved() && creditCardResponse">\n\t\t\t\t<div class="alert alert-danger">\n\t\t\t\t\t<h4>Credit Card</h4>\n\t\t\t\t\t<p>There was a problem processing the credit card.</p>\n\t\t\t\t\t<p>{{ creditCardResponse }}</p>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t\t<div\n\t\t\t\t class="paymentoption half-padding-top"\n\t\t\t\t *ngIf="vm.billing.selectedPaymentMethod === \'CreditCard\' && vm.isEmea && isCreditCardApproved() && creditCardResponse">\n\t\t\t\t<div class="alert alert-success">\n\t\t\t\t\t<h4>Credit Card Approved</h4>\n\t\t\t\t\t<p>Your credit card will be charged once you place the order.</p>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t\t<div class="paymentoption half-padding-top" *ngIf="vm.billing.selectedPaymentMethod === \'ManualCreditCard\' && vm.isEmea">\n\t\t\t\t<div class="alert alert-info">\n\t\t\t\t\t<h4>Credit Card By Phone</h4>\n\t\t\t\t\t<p> You will be able to place your order without providing payment details online, but your order will not ship until Partner Support has\n\t\t\t\t\t\tcontacted you to collect payment. Should you have any additional questions, please contact Partner Support at <a\n\t\t\t\t\t\t   href="mailto:ps-emea@snapav.com">ps-emea@snapav.com</a> or <a href="tel:+44 (0)800 121 7702">+44 (0)800 121 7702</a>. </p>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t</div>\n\t\t<div *ngIf="!vm.isEmea || !enableShift4CreditCardProcessing">\n\t\t\t<div\n\t\t\t\t class="paymentoption half-padding-top"\n\t\t\t\t *ngIf="vm.billing.selectedPaymentMethod === \'CreditCard\'">\n\t\t\t\t<h4>Credit Card</h4>\n\t\t\t\t<form name="ccform" #ccform="ngForm" class="validate no-margin">\n\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t<div class="col-sm-6 col-12">\n\t\t\t\t\t\t\t<select\n\t\t\t\t\t\t\t\t\ttest-id="selectedCardType"\n\t\t\t\t\t\t\t\t\tname="cctype"\n\t\t\t\t\t\t\t\t\t#cctype="ngModel"\n\t\t\t\t\t\t\t\t\t[(ngModel)]="vm.billing.billingOptions.cardType"\n\t\t\t\t\t\t\t\t\t(ngModelChange)="updateBilling()"\n\t\t\t\t\t\t\t\t\trequired\n\t\t\t\t\t\t\t\t\tautocomplete="cc-type">\n\t\t\t\t\t\t\t\t<option disabled [ngValue]="undefined">Select Card Type</option>\n\t\t\t\t\t\t\t\t<option *ngFor="let type of vm.cardTypes" [ngValue]="type.name"> {{ type.description }} </option>\n\t\t\t\t\t\t\t</select>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class="col-sm-6 d-xs-none">\n\t\t\t\t\t\t\t<a\n\t\t\t\t\t\t\t   href="javascript:;"\n\t\t\t\t\t\t\t   class="fab {{ cardType.icon }} text-grey"\n\t\t\t\t\t\t\t   style="margin-right: 5px"\n\t\t\t\t\t\t\t   [class.active]="\n\t\t\t\t\tvm.billing.billingOptions.cardType === cardType.name\n\t\t\t\t"\n\t\t\t\t\t\t\t   (click)="updateCardType(cardType.name)"\n\t\t\t\t\t\t\t   *ngFor="let cardType of vm.cardTypes"></a>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t\t<mat-form-field>\n\t\t\t\t\t\t<input\n\t\t\t\t\t\t\t   test-id="ccnumber"\n\t\t\t\t\t\t\t   matInput\n\t\t\t\t\t\t\t   type="text"\n\t\t\t\t\t\t\t   name="ccnumber"\n\t\t\t\t\t\t\t   #ccnumber="ngModel"\n\t\t\t\t\t\t\t   placeholder="Credit Card Number"\n\t\t\t\t\t\t\t   maxlength="16"\n\t\t\t\t\t\t\t   [(ngModel)]="vm.billing.billingOptions.cardNumber"\n\t\t\t\t\t\t\t   (ngModelChange)="updateBilling()"\n\t\t\t\t\t\t\t   required\n\t\t\t\t\t\t\t   autocomplete="cc-number" />\n\t\t\t\t\t</mat-form-field>\n\t\t\t\t\t<mat-form-field>\n\t\t\t\t\t\t<input\n\t\t\t\t\t\t\t   test-id="nameoncard"\n\t\t\t\t\t\t\t   matInput\n\t\t\t\t\t\t\t   type="text"\n\t\t\t\t\t\t\t   name="nameoncard"\n\t\t\t\t\t\t\t   #nameoncard="ngModel"\n\t\t\t\t\t\t\t   placeholder="Name on Card"\n\t\t\t\t\t\t\t   ngPattern="/^[A-Za-z ]{1,26}$/"\n\t\t\t\t\t\t\t   [(ngModel)]="vm.billing.billingOptions.nameOnCard"\n\t\t\t\t\t\t\t   (ngModelChange)="updateBilling()"\n\t\t\t\t\t\t\t   required\n\t\t\t\t\t\t\t   autocomplete="cc-name" />\n\t\t\t\t\t</mat-form-field>\n\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t<div class="col-lg-3 col-md-3 col-sm-3 col-6">\n\t\t\t\t\t\t\t<select\n\t\t\t\t\t\t\t\t\ttest-id="ccexpmonth"\n\t\t\t\t\t\t\t\t\tname="ccexpmonth"\n\t\t\t\t\t\t\t\t\t#ccexpmonth="ngModel"\n\t\t\t\t\t\t\t\t\t[(ngModel)]="vm.billing.billingOptions.expirationMonth"\n\t\t\t\t\t\t\t\t\t(ngModelChange)="updateBilling()"\n\t\t\t\t\t\t\t\t\trequired\n\t\t\t\t\t\t\t\t\tautocomplete="cc-exp-month">\n\t\t\t\t\t\t\t\t<option disabled [ngValue]="undefined">Month</option>\n\t\t\t\t\t\t\t\t<option *ngFor="let month of creditCardService.creditCardMonths"> {{ month }} </option>\n\t\t\t\t\t\t\t</select>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class="col-lg-3 col-md-3 col-sm-3 col-6">\n\t\t\t\t\t\t\t<select\n\t\t\t\t\t\t\t\t\ttest-id="ccexpyear"\n\t\t\t\t\t\t\t\t\tname="ccexpyear"\n\t\t\t\t\t\t\t\t\t#ccexpyear="ngModel"\n\t\t\t\t\t\t\t\t\t[(ngModel)]="vm.billing.billingOptions.expirationYear"\n\t\t\t\t\t\t\t\t\t(ngModelChange)="updateBilling()"\n\t\t\t\t\t\t\t\t\trequired\n\t\t\t\t\t\t\t\t\tautocomplete="cc-exp-year">\n\t\t\t\t\t\t\t\t<option disabled [ngValue]="undefined">Year</option>\n\t\t\t\t\t\t\t\t<option *ngFor="let year of creditCardService.creditCardYears"> {{ year }} </option>\n\t\t\t\t\t\t\t</select>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t<div class="col-sm-6 col-12">\n\t\t\t\t\t\t\t<mat-form-field>\n\t\t\t\t\t\t\t\t<input\n\t\t\t\t\t\t\t\t\t   test-id="ccseccode"\n\t\t\t\t\t\t\t\t\t   matInput\n\t\t\t\t\t\t\t\t\t   name="ccseccode"\n\t\t\t\t\t\t\t\t\t   #ccseccode="ngModel"\n\t\t\t\t\t\t\t\t\t   type="text"\n\t\t\t\t\t\t\t\t\t   class="no-margin"\n\t\t\t\t\t\t\t\t\t   placeholder="Security Code"\n\t\t\t\t\t\t\t\t\t   [maxlength]="maxCvnLength()"\n\t\t\t\t\t\t\t\t\t   [(ngModel)]="vm.billing.billingOptions.securityCode"\n\t\t\t\t\t\t\t\t\t   (ngModelChange)="updateBilling()"\n\t\t\t\t\t\t\t\t\t   required\n\t\t\t\t\t\t\t\t\t   autocomplete="cc-csc" />\n\t\t\t\t\t\t\t</mat-form-field>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div *ngIf="vm.billing.selectedPaymentMethod === \'CreditCard\'">\n\t\t\t\t\t\t<div\n\t\t\t\t\t\t\t class="alert alert-danger no-margin half-margin-top"\n\t\t\t\t\t\t\t *ngIf="cctype.touched && cctype?.errors?.required">\n\t\t\t\t\t\t\t<p>Card Type is a required field.</p>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div\n\t\t\t\t\t\t\t class="alert alert-danger no-margin half-margin-top"\n\t\t\t\t\t\t\t *ngIf="ccnumber.touched && ccnumber?.errors?.pattern">\n\t\t\t\t\t\t\t<p>Please enter a valid credit card number.</p>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div\n\t\t\t\t\t\t\t class="alert alert-danger no-margin half-margin-top"\n\t\t\t\t\t\t\t *ngIf="nameoncard.touched && nameoncard?.errors?.required">\n\t\t\t\t\t\t\t<p>Name on Card is a required field.</p>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div\n\t\t\t\t\t\t\t class="alert alert-danger no-margin half-margin-top"\n\t\t\t\t\t\t\t *ngIf="nameoncard.touched && nameoncard?.errors?.pattern">\n\t\t\t\t\t\t\t<p> Please enter a valid name. Must be no more than 26 alpha characters (including spaces). </p>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div\n\t\t\t\t\t\t\t class="alert alert-danger no-margin half-margin-top"\n\t\t\t\t\t\t\t *ngIf="ccexpmonth.touched && ccexpmonth?.errors?.required">\n\t\t\t\t\t\t\t<p>Expiration Month is a required field.</p>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div\n\t\t\t\t\t\t\t class="alert alert-danger no-margin half-margin-top"\n\t\t\t\t\t\t\t *ngIf="ccexpyear.touched && ccexpyear?.errors?.required">\n\t\t\t\t\t\t\t<p>Expiration Year is a required field.</p>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div\n\t\t\t\t\t\t\t class="alert alert-danger no-margin half-margin-top"\n\t\t\t\t\t\t\t *ngIf="ccseccode.touched && ccseccode?.errors?.required">\n\t\t\t\t\t\t\t<p>Security Code is a required field.</p>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div\n\t\t\t\t\t\t\t class="alert alert-danger no-margin half-margin-top"\n\t\t\t\t\t\t\t *ngIf="ccseccode?.errors?.maxlength || ccseccode?.errors?.pattern">\n\t\t\t\t\t\t\t<p>Please enter valid security code.</p>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div\n\t\t\t\t\t\t\t class="alert alert-danger no-margin half-margin-top"\n\t\t\t\t\t\t\t *ngFor="let error of vm.billing.paymentErrors">\n\t\t\t\t\t\t\t<p>{{ error.errorMessage }}</p>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</form>\n\t\t\t</div>\n\t\t</div>\n\t\t<div\n\t\t\t class="paymentoption half-padding-top"\n\t\t\t *ngIf="vm.billing.selectedPaymentMethod === \'WireTransfer\'">\n\t\t\t<h4>Wire Transfer</h4>\n\t\t\t<p> For wire transfers, we require full payment prior to order shipment. Please continue to confirm your order, then wire payment using the\n\t\t\t\tinformation below. Please reference your account and order number on the transfer request. </p>\n\t\t\t<div class="alert alert-warning" *ngIf="!vm.isEmea && !vm.isAustralia">\n\t\t\t\t<div *ngIf="vm.currencyCode === \'USD\'">\n\t\t\t\t\t<p> Bank of America N.A<br /> P.O. Box 1091<br /> Charlotte, NC 28254-3489 </p>\n\t\t\t\t\t<b>Account Name:</b> Control4 <br />\n\t\t\t\t\t<b>Account Number:</b> 237025432989 <br />\n\t\t\t\t\t<b>Routing Numbers:</b>\n\t\t\t\t\t<ul class="routing-numbers">\n\t\t\t\t\t\t<li><b>Wire:</b> 026009593</li>\n\t\t\t\t\t\t<li><b>ACH:</b> 053000196</li>\n\t\t\t\t\t\t<li><b>SWIFT CODE:</b> BOFAUS3N</li>\n\t\t\t\t\t</ul>\n\t\t\t\t</div>\n\t\t\t\t<div *ngIf="vm.currencyCode === \'CAD\'">\n\t\t\t\t\t<p>\n\t\t\t\t\t\t<b>Bank of America NA, Canada Branch</b><br /> 200 Front Street West, Ste. 2600<br /> Toronto, ON M5V 3L2 CANADA\n\t\t\t\t\t</p>\n\t\t\t\t\t<b>Account Name:</b> Control4 <br />\n\t\t\t\t\t<b>Account Number:</b> 52258200 <br />\n\t\t\t\t\t<b>Routing Numbers:</b>\n\t\t\t\t\t<ul class="routing-numbers">\n\t\t\t\t\t\t<li><b>ABA (Routing & Transit):</b> 024156792</li>\n\t\t\t\t\t\t<li><b>SWIFT CODE:</b> BOFACATT</li>\n\t\t\t\t\t</ul>\n\t\t\t\t</div>\n\t\t\t\t<p> If you need more information, please contact the <a href="mailto:International@adiglobal.com">Sales Support Team</a>. </p>\n\t\t\t</div>\n\t\t\t<div class="alert alert-warning" *ngIf="vm.isEmea">\n\t\t\t\t<div *ngIf="vm.currencyCode != \'CHF\'">\n\t\t\t\t\t<p>\n\t\t\t\t\t\t<b>Barclays Bank Plc</b><br /> PO Box 600<br /> 1 \u2013 3 Parliament Street<br /> York YO1 8GA\n\t\t\t\t\t</p>\n\t\t\t\t\t<div *ngIf="vm.currencyCode === \'GBP\'">\n\t\t\t\t\t\t<b>Sort Code:</b> 20-99-15<br />\n\t\t\t\t\t\t<b>Account Name:</b> Snap One EMEA Ltd <br />\n\t\t\t\t\t\t<b>Account Number:</b> 30966460<br />\n\t\t\t\t\t\t<b>Routing Numbers:</b>\n\t\t\t\t\t\t<ul class="routing-numbers">\n\t\t\t\t\t\t\t<li><b>BARC/SWIFT CODE:</b> BARCGB22</li>\n\t\t\t\t\t\t\t<li><b>IBAN:</b> GB02 BARC 2099 1530 9664 60</li>\n\t\t\t\t\t\t</ul>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div *ngIf="vm.currencyCode === \'USD\'">\n\t\t\t\t\t\t<b>Sort Code:</b> 20-99-15<br />\n\t\t\t\t\t\t<b>Account Name:</b> Snap One EMEA Ltd <br />\n\t\t\t\t\t\t<b>Account Number:</b> 86517533<br />\n\t\t\t\t\t\t<b>Routing Numbers:</b>\n\t\t\t\t\t\t<ul class="routing-numbers">\n\t\t\t\t\t\t\t<li><b>BARC/SWIFT CODE:</b> BARCGB22</li>\n\t\t\t\t\t\t\t<li><b>IBAN:</b> GB21 BARC 2099 1586 5175 33</li>\n\t\t\t\t\t\t</ul>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div *ngIf="vm.currencyCode === \'EUR\'">\n\t\t\t\t\t\t<b>Sort Code:</b> 20-99-15<br />\n\t\t\t\t\t\t<b>Account Name:</b> Snap One EMEA Ltd <br />\n\t\t\t\t\t\t<b>Account Number:</b> 73608499<br />\n\t\t\t\t\t\t<b>Routing Numbers:</b>\n\t\t\t\t\t\t<ul class="routing-numbers">\n\t\t\t\t\t\t\t<li><b>BARC/SWIFT CODE:</b> BARCGB22</li>\n\t\t\t\t\t\t\t<li><b>IBAN:</b> GB47 BARC 2099 1573 6084 99</li>\n\t\t\t\t\t\t</ul>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div *ngIf="vm.currencyCode === \'CHF\'">\n\t\t\t\t\t<p>\n\t\t\t\t\t\t<b>Barclays Bank Plc</b><br /> Leicester<br /> Leicestershire<br /> LE87 2BB\n\t\t\t\t\t</p><br>\n\t\t\t\t</div>\n\t\t\t\t<p> If you need more information, please contact the <a href="mailto:International@adiglobal.com">Sales Support Team</a>. </p>\n\t\t\t</div>\n\t\t\t<div class="alert alert-warning" *ngIf="vm.isAustralia">\n\t\t\t\t<p>\n\t\t\t\t\t<b>Bank of America Merrill Lynch</b><br /> L38, GPT, 1 Farrer Place<br /> Sydney, NSW 2000 Australia\n\t\t\t\t</p>\n\t\t\t\t<div *ngIf="vm.currencyCode === \'AUD\'">\n\t\t\t\t\t<b>Account Name:</b> Control4 APAC Pty Ltd<br />\n\t\t\t\t\t<b>Account Number:</b> 17483014<br />\n\t\t\t\t\t<b>Routing Numbers:</b>\n\t\t\t\t\t<ul class="routing-numbers">\n\t\t\t\t\t\t<li><b>BSB:</b> 232-001</li>\n\t\t\t\t\t</ul>\n\t\t\t\t</div>\n\t\t\t\t<div *ngIf="vm.currencyCode === \'NZD\'">\n\t\t\t\t\t<b>Account Name:</b> Control4 APAC Pty Ltd<br />\n\t\t\t\t\t<b>Account Number:</b> 17483030<br />\n\t\t\t\t\t<b>Routing Numbers:</b>\n\t\t\t\t\t<ul class="routing-numbers">\n\t\t\t\t\t\t<li><b>SWIFT CODE:</b> BOFAAUSX</li>\n\t\t\t\t\t</ul>\n\t\t\t\t</div>\n\t\t\t\t<div *ngIf="vm.currencyCode === \'USD\'">\n\t\t\t\t\t<b>Account Name:</b> Control4 APAC Pty Ltd<br />\n\t\t\t\t\t<b>Account Number:</b> 17483022<br />\n\t\t\t\t\t<b>Routing Numbers:</b>\n\t\t\t\t\t<ul class="routing-numbers">\n\t\t\t\t\t\t<li><b>SWIFT CODE:</b> BOFAAUSX</li>\n\t\t\t\t\t</ul>\n\t\t\t\t</div>\n\t\t\t\t<p> If you have any queries regarding these details, please contact <a href="mailto:accounting-au@snapone.com">accounting-au@snapone.com</a>.\n\t\t\t\t</p>\n\t\t\t</div>\n\t\t\t<div\n\t\t\t\t class="alert alert-danger no-margin half-margin-top"\n\t\t\t\t *ngFor="let error of vm.billing.paymentErrors">\n\t\t\t\t<p>{{ error.errorMessage }}</p>\n\t\t\t</div>\n\t\t</div>\n\t\t<div\n\t\t\t class="paymentoption half-padding-top half-padding-bottom"\n\t\t\t *ngIf="vm.billing.selectedPaymentMethod === \'Account\'">\n\t\t\t<h4>On Account</h4>\n\t\t\t<p> You are authorized to defer payment on account credit. Please proceed with checkout and this order will be billed at a later date. </p>\n\t\t\t<div\n\t\t\t\t class="alert alert-danger no-margin half-margin-top"\n\t\t\t\t *ngFor="let error of vm.billing.paymentErrors">\n\t\t\t\t<p>{{ error.errorMessage }}</p>\n\t\t\t</div>\n\t\t</div>\n\t</div>\n</ng-container>'},y0SQ:function(t,e){t.exports=""},"zi+e":function(t,e){t.exports='<div class="alert alert-warning"\n\t *ngIf="!isMsrp && (showWarning || (showSnapShippingMessage && (snapFreeShippingEnabled$ | async)) || (partnerShippingTotals?.length))">\n\t<ng-container *ngIf="!(snapFreeShippingEnabled$ | async)">\n\t\t<ng-container *ngIf="showWarning || partnerShippingTotals?.length">\n\t\t\t<h4>Free Shipping</h4>\n\t\t\t<div class="row">\n\t\t\t\t<div class="col-lg-8 col-md-7 col-sm-6">\n\t\t\t\t\t<p>\n\t\t\t\t\t\t<span *ngIf="showWarning">Your free shipping threshold is {{freeShippingThreshold | currency:currencySymbol}}. This order will qualify\n\t\t\t\t\t\t\tfor free ground shipping if {{freeShippingThreshold - discountedSubtotal | currency:currencySymbol}} of product is added to your\n\t\t\t\t\t\t\tcart.</span>\n\t\t\t\t\t\t<span *ngIf="!showWarning">This order qualifies for free shipping.</span>\n\t\t\t\t\t\t<span *ngIf="partnerShippingTotals?.length">Partner shipping exceptions listed below.</span>\n\t\t\t\t\t</p>\n\t\t\t\t</div>\n\t\t\t\t<div class="col-lg-4 col-md-5 col-sm-6">\n\t\t\t\t\t<button test-id="continueShoppingClick" type="button" class="grey block" (click)="continueShopping()">Continue Shopping</button>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t</ng-container>\n\t</ng-container>\n\t<ng-container *ngIf="(snapFreeShippingEnabled$ | async)">\n\t\t<ng-container *ngIf="showWarning || partnerShippingTotals?.length">\n\t\t\t<h4>Free Shipping</h4>\n\t\t\t<div class="row">\n\t\t\t\t<div class="col-lg-8 col-md-7 col-sm-6">\n\t\t\t\t\t<p>\n\t\t\t\t\t\t<span *ngIf="showWarning">Your {{brandName}} free shipping threshold is {{freeShippingThreshold | currency:currencySymbol}}. This order\n\t\t\t\t\t\t\twill qualify for {{brandName}} free ground shipping if {{freeShippingThreshold - discountedSubtotal | currency:currencySymbol}} of\n\t\t\t\t\t\t\tproduct is added to your cart.</span>\n\t\t\t\t\t\t<span *ngIf="!showWarning">This order qualifies for {{brandName}} free shipping.</span>\n\t\t\t\t\t\t<span *ngIf="partnerShippingTotals?.length">Partner shipping exceptions listed below.</span>\n\t\t\t\t\t</p>\n\t\t\t\t</div>\n\t\t\t\t<div class="col-lg-4 col-md-5 col-sm-6">\n\t\t\t\t\t<button test-id="continueShoppingClick" type="button" class="grey block" (click)="continueShopping()">Continue Shopping</button>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t</ng-container>\n\t\t<ng-container *ngIf="showSnapShippingMessage">\n\t\t\t<h4>SnapAV Products</h4>\n\t\t\t<div class="row">\n\t\t\t\t<div class="col-lg-8 col-md-7 col-sm-6">\n\t\t\t\t\t<p>\n\t\t\t\t\t\t<span *ngIf="!freeSnapShippingMet && !isSnapRewards">The SnapAV free shipping threshold is {{freeSnapShippingThreshold |\n\t\t\t\t\t\t\tcurrency:currencySymbol}}. SnapAV products will independently qualify for free ground shipping if {{freeSnapShippingThreshold -\n\t\t\t\t\t\t\tdiscountedSnapSubtotal | currency:currencySymbol}} of SnapAV product is added to your cart.</span>\n\t\t\t\t\t\t<span *ngIf="freeSnapShippingMet && !isSnapRewards">SnapAV products independently qualify for free ground shipping because you have over\n\t\t\t\t\t\t\t{{freeSnapShippingThreshold | currency:currencySymbol}} in SnapAV products added to your cart.</span>\n\t\t\t\t\t\t<span *ngIf="isSnapRewards">SnapAV products independently qualify for free ground shipping based on your SnapAV Partner Rewards\n\t\t\t\t\t\t\tstatus.</span>\n\t\t\t\t\t</p>\n\t\t\t\t</div>\n\t\t\t\t<div class="col-lg-4 col-md-5 col-sm-6">\n\t\t\t\t\t<button type="button" class="grey block" (click)="continueSnapShopping()">Shop SnapAV</button>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t</ng-container>\n\t</ng-container>\n\t<div *ngIf="partnerShippingTotals?.length">\n\t\t<div class="table no-margin">\n\t\t\t<div class="head">\n\t\t\t\t<div class="row">\n\t\t\t\t\t<div class="col-sm-2">Partner</div>\n\t\t\t\t\t<div class="col-sm-5 text-right d-xs-none">Free Shipping Threshold</div>\n\t\t\t\t\t<div class="col-sm-5 text-right d-xs-none">Add To Receive Free Shipping</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t\t<div class="body">\n\t\t\t\t<div class="row" *ngFor="let partnerShip of partnerShippingTotals">\n\t\t\t\t\t<div class="col-sm-2">{{partnerShip.partnerName}}</div>\n\t\t\t\t\t<div class="col-sm-5 text-right d-xs-none"> {{partnerShip.freeShippingMinimum | currency:currencySymbol}}</div>\n\t\t\t\t\t<div class="col-sm-5 text-right d-xs-none">{{partnerShip.distanceToGoal | currency:currencySymbol}} </div>\n\t\t\t\t\t<div class="col-12 d-block d-sm-none"><strong>Free Shipping Threshold:</strong> {{partnerShip.freeShippingMinimum |\n\t\t\t\t\t\tcurrency:currencySymbol}}<br><strong>Add To Receive Free Shipping:</strong> {{partnerShip.distanceToGoal | currency:currencySymbol}}\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t</div>\n\t\t<a href="javascript:;" c4Toggle="partnerfreeshipping"><small class="text-dark">More Information</small></a>\n\t\t<p class="partnerfreeshipping hidden"><small class="text-dark">This order incurred additional partner shipping charges because specific partner shipping\n\t\t\t\tminimum thresholds have not yet been met. These partner charges allow {{brandName}} to offer hundreds of low-priced partner products that would\n\t\t\t\tbe cost-prohibitive to ship on their own.</small></p>\n\t</div>\n</div>\n<div class="alert alert-warning" *ngIf="showAlertItems && shippingAlertItems?.length">\n\t<h4>Shipping From Different Warehouse</h4>\n\t<p>The following products are shipping from a different warehouse because they\'re currently out of stock at your pickup location or in the warehouse closest\n\t\tto your shipping address. Please allow 3-5 business days for delivery.</p>\n\t<div class="table">\n\t\t<div class="body">\n\t\t\t<div class="row" *ngFor="let removed of shippingAlertItems">\n\t\t\t\t<div class="col-sm 12">\n\t\t\t\t\t<div class="bold">{{removed.name}}</div>\n\t\t\t\t\t<small class="block">{{removed.sku}}</small>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t</div>\n\t</div>\n</div>'}}]);