m | currency:(currency$ | async)}} for free shipping"></span>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="col-5 text-right" test-id="partnerShipping">{{partnerShip.flatShipping | currency:(currency$ | async)}}</div>\n\t\t\t\t</div>\n\t\t\t\t<div class="row">\n\t\t\t\t\t<div class="col-7">Tax</div>\n\t\t\t\t\t<c4-loading class="col-5 right small" *ngIf="modifyingCart"></c4-loading>\n\t\t\t\t\t<div class="col-5 text-right" *ngIf="!modifyingCart" test-id="taxTotal">{{totals.taxTotal |\n\t\t\t\t\t\tcurrency:(currency$ | async)}}</div>\n\t\t\t\t</div>\n\t\t\t\t<div class="row">\n\t\t\t\t\t<div class="col-7"><b>Total</b></div>\n\t\t\t\t\t<c4-loading class="col-5 right small" *ngIf="modifyingCart"></c4-loading>\n\t\t\t\t\t<div class="col-5 text-right" *ngIf="!modifyingCart"><b test-id="grandTotal">{{totals.grandTotal\n\t\t\t\t\t\t\t| currency:(currency$ | async)}}</b></div>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t\t<mat-form-field>\n\t\t\t\t<input test-id="poReference" matInput type="text" class="no-margin" placeholder="PO Reference" [(ngModel)]="poReference" maxlength="100">\n\t\t\t</mat-form-field>\n\t\t\t<div *ngIf="modifyingCart">\n\t\t\t\t<div class="alert alert-warning no-margin half-margin-top">\n\t\t\t\t\t<p>Please wait while changes are applied to your order.</p>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t\t<div *ngIf="totals.billing?.paymentErrors?.length">\n\t\t\t\t<div class="alert alert-warning no-margin half-margin-top">\n\t\t\t\t\t<ul class="no-style">\n\t\t\t\t\t\t<li *ngFor="let error of totals.billing.paymentErrors">{{error.errorMessage}}</li>\n\t\t\t\t\t</ul>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t</div>\n\t</div>\n\t<button test-id="authorizePaymentClick" type="button" class="block" [disabled]="!canProceed || modifyingCart || impersonatingButCantOrder"\n\t\t\t(click)="authorizePayment()">Place Order</button>\n</div>'},GmXa:function(t,e){t.exports=":host {\n  display: block;\n  width: 100%;\n}"},IT9U:function(t,e){t.exports=":host {\n  display: block;\n  width: 100%;\n}\n\n