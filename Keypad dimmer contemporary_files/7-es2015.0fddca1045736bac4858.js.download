button:hover:after,\n.status .col-sm-2:not(:last-child) button.active:hover:after {\n    border-top-color: transparent;\n    border-bottom-color: transparent;\n    border-left-color: #c32032;\n  }\n}'},cKvL:function(t,e){t.exports='<div class="table">\n\t<div class="head d-xs-none">\n\t\t<div class="row">\n\t\t\t<div class="col-sm-3 clickable" (click)="sort(\'consumerName\')"> Customer <span\n\t\t\t\t\t  *ngIf="sortField === \'consumerName\'">\n\t\t\t\t\t<i [class]="desc ? \'fal fa-chevron-up\' : \'fal fa-chevron-down\'"></i>\n\t\t\t\t</span>\n\t\t\t</div>\n\t\t\t<div class="col-sm-3 clickable" (click)="sort(\'controllerType\')"> Controller <span\n\t\t\t\t\t  *ngIf="sortField === \'controllerType\'">\n\t\t\t\t\t<i [class]="desc ? \'fal fa-chevron-up\' : \'fal fa-chevron-down\'"></i>\n\t\t\t\t</span>\n\t\t\t</div>\n\t\t\t<div class="col-sm-3 clickable" (click)="sort(\'controllerOs\')"> Smart Home OS <span\n\t\t\t\t\t  *ngIf="sortField === \'controllerOs\'">\n\t\t\t\t\t<i [class]="desc ? \'fal fa-chevron-up\' : \'fal fa-chevron-down\'"></i>\n\t\t\t\t</span>\n\t\t\t</div>\n\t\t</div>\n\t</div>\n\t<div class="body">\n\t\t<c4-customer-item attr.test-id="c4-customer-item-{{i}}" [consumer]="consumer" *ngFor="let consumer of customers | paging: pagingInfo; index as i">\n\t\t</c4-customer-item>\n\t</div>\n\t<c4-pager [(info)]="pagingInfo"></c4-pager>\n</div>'},fmB0:function(t,e){t.exports='<div class="padding">\n\t<div class="row half-padding-bottom">\n\t\t<div class="col-md-6 col-7">\n\t\t\t<h1 class="truncate">Customer Upgrades</h1>\n\t\t</div>\n\t\t<div class="col-md-4 offset-md-2 col-5">\n\t\t\t<div class="form dark" *ngIf="isDistributor$ | async">\n\t\t\t\t<c4-subdealer-select [value]="subdealerId$ | async" (valueChange)="onSubDealerChange($event)">\n\t\t\t\t</c4-subdealer-select>\n\t\t\t</div>\n\t\t</div>\n\t</div>\n\t<div class="widget" style="min-height: 110px;">\n\t\t<div class="padding">\n\t\t\t<c4-loading *ngIf="!loaded"></c4-loading>\n\t\t\t<div *ngIf="loaded">\n\t\t\t\t<h2>UPGRADE OPPORTUNITIES\u2014SAVE 15% ON EVERY UPGRADE</h2>\n\t\t\t\t<div class="row">\n\t\t\t\t\t<div class="col-sm-6 half-margin-bottom">\n\t\t\t\t\t\t<p> With the release of OS 3 we\u2019ve simplified our upgrade program and sweetened the deal for you and your customers! Your Control4\n\t\t\t\t\t\t\tcustomers receive a <a href="javascript:;"\n\t\t\t\t\t\t\t   routerLink="/programs/customer-upgrade">15%* discount</a> when they upgrade or expand their system. You get free shipping on all\n\t\t\t\t\t\t\tControl4, Pakedge, or Triad gear for the project, and receive the upgrade discount when you place the order \u2013 no paperwork to fill\n\t\t\t\t\t\t\tout later! </p>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="col-sm-6 half-margin-bottom">\n\t\t\t\t\t\t<div>\n\t\t\t\t\t\t\t<h2 class="no-margin bold inline">{{outdatedControllers$ | async}}</h2>\n\t\t\t\t\t\t\t<p class="inline"> Primary controllers <no-br>need upgrading</no-br>\n\t\t\t\t\t\t\t</p>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<progress [ngClass]="{\n\t\t\t\t\t                                \'danger\': percentComplete <= 50,\n\t\t\t\t\t                                \'warning\': percentComplete > 50 && percentComplete <= 75,\n\t\t\t\t\t                                \'success\': percentComplete > 75\n\t\t\t\t\t                            }" [value]="percentComplete" max="100" style="margin: 10px 0 6px 0;"></progress>\n\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t<div class="col-6"><small class="no-margin">\n\t\t\t\t\t\t\t\t\t<span class="bold">{{percentComplete}}%</span> Controllers up to date</small></div>\n\t\t\t\t\t\t\t<div class="col-6 text-right"><small class="no-margin">\n\t\t\t\t\t\t\t\t\t<span class="bold">{{allCustomers.length}}</span> Total customer projects</small>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class="row">\n\t\t\t\t\t<div class="col-sm-12 half-margin-bottom">\n\t\t\t\t\t\t<p> Now is the perfect time to reconnect with your customers and add a new revenue stream to your business. By upgrading outdated\n\t\t\t\t\t\t\tproducts and updating them to OS 3, your customers get a new, personalized smart home experience; and you generate new revenue for\n\t\t\t\t\t\t\tyour dealership. It\u2019s a win-win! </p>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<button test-id="toggleHowToUpgradeClick" (click)="toggleHowToUpgrade()" class="light-grey"><i class="fal"\n\t\t\t\t\t   [ngClass]="showOpportunities ? \'fa-chevron-up\' : \'fa-chevron-down\'">\n\t\t\t\t\t</i>Learn How to Upgrade</button>\n\t\t\t\t<div class="light-grey half-margin-bottom" [hidden]="!showOpportunities">\n\t\t\t\t\t<a href="javascript:void(0);" test-id="togglehowToUpgradeClick" (click)="toggleHowToUpgrade()" class="c4close"></a>\n\t\t\t\t\t<div class="row no-margin">\n\t\t\t\t\t\t<div class="col-sm-3">\n\t\t\t\t\t\t\t<div class="background"\n\t\t\t\t\t\t\t\t style="height: 125px; background-image: url(//res.cloudinary.com/control4/image/upload/static-pages/showroom/posters-ht.jpg);">\n\t\t\t\t\t\t\t\t<div class="background-clickable tabs active" c4ClickToggle="tabs" hide="tab" show="one"\n\t\t\t\t\t\t\t\t\t trackCategory="Upgrade dashboard" trackLabel="1 identify customers" c4Track="Tab">\n\t\t\t\t\t\t\t\t\t<div class="vertically-center text-white text-center">\n\t\t\t\t\t\t\t\t\t\t<p class="uppercase no-margin"><small class="text-light-grey">Step 1</small></p>\n\t\t\t\t\t\t\t\t\t\t<h3 class="uppercase text-white">Identify Customers</h3>\n\t\t\t\t\t\t\t\t\t\t<span class="round-icon-outline"><i class="fal fa-chevron-down"></i></span>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class="col-sm-3">\n\t\t\t\t\t\t\t<div class="background"\n\t\t\t\t\t\t\t\t style="height: 125px; background-image: url(//res.cloudinary.com/control4/image/upload/static-pages/showroom/posters-ht.jpg);">\n\t\t\t\t\t\t\t\t<div class="background-clickable tabs" c4ClickToggle="tabs" hide="tab" show="two"\n\t\t\t\t\t\t\t\t\t trackCategory="Upgrade dashboard" trackLabel="2 Marketing" c4Track="Tab">\n\t\t\t\t\t\t\t\t\t<div class="vertically-center text-white text-center">\n\t\t\t\t\t\t\t\t\t\t<p class="uppercase no-margin"><small class="text-light-grey">Step 2</small></p>\n\t\t\t\t\t\t\t\t\t\t<h3 class="uppercase text-white">Contact</h3>\n\t\t\t\t\t\t\t\t\t\t<span class="round-icon-outline"><i class="fal fa-chevron-down"></i></span>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class="col-sm-3">\n\t\t\t\t\t\t\t<div class="background"\n\t\t\t\t\t\t\t\t style="height: 125px; background-image: url(//res.cloudinary.com/control4/image/upload/static-pages/showroom/posters-ht.jpg);">\n\t\t\t\t\t\t\t\t<div class="background-clickable tabs" c4ClickToggle="tabs" hide="tab" show="three"\n\t\t\t\t\t\t\t\t\t trackCategory="Upgrade dashboard" trackLabel="3 Demo" c4Track="Tab">\n\t\t\t\t\t\t\t\t\t<div class="vertically-center text-white text-center">\n\t\t\t\t\t\t\t\t\t\t<p class="uppercase no-margin"><small class="text-light-grey">Step 3</small></p>\n\t\t\t\t\t\t\t\t\t\t<h3 class="uppercase text-white">Demo</h3>\n\t\t\t\t\t\t\t\t\t\t<span class="round-icon-outline"><i class="fal fa-chevron-down"></i></span>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class="col-sm-3">\n\t\t\t\t\t\t\t<div class="background"\n\t\t\t\t\t\t\t\t style="height: 125px; background-image: url(//res.cloudinary.com/control4/image/upload/static-pages/showroom/posters-ht.jpg);">\n\t\t\t\t\t\t\t\t<div class="background-clickable tabs" c4ClickToggle="tabs" hide="tab" show="four"\n\t\t\t\t\t\t\t\t\t trackCategory="Upgrade dashboard" trackLabel="4 Close the upgrade" c4Track="Tab">\n\t\t\t\t\t\t\t\t\t<div class="vertically-center text-white text-center">\n\t\t\t\t\t\t\t\t\t\t<p class="uppercase no-margin"><small class="text-light-grey">Step 4</small></p>\n\t\t\t\t\t\t\t\t\t\t<h3 class="uppercase text-white">Save 15%</h3>\n\t\t\t\t\t\t\t\t\t\t<span class="round-icon-outline"><i class="fal fa-chevron-down"></i></span>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="padding half-padding-top">\n\t\t\t\t\t\t<div class="tab one">\n\t\t\t\t\t\t\t<h3>Identify Customers</h3>\n\t\t\t\t\t\t\t<p> Use the customer filters below to segment your customers based on their potential upgrade opportunity. Or, sort and filter based\n\t\t\t\t\t\t\t\ton your own business needs. </p>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class="tab two hidden">\n\t\t\t\t\t\t\t<h3>Contact</h3>\n\t\t\t\t\t\t\t<p> Contact customers that are eligible for an upgrade and schedule an OS 3 demo. Download your customers\u2019 contact information by\n\t\t\t\t\t\t\t\tclicking Export XLS below. Use our pre-made OS 3 sales tools to help with spreading the OS 3 message. Link to your personally\n\t\t\t\t\t\t\t\tbranded OS 3 upgrade microsite in your emails and digital advertising. </p>\n\t\t\t\t\t\t\t<a class="c4btn grey" routerLink="/os3/selling-os3" fragment="resources">OS 3 Sales Tools</a>\n\t\t\t\t\t\t\t<c4-microsite-list [upgradeMicrositeOnly]="true"></c4-microsite-list>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class="tab three hidden">\n\t\t\t\t\t\t\t<h3>Demonstrate</h3>\n\t\t\t\t\t\t\t<p> Prior to demoing, run OS\u202f3 Upgrade Advisor remotely with Composer Pro. Complete an OS 3 demo with the customer and discuss any\n\t\t\t\t\t\t\t\tnecessary upgrades or system expansion recommendations. </p>\n\t\t\t\t\t\t\t<a href="//www.control4.com/docs/product/control4-showroom-demo/best-practices/english/latest"\n\t\t\t\t\t\t\t   class="c4btn grey">OS 3 Demo Guide</a>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class="tab four hidden">\n\t\t\t\t\t\t\t<h3>Close and install</h3>\n\t\t\t\t\t\t\t<p> Offer a 15% discount on all Control4, Pakedge, and Triad gear when your customer upgrades or expands their Control4 system. You\n\t\t\t\t\t\t\t\treceive the discount upfront at the time of checkout online and free ground shipping. </p>\n\t\t\t\t\t\t\t<a class="c4btn grey" routerLink="/programs/customer-upgrade">Learn More</a>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class="row">\n\t\t\t\t\t<div class="col-md-6 half-margin-bottom">\n\t\t\t\t\t\t<mat-form-field class="no-margin">\n\t\t\t\t\t\t\t<input test-id="customerSearchTerm" matInput type="text" placeholder="Search by name, controller, OS, status"\n\t\t\t\t\t\t\t\t   [ngModel]="filter.searchTerm" (ngModelChange)="onSearchChange($event)">\n\t\t\t\t\t\t</mat-form-field>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="col-md-2 col-6 half-margin-bottom">\n\t\t\t\t\t\t<button test-id="showFiltersToggleClick" class="light-grey block no-margin" (click)="showFilters = !showFilters" *ngIf="loaded">\n\t\t\t\t\t\t\t<i class="fal"\n\t\t\t\t\t\t\t   [ngClass]="showFilters ? \'fa-chevron-up\' : \'fa-chevron-down\'"></i>Filter</button>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="col-md-2 col-6 half-margin-bottom">\n\t\t\t\t\t\t<button test-id="exportFiltersClick" *ngIf="loaded" class="light-grey block no-margin" (click)="exportDashboardControllers()"\n\t\t\t\t\t\t\t\t[disabled]="allCustomers === filteredCustomers" c4Track="Click"\n\t\t\t\t\t\t\t\ttrackCategory="Controller Dashboard" trackLabel="Export Filtered Customers">\n\t\t\t\t\t\t\t<i class="fal fa-arrow-to-bottom"></i>Export Filtered</button>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="col-md-2 col-6 half-margin-bottom">\n\t\t\t\t\t\t<button test-id="exportAllFiltersClick" *ngIf="loaded" class="light-grey block no-margin"\n\t\t\t\t\t\t\t\t(click)="exportAllDashboardControllers()" c4Track="Click"\n\t\t\t\t\t\t\t\ttrackCategory="Controller Dashboard" trackLabel="Export All">\n\t\t\t\t\t\t\t<i class="fal fa-arrow-to-bottom"></i>Export All</button>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class="light-grey padding half-margin-bottom" [hidden]="!showFilters">\n\t\t\t\t\t<a href="javascript:void(0);" test-id="toggleShowFiltersClick" (click)="showFilters = !showFilters" class="c4close"></a>\n\t\t\t\t\t<p>\n\t\t\t\t\t\t<small *ngIf="showAdvancedFilter">\n\t\t\t\t\t\t\t<span class="bold">Advanced</span> | <a test-id="toggleShowAdvancedFiltersClick" href="javascript:void(0);"\n\t\t\t\t\t\t\t   (click)="showAdvancedFilter = !showAdvancedFilter">Filter presets</a>\n\t\t\t\t\t\t</small>\n\t\t\t\t\t\t<small *ngIf="!showAdvancedFilter">\n\t\t\t\t\t\t\t<span class="bold">Filter presets</span> | <a href="javascript:void(0);"\n\t\t\t\t\t\t\t   (click)="showAdvancedFilter = !showAdvancedFilter">Advanced</a>\n\t\t\t\t\t\t</small>\n\t\t\t\t\t</p>\n\t\t\t\t\t<div class="row no-margin" [hidden]="showAdvancedFilter">\n\t\t\t\t\t\t<div class="col-lg-4 col-sm-6" *ngFor="let preset of presets">\n\t\t\t\t\t\t\t<label>\n\t\t\t\t\t\t\t\t<span>\n\t\t\t\t\t\t\t\t\t<input test-id="filterPresetRadio" type="radio" c4Track="Click" [(ngModel)]="filter" [value]="preset"\n\t\t\t\t\t\t\t\t\t\t   trackCategory="Controller Dashboard" [trackLabel]="preset.label"> {{preset.label}} <c4-tooltip class="bottom"\n\t\t\t\t\t\t\t\t\t\t\t\t*ngIf="preset.description"> {{preset.description}} </c4-tooltip>\n\t\t\t\t\t\t\t\t</span>\n\t\t\t\t\t\t\t</label>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="form dark" [hidden]="!showAdvancedFilter">\n\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t<div class="col-sm-6">\n\t\t\t\t\t\t\t\t<mat-form-field>\n\t\t\t\t\t\t\t\t\t<mat-label>Select Controller</mat-label>\n\t\t\t\t\t\t\t\t\t<mat-select test-id="selectController" multiple [ngModel]="filter.controllerTypeGroupIds"\n\t\t\t\t\t\t\t\t\t\t\t\t(ngModelChange)="updateFilter({controllerTypeGroupIds:$event, controllerTypeIds: []})">\n\t\t\t\t\t\t\t\t\t\t<mat-option *ngFor="let controller of controllerTypeGroups"\n\t\t\t\t\t\t\t\t\t\t\t\t\t[value]="controller.id"> {{controller.name}}</mat-option>\n\t\t\t\t\t\t\t\t\t\t<mat-option [value]="0">Unknown</mat-option>\n\t\t\t\t\t\t\t\t\t</mat-select>\n\t\t\t\t\t\t\t\t</mat-form-field>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class="col-sm-6">\n\t\t\t\t\t\t\t\t<mat-form-field>\n\t\t\t\t\t\t\t\t\t<mat-label>Select OS</mat-label>\n\t\t\t\t\t\t\t\t\t<mat-select test-id="selectOs" multiple [ngModel]="filter.controllerOsGroupIds"\n\t\t\t\t\t\t\t\t\t\t\t\t(ngModelChange)="updateFilter({controllerOsGroupIds:$event, controllerOsIds: []})">\n\t\t\t\t\t\t\t\t\t\t<mat-option *ngFor="let os of controllerOsGroups" [value]="os.id">{{os.name}} </mat-option>\n\t\t\t\t\t\t\t\t\t\t<mat-option [value]="0">Unknown</mat-option>\n\t\t\t\t\t\t\t\t\t</mat-select>\n\t\t\t\t\t\t\t\t</mat-form-field>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="text-right">\n\t\t\t\t\t\t<small>\n\t\t\t\t\t\t\t<span [hidden]="!showAdvancedFilter">\n\t\t\t\t\t\t\t\t<a href="javascript:void(0);" test-id="saveAsPresetClick" (click)="saveAsPreset()"> Create new preset from these selections</a>\n\t\t\t\t\t\t\t\t| </span>\n\t\t\t\t\t\t\t<a href="javascript:void(0);" test-id="resetFiltersClick" (click)="resetFilters()">Reset Filters</a>\n\t\t\t\t\t\t</small>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class="row">\n\t\t\t\t\t<div class="col-lg-9 col-sm-8">\n\t\t\t\t\t\t<c4-customers-list [customers]="filteredCustomers"></c4-customers-list>\n\t\t\t\t\t\t<div class="alert alert-warning" *ngIf="filteredCustomers?.length === 0 && filter.searchTerm"> There are no records with the above\n\t\t\t\t\t\t\tcriteria associated with this account. If you feel the message is in error, please contact your customers directly to have them\n\t\t\t\t\t\t\treassign the dealer of record within the My Account section of the Customer Portal, customer.control4.com. </div>\n\t\t\t\t\t\t<div class="alert alert-warning" *ngIf="filteredCustomers?.length === 0 && !filter.searchTerm"> There are no customers associated to\n\t\t\t\t\t\t\tthis dealer account. If you feel the message is in error, please contact your customers directly to have them reassign the dealer of\n\t\t\t\t\t\t\trecord within the My Account section of the Customer Portal, customer.control4.com. </div>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="col-lg-3 col-sm-4">\n\t\t\t\t\t\t<div class="table">\n\t\t\t\t\t\t\t<div class="head">\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-12">Controllers</div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<c4-loading *ngIf="!loaded"></c4-loading>\n\t\t\t\t\t\t<div *ngIf="loaded && !showCharts" class="padding-bottom">\n\t\t\t\t\t\t\t<div class="vertically-center text-center">There is no controller data for this dealer. </div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<c4-pie-chart [display]="loaded && showCharts" chartHeight="250"\n\t\t\t\t\t\t\t\t\t  (sectionClick)="updateControllerTypeFilter($event)" [data]="typeChart">\n\t\t\t\t\t\t</c4-pie-chart>\n\t\t\t\t\t\t<div class="table">\n\t\t\t\t\t\t\t<div class="head">\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-12">Smart Home OS</div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<c4-loading *ngIf="!loaded"></c4-loading>\n\t\t\t\t\t\t<div *ngIf="loaded && !showCharts" class="padding-bottom">\n\t\t\t\t\t\t\t<div class="vertically-center text-center">There is no controller data for this dealer. </div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<c4-pie-chart [display]="loaded && showCharts" chartHeight="250"\n\t\t\t\t\t\t\t\t\t  (sectionClick)="updateControllerOsFilter($event)" [data]="osChart">\n\t\t\t\t\t\t</c4-pie-chart>\n\t\t\t\t\t\t<a href="javascript:void(0);" test-id="resetFiltersAnchorBottom" *ngIf="filter !== defaultFilter" (click)="resetFilters()">Reset\n\t\t\t\t\t\t\tFilters</a>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t\t<p>\n\t\t\t\t<small class="footnote block"><b>*</b>Products purchased with the 15% customer upgrade program discount will not be eligible for any further\n\t\t\t\t\tdiscounts, including the Snap Partner Rewards program discount.</small>\n\t\t\t</p>\n\t\t</div>\n\t</div>\n</div>'},"h7Q+":function(t,e){t.exports='<div class="row no-margin">\n\t<div class="col-lg-4">\n\t\t<small>{{lead.leadType | leadTypeMap : "Lead"}}</small>\n\t\t<p class="no-margin">\n\t\t\t<a href="javascript:;" test-id="changeDetailsViewClick" class="text-dark bold" (click)="changeView(\'details\')">{{lead.name}} <i\n\t\t\t\t   class="fal fa-chevron-{{view === \'details\' ? \'up\' : \'down\'}} text-grey"></i>\n\t\t\t</a>\n\t\t</p>\n\t\t<ul class="no-style" *ngIf="view === \'details\'">\n\t\t\t<li>{{lead.streetAddress}}</li>\n\t\t\t<li>{{lead.city}}<span *ngIf="lead.state && lead.city">,</span> {{lead.state}} {{lead.postalCode}}</li>\n\t\t\t<li>{{lead.country}}</li>\n\t\t\t<li><a [href]="\'mailto:\'+lead.email">{{lead.email}}</a></li>\n\t\t\t<li><a [href]="\'tel:\'+ lead.phone">{{lead.phone}}</a></li>\n\t\t\t<li *ngIf="lead.consumerAccount">{{lead.consumerAccount}}</li>\n\t\t</ul>\n\t</div>\n\t<div class="col-lg-8">\n\t\t<div *ngIf="view === \'installConfirm\'" class="alert alert-success">\n\t\t\t<h4>Project Installed</h4>\n\t\t\t<p>You have indicated this project is installed and the sale complete. If confirmed this {{lead.leadType | leadTypeMap\n\t\t\t\t: "Lead" | lowercase}} will be removed from open {{lead.leadType | leadTypeMap : "Lead" | lowercase}}s.</p>\n\t\t\t<button test-id="installUpdateStatusConfirmClick" class="grey" (click)="updateStatus()" trackCategory="Leads" c4Track="Click"\n\t\t\t\t\t[trackLabel]="(lead.leadType | leadTypeMap : \'Lead\') + \' Install Confirm\'"\n\t\t\t\t\t[disabled]="disabled">Confirm</button>\n\t\t\t<button test-id="cancelUpdateStatusClick" class="transparent" (click)="changeView(\'\')" trackCategory="Leads" c4Track="Click"\n\t\t\t\t\t[trackLabel]="(lead.leadType | leadTypeMap : \'Lead\') + \' Install Cancel\'">Cancel</button>\n\t\t</div>\n\t\t<div class="row no-margin status">\n\t\t\t<div class="col-sm-2" *ngFor="let status of leadStatusMap; index as i">\n\t\t\t\t<button attr.test-id="queueStatusUpdateClick-{{i}}"\n\t\t\t\t\t\t[ngClass]="[\'block no-margin\', (update.status || lead.status) === status.key ? \'active\' : \'light-grey\']"\n\t\t\t\t\t\t(click)="queueStatusUpdate(status.key)">{{status.value}}</button>\n\t\t\t</div>\n\t\t</div>\n\t\t<small class="block text-right">Updated {{lead.lastModifiedAt | date: \'MMM dd, yyyy\' }} | <a href="javascript:;"\n\t\t\t   (click)="changeView(\'cancelConfirm\')" trackCategory="Leads" c4Track="Click"\n\t\t\t   [trackLabel]="\'Cancel \' + (lead.leadType | leadTypeMap: \'Lead\')">Cancel {{lead.leadType\n\t\t\t\t| leadTypeMap: \'Lead\'}}</a></small>\n\t\t<c4-lead-cancellation-form *ngIf="view === \'cancelConfirm\'" [lead]="lead" (confirmed)="changeView(\'\')" (closed)="changeView(\'cancelConfirm\')">\n\t\t</c4-lead-cancellation-form>\n\t\t<div *ngIf="view === \'notes\'">\n\t\t\t<div class="half-margin-bottom" *ngIf="(lead.leadType === \'Microsite\' || lead.leadType === \'Showroom Event\') && lead.formattedDealerAddress">\n\t\t\t\t<small class="block half-margin-top"><strong>Dealership Location</strong>\n\t\t\t\t\t<ul class="no-style">\n\t\t\t\t\t\t<li>{{lead.dealerAddress}}</li>\n\t\t\t\t\t\t<li>{{lead.dealerCity}}<span ng-if="lead.dealerCity && lead.dealerState">,</span> {{lead.dealerState}} {{lead.dealerZip}}</li>\n\t\t\t\t\t\t<li *ngIf="lead.partySizeCount !== \'0\'">{{lead.partySizeCount}} Attendees</li>\n\t\t\t\t\t</ul>\n\t\t\t\t</small>\n\t\t\t</div>\n\t\t\t<p class="no-margin bold">Activity History</p>\n\t\t\t<textarea test-id="updateNotes" maxlength="245" [(ngModel)]="update.notes"></textarea>\n\t\t\t<small class="block text-right">{{update.notes ? update.notes.length : 0}} / 245 characters</small>\n\t\t\t<ul class="inline">\n\t\t\t\t<li><button test-id="updateStatus" class="grey no-margin" (click)="updateStatus()" c4Track="Click" trackCategory="Leads"\n\t\t\t\t\t\t\t[trackLabel]="(lead.leadType | leadTypeMap : \'Lead\') + \' Status \' + update.status + \' Confirm\'"\n\t\t\t\t\t\t\t[disabled]="disabled">Confirm</button>\n\t\t\t\t</li>\n\t\t\t\t<li><button test-id="changeViewClick" class="transparent no-margin" (click)="changeView(\'\')">Cancel</button></li>\n\t\t\t</ul>\n\t\t\t<p class="half-margin-top"><small>{{lead.notes}}</small></p>\n\t\t</div>\n\t\t<div *ngIf="view === \'details\'">\n\t\t\t<div class="half-margin-bottom" *ngIf="(lead.leadType === \'Microsite\' || lead.leadType === \'Showroom Event\') && lead.formattedDealerAddress">\n\t\t\t\t<small class="block half-margin-top"><strong>Dealership Location</strong>\n\t\t\t\t\t<ul class="no-style">\n\t\t\t\t\t\t<li>{{lead.dealerAddress}}</li>\n\t\t\t\t\t\t<li>{{lead.dealerCity}}<span ng-if="lead.dealerCity && lead.dealerState">,</span> {{lead.dealerState}} {{lead.dealerZip}}</li>\n\t\t\t\t\t\t<li *ngIf="lead.partySizeCount !== \'0\'">{{lead.partySizeCount}} Attendees</li>\n\t\t\t\t\t</ul>\n\t\t\t\t</small>\n\t\t\t</div>\n\t\t\t<p *ngIf="lead.notes" class="no-margin bold">Activity History</p>\n\t\t\t<p><small>{{lead.notes}}</small></p>\n\t\t\t<p *ngIf="!isEmpty(lead.details) || lead.leadGenNotes" class="no-margin bold">Details</p>\n\t\t\t<div class="row no-margin" *ngFor="let detail of lead.details | keyvalue">\n\t\t\t\t<div class="col-sm-4 bold"><small>{{detail.key}}</small></div>\n\t\t\t\t<div class="col-sm-8"><small>{{detail | leadDetailDisplay}}</small></div>\n\t\t\t</div>\n\t\t\t<div class="row no-margin" *ngIf="lead.leadGenNotes">\n\t\t\t\t<div class="col-sm-4 bold"><small>Agent Notes</small></div>\n\t\t\t\t<div class="col-sm-8"><small>{{lead.leadGenNotes}}</small></div>\n\t\t\t</div>\n\t\t</div>\n\t</div>\n</div>'},hUZZ:function(t,e){t.exports=""},p1iS:function(t,e){t.exports=""},qlI5:function(t,e){t.exports=""},tAbR:function(t,e){t.exports=""},uxkY:function(t,e){t.exports=""},wZDd:function(t,e){t.exports=""},xzcr:function(t,e){t.exports=".border-left-success {\n  border-left: 3px solid #c5b92f50;\n  -webkit-transition: border-left ease-in-out 0.3s;\n  transition: border-left ease-in-out 0.3s;\n}\n.border-left-success:hover {\n  border-left: 3px solid #c5b92f;\n}\n.info-help {\n  cursor: help;\n}\n.new {\n  -o-box-shadow: inset 3px 0 0 0 #c5b92f;\n  box-shadow: inset 3px 0 0 0 #c5b92f;\n}\n.new-47 {\n  -o-box-shadow: inset 3px 0 0 0 #e7b538;\n  box-shadow: inset 3px 0 0 0 #e7b538;\n}\n.new-8plus {\n  -o-box-shadow: inset 3px 0 0 0 #8A2432;\n  box-shadow: inset 3px 0 0 0 #8A2432;\n}\na.success {\n  -webkit-transition: all 0.1s ease-in-out;\n  transition: all 0.1s ease-in-out;\n}\na.success:hover {\n  color: #424548;\n}\n.update-success, .new-success {\n  background-color: #c5b92f20;\n  border-left: 3px solid #c5b92f;\n  max-width: 160px;\n  padding: 1.5px 6px;\n}\n.update-danger, .new-danger {\n  background-color: #7F202C20;\n  border-left: 3px solid #7F202C;\n  max-width: 160px;\n  padding: 1.5px 6px;\n}\n.update-warning, .new-warning {\n  background-color: #E7B53833;\n  border-left: 3px solid #E7B538;\n  max-width: 160px;\n  padding: 1.5px 6px;\n}\n@media only screen and (max-width: 767px) {\n  .update-success, .new-success {\n    background-color: #c5b92f20;\n    border-left: 3px solid #c5b92f;\n    max-width: 200px;\n    padding: 1.5px 6px;\n  }\n\n  .update-danger, .new-danger {\n    background-color: #7F202C20;\n    border-left: 3px solid #7F202C;\n    max-width: 200px;\n    padding: 1.5px 6px;\n  }\n\n  .update-warning, .new-warning {\n    background-color: #E7B53833;\n    border-left: 3px solid #E7B538;\n    max-width: 200px;\n    padding: 1.5px 6px;\n  }\n}"},"y+H8":function(t,e){t.exports='<div class="widget">\n\t<h3 class="widget-header-white">Open</h3>\n\t<ul class="inline absolute top right">\n\t\t<li><button test-id="openLeadsClick" class="no-margin" [className]="viewing === \'leads\' ? \'light-grey\' : \'transparent\'"\n\t\t\t\t\t(click)="viewing = \'leads\'" c4Track="Click" trackCategory="Leads" trackLabel="Open Leads">Leads <span\n\t\t\t\t\t  class="badge" *ngIf="(openLeads$ | async)?.length as open">{{open}}</span></button></li>\n\t\t<li><button test-id="openUpgradesClick" class="no-margin" [className]="viewing === \'upgrades\' ? \'light-grey\' : \'transparent\'"\n\t\t\t\t\t(click)="viewing = \'upgrades\'" c4Track="Click" trackCategory="Leads" trackLabel="Open Upgrades">Upgrades <span class="badge"\n\t\t\t\t\t  *ngIf="(openUpgrades$ | async)?.length as upgrades">{{upgrades}}</span></button>\n\t\t</li>\n\t\t<li><button test-id="openShowroomEventsClick" class="no-margin" [className]="viewing === \'showrooms\' ? \'light-grey\' : \'transparent\'"\n\t\t\t\t\t(click)="viewing = \'showrooms\'" c4Track="Click" trackCategory="Leads"\n\t\t\t\t\ttrackLabel="Open Showroom Events">Showroom Events<span class="badge"\n\t\t\t\t\t  *ngIf="(openShowroomEvents$ | async)?.length as showrooms">{{showrooms}}</span></button></li>\n\t</ul>\n\t<div class="padding">\n\t\t<div *ngIf="viewing === \'leads\'">\n\t\t\t<p *ngIf="!(openLeads$ | async)?.length"> You do not have any open leads at this time. When you accept a new lead, it will show up here. </p>\n\t\t\t<div class="table">\n\t\t\t\t<div class="body">\n\t\t\t\t\t<c4-open-lead attr.test-id="c4-open-lead-leads-{{i}}" *ngFor="let lead of openLeads$ | async; index as i" [lead]="lead"\n\t\t\t\t\t\t\t\t  class="block half-margin-bottom"></c4-open-lead>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t</div>\n\t\t<div *ngIf="viewing === \'upgrades\'">\n\t\t\t<p *ngIf="!(openUpgrades$ | async)?.length"> You do not have any open upgrades at this time. Contact your Control4 Sales Manager if you want help\n\t\t\t\tsecuring existing customer upgrade opportunities. </p>\n\t\t\t<div class="table">\n\t\t\t\t<div class="body">\n\t\t\t\t\t<c4-open-lead attr.test-id="c4-open-leads-upgrades-{{i}}" *ngFor="let lead of openUpgrades$ | async; index as i" [lead]="lead"\n\t\t\t\t\t\t\t\t  class="row"></c4-open-lead>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t</div>\n\t\t<div *ngIf="viewing === \'showrooms\'">\n\t\t\t<p *ngIf="!(openShowroomEvents$ | async)?.length"> You do not have any open showroom leads at this time. Contact your Control4 Sales Manager if you\n\t\t\t\twant help securing showroom event opportunities. </p>\n\t\t\t<div class="table">\n\t\t\t\t<div class="body">\n\t\t\t\t\t<c4-open-lead attr.test-id="c4-open-leads-showrooms-{{i}}" *ngFor="let lead of openShowroomEvents$ | async; index as i" [lead]="lead">\n\t\t\t\t\t</c4-open-lead>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t</div>\n\t</div>\n</div>'},yexV:function(t,e){t.exports='<div class="padding">\n\t<div class="row half-padding-bottom">\n\t\t<div class="col-md-4 col-6">\n\t\t\t<h1>Subscriptions</h1>\n\t\t</div>\n\t\t\x3c!-- <div class="col-md-4 offset-md-4 col-6">\n\t\t\t<div class="form dark" *ngIf="isDistributor$ | async">\n\t\t\t\t<c4-subdealer-select [value]="subdealerFilter$ | async" (valueChange)="onSubDealerChange($event)">\n\t\t\t\t</c4-subdealer-select>\n\t\t\t</div>\n\t\t</div> --\x3e\n\t</div>\n\t<div class="widget padding">\n\t\t\x3c!-- <h2 class="bold">{{(consumersWithout4Sight$ | async)}} Customers Without 4Sight</h2> --\x3e\n\t\t<p class="alert alert-warning" style="padding-left: 70px;">\n\t\t\t<i>The Control4 Subscriptions Dashboard is currently being updated. Please access your 4Sight/ Connect/ + Assist subscription summary information in\n\t\t\t\tthe <b>Reports</b> section in OvrC under <b>Control4 Accounts.</b></i>\n\t\t</p>\n\t\t\x3c!-- <div class="row" *ngIf="!consumersLoaded">\n\t\t\t<c4-loading></c4-loading>\n\t\t</div>\n\t\t<div class="row" *ngIf="consumersLoaded">\n\t\t\t<div class="col-md-6">\n\t\t\t\t<p>Get real-time information about your customers\' 4Sight subscription adoption.</p>\n\t\t\t\t<p>\n\t\t\t\t\tFilter your customer list by those who are purchasing subscriptions on their own \n\t\t\t\t\tor by subscriptions you purchased on their behalf. Use the dashboard to understand \n\t\t\t\t\tin detail the history of each 4Sight subscription and identify new opportunities for\n\t\t\t\t\tcustomers without subscriptions. \n\t\t\t\t</p>\n\t\t\t\t<p>\n\t\t\t\t\tWhether the customer purchased their own subscription or you purchased it on their behalf,\n\t\t\t\t\tyou will receive 25% of the MSRP back. When you purchase on their behalf, the 25% comes \n\t\t\t\t\tas a direct discount to you. If the customer subscribes themselves then you will receive 25% \n\t\t\t\t\tof what they are charged back as credit towards a future purchase. For example: If a Partner \n\t\t\t\t\tin the U.S. subscribes a customer to 4Sight the Partner would pay $90 USD. If the customer \n\t\t\t\t\twere to subscribe themselves, then they would be charged $120 USD MSRP and the Partner \n\t\t\t\t\twould be credited $30 USD.\n\t\t\t\t</p>\n\t\t\t\t<p>\n\t\t\t\t\t<small>Dashboard Last Updated {{ refreshDate$ | async | date: \'MMM dd, yyyy\' }}</small>\n\t\t\t\t</p>\n\t\t\t</div>\n\t\t\t<div class="col-md-6">\n\t\t\t\t<c4-license-adoption></c4-license-adoption>\n\t\t\t</div>\n\t\t</div>\n\t\t<div class="form half-padding-top">\n\t\t\t<div class="row">\n\t\t\t\t<div class="col-md-6 col-sm-8">\n\t\t\t\t\t<h3>Your Customers</h3>\n\t\t\t\t</div>\n\t\t\t\t<div class="col-md-3 col-sm-4 offset-sm-0 col-6 offset-6">\n\t\t\t\t\t<button test-id="exportXlsClick" *ngIf="consumersLoaded" (click)="exportDashboardControllers()" class="light-grey block"\n\t\t\t\t\t\t\t[disabled]="!filteredCustomers?.length" c4Track="Click" trackCategory="Licenses Dashboard"\n\t\t\t\t\t\t\ttrackLabel="Export XLS">\n\t\t\t\t\t\t<i class="fal fa-arrow-to-bottom"></i>Export XLS</button>\n\t\t\t\t</div>\n\t\t\t\t<div class="col-md-3 offset-md-0 col-sm-4 offset-sm-8 col-6 offset-6">\n\t\t\t\t\t<button test-id="toggleFiltersClick" class="light-grey block" (click)="showFilters = !showFilters" *ngIf="consumersLoaded">\n\t\t\t\t\t\t<i class="fal fa-chevron-down"></i>Filter</button>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t\t<div id="filter" class="padding light-grey form dark" [hidden]="!showFilters" *ngIf="consumersLoaded">\n\t\t\t\t<div class="row">\n\t\t\t\t\t<div class="col-md-4">\n\t\t\t\t\t\t<p class="small-caps text-grey" style="margin-bottom: 3px;">Customer</p>\n\t\t\t\t\t\t<mat-form-field>\n\t\t\t\t\t\t\t<input test-id="subscriptionSearchTerm" matInput type="text" class="" placeholder="search by name"\n\t\t\t\t\t\t\t\t   [ngModel]="filter.searchTerm" (ngModelChange)="onSearchChange($event)">\n\t\t\t\t\t\t</mat-form-field>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="col-md-2 col-6">\n\t\t\t\t\t\t<p class="small-caps text-grey" style="margin-bottom: 3px;">Activity Start Date</p>\n\t\t\t\t\t\t<input test-id="activityStartDate" type="date" placeholder="Activity Start Date"\n\t\t\t\t\t\t\t   [disabled]="!(filter.expiryType === \'all\' || filter.expiryType === \'expired\')"\n\t\t\t\t\t\t\t   [ngModel]="filter.startDate" (ngModelChange)="onStartDateChange($event)">\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="col-md-2 col-6">\n\t\t\t\t\t\t<p class="small-caps text-grey" style="margin-bottom: 3px;">Activity End Date</p>\n\t\t\t\t\t\t<input test-id="activityEndDate" type="date" placeholder="Activity End Date"\n\t\t\t\t\t\t\t   [disabled]="!(filter.expiryType  === \'all\' || filter.expiryType === \'expired\')"\n\t\t\t\t\t\t\t   [ngModel]="filter.endDate" (ngModelChange)="onEndDateChange($event)">\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="col-md-2 col-6">\n\t\t\t\t\t\t<p class="small-caps text-grey" style="margin-bottom: 3px;">Type</p>\n\t\t\t\t\t\t<select test-id="selectedPurchaseType" [ngModel]="filter.purchaseType" (ngModelChange)="onPurchaseTypeChange($event)"\n\t\t\t\t\t\t\t\t[disabled]="filter.expiryType === \'No License\'">\n\t\t\t\t\t\t\t<option value="" disabled>Filter By Type</option>\n\t\t\t\t\t\t\t<option *ngFor="let item of purchaseTypeMap | keyvalue" [value]="item.key">{{item.value}} </option>\n\t\t\t\t\t\t</select>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="col-md-2 col-6">\n\t\t\t\t\t\t<p class="small-caps text-grey" style="margin-bottom: 3px;">Expiration</p>\n\t\t\t\t\t\t<select test-id="selectedExpiryType" [ngModel]="filter.expiryType" (ngModelChange)="onExpiryTypeChange($event)"\n\t\t\t\t\t\t\t\t[disabled]="filter.purchaseType === \'none\'">\n\t\t\t\t\t\t\t<option value="" disabled>4Sight Expiration</option>\n\t\t\t\t\t\t\t<option *ngFor="let item of expiryTypeMap | keyvalue" [value]="item.key">{{item.value}} </option>\n\t\t\t\t\t\t</select>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class="row text-right">\n\t\t\t\t\t<small>\n\t\t\t\t\t\t<a href="javascript:;" test-id="resetFiltersClick" data-hide="#filter" (click)="resetFilters()">Reset Filter</a>\n\t\t\t\t\t</small>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t\t<c4-loading *ngIf="!consumersLoaded"></c4-loading>\n\t\t\t<div class="table" *ngIf="consumersLoaded">\n\t\t\t\t<div class="head d-none d-md-block">\n\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t<div class="col-sm-5 offset-md-3 light-grey half-padding-left">4Sight</div>\n\t\t\t\t\t\t<div class="col-sm-2 half-padding-left">Composer HE</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class="body">\n\t\t\t\t\t<div class="row" *ngFor="let consumer of filteredCustomers | paging: pagingInfo; index as i">\n\t\t\t\t\t\t<div class="col-md-3">\n\t\t\t\t\t\t\t<p class="no-margin">{{consumer.consumerName | camelize}}</p>\n\t\t\t\t\t\t\t<div [hidden]="!consumer.displayDetails">\n\t\t\t\t\t\t\t\t<small>\n\t\t\t\t\t\t\t\t\t<ul class="no-style">\n\t\t\t\t\t\t\t\t\t\t<li *ngIf="consumer.consumerId">{{consumer.consumerId}}</li>\n\t\t\t\t\t\t\t\t\t\t<li *ngIf="consumer.consumerPhone">\n\t\t\t\t\t\t\t\t\t\t\t<a\n\t\t\t\t\t\t\t\t\t\t\t   [href]="\'tel:\' + consumer.consumerPhone">{{consumer.consumerPhone | phone }}</a>\n\t\t\t\t\t\t\t\t\t\t</li>\n\t\t\t\t\t\t\t\t\t\t<li *ngIf="consumer.consumerEmail">\n\t\t\t\t\t\t\t\t\t\t\t<a\n\t\t\t\t\t\t\t\t\t\t\t   [href]="\'mailto:\' + consumer.consumerEmail">{{consumer.consumerEmail}}</a>\n\t\t\t\t\t\t\t\t\t\t</li>\n\t\t\t\t\t\t\t\t\t</ul>\n\t\t\t\t\t\t\t\t\t<ul class="no-style" *ngIf="consumer.distributorAccountName">\n\t\t\t\t\t\t\t\t\t\t<p class="no-margin bold">Dealer Info</p>\n\t\t\t\t\t\t\t\t\t\t<li>{{consumer.dealerId}}</li>\n\t\t\t\t\t\t\t\t\t\t<li>\n\t\t\t\t\t\t\t\t\t\t\t<a\n\t\t\t\t\t\t\t\t\t\t\t   [href]="\'tel:\' + consumer.dealerPhone">{{consumer.dealerPhone | phone }}</a>\n\t\t\t\t\t\t\t\t\t\t</li>\n\t\t\t\t\t\t\t\t\t\t<li>\n\t\t\t\t\t\t\t\t\t\t\t<a [href]="\'mailto:\' + consumer.dealerEmail">{{consumer.dealerEmail}}</a>\n\t\t\t\t\t\t\t\t\t\t</li>\n\t\t\t\t\t\t\t\t\t</ul>\n\t\t\t\t\t\t\t\t</small>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class="col-md-5 light-grey half-padding-left" style="min-height: 75px;">\n\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t<div class="col-3">\n\t\t\t\t\t\t\t\t\t<i [ngClass]="[\'fa c4status\', consumer.iconClass || \'\']"></i>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="col-9">\n\t\t\t\t\t\t\t\t\t<small>\n\t\t\t\t\t\t\t\t\t\t<ul class="no-style">\n\t\t\t\t\t\t\t\t\t\t\t<li class="bold d-block d-md-none">4Sight</li>\n\t\t\t\t\t\t\t\t\t\t\t<li *ngIf="consumer.renewingLicense">Auto-Renew</li>\n\t\t\t\t\t\t\t\t\t\t\t<li *ngIf="consumer.fourSightActivationDate"> {{consumer.consumerPurchase ? "Customer" : "Dealer"}} Purchased {{ consumer.fourSightActivationDate |\n\t\t\t\t\t\t\t\t\t\t\t\tdate: \'MMM dd, yyyy\' }} </li>\n\t\t\t\t\t\t\t\t\t\t\t<li *ngIf="consumer.fourSightActivationDate">{{consumer.fourSightExpirationDate | licenseStatus:\n\t\t\t\t\t\t\t\t\t\t\t\tconsumer.renewingLicense}}</li>\n\t\t\t\t\t\t\t\t\t\t\t<li *ngIf="!consumer.fourSightActivationDate">No 4Sight License</li>\n\t\t\t\t\t\t\t\t\t\t</ul>\n\t\t\t\t\t\t\t\t\t</small>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class="row" [hidden]="!consumer.displayDetails" style="min-height: 100px;">\n\t\t\t\t\t\t\t\t<div class="col-9 offset-3">\n\t\t\t\t\t\t\t\t\t<small>\n\t\t\t\t\t\t\t\t\t\t<ul class="no-style">\n\t\t\t\t\t\t\t\t\t\t\t<li class="bold">History</li>\n\t\t\t\t\t\t\t\t\t\t\t<li *ngFor="let license of consumer?.licenseHistory"> {{consumer.consumerPurchase ? "Customer" : "Dealer"}}\n\t\t\t\t\t\t\t\t\t\t\t\tPurchased {{consumer.fourSightActivationDate |\n\t\t\t\t\t\t\t\t\t\t\t\tdate: \'MMM dd, yyyy\' }} <span *ngIf="license.renewingLicense"> (renewing)</span>\n\t\t\t\t\t\t\t\t\t\t\t</li>\n\t\t\t\t\t\t\t\t\t\t\t<li *ngIf="!consumer.licenseHistory?.length">No Activity</li>\n\t\t\t\t\t\t\t\t\t\t</ul>\n\t\t\t\t\t\t\t\t\t</small>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class="col-md-2 half-padding-left d-none d-md-block">\n\t\t\t\t\t\t\t<i class="fa c4status c4status-success" *ngIf="consumer.composerActivationDate"></i>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class="col-md-5 half-padding-left d-block d-md-none">\n\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t<div class="col-3">\n\t\t\t\t\t\t\t\t\t<i class="fa c4status c4status-success" *ngIf="consumer.composerActivationDate"></i>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="col-9">\n\t\t\t\t\t\t\t\t\t<small>\n\t\t\t\t\t\t\t\t\t\t<ul class="no-style">\n\t\t\t\t\t\t\t\t\t\t\t<li class="bold d-block d-md-none">Composer HE</li>\n\t\t\t\t\t\t\t\t\t\t</ul>\n\t\t\t\t\t\t\t\t\t</small>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class="col-md-2 offset-md-0 col-sm-4 offset-sm-8 col-6 offset-6">\n\t\t\t\t\t\t\t<button attr.test-id="toggleDetailsClick-{{i}}" class="block no-margin light-grey" (click)="toggleDetails(consumer)"\n\t\t\t\t\t\t\t\t\ttitle="Details and Activity">\n\t\t\t\t\t\t\t\t<i class="fal fa-chevron-down"></i>Details</button>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<c4-pager [(info)]="pagingInfo"></c4-pager>\n\t\t\t</div>\n\t\t\t<div class="alert alert-warning no-border-radius-top"\n\t\t\t\t *ngIf="consumersLoaded && hasFilter && !filteredCustomers?.length">\n\t\t\t\t<p> There are no records with the above criteria associated with this account. If you feel the message is in error, please contact your\n\t\t\t\t\tcustomers directly to have them reassign the dealer of record within the My Account section of the Customer Portal, customer.control4.com.\n\t\t\t\t</p>\n\t\t\t</div>\n\t\t\t<div class="alert alert-warning no-border-radius-top" *ngIf="consumersLoaded && !allCustomers?.length">\n\t\t\t\t<p>There are no customers associated to this dealer account</p>\n\t\t\t</div>\n\t\t\t<div class="table no-margin" *ngIf="consumersLoaded && filteredCustomers?.length && (canPurchase$ | async)">\n\t\t\t\t<div class="head">\n\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t<div class="col-md-3">Purchase</div>\n\t\t\t\t\t\t<div class="col-md-5 col-6 light-grey half-padding-left">4Sight</div>\n\t\t\t\t\t\t<div class="col-md-4 col-6 half-padding-left">Composer HE</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class="body">\n\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t<div class="col-md-5 offset-md-3 col-6">\n\t\t\t\t\t\t\t<input test-id="fourSightQty" type="number" name="name" class="no-margin" placeholder="4Sight QTY" min="1"\n\t\t\t\t\t\t\t\t   [(ngModel)]="fourSightQuantity">\n\t\t\t\t\t\t\t<c4-product-add-to-cart test-id="c4-product-add-to-cart-fourSightQty" classes="block" skus="C4-4Sight-E"\n\t\t\t\t\t\t\t\t\t\t\t\t\t[quantity]="fourSightQuantity"\n\t\t\t\t\t\t\t\t\t\t\t\t\t[onComplete]="on4SightComplete" [disabled]="addingToCart || fourSightQuantity <= 0"\n\t\t\t\t\t\t\t\t\t\t\t\t\taction-source="SubscriptionsDashboard"></c4-product-add-to-cart>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class="col-md-4 col-6">\n\t\t\t\t\t\t\t<input test-id="composerHeQTY" type="number" name="name" class="no-margin" placeholder="Composer HE QTY" min="1"\n\t\t\t\t\t\t\t\t   [(ngModel)]="composerHeQuantity">\n\t\t\t\t\t\t\t<c4-product-add-to-cart test-id="c4-product-add-to-cart-composerHeQty" classes="block grey" skus="C4-CHE-XXX-E"\n\t\t\t\t\t\t\t\t\t\t\t\t\t[quantity]="composerHeQuantity" [onComplete]="onComposerComplete"\n\t\t\t\t\t\t\t\t\t\t\t\t\t[disabled]="addingToCart || composerHeQuantity <= 0"\n\t\t\t\t\t\t\t\t\t\t\t\t\taction-source="SubscriptionsDashboard">\n\t\t\t\t\t\t\t</c4-product-add-to-cart>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t</div> --\x3e\n\t</div>\n</div>'},"z+rX":function(t,e){t.exports=""}}]);