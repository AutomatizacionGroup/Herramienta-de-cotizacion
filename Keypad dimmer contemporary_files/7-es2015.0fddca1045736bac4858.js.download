(window.webpackJsonp=window.webpackJsonp||[]).push([[7],{"+NrM":function(t,e){t.exports="#primary-contact-select option {\n  text-transform: none;\n}"},"1elh":function(t,e){t.exports='<div id="leads-page" class="padding">\n\t<div class="row">\n\t\t<div class="col-sm-5">\n\t\t\t<h1 class="inline">My Leads</h1>\n\t\t\t<c4-feature-toggle hidden="true" toggle="enableLeads20" label="Leads 2.0" (showChange)="showLeads20 = $event"></c4-feature-toggle>\n\t\t</div>\n\t\t<div class="col-sm-7 text-right">\n\t\t\t<button test-id="toggleDisplayContactClick" [ngClass]="displayContact ? \'red\' : \'white\'" (click)="showContact()" c4Track="Click"\n\t\t\t\t\ttrackCategory="Leads"\n\t\t\t\t\ttrackLabel="Contact Us Open">\n\t\t\t\t<i class="fal fa-envelope"></i>Contact Us</button>\n\t\t\t<button test-id="toggleDisplayPreferencesClick" [ngClass]="displayPreferences ? \'red\' : \'white\'" (click)="showPreferences()"\n\t\t\t\t\tc4Track="Click"\n\t\t\t\t\ttrackCategory="Leads" trackLabel="Preferences Open">\n\t\t\t\t<i class="fal fa-cogs"></i>Settings</button>\n\t\t</div>\n\t</div>\n\t<c4-leads-contact-us *ngIf="displayContact" (display)="displayContact = $event"></c4-leads-contact-us>\n\t<c4-leads-preferences *ngIf="displayPreferences" (display)="displayPreferences = $event"></c4-leads-preferences>\n\t<c4-old-leads-page *ngIf="!showLeads20"></c4-old-leads-page>\n\t<c4-new-leads-page *ngIf="showLeads20"></c4-new-leads-page>\n</div>'},"21g2":function(t,e){t.exports=".clickable {\n  cursor: pointer;\n}\n.clickable:hover {\n  color: #c32032;\n}\n.background-clickable {\n  height: 100%;\n  background-color: #000;\n  cursor: pointer;\n  -webkit-transition-duration: 0.8s;\n  transition-duration: 0.8s;\n}\n.background-clickable:hover {\n  background-color: #8a2432;\n  -webkit-transition-duration: 0.2s;\n  transition-duration: 0.2s;\n}\n.background-clickable.active {\n  background-color: #8a2432;\n}\n.background-clickable h3 {\n  margin: 0 0 12px 0;\n}\n.round-icon-outline {\n  display: inline-block;\n  height: 33px;\n  width: 33px;\n  font-size: 18px;\n  line-height: 33px;\n  text-align: center;\n  border: 1.5px solid #8a2432;\n  border-radius: 50%;\n  -webkit-transition-duration: 0.8s;\n  transition-duration: 0.8s;\n}\n.round-icon-outline i {\n  line-height: 33px;\n}\n.background-clickable.active .round-icon-outline {\n  border: 1.5px solid transparent;\n  background-color: #c32032;\n}\nbody form.dark input:not([type=submit]):not([type=checkbox]):not([type=radio]):not([type=range]), body form.dark select, body form.dark textarea, body .form.dark input:not([type=submit]):not([type=checkbox]):not([type=radio]):not([type=range]), body .form.dark select, body .form.dark textarea {\n  background-color: #e8e8e8;\n}\n.well {\n  background-color: #F0EEEE;\n  border: 1px solid #E2E0E0;\n  border-radius: 4px;\n  box-shadow: inset 0 1px 1px rgba(0, 0, 0, 0.05);\n  padding: 20px;\n}\n.mat-select,\n.mat-select-trigger {\n  height: 100%;\n  padding: 0 5px;\n}\n.mat-option,\n.mat-select-value {\n  background-color: #fff;\n}\n.mat-select-value-text {\n  padding-left: 10px;\n}\n.mat-select,\n.mat-form-field {\n  background-color: #fff;\n}\n.mat-select {\n  display: block;\n  padding-top: 15px;\n}\n.mat-select.mat-select-disabled,\n.mat-form-field.mat-form-field-disabled {\n  color: #989a9c !important;\n  background-color: #ddddde !important;\n}"},"3abz":function(t,e){t.exports='<mat-form-field *ngIf="status === \'Closed Won\'">\n\t<input test-id="projectName" matInput placeholder="Project Name" [disabled]="disabled" [(ngModel)]="update.projectName">\n</mat-form-field>\n<c4-date-time *ngIf="status === \'Bid Accepted\'" placeholder="Anticipated install date" [disabled]="disabled" [(value)]="update.installDate"></c4-date-time>\n<mat-form-field>\n\t<input test-id="dealerNotes" matInput placeholder="Dealer notes" maxlength="250" [disabled]="disabled" [(ngModel)]="update.notes">\n\t<small class="block text-right">{{update.notes ? update.notes.length : 0}} / 250 characters</small>\n</mat-form-field>\n<div>\n\t<button test-id="updateLeadStatusClick" class="grey" (click)="updateStatus()" [disabled]="disabled || !valid()">Confirm</button>\n\t<button test-id="cancelUpdateLeadStatusClick" class="transparent" (click)="cancel()" [disabled]="disabled">Cancel</button>\n</div>'},"87hv":function(t,e){t.exports='<div class="row" style="padding-top: 10px;">\n\t<div class="col-sm-3">\n\t\t<a href="javascript:;" test-id="toggleDisplayDetailsClick" class="text-dark" (click)="displayDetails = !displayDetails">\n\t\t\t{{consumer.consumerName | camelize}} <i class="fal text-grey"\n\t\t\t   [ngClass]="displayDetails ? \'fa-chevron-up\' : \'fa-chevron-down\'"></i>\n\t\t</a>\n\t\t<div [hidden]="!displayDetails">\n\t\t\t<small>\n\t\t\t\t<ul class="no-style">\n\t\t\t\t\t<li>{{consumer.consumerAccountName}}</li>\n\t\t\t\t\t<li>{{consumer.consumerPhone | phone }}</li>\n\t\t\t\t\t<li><a href="mailto:{{consumer.consumerEmail}}">{{consumer.consumerEmail}}</a>\n\t\t\t\t\t</li>\n\t\t\t\t</ul>\n\t\t\t\t<ul class="no-style" *ngIf="consumer.distributorAccountName != null">\n\t\t\t\t\t<p class="no-margin bold">Dealer Info</p>\n\t\t\t\t\t<li>{{consumer.dealerId}}</li>\n\t\t\t\t\t<li>{{consumer.dealerPhone | phone }}</li>\n\t\t\t\t\t<li><a href="mailto:{{consumer.dealerEmail}}">{{consumer.dealerEmail}}</a>\n\t\t\t\t\t</li>\n\t\t\t\t</ul>\n\t\t\t</small>\n\t\t</div>\n\t\t<small class="block" *ngIf="lastOrderDisplay">Last order on {{ lastOrderDisplay }}</small>\n\t</div>\n\t<div class="col-sm-3 col-6">\n\t\t<i class="fas fa-fw" [title]="consumer.controllerTypeGroup"\n\t\t   [ngClass]="iconColor(consumer.typeGroupColor)"></i>{{consumer.controllerType}} <small class="block" [class.text-danger]="oldCheckin">Last checked-in\n\t\t\ton {{  lastCheckInDisplay }}</small>\n\t</div>\n\t<div class="col-sm-3 col-6">\n\t\t<i class="fas fa-fw" [title]="consumer.controllerOsGroup" [ngClass]="iconColor(consumer.osGroupColor)"></i>\n\t\t<span *ngIf="consumer.controllerOs !== \'Unknown\'">OS</span> {{consumer.controllerOs}} <small class="block text-danger"\n\t\t\t   *ngIf="osWarning">{{ osWarning }}</small>\n\t</div>\n\t<div class="col-sm-3" style="padding-top: 0; padding-bottom: 0;">\n\t\t<button test-id="presentUpgradeClick" *ngIf="!consumer.orderId || !(canSwitchCart$ | async)" class="block grey"\n\t\t\t\tstyle="white-space: normal"\n\t\t\t\t[disabled]="!(canPurchase$ | async)" (click)="presentUpgrade()" c4Track="Click"\n\t\t\t\ttrackCategory="Controller Dashboard" [trackLabel]="consumer.action">{{consumer.action}}</button>\n\t\t<button test-id="continueUpgradeClick" *ngIf="consumer.orderId && (canSwitchCart$ | async)" class="block"\n\t\t\t\tstyle="white-space: normal;"\n\t\t\t\t[disabled]="!(canPurchase$ | async)" (click)="presentUpgrade()" c4Track="Click"\n\t\t\t\ttrackCategory="Controller Dashboard" trackLabel="Upgrades">Continue Upgrade</button>\n\t\t<button test-id="viewUpgradeHistoryClick"\n\t\t\t\t*ngIf="displayDetails && consumer.previousOrderIds.length && (canViewOrders$ | async)" type="button"\n\t\t\t\tclass="c4btn block no-margin light-grey" (click)="viewUpgradeHistory()" c4Track="Click"\n\t\t\t\ttrackCategory="Controller Dashboard" trackLabel="View Upgrade Orders">View Orders</button>\n\t</div>\n</div>'},"8MGU":function(t,e){t.exports='<div class="row">\n\t<div class="col-6">\n\t\t<div id="contact" class="widget">\n\t\t\t<h3 class="widget-header-white">Contact Us</h3>\n\t\t\t<div class="padding">\n\t\t\t\t<div *ngIf="!sent">\n\t\t\t\t\t<select test-id="selectedHelpSubject" [(ngModel)]="subject">\n\t\t\t\t\t\t<option value="" disabled>How Can We Help You?</option>\n\t\t\t\t\t\t<option value="lead">I have a question/comment about my leads</option>\n\t\t\t\t\t\t<option value="web">There is a problem with this webpage</option>\n\t\t\t\t\t</select>\n\t\t\t\t\t<div *ngIf="subject">\n\t\t\t\t\t\t<textarea test-id="sendMessage" [(ngModel)]="comments" placeholder="message"></textarea>\n\t\t\t\t\t\t<button test-id="sendMessageClick" type="button" (click)="onSubmit()" [disabled]="!comments?.length" c4Track="Click"\n\t\t\t\t\t\t\t\ttrackCategory="Leads"\n\t\t\t\t\t\t\t\ttrackLabel="Contact Us Send">\n\t\t\t\t\t\t\t<i class="fal fa-check"></i>Send Message</button>\n\t\t\t\t\t\t<a test-id="hideContactUsClick" (click)="hide()" class="c4btn transparent" c4Track="Click" trackCategory="Leads"\n\t\t\t\t\t\t   trackLabel="Contact Us Cancel">Cancel</a>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div *ngIf="sent">\n\t\t\t\t\t<div class="alert alert-success">\n\t\t\t\t\t\t<h4>Thank You</h4>\n\t\t\t\t\t\t<p>Your message has been sent successfully. We will be in contact with you.</p>\n\t\t\t\t\t\t<button test-id="confirmOkayClick" class="grey" (click)="hide()">okay</button>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t</div>\n\t</div>\n\t<div class="col-6">\n\t\t<div id="sales-manager" class="widget">\n\t\t\t<h3 class="widget-header-white">Sales Manager</h3>\n\t\t\t<div class="padding" *ngIf="salesManager">\n\t\t\t\t<p>Contact your Sales Manager if you want help securing new leads or existing customer upgrade opportunities.</p>\n\t\t\t\t<ul class="no-style">\n\t\t\t\t\t<li><b>{{salesManager.firstName}} {{salesManager.lastName}}</b></li>\n\t\t\t\t\t<li><a [href]="\'tel:\' + salesManager.phone">{{salesManager.phone}}</a></li>\n\t\t\t\t\t<li><a [href]="\'mailto:\' + salesManager.email">{{salesManager.email}}</a></li>\n\t\t\t\t</ul>\n\t\t\t</div>\n\t\t</div>\n\t</div>\n</div>'},"9bWd":function(t,e){t.exports=""},"BWb+":function(t,e){t.exports=""},CsKf:function(t,e){t.exports='<div class="widget">\n\t<h3 class="widget-header-white">Settings</h3>\n\t<div class="padding">\n\t\t<c4-loading *ngIf="!prefs"></c4-loading>\n\t\t<div class="animate-show" *ngIf="prefs">\n\t\t\t<h3 class="half-padding-bottom">Primary Contact</h3>\n\t\t\t<div class="row half-padding-bottom">\n\t\t\t\t<div class="col-sm-6">\n\t\t\t\t\t<div *ngIf="!changePrimaryContact">\n\t\t\t\t\t\t<p>Your primary contact is the contact person within your organization that receives all lead notifications from Control4. If you would\n\t\t\t\t\t\t\tlike to update your primary contact, please click the Change Primary Contact link below and select the appropriate contact within\n\t\t\t\t\t\t\tyour organization.</p>\n\t\t\t\t\t\t<ul class="no-style">\n\t\t\t\t\t\t\t<li class="bold">{{prefs.leadContact?.name || \'None Selected\'}}</li>\n\t\t\t\t\t\t\t<li *ngIf="prefs.leadContact?.phone">\n\t\t\t\t\t\t\t\t<a [href]="\'tel:\' + prefs.leadContact.phone">{{prefs.leadContact.phone}}</a>\n\t\t\t\t\t\t\t</li>\n\t\t\t\t\t\t\t<li *ngIf="prefs.leadContact?.email">\n\t\t\t\t\t\t\t\t<a [href]="\'mailto:\' + prefs.leadContact.email">{{prefs.leadContact.email}}</a>\n\t\t\t\t\t\t\t</li>\n\t\t\t\t\t\t\t<li>\n\t\t\t\t\t\t\t\t<small>\n\t\t\t\t\t\t\t\t\t<a test-id="toggleChangePrimaryContactClick" href="javascript:;" class="text-grey"\n\t\t\t\t\t\t\t\t\t   (click)="toggleChangePrimaryContact()">Change Primary Contact</a>\n\t\t\t\t\t\t\t\t</small>\n\t\t\t\t\t\t\t</li>\n\t\t\t\t\t\t</ul>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div *ngIf="changePrimaryContact">\n\t\t\t\t\t\t<p>Use the list below to select the primary contact within your organization that should receive lead notifications.</p>\n\t\t\t\t\t\t<select test-id="selectedPrimaryContact" id="primary-contact-select" [(ngModel)]="prefs.leadContact">\n\t\t\t\t\t\t\t<option disabled value="">- CHOOSE PRIMARY CONTACT -</option>\n\t\t\t\t\t\t\t<option *ngFor="let contact of prefs.availableLeadContacts" [ngValue]="contact">{{contact.name}} ({{contact.email\n\t\t\t\t\t\t\t\t| lowercase}})</option>\n\t\t\t\t\t\t</select>\n\t\t\t\t\t\t<button test-id="updatePrimaryContactClick" class="c4btn grey" [disabled]="prefs?.leadContact === originalLeadContact"\n\t\t\t\t\t\t\t\t(click)="save()">Update Primary Contact </button>\n\t\t\t\t\t\t<button test-id="cancelChangePrimaryContactClick" class="c4btn transparent" (click)="toggleChangePrimaryContact()">Cancel</button>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t\t<h3 class="half-padding-bottom">Preferences</h3>\n\t\t\t<div class="row half-padding-bottom">\n\t\t\t\t<div class="col-sm-6">\n\t\t\t\t\t<p>How far are you willing to travel?</p>\n\t\t\t\t</div>\n\t\t\t\t<div class="col-sm-6">\n\t\t\t\t\t<select test-id="preferredTravel" name="preferredTravel" [(ngModel)]="prefs.preferredTravel">\n\t\t\t\t\t\t<option value="20 Miles">Up to 20 Miles</option>\n\t\t\t\t\t\t<option value="20-50 Miles">Up to 50 Miles</option>\n\t\t\t\t\t\t<option value="50-100 Miles">Up to 100 Miles</option>\n\t\t\t\t\t\t<option value="100+ Miles">Over 100 Miles</option>\n\t\t\t\t\t</select>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t\t<div class="row half-padding-bottom">\n\t\t\t\t<div class="col-sm-6">\n\t\t\t\t\t<p>Which Control4 solutions do you offer and install?</p>\n\t\t\t\t</div>\n\t\t\t\t<div class="col-sm-6">\n\t\t\t\t\t<label *ngFor="let option of solutionOptions | keyvalue">\n\t\t\t\t\t\t<input test-id="control4SolutionCheckbox" type="checkbox" [checked]="prefs.control4Solution | keyValueSelected: option.value"\n\t\t\t\t\t\t\t   (change)="toggleSolutionOption(option.value)">{{option.value}} </label>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t\t<div class="row half-padding-bottom">\n\t\t\t\t<div class="col-sm-6">\n\t\t\t\t\t<p>How long before you could begin a new project?</p>\n\t\t\t\t</div>\n\t\t\t\t<div class="col-sm-6">\n\t\t\t\t\t<select test-id="selectedTimeBeforeInstallation" name="timeBeforeInstallation" [(ngModel)]="prefs.timeToInstall">\n\t\t\t\t\t\t<option value="Less than 1 week">Less than 1 week</option>\n\t\t\t\t\t\t<option value="1-4 Weeks">1-4 Weeks</option>\n\t\t\t\t\t\t<option value="1 month+">More than 1 month</option>\n\t\t\t\t\t</select>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t\t<div class="row half-padding-bottom">\n\t\t\t\t<div class="col-sm-6">\n\t\t\t\t\t<p>What is the minimum project budget you will accept from a prospect?</p>\n\t\t\t\t</div>\n\t\t\t\t<div class="col-sm-6">\n\t\t\t\t\t<select test-id="selectedBudgetPreference" name="budgetPreference" [(ngModel)]="prefs.budgetPreference">\n\t\t\t\t\t\t<option value="Under $5,000">Less than $5,000</option>\n\t\t\t\t\t\t<option value="$5,000-$25,000">Between $5,000 and $25,000</option>\n\t\t\t\t\t\t<option value="$25,000-$50,000">Between $25,000 and $50,000</option>\n\t\t\t\t\t\t<option value="$50,000+">Over $50,000</option>\n\t\t\t\t\t</select>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t\t<div class="row half-padding-bottom">\n\t\t\t\t<div class="col-sm-6">\n\t\t\t\t\t<p>What are the project sizes you install Control4 home automation in? (select all that apply)</p>\n\t\t\t\t</div>\n\t\t\t\t<div class="col-sm-6">\n\t\t\t\t\t<label *ngFor="let option of projectSizeOptions | keyvalue; index as i">\n\t\t\t\t\t\t<input attr.test-id="projectSizeOptionCheckbox-{{i}}" type="checkbox" [checked]="prefs.projectSize | keyValueSelected: option.value"\n\t\t\t\t\t\t\t   (change)="toggleProjectSizeOption(option.value)">{{option.value}} </label>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t\t<div class="row half-padding-bottom">\n\t\t\t\t<div class="col-sm-6">\n\t\t\t\t\t<p>Which type of residential structures do you install Control4 home automation in?</p>\n\t\t\t\t</div>\n\t\t\t\t<div class="col-sm-6">\n\t\t\t\t\t<label *ngFor="let option of installTypeOptions | keyvalue; index as i">\n\t\t\t\t\t\t<input attr.test-id="installTypeOptionCheckbox-{{i}}" type="checkbox" [checked]="prefs.installType | keyValueSelected: option.value"\n\t\t\t\t\t\t\t   (change)="toggleInstallTypeOption(option.value)">{{option.value}} </label>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t</div>\n\t\t<ul class="inline">\n\t\t\t<li>\n\t\t\t\t<button test-id="saveLeadPreferencesClick" class="grey no-margin" (click)="save()" [disabled]="!prefs" c4Track="Click"\n\t\t\t\t\t\ttrackCategory="Leads"\n\t\t\t\t\t\ttrackLabel="Preferences Save">Save</button>\n\t\t\t</li>\n\t\t\t<li>\n\t\t\t\t<button test-id="cancelUpdateLeadPreferencesClick" class="transparent" (click)="close()" c4Track="Click" trackCategory="Leads"\n\t\t\t\t\t\ttrackLabel="Preferences Cancel">Cancel</button>\n\t\t\t</li>\n\t\t</ul>\n\t</div>\n</div>'},DQ1U:function(t,e){t.exports='<div class="col-lg-10 col-xl-8">\n\t<small>Navigate a leads status by clicking on the corresponding label.</small>\n\t<mat-horizontal-stepper *ngIf="!(isMobile$ | async)" [selectedIndex]="stepIndex"\n\t\t\t\t\t\t\t(selectionChange)="stepIndex = $event.selectedIndex">\n\t\t<ng-template matStepperIcon="edit">\n\t\t\t<i class="fal fa-pen-alt"></i>\n\t\t</ng-template>\n\t\t<mat-step *ngFor="let status of leadStatusMap; let i = index" [label]="status.value"\n\t\t\t\t  [completed]="i < stepIndex">\n\t\t\t<c4-lead-update-status-form attr.test-id="c4-lead-update-status-horizontal-{{i}}" *ngIf="stepIndex === i" [reset]="reset"\n\t\t\t\t\t\t\t\t\t\t[opportunityId]="opportunityId"\n\t\t\t\t\t\t\t\t\t\t[status]="status.key" (closed)="cancel()">\n\t\t\t</c4-lead-update-status-form>\n\t\t</mat-step>\n\t</mat-horizontal-stepper>\n\t<mat-vertical-stepper *ngIf="isMobile$ | async" [selectedIndex]="stepIndex"\n\t\t\t\t\t\t  (selectionChange)="stepIndex = $event.selectedIndex">\n\t\t<ng-template matStepperIcon="edit">\n\t\t\t<i class="fal fa-pen-alt"></i>\n\t\t</ng-template>\n\t\t<mat-step *ngFor="let status of leadStatusMap; let i = index" [label]="status.value"\n\t\t\t\t  [completed]="i < stepIndex">\n\t\t\t<c4-lead-update-status-form attr.test-id="c4-lead-update-status-vertical-{{i}}" *ngIf="stepIndex === i" [reset]="reset"\n\t\t\t\t\t\t\t\t\t\t[opportunityId]="opportunityId"\n\t\t\t\t\t\t\t\t\t\t[status]="status.key" (closed)="cancel()">\n\t\t\t</c4-lead-update-status-form>\n\t\t</mat-step>\n\t</mat-vertical-stepper>\n</div>'},EL6B:function(t,e){t.exports='<div class="alert alert-warning form dark half-margin-top half-margin-bottom">\n\t<h4>Reason</h4>\n\t<p>Thank you for updating this {{(lead.leadType | leadTypeMap: \'lead\') | lowercase}}, we will remove it from your pipeline. Please let us know why this\n\t\t{{(lead.leadType | leadTypeMap: \'lead\') | lowercase}} didn\u2019t purchase.</p>\n\t<select test-id="selectedRejectionReason" required [(ngModel)]="update.rejectionReason" [disabled]="disabled">\n\t\t<option [ngValue]="undefined" disabled>Select One </option>\n\t\t<option>Customer no longer wants Control4</option>\n\t\t<option>Control4 was too expensive</option>\n\t\t<option>Customer is already working with another dealer</option>\n\t\t<option>Customer put the project on hold</option>\n\t\t<option>Customer decided to install a competitive solution</option>\n\t\t<option>Customer wanted a DIY solution</option>\n\t\t<option>Other</option>\n\t</select>\n\t<div *ngIf="update.rejectionReason === \'Other\'">\n\t\t<textarea test-id="rejectionExplanation" placeholder="Please explain" [(ngModel)]="update.rejectionExplanation" maxlength="245"\n\t\t\t\t  [disabled]="disabled"></textarea>\n\t\t<small class="block text-right">{{update?.rejectionExplanation ? update?.rejectionExplanation.length : 0}} / 245 characters</small>\n\t</div>\n\t<ul class="inline">\n\t\t<li><button test-id="confirmLeadCancelationClick" class="grey no-margin" (click)="confirm()" trackCategory="Leads" c4Track="Click"\n\t\t\t\t\t[disabled]="disabled || !valid()"\n\t\t\t\t\ttrackLabel="{{lead.leadType | leadTypeMap : \'Lead\'}} Status {{update.status}} Confirm">Confirm</button>\n\t\t</li>\n\t\t<li><button test-id="cancelLeadCancelationClick" class="transparent no-margin" (click)="cancel()" trackCategory="Leads" c4Track="Click"\n\t\t\t\t\ttrackLabel="{{lead.leadType | leadTypeMap: \'Lead\'}} Cancelation Cancel" [disabled]="disabled">Cancel</button>\n\t\t</li>\n\t</ul>\n</div>'},EQb1:function(t,e){t.exports=""},FOMe:function(t,e){t.exports=""},Fxfy:function(t,e){t.exports='<div class="col-12 col-md-2">\n\t<span>\n\t\t<c4-tooltip class="leads" *ngIf="lead | leadTypeTooltip as tooltip">{{tooltip}}</c4-tooltip>\n\t\t<a href="javascript:;" class="text-grey">\n\t\t\t<i class="fal {{ lead | leadIcon }} inline"></i>{{ isNew ? \'New!\' : \'Open\'}}</a>\n\t</span>\n\t<span class="d-block d-md-none">{{lead.name}}</span>\n\t<small class="block no-wrap {{ lead | leadUpdateDateStyle }}" [title]="lead | leadUpdateDateHelp">{{isNew ? \'Granted\' : \'Updated\'}}:\n\t\t{{ lead.lastModifiedAt | date: \'MMM d, yyyy\' }}</small>\n</div>\n<div class="col-md-2 d-none d-md-block truncate" title="{{lead.name}}">{{lead.name}}</div>\n<div class="col-12 col-md-2 truncate">\n\t<span class="block"><a href="tel:{{lead.phone}}" class="text-dark">{{lead.phone }}</a></span>\n\t<small><a href="mailto:{{lead.email}}" class="text-grey" title="{{lead.email}}">{{lead.email}}</a></small>\n</div>\n<ng-container *ngIf="isNew">\n\t<div class="col-12 col-md-3 d-none d-md-block">\n\t\t<progress max="1" style="margin-top: 3px;" [value]="percentComplete"></progress>\n\t\t<small class="text-right block">{{ isNew ? \'New!\' : \'Open\'}}</small>\n\t</div>\n\t<div class="col-6 d-block d-md-none">\n\t\t<button test-id="acceptLeadClick" class="c4btn block light-grey no-margin" (click)="acceptLead()" [disabled]="disabled">Accept</button>\n\t</div>\n\t<div class="col-6 d-block d-md-none">\n\t\t<button test-id="rejectLeadClick" class="c4btn block transparent no-margin text-grey" (click)="changeView(\'rejectConfirm\')"\n\t\t\t\t[disabled]="disabled">Reject</button>\n\t</div>\n\t<div class="col-md-3 d-none d-md-block text-right">\n\t\t<button test-id="acceptLeadClickRight" class="c4btn light-grey no-margin" (click)="acceptLead()" [disabled]="disabled">Accept</button>\n\t\t<button test-id="rejectLeadClickRight" class="c4btn transparent no-margin text-grey" (click)="changeView(\'rejectConfirm\')"\n\t\t\t\t[disabled]="disabled">Reject</button>\n\t</div>\n\t<div class="col-12 p-0">\n\t\t<mat-expansion-panel [expanded]="view === \'rejectConfirm\'">\n\t\t\t<c4-lead-rejection-form [lead]="lead" [reset]="view !== \'rejectConfirm\'" (closed)="changeView(\'\')"></c4-lead-rejection-form>\n\t\t</mat-expansion-panel>\n\t</div>\n</ng-container>\n<ng-container *ngIf="!isNew">\n\t<div class="col-12 col-md-3">\n\t\t<progress max="1" style="margin-top: 3px;" [value]="percentComplete" [class.success]="status === \'Installed\'"></progress>\n\t\t<small class="text-right block">\n\t\t\t<i class="fal fa-check text-success" *ngIf="status === \'Installed\'"></i>\n\t\t\t<i class="fal fa-exclamation-circle text-warning" *ngIf="!status"></i> {{status || \'Please Edit to Select Status\' }} </small>\n\t\t<small class=\'text-right block\' *ngIf="status === \'Installed\'">Lead will be removed on page refresh</small>\n\t</div>\n\t<div class="col-6 d-block d-md-none">\n\t\t<button test-id="editUpdateStatusClick" class="c4btn block light-grey no-margin" (click)="changeView(\'updateStatus\')">Edit</button>\n\t</div>\n\t<div class="col-6 d-block d-md-none">\n\t\t<button test-id="deleteUpdateStatusClick" class="c4btn block transparent no-margin text-grey" (click)="changeView(\'cancelConfirm\')">Delete</button>\n\t</div>\n\t<div class="col-md-3 d-none d-md-block text-right">\n\t\t<button test-id="editUpdateStatusClickRight" class="c4btn light-grey no-margin" (click)="changeView(\'updateStatus\')">Edit</button>\n\t\t<button test-id="deleteUpdateStatusClickRight" class="c4btn transparent no-margin text-grey delete"\n\t\t\t\t(click)="changeView(\'cancelConfirm\')"\n\t\t\t\ttitle="This action will remove the lead from the pipeline"\n\t\t\t\t[disabled]="status === \'Installed\'">Delete</button>\n\t</div>\n\t<div class="col-12 p-0">\n\t\t<mat-expansion-panel [expanded]="view === \'updateStatus\'">\n\t\t\t<ng-template matExpansionPanelContent>\n\t\t\t\t<c4-lead-status-stepper [opportunityId]="lead.opportunityId" [reset]="view !== \'updateStatus\'" [stepIndex]="stepIndex"\n\t\t\t\t\t\t\t\t\t\t(closed)="changeView(\'\')">\n\t\t\t\t</c4-lead-status-stepper>\n\t\t\t</ng-template>\n\t\t</mat-expansion-panel>\n\t\t<mat-expansion-panel [expanded]="view === \'cancelConfirm\'">\n\t\t\t<ng-container>\n\t\t\t\t<c4-lead-cancellation-form [lead]="lead" [reset]="view !== \'cancelConfirm\'" (confirmed)="changeView(\'\')" (closed)="changeView(\'\')">\n\t\t\t\t</c4-lead-cancellation-form>\n\t\t\t</ng-container>\n\t\t</mat-expansion-panel>\n\t</div>\n</ng-container>\n<div class="col-12">\n\t<c4-lead-customer-details [lead]="lead"></c4-lead-customer-details>\n</div>'},GqZ8:function(t,e){t.exports='<div class="row">\n\t<div class="col-sm-4 half-padding-top">\n\t\t<h3 class="no-margin"> New! <i class="fal fa-arrow-down text-grey"></i>\n\t\t</h3>\n\t\t<p class="no-margin">\n\t\t\t<span class="bold">{{lead.name}}</span>&nbsp;<small>New {{lead.leadType | leadTypeMap : "Lead"}}</small>\n\t\t</p>\n\t\t<ul class="no-style">\n\t\t\t<li>{{lead.streetAddress}}</li>\n\t\t\t<li>{{lead.city}}<span *ngIf="lead.city && lead.state">,</span> {{lead.state}} {{lead.postalCode}}</li>\n\t\t\t<li>{{lead.country}}</li>\n\t\t\t<li><a [href]="\'tel:\' + lead.phone">{{lead.phone}}</a></li>\n\t\t\t<li><a [href]="\'mailto:\' + lead.email">{{lead.email}}</a></li>\n\t\t\t<li *ngIf="lead.consumerAccount">{{lead.consumerAccount}}</li>\n\t\t</ul>\n\t</div>\n\t<div class="col-sm-8 half-padding-top">\n\t\t<div class="row no-margin">\n\t\t\t<div class="col-sm-6">\n\t\t\t\t<button test-id="acceptLeadClick" class="block no-margin " (click)="acceptLead(lead)" [disabled]="working" c4Track="Click"\n\t\t\t\t\t\ttrackCategory="Leads"\n\t\t\t\t\t\t[trackLabel]="\'New \' + (lead.leadType | leadTypeMap : \'Lead\') + \' Accept\'"><i class="fal fa-check"></i> Yes, I want this\n\t\t\t\t\t{{lead.leadType | leadTypeMap : "Lead"}}</button>\n\t\t\t</div>\n\t\t\t<div class="col-sm-6">\n\t\t\t\t<button test-id="toggleRejectingLeadTypeClick" class="block light-grey no-margin" (click)="rejecting = true" [disabled]="working"\n\t\t\t\t\t\tc4Track="Click"\n\t\t\t\t\t\ttrackCategory="Leads" [trackLabel]="\'New \' + (lead.leadType | leadTypeMap : \'Lead\') + \' Decline\'"><i class="fal fa-times"></i> I do not\n\t\t\t\t\twant this {{lead.leadType | leadTypeMap : "Lead"}}</button>\n\t\t\t</div>\n\t\t</div>\n\t\t<h1></h1>\n\t\t<c4-lead-rejection-form *ngIf="rejecting" [lead]="lead"></c4-lead-rejection-form>\n\t\t<div class="half-margin-top half-margin-bottom">\n\t\t\t<div class="half-margin-bottom" *ngIf="(lead.leadType === \'Microsite\' || lead.leadType === \'Showroom Event\') && lead.formattedDealerAddress">\n\t\t\t\t<small class="block half-margin-top"><strong>Dealership Location</strong>\n\t\t\t\t\t<ul class="no-style">\n\t\t\t\t\t\t<li>{{lead.dealerAddress}}</li>\n\t\t\t\t\t\t<li>{{lead.dealerCity}}<span ng-if="lead.dealerCity && lead.dealerState">,</span> {{lead.dealerState}} {{lead.dealerZip}}</li>\n\t\t\t\t\t\t<li *ngIf="lead.partySizeCount !== \'0\'">{{lead.partySizeCount}} Attendees</li>\n\t\t\t\t\t</ul>\n\t\t\t\t</small>\n\t\t\t</div>\n\t\t\t<p class="no-margin bold"><small>Lead Granted &mdash; {{lead.lastModifiedAt | date:\'MMM dd, yyyy\'}}</small></p>\n\t\t\t<p><small>{{lead.notes}}</small></p>\n\t\t\t<div *ngIf="lead.details">\n\t\t\t\t<p class="no-margin"><b>Details</b></p>\n\t\t\t\t<div class="row" *ngFor="let detail of lead.details | keyvalue">\n\t\t\t\t\t<div class="col-sm-4 bold"><small>{{detail.key}}</small></div>\n\t\t\t\t\t<div class="col-sm-8"><small>{{detail | leadDetailDisplay}}</small></div>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t</div>\n\t</div>\n</div>'},GwnK:function(t,e){t.exports='<div class="widget">\n\t<h3 class="widget-header-white">New Leads</h3>\n\t<div class="padding">\n\t\t<ng-container *ngIf="newLeads$ | async as newLeads">\n\t\t\t<div *ngIf="!newLeads.length">\n\t\t\t\t<h4>No New Leads</h4>\n\t\t\t\t<p>Contact your Control4 Sales Manager if you want help securing new leads or existing customer upgrade opportunities.</p>\n\t\t\t\t<ul class="no-style" *ngIf="salesManager">\n\t\t\t\t\t<li><b>{{salesManager.firstName}} {{salesManager.lastName}}</b></li>\n\t\t\t\t\t<li><a [href]="\'tel:\' + salesManager.phone">{{salesManager.phone}}</a></li>\n\t\t\t\t\t<li><a [href]="\'mailto:\' + salesManager.email">{{salesManager.email}}</a></li>\n\t\t\t\t</ul>\n\t\t\t</div>\n\t\t\t<div *ngIf="newLeads.length">\n\t\t\t\t<h4>Leads and Upgrades are Potential Customers</h4>\n\t\t\t\t<p><small>Below are the leads we have worked to pass along to you. Follow-up on your new leads immediately by either accepting or rejecting the\n\t\t\t\t\t\tlead. Please act quickly to contact your lead(s), as we pass these opportunities on to multiple dealers to ensure follow-up. You can\n\t\t\t\t\t\tmanually track the progress of each lead, and if the lead opportunity needs to be cancelled at any point throughout your sales process,\n\t\t\t\t\t\tsimply select \u201cCancel Lead" in the status dropdown and select a reason so we can further optimize our process to pass you better leads\n\t\t\t\t\t\tin the future.</small></p>\n\t\t\t\t<div class="border-bottom" *ngFor="let lead of newLeads; index as i">\n\t\t\t\t\t<c4-new-lead attr.test-id="c4-new-lead-{{i}}" [lead]="lead"></c4-new-lead>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t</ng-container>\n\t</div>\n</div>'},Hlbh:function(t,e){t.exports=""},Iv8b:function(t,e){t.exports='<div class="col-12 p-0">\n\t<div class="alert alert-warning form dark half-margin-top half-margin-bottom">\n\t\t<h4>Reason</h4>\n\t\t<p>Please tell us more about why this {{lead.leadType | leadTypeMap : "Lead" | lowercase}} wasn\u2019t a fit for you so that we can pass more relevant\n\t\t\t{{lead.leadType | leadTypeMap : "Lead" | lowercase}}s in the future.</p>\n\t\t<select test-id="selectedRejectionReason" required [(ngModel)]="reject.rejectionReason" [disabled]="disabled">\n\t\t\t<option [ngValue]="undefined" disabled> Select One</option>\n\t\t\t<option>I don\u2019t have the time right now</option>\n\t\t\t<option>Customer didn\u2019t have a big enough budget/project</option>\n\t\t\t<option>Project is too big</option>\n\t\t\t<option>Customer is already doing business with other dealer.</option>\n\t\t\t<option>Customer project location is too far away</option>\n\t\t\t<option>Other</option>\n\t\t</select>\n\t\t<div *ngIf="reject.rejectionReason === \'Other\'">\n\t\t\t<textarea test-id="rejectionExplanation" placeholder="Please explain" [(ngModel)]="reject.rejectionExplanation" maxlength="245"\n\t\t\t\t\t  [disabled]="disabled"></textarea>\n\t\t\t<small class="block text-right">{{reject?.rejectionExplanation ? reject?.rejectionExplanation.length : 0}} / 245 characters</small>\n\t\t</div>\n\t\t<button test-id="rejectLeadClick" class="grey no-margin" (click)="rejectLead(lead)" [disabled]="disabled || !valid()"\n\t\t\t\tc4Track="Click" trackCategory="Leads" trackLabel="New {{lead.leadType | leadTypeMap : \'Lead\'}}  Reject Confirm">Confirm</button>\n\t\t<button test-id="cancelLeadRejectionFormClick" class="transparent no-margin" (click)="cancel()" [disabled]="disabled"\n\t\t\t\tc4Track="Click" trackCategory="Leads" trackLabel="New \'{{lead.leadType | leadTypeMap : \'Lead\'}} Reject Cancel">Cancel</button>\n\t</div>\n</div>'},MflK:function(t,e){t.exports=".border-left-success {\n  border-left: 3px solid #c5b92f50;\n  -webkit-transition: border-left ease-in-out 0.3s;\n  transition: border-left ease-in-out 0.3s;\n}\n.border-left-success:hover {\n  border-left: 3px solid #c5b92f;\n}\n.info-help {\n  cursor: help;\n}\n.new {\n  -o-box-shadow: inset 3px 0 0 0 #c5b92f;\n  box-shadow: inset 3px 0 0 0 #c5b92f;\n}\n.new-47 {\n  -o-box-shadow: inset 3px 0 0 0 #e7b538;\n  box-shadow: inset 3px 0 0 0 #e7b538;\n}\n.new-8plus {\n  -o-box-shadow: inset 3px 0 0 0 #8A2432;\n  box-shadow: inset 3px 0 0 0 #8A2432;\n}\na.success {\n  -webkit-transition: all 0.1s ease-in-out;\n  transition: all 0.1s ease-in-out;\n}\na.success:hover {\n  color: #424548;\n}\n.update-success, .new-success {\n  background-color: #c5b92f20;\n  border-left: 3px solid #c5b92f;\n  max-width: 160px;\n  padding: 1.5px 6px;\n}\n.update-danger, .new-danger {\n  background-color: #7F202C20;\n  border-left: 3px solid #7F202C;\n  max-width: 160px;\n  padding: 1.5px 6px;\n}\n.update-warning, .new-warning {\n  background-color: #E7B53833;\n  border-left: 3px solid #E7B538;\n  max-width: 160px;\n  padding: 1.5px 6px;\n}\n@media only screen and (max-width: 767px) {\n  .update-success, .new-success {\n    background-color: #c5b92f20;\n    border-left: 3px solid #c5b92f;\n    max-width: 200px;\n    padding: 1.5px 6px;\n  }\n\n  .update-danger, .new-danger {\n    background-color: #7F202C20;\n    border-left: 3px solid #7F202C;\n    max-width: 200px;\n    padding: 1.5px 6px;\n  }\n\n  .update-warning, .new-warning {\n    background-color: #E7B53833;\n    border-left: 3px solid #E7B538;\n    max-width: 200px;\n    padding: 1.5px 6px;\n  }\n}\nbutton.delete:disabled {\n  background-color: white !important;\n  cursor: not-allowed;\n}"},NScF:function(t,e){t.exports='<h4>Leads and Upgrades are Potential Customers</h4>\n<p><small class="d-md-none">Below are the leads we have worked to pass along to you. Please act quickly to contact your lead(s), as we disperse these\n\t\topportunities to multiple dealers to ensure follow-up.</small></p>\n<p><small class="d-none d-md-block">Below are the leads we have worked to pass along to you. Follow-up on your new leads immediately by either accepting or\n\t\trejecting. Please act quickly to contact your lead(s), as we pass these opportunities on to multiple dealers to ensure follow-up. You can manually track\n\t\tthe progress of each lead, and if the lead opportunity needs to be cancelled at any point throughout your sales process, simply select "Delete Lead\u201d in\n\t\tthe edit status field and select a reason so we can further optimize our process to pass you better leads in the future.</small></p>\n<div class="widget padding half-margin-bottom half-padding-bottom align-items-center" *ngIf="filter$.getValue() as filter">\n\t<h4>Search and Filter Leads <ng-container *ngIf="filter !== defaultFilter">| <a href="javascript:;" test-id="resetFiltersClick"\n\t\t\t   (click)="clearFilter()"><small>Reset Filter(s)</small></a>\n\t\t</ng-container>\n\t</h4>\n\t<div class="row half-margin-top" id="search-filter">\n\t\t<div class="col-md-6">\n\t\t\t<mat-form-field>\n\t\t\t\t<input test-id="newLeadsSearch" matInput type="text" placeholder="Search by name, phone, email" name="search" [ngModel]="filter.omnibox"\n\t\t\t\t\t   (ngModelChange)="updateFilter({ omnibox: $event })">\n\t\t\t</mat-form-field>\n\t\t</div>\n\t\t<div class="col-md-6">\n\t\t\t<select test-id="selectedLeadStatus" [ngModel]="filter.status" (ngModelChange)="updateFilter({ status: $event })">\n\t\t\t\t<option [ngValue]="undefined">All Statuses</option>\n\t\t\t\t<option value="New!">New</option>\n\t\t\t\t<option value="No Contact">Not Contacted</option>\n\t\t\t\t<option value="Contacted">Contacted</option>\n\t\t\t\t<option value="Proposal Accepted">Proposal Accepted</option>\n\t\t\t</select>\n\t\t</div>\n\t</div>\n\t<small class="d-none d-md-block">Filter by lead type</small>\n\t<div class="row quarter-padding-top text-center">\n\t\t<div class="col-4 col-sm-2 half-margin-bottom">\n\t\t\t<a href="javascript:;"\n\t\t\t   class="text-grey"\n\t\t\t   [class.bold]="!filter.type"\n\t\t\t   (click)="updateFilter({ type: undefined })">\n\t\t\t\t<i class="fal fa-list fa-fw"></i>\n\t\t\t\t<span class="block small">All Leads</span>\n\t\t\t</a></div>\n\t</div>\n\t<div class="row quarter-padding-top text-center">\n\t\t<div class="col-4 col-lg-2 col-md-4 col-sm-4 half-margin-bottom">\n\t\t\t<a href="javascript:;"\n\t\t\t   class="text-grey"\n\t\t\t   title="Control4 Qualified Lead: A lead who has been pre-qualified by a Control4 representative and is interested in speaking with a dealer."\n\t\t\t   [class.bold]="filter.type === leadDisplayType.Control4Qualified"\n\t\t\t   (click)="updateFilter({ type: leadDisplayType.Control4Qualified })">\n\t\t\t\t<i class="fal fa-headset fa-fw"></i>\n\t\t\t\t<span class="block small no-wrap">Control4 Qualified Lead</span>\n\t\t\t</a>\n\t\t</div>\n\t\t<div class="col-4 col-lg-2 col-md-4 col-sm-4 half-margin-bottom">\n\t\t\t<a href="javascript:;"\n\t\t\t   class="text-grey"\n\t\t\t   title="Customer Requested Update: A customer who filled out a form requesting more information and an update to OS 3."\n\t\t\t   [class.bold]="filter.type === leadDisplayType.CustomerUpgrade"\n\t\t\t   (click)="updateFilter({ type: leadDisplayType.CustomerUpgrade })">\n\t\t\t\t<i class="fal fa-comment-alt-plus fa-fw fa-flip-horizontal"></i>\n\t\t\t\t<span class="block small">Customer Requested Update</span>\n\t\t\t</a>\n\t\t</div>\n\t\t<div class="col-4 col-lg-2 col-md-4 col-sm-4 half-margin-bottom">\n\t\t\t<a href="javascript:;"\n\t\t\t   class="text-grey"\n\t\t\t   title="Control4 Qualified Upgrade: A current customer who has spoken with a Control4 representative about upgrading their Control4 system to the latest software and hardware."\n\t\t\t   [class.bold]="filter.type === leadDisplayType.DealerUpgrade"\n\t\t\t   (click)="updateFilter({ type: leadDisplayType.DealerUpgrade })">\n\t\t\t\t<i class="fal fa-comment-alt-plus fa-fw"></i>\n\t\t\t\t<span class="block small">Control4 Qualified Upgrade</span>\n\t\t\t</a></div>\n\t\t<div class="col-4 col-lg-2 col-md-4 col-sm-4 half-margin-bottom">\n\t\t\t<a href="javascript:;"\n\t\t\t   class="text-grey"\n\t\t\t   title="Showroom Event: A lead/customer who has registered to attend a C4Yourself event or other event at your showroom. Exclusive to Certified Showroom Dealers."\n\t\t\t   [class.bold]="filter.type === leadDisplayType.Showroom"\n\t\t\t   (click)="updateFilter({ type: leadDisplayType.Showroom })">\n\t\t\t\t<i class="fal fa-bookmark fa-fw"></i>\n\t\t\t\t<span class="block small">Showroom Event</span>\n\t\t\t</a></div>\n\t\t<div class="col-4 col-lg-2 col-md-4 col-sm-4 half-margin-bottom">\n\t\t\t<a href="javascript:;"\n\t\t\t   class="text-grey"\n\t\t\t   title="Lighting Request: A lead/customer who filled out the lighting request form directly on your microsite."\n\t\t\t   [class.bold]="filter.type === leadDisplayType.LightingRequest"\n\t\t\t   (click)="updateFilter({ type: leadDisplayType.LightingRequest })">\n\t\t\t\t<i class="fal fa-lightbulb-on fa-fw"></i>\n\t\t\t\t<span class="block small">Lighting Request</span>\n\t\t\t</a></div>\n\t\t<div class="col-4 col-lg-2 col-md-4 col-sm-4 half-margin-bottom">\n\t\t\t<a href="javascript:;"\n\t\t\t   class="text-grey"\n\t\t\t   title="Dealer Microsite: A lead/customer who filled out the form directly on your microsite."\n\t\t\t   [class.bold]="filter.type === leadDisplayType.Microsite"\n\t\t\t   (click)="updateFilter({ type: leadDisplayType.Microsite })">\n\t\t\t\t<i class="fal fa-window fa-fw"></i>\n\t\t\t\t<span class="block small">Dealer Microsite</span>\n\t\t\t</a></div>\n\t</div>\n</div>\n<div class="widget" id="leads-table">\n\t<ng-container *ngIf="loaded">\n\t\t<div class="half-padding-left half-padding-right" style="padding-top: 10px; padding-bottom: 10px;">\n\t\t\t\x3c!-- TABLE MEDIUM UP --\x3e\n\t\t\t<div class="table" *ngIf="loaded">\n\t\t\t\t<div class="head d-none d-md-block">\n\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t<div class="col-sm-2 truncate">\n\t\t\t\t\t\t\t<a href="javascript:void(0);" class="text-dark">\n\t\t\t\t\t\t\t\t<span class="text-dark">Type</span>\n\t\t\t\t\t\t\t</a>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class="col-sm-3 col-md-2">\n\t\t\t\t\t\t\t<a href="javascript:void(0);" test-id="updateSortNameClick" title="Sort by name alphabetically" (click)="updateSort(\'name\')">\n\t\t\t\t\t\t\t\t<span class="text-dark">Name</span>\n\t\t\t\t\t\t\t\t<i *ngIf="sort$.getValue() as sort" [ngClass]="{\n\t\t\t\t\t\t\t\t\t\t\t\'fad text-grey\': sort.col === \'name\',\n\t\t\t\t\t\t\t\t\t\t\t\'fas text-light-grey\': sort.col !== \'name\',\n\t\t\t\t\t\t\t\t\t\t\t\'fa-sort\': true,\n\t\t\t\t\t\t\t\t\t\t\t\'fa-rotate-180\': !sort.desc && sort.col === \'name\'\n\t\t\t\t\t\t\t\t\t\t}"\n\t\t\t\t\t\t\t\t   aria-hidden="true"><span class="sr-only">Sort column</span></i>\n\t\t\t\t\t\t\t</a>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class="col-sm-3 col-md-2">Contact</div>\n\t\t\t\t\t\t<div class="col-md-3 d-none d-md-block">\n\t\t\t\t\t\t\t<a href="javascript:void(0);" test-id="updateSortStatusClick" (click)="updateSort(\'status\')" title="Sort by lead status">\n\t\t\t\t\t\t\t\t<span class="text-dark">Status</span><i *ngIf="sort$.getValue() as sort" [ngClass]="{\n\t\t\t\t\t\t\t\t\t\t\t\'fad text-grey\': sort.col === \'status\',\n\t\t\t\t\t\t\t\t\t\t\t\'fas text-light-grey\': sort.col !== \'status\',\n\t\t\t\t\t\t\t\t\t\t\t\'fa-sort\': true,\n\t\t\t\t\t\t\t\t\t\t\t\'fa-rotate-180\': !sort.desc && sort.col === \'status\'\n\t\t\t\t\t\t\t\t\t\t}" aria-hidden="true"><span class="sr-only">Sort column</span></i>\n\t\t\t\t\t\t\t</a>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class="col-3 text-right d-none d-md-block">\n\t\t\t\t\t\t\t\x3c!-- <a href="javascript:void(0);" class="text-grey" title="Export leads as CSV">\n\t\t\t\t\t\t\t\t\t<i class="fal fa-file-export"></i><span style="font-weight: 400;">Export</span></a> --\x3e\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class="body">\n\t\t\t\t\t<c4-lead-detail attr.test-id="c4-lead-detail-{{i}}" class="row" *ngFor="let lead of leads$ | paging: pagingInfo | async; index as i"\n\t\t\t\t\t\t\t\t\t[lead]="lead"></c4-lead-detail>\n\t\t\t\t\t<c4-pager [(info)]="pagingInfo"></c4-pager>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t</div>\n\t</ng-container>\n</div>\n<c4-loading *ngIf="!loaded"></c4-loading>'},NhcU:function(t,e){t.exports='<mat-expansion-panel>\n\t<mat-expansion-panel-header>\n\t\t<small>Details<i class="fal fa-chevron-down"></i></small>\n\t</mat-expansion-panel-header>\n\t<ng-template matExpansionPanelContent>\n\t\t<div class="row">\n\t\t\t<div class="col-12 col-md-4 half-margin-bottom">\n\t\t\t\t<h4>Customer Details</h4>\n\t\t\t\t<ul class="no-style">\n\t\t\t\t\t<li>{{lead.name}}</li>\n\t\t\t\t\t<li *ngIf="lead.phone"><a href="tel:{{lead.phone}}" class="text-grey">{{lead.phone}}</a></li>\n\t\t\t\t\t<li *ngIf="lead.email"><a href="mailto:{{lead.email}}" class="text-grey">{{lead.email}}</a>\n\t\t\t\t\t</li>\n\t\t\t\t\t<li *ngIf="lead.streetAddress">{{ lead.streetAddress }}</li>\n\t\t\t\t\t<li *ngIf="lead.city || lead.state || lead.postalCode">{{ lead.city}}<span *ngIf="lead.city && lead.state">, </span>{{lead.state}}\n\t\t\t\t\t\t{{lead.postalCode}} </li>\n\t\t\t\t</ul>\n\t\t\t</div>\n\t\t\t<div class="col-12 col-md-8 half-margin-bottom">\n\t\t\t\t<div *ngIf="lead.partySizeCount != 0 && lead.partySizeCount !== null" class="half-margin-bottom">\n\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t<div class="col-6 col-md-4">\n\t\t\t\t\t\t\t<h4>Event RSVP Details</h4>\n\t\t\t\t\t\t\t<p>{{lead.partySizeCount}} attending</p>\n\t\t\t\t\t\t\t<p><span class="bold">Dealership Location</span><br> {{lead.dealerAddress}}<br> {{lead.dealerCity}}<span\n\t\t\t\t\t\t\t\t\t  ng-if="lead.dealerCity && lead.dealerState">,</span> {{lead.dealerState}} {{lead.dealerZip}} </p>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div *ngIf="lead.details">\n\t\t\t\t\t<h4>Job Details</h4>\n\t\t\t\t\t<div class="row" *ngFor="let detail of lead.details | keyvalue">\n\t\t\t\t\t\t<div class="col-6 col-md-4">{{detail.key}}</div>\n\t\t\t\t\t\t<div class="col-6 col-md-8">{{detail | leadDetailDisplay}}</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t\t<div class="col-12" *ngIf="lead.leadGenNotes">\n\t\t\t\t<h4>Agent Notes</h4>\n\t\t\t\t<p>{{lead.leadGenNotes}}</p>\n\t\t\t</div>\n\t\t</div>\n\t\t<ng-container *ngIf="lead.updates?.length || lead.notes">\n\t\t\t<h4>Activity History</h4>\n\t\t\t<div class="row">\n\t\t\t\t<div class="col-4 col-lg-2">\n\t\t\t\t\t<h5>Updated</h5>\n\t\t\t\t</div>\n\t\t\t\t<div class="col-4 col-lg-2">\n\t\t\t\t\t<h5>Status</h5>\n\t\t\t\t</div>\n\t\t\t\t<div class="col-4 col-lg-7">\n\t\t\t\t\t<h5>Dealer Notes</h5>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t\t<div class="row half-margin-bottom" *ngFor="let update of lead.updates">\n\t\t\t\t<div class="col-4 col-lg-2">\n\t\t\t\t\t<small>\n\t\t\t\t\t\t<ul class="no-style">\n\t\t\t\t\t\t\t<li>{{ update.createdAt | date: "MMM dd, yyyy" }}</li>\n\t\t\t\t\t\t\t<li>{