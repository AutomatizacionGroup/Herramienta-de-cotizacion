(t)}resetRebate(){this.rebateTrainee=null,this.rebateLoading=!0,this.rebateLoginName=this.rebateLoginName.trim(),this.userService.resetRebateStartDate(this.rebateLoginName,this.rebateDate).subscribe(t=>{this.rebateTrainee=t,this.rebateLoading=!1,this.rebateResetMessage=`Rebate start date for ${this.rebateLoginName} has been set to ${this.rebateDate}.`,this.traineeLoginName=this.rebateLoginName,this.getTrainee()})}updateUserSalesforceInfo(){this.updateTrainee=null,this.updateLoading=!0,this.updateLoginName=this.updateLoginName.trim(),this.salesforceContactId=this.salesforceContactId.trim(),this.salesforceUserId=this.salesforceUserId.trim(),this.userService.updateUserSalesforceInfo(this.updateLoginName,this.salesforceContactId,this.salesforceUserId).subscribe(t=>{this.updateTrainee=t,this.updateLoading=!1,t.success&&(this.updateMessage=`${this.updateLoginName} Salesforce information has been updated!`,this.traineeLoginName=this.updateLoginName,this.getTrainee())})}transferPcnaKit(){this.transferResult=null,this.loading=!0,this.fromLoginName=this.fromLoginName.trim(),this.toLoginName=this.toLoginName.trim(),this.userService.transferPcnaKit(this.fromLoginName,this.toLoginName).subscribe(t=>{this.transferResult=t,this.loading=!1,this.transferMessage=`Successfully transferred PCNA kit from <b>${this.fromLoginName}</b> to <b>${this.toLoginName}</b>!`})}registerUserForPcna(){this.userToRegister=this.userToRegister.trim(),this.userService.registerUserForPcna(this.userToRegister,this.selectedPCNAType).subscribe(t=>{this.userRegistrationResult=t,this.registerForPcnaMessage=`Successfully registered <b>${this.userToRegister}</b> for PCNA`})}unregisterUserForPcnaLearningPath(){this.unregisterLoading=!0,this.userToUnregister=this.userToUnregister.trim(),this.unregisterUserForPcnaLearningPathUrl=null,this.unregisterForPcnaMessage=null,this.userService.unregisterUserForPcnaLearningPath(this.userToUnregister,this.selectedPCNATypeForUnregister).subscribe(t=>{t.value?this.unregisterUse