(window.webpackJsonp=window.webpackJsonp||[]).push([[8],{"+6n/":function(t,e){t.exports='<div class="widget">\n\t<h3 class="widget-header-grey">{{isNewUser ? \'New\' : \'Edit\'}} User</h3>\n\t<div class="absolute top block text-right">\n\t\t<button test-id="cancelUserEditClick" class="transparent no-border-radius-left" (click)="cancel()"><i class="fal fa-times"></i>Cancel</button>\n\t</div>\n\t<div class="padding">\n\t\t<form name="EditUserForm" #editUserForm="ngForm" class="no-margin" (ngSubmit)="save()">\n\t\t\t<div class="row half-padding-bottom">\n\t\t\t\t<div class="col-sm-6">\n\t\t\t\t\t<mat-form-field class="fs-block">\n\t\t\t\t\t\t<input test-id="firstName" matInput type="text" placeholder="First Name" name="firstName"\n\t\t\t\t\t\t\t   [(ngModel)]="user.firstName" required>\n\t\t\t\t\t</mat-form-field>\n\t\t\t\t</div>\n\t\t\t\t<div class="col-sm-6">\n\t\t\t\t\t<mat-form-field class="fs-block">\n\t\t\t\t\t\t<input test-id="lastName" matInput type="text" placeholder="Last Name" name="lastName" [(ngModel)]="user.lastName"\n\t\t\t\t\t\t\t   required>\n\t\t\t\t\t</mat-form-field>\n\t\t\t\t</div>\n\t\t\t\t<div class="col-sm-6">\n\t\t\t\t\t<mat-form-field>\n\t\t\t\t\t\t<input test-id="loginName" matInput type="text" placeholder="Username" name="loginName" [(ngModel)]="user.loginName"\n\t\t\t\t\t\t\t   [disabled]="!isNewUser" [pattern]="usernameRegex$ | async" required>\n\t\t\t\t\t</mat-form-field>\n\t\t\t\t</div>\n\t\t\t\t<div class="col-sm-6">\n\t\t\t\t\t<mat-form-field class="fs-block">\n\t\t\t\t\t\t<input test-id="email" matInput type="email" placeholder="Email" name="email" [(ngModel)]="user.email"\n\t\t\t\t\t\t\t   [pattern]="emailRegex" required>\n\t\t\t\t\t</mat-form-field>\n\t\t\t\t</div>\n\t\t\t\t<div class="col-sm-6" *ngIf="(isDistributor$ | async) && !(isSubDealerUser$ | async)">\n\t\t\t\t\t<small>Set Subdealer</small>\n\t\t\t\t\t<c4-subdealer-select [(value)]="user.subDealerId" [selectAll]="false"></c4-subdealer-select>\n\t\t\t\t\t<p>\n\t\t\t\t\t\t<small *ngIf="!(isPakedge$ | async)">Create a sub-dealer user by selecting a sub-dealer account from the drop down. Sub-dealer accounts\n\t\t\t\t\t\t\tare created through my.control4.com</small>\n\t\t\t\t\t\t<small *ngIf="isPakedge$ | async">Please contact <a\n\t\t\t\t\t\t\t   href="mailto:onlineordering@pakedge.com">onlineordering@pakedge.com</a> to add additional sub-dealers.</small>\n\t\t\t\t\t</p>\n\t\t\t\t</div>\n\t\t\t\t<div class="col-sm-6" *ngIf="!isNewUser && (hasImpersonation$ | async)">\n\t\t\t\t\t<select test-id="userStatus" name="activeFlag" [(ngModel)]="user.isActive" [disabled]="isNewUser">\n\t\t\t\t\t\t<option disabled [value]="undefined">User Status</option>\n\t\t\t\t\t\t<option [value]="true">Active</option>\n\t\t\t\t\t\t<option [value]="false">Inactive</option>\n\t\t\t\t\t</select>\n\t\t\t\t</div>\n\t\t\t\t<div class="col-sm-6" *ngIf="!isNewUser && (hasImpersonation$ | async)">\n\t\t\t\t\t<select test-id="userVisibility" name="enabledFlag" [(ngModel)]="user.enabled" [disabled]="isNewUser">\n\t\t\t\t\t\t<option disabled [value]="undefined">User Visibility</option>\n\t\t\t\t\t\t<option [value]="true">Visible</option>\n\t\t\t\t\t\t<option [value]="false">Invisible</option>\n\t\t\t\t\t</select>\n\t\t\t\t</div>\n\t\t\t\t<div class="col-sm-6">\n\t\t\t\t\t<mat-form-field>\n\t\t\t\t\t\t<input test-id="jobTitle" matInput type="text" placeholder="Job Title" name="jobTitle" [(ngModel)]="user.jobTitle">\n\t\t\t\t\t</mat-form-field>\n\t\t\t\t</div>\n\t\t\t\t<div class="col-sm-6" *ngIf="user.technicianId">\n\t\t\t\t\t<mat-form-field>\n\t\t\t\t\t\t<input test-id="technicianId" matInput type="text" placeholder="Technician ID" name="technicianId"\n\t\t\t\t\t\t\t   [(ngModel)]="user.technicianId" disabled>\n\t\t\t\t\t</mat-form-field>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t\t<div class="alert alert-warning" *ngIf="editUserForm.hasError(\'pattern\', \'email\')">\n\t\t\t\t<p>Please enter a valid email address.</p>\n\t\t\t</div>\n\t\t\t<div class="alert alert-warning" *ngIf="editUserForm.hasError(\'pattern\', \'loginName\')">\n\t\t\t\t<p>Usernames must contain between 6 and 32 characters and consist of letters or numbers only; special characters and spaces are not allowed.</p>\n\t\t\t</div>\n\t\t\t<div class="half-padding-bottom no-margin" *ngIf="isSuper$ | async">\n\t\t\t\t<h4>Portal Access</h4>\n\t\t\t\t<c4-enum-checkbox test-id="portalAccessCheckboxes" [labelMap]="portalNames" [(value)]="user.portalAccess"></c4-enum-checkbox>\n\t\t\t</div>\n\t\t\t<p><span style="font-weight: bold">Important</span>: Roles are optional when creating new users. Roles should be carefully assigned to new users.\n\t\t\t</p>\n\t\t\t<div class="row half-padding-bottom">\n\t\t\t\t<div class="col-md-6">\n\t\t\t\t\t<h4 *ngIf="(internalSecurityRoles$ | async).size && (isInternal$ | async)">External Security Roles</h4>\n\t\t\t\t\t<c4-enum-checkbox test-id="externalSecurityRolesCheckboxes" [labelMap]="externalSecurityRoles$ | async" [(value)]="user.securityRoles"\n\t\t\t\t\t\t\t\t\t  columnClass="col-sm-6"></c4-enum-checkbox>\n\t\t\t\t</div>\n\t\t\t\t<div class="col-md-6" *ngIf="(internalSecurityRoles$ | async).size && (isInternal$ | async)">\n\t\t\t\t\t<h4>Internal Security Roles</h4>\n\t\t\t\t\t<c4-enum-checkbox test-id="internalSecurityRolesCheckboxes" [labelMap]="internalSecurityRoles$ | async" [(value)]="user.securityRoles"\n\t\t\t\t\t\t\t\t\t  columnClass="col-sm-6"></c4-enum-checkbox>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t\t<div class="row half-padding-bottom" *ngIf="isNewUser">\n\t\t\t\t<label>\n\t\t\t\t\t<input test-id="loggingInWithNewPasswordCheckbox" name="loggingInWithNewPassword" type="checkbox"\n\t\t\t\t\t\t   [(ngModel)]="user.loggingInWithNewPassword" />\n\t\t\t\t\t<span>Send email to user with login link <small>(recommended)</small></span>\n\t\t\t\t</label>\n\t\t\t</div>\n\t\t\t<div class="row half-padding-bottom" *ngIf="isNewUser && !user.loggingInWithNewPassword">\n\t\t\t\t<div class="col-md-3 col-sm-6">\n\t\t\t\t\t<mat-form-field>\n\t\t\t\t\t\t<input test-id="newPassword" matInput type="password" name="password" #password="ngModel" placeholder="New Password"\n\t\t\t\t\t\t\t   [(ngModel)]="user.password" [pattern]="authService.passwordRegex" required />\n\t\t\t\t\t</mat-form-field>\n\t\t\t\t</div>\n\t\t\t\t<div class="col-md-3 col-sm-6">\n\t\t\t\t\t<mat-form-field>\n\t\t\t\t\t\t<input test-id="confirmPassword" matInput type="password" name="confirmPassword" placeholder="Confirm Password"\n\t\t\t\t\t\t\t   [(ngModel)]="confirmPassword" required />\n\t\t\t\t\t</mat-form-field>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t\t<div *ngIf="!isNewUser">\n\t\t\t\t<div class="table half-margin-bottom text-center">\n\t\t\t\t\t<div class="header">\n\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t<div class="col-sm-2 d-xs-none">\n\t\t\t\t\t\t\t\t<b>Created</b>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class="col-sm-2 d-xs-none">\n\t\t\t\t\t\t\t\t<b>Updated</b>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class="col-sm-2 d-xs-none">\n\t\t\t\t\t\t\t\t<b>Last Login</b>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class="col-sm-2 d-xs-none">\n\t\t\t\t\t\t\t\t<b>Password Changed</b>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class="col-sm-2 d-xs-none">\n\t\t\t\t\t\t\t\t<b>Disabled</b>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class="col-sm-1 d-xs-none">\n\t\t\t\t\t\t\t\t<b>Visits</b>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="body">\n\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t<div class="col-sm-2 col-12">\n\t\t\t\t\t\t\t\t<span class="bold d-block d-sm-none">Created</span>\n\t\t\t\t\t\t\t\t<span *ngIf="user.addDate">{{user.addDate | date: \'MMM dd, yyyy\'}}</span>\n\t\t\t\t\t\t\t\t<span *ngIf="!user.addDate" style="padding-right:5px;">Never</span>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class="col-sm-2 col-12">\n\t\t\t\t\t\t\t\t<span class="bold d-block d-sm-none">Updated</span>\n\t\t\t\t\t\t\t\t<span *ngIf="user.lastChangeDate">{{user.lastChangeDate | date: \'MMM dd, yyyy\'}}</span>\n\t\t\t\t\t\t\t\t<span *ngIf="!user.lastChangeDate">Never</span>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class="col-sm-2 col-12">\n\t\t\t\t\t\t\t\t<span class="bold d-block d-sm-none">Last Login</span>\n\t\t\t\t\t\t\t\t<span *ngIf="user.lastVisitDate">{{user.lastVisitDate | date: \'MMM dd, yyyy\'}}</span>\n\t\t\t\t\t\t\t\t<span *ngIf="!user.lastVisitDate">Never</span>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class="col-sm-2 col-12">\n\t\t\t\t\t\t\t\t<span class="bold d-block d-sm-none">Password Changed</span>\n\t\t\t\t\t\t\t\t<span\n\t\t\t\t\t\t\t\t\t  *ngIf="user.lastPasswordChangeDate">{{user.lastPasswordChangeDate | date: \'MMM dd, yyyy\'}}</span>\n\t\t\t\t\t\t\t\t<span *ngIf="!user.lastPasswordChangeDate">Never</span>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class="col-sm-2 col-12">\n\t\t\t\t\t\t\t\t<span class="bold d-block d-sm-none">Disabled</span>\n\t\t\t\t\t\t\t\t<span\n\t\t\t\t\t\t\t\t\t  *ngIf="user.lastLockoutDate">{{user.lastLockoutDate | date: \'MMM dd, yyyy\'}}</span>\n\t\t\t\t\t\t\t\t<span *ngIf="!user.lastLockoutDate">Never</span>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class="col-sm-1 col-12" style="padding-left:5px;">\n\t\t\t\t\t\t\t\t<span class="bold d-block d-sm-none">Visits</span> {{user.visits}}\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class="half-margin-bottom">\n\t\t\t\t\t<button test-id="emailPasswordResetClick" type="button" (click)="sendResetPasswordEmail()" class="light-grey"><i\n\t\t\t\t\t\t   class="fal fa-envelope"></i>Email Password Reset</button>\n\t\t\t\t\t<small class="block">\n\t\t\t\t\t\t<a *ngIf="(hasImpersonation$ | async) && !(isCognitoForgotPasswordEnabled$ | async)"\n\t\t\t\t\t\t   (click)="generateResetPasswordLink()" class="text-grey">Password Reset Link</a>\n\t\t\t\t\t</small>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t\t<div class="alert alert-warning" *ngIf="editUserForm.hasError(\'pattern\', \'password\')">\n\t\t\t\t<p>Password must be between eight and twenty characters and must include the following: one or more capital letter, one or more lowercase\n\t\t\t\t\tletter, one or more numerical digit, one or more special character.</p>\n\t\t\t</div>\n\t\t\t<div class="alert alert-warning"\n\t\t\t\t *ngIf="user.password && confirmPassword && user.password !== confirmPassword">\n\t\t\t\t<p>Password and Confirm Password must match.</p>\n\t\t\t</div>\n\t\t\t<div class="alert alert-warning" *ngIf="passwordWasReset">\n\t\t\t\t<div *ngIf="passwordResetLink">The following link can be used to reset the user\'s password. <br /><b\n\t\t\t\t\t   select-me>{{passwordResetLink}}</b></div>\n\t\t\t\t<div *ngIf="!passwordResetLink">Your password reset request has been submitted. A link will be emailed to <b>{{user.email}}</b> to complete the\n\t\t\t\t\tpassword reset.</div>\n\t\t\t</div>\n\t\t\t<div class="pull-right" *ngIf="!isNewUser">\n\t\t\t\t<button test-id="deleteUserClick" type="button" (click)="beginRemove()" *ngIf="!isNewUser && user.enabled"\n\t\t\t\t\t\tclass="grey no-margin"><i class="fal fa-trash"></i>Delete User</button>\n\t\t\t</div>\n\t\t\t<button test-id="saveUserClick" [disabled]="editUserForm.invalid || (isNewUser && user.password !== confirmPassword) || saving"\n\t\t\t\t\tclass="no-margin"><i class="fal fa-check"></i>Save</button>\n\t\t\t<button test-id="cancelUserEditClickBottom" type="button" (click)="cancel()" class="transparent"><i class="fal fa-times"></i>Cancel</button>\n\t\t</form>\n\t</div>\n</div>'},"2fHt":function(t,e){t.exports='<div class="padding" *ngIf="company">\n\t<h1>Account Overview</h1>\n\t<div class="row">\n\t\t<div class="col-md-4" *ngIf="!(isMergedLoyaltyProgram$ | async) && !company.isDistributor && (canSeeStatus$ | async) && (showAccountStatus$ | async)">\n\t\t\t<c4-status-progress-widget></c4-status-progress-widget>\n\t\t</div>\n\t\t<div\n\t\t\t [className]="company.isDistributor || (!(canSeeStatus$ | async) && !(showAccountStatus$ | async)) || (isMergedLoyaltyProgram$ | async) ? \'col-md-12\' : \'col-md-8\'">\n\t\t\t<div class="widget home half-padding-bottom">\n\t\t\t\t<h3 class="widget-header-white">{{(isSubdealer$ | async) ? "Distributor Information" : "Dealership" }} </h3>\n\t\t\t\t<div class="padding">\n\t\t\t\t\t<h4>{{company.id}} <em>{{company.accountName}}</em>\n\t\t\t\t\t</h4>\n\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t<div [className]="(isMergedLoyaltyProgram$ | async) ? \'col-sm-4\' : \'col-sm-6\'">\n\t\t\t\t\t\t\t<div class="row" *ngIf="company.phone1">\n\t\t\t\t\t\t\t\t<div class="col-4 bold">Phone</div>\n\t\t\t\t\t\t\t\t<div class="col-8">{{company.phone1}}</div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class="row" *ngIf="company.phoneFax">\n\t\t\t\t\t\t\t\t<div class="col-4 bold">Fax</div>\n\t\t\t\t\t\t\t\t<div class="col-8">{{company.phoneFax}}</div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class="row" *ngIf="company.emailAddress">\n\t\t\t\t\t\t\t\t<div class="col-4 bold">Email</div>\n\t\t\t\t\t\t\t\t<div class="col-8 truncate">\n\t\t\t\t\t\t\t\t\t<a [href]="\'mailto:\' + company.emailAddress">{{company.emailAddress}}</a>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class="row" *ngIf="websiteLink">\n\t\t\t\t\t\t\t\t<div class="col-4 bold">Web</div>\n\t\t\t\t\t\t\t\t<div class="col-8 truncate">\n\t\t\t\t\t\t\t\t\t<a [href]="websiteLink" class="overridelegal"\n\t\t\t\t\t\t\t\t\t   target="_blank">{{company.website}}</a>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class="row" *ngIf="billingAddress">\n\t\t\t\t\t\t\t\t<div class="col-4 bold">Billing</div>\n\t\t\t\t\t\t\t\t<div class="col-8">\n\t\t\t\t\t\t\t\t\t<span *ngIf="billingAddress.line1">{{billingAddress.line1}} <br />\n\t\t\t\t\t\t\t\t\t</span>\n\t\t\t\t\t\t\t\t\t<span *ngIf="billingAddress.line2">{{billingAddress.line2}} <br />\n\t\t\t\t\t\t\t\t\t</span>\n\t\t\t\t\t\t\t\t\t<span\n\t\t\t\t\t\t\t\t\t\t  *ngIf="!isEmea && (billingAddress.city || billingAddress.stateProvince || billingAddress.postalCode)">\n\t\t\t\t\t\t\t\t\t\t{{billingAddress.city}}, {{billingAddress.stateProvince}} {{billingAddress.postalCode}} <br />\n\t\t\t\t\t\t\t\t\t</span>\n\t\t\t\t\t\t\t\t\t<ng-container *ngIf="isEmea">\n\t\t\t\t\t\t\t\t\t\t<ng-container *ngIf="billingAddress.country != \'US\'">\n\t\t\t\t\t\t\t\t\t\t\t<span *ngIf="billingAddress.city">{{billingAddress.city}} <br />\n\t\t\t\t\t\t\t\t\t\t\t</span>\n\t\t\t\t\t\t\t\t\t\t\t<span *ngIf="billingAddress.stateProvince"> {{billingAddress.stateProvince}} <br />\n\t\t\t\t\t\t\t\t\t\t\t</span>\n\t\t\t\t\t\t\t\t\t\t\t<span *ngIf="billingAddress.postalCode">{{billingAddress.postalCode}} <br />\n\t\t\t\t\t\t\t\t\t\t\t</span>\n\t\t\t\t\t\t\t\t\t\t</ng-container>\n\t\t\t\t\t\t\t\t\t\t<span *ngIf="billingAddress.country">{{billingAddress.country}} <br />\n\t\t\t\t\t\t\t\t\t\t</span>\n\t\t\t\t\t\t\t\t\t</ng-container>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div [className]="(isMergedLoyaltyProgram$ | async) ? \'col-sm-4\' : \'col-sm-6\'">\n\t\t\t\t\t\t\t<div class="row" *ngIf="shippingMethod">\n\t\t\t\t\t\t\t\t<div class="col-4 bold">Ship Method</div>\n\t\t\t\t\t\t\t\t<div class="col-8">{{shippingMethod.name}}</div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class="row" *ngIf="shippingAddress">\n\t\t\t\t\t\t\t\t<div class="col-4 bold">Ship Address</div>\n\t\t\t\t\t\t\t\t<div class="col-8">\n\t\t\t\t\t\t\t\t\t<span *ngIf="shippingAddress.line1"> {{shippingAddress.line1}} <br />\n\t\t\t\t\t\t\t\t\t</span>\n\t\t\t\t\t\t\t\t\t<span *ngIf="shippingAddress.line2"> {{shippingAddress.line2}} <br />\n\t\t\t\t\t\t\t\t\t</span>\n\t\t\t\t\t\t\t\t\t<span\n\t\t\t\t\t\t\t\t\t\t  *ngIf="!isEmea && (shippingAddress.city || billingAddress.stateProvince || billingAddress.postalCode)">\n\t\t\t\t\t\t\t\t\t\t{{shippingAddress.city}}, {{shippingAddress.stateProvince}} {{shippingAddress.postalCode}} <br />\n\t\t\t\t\t\t\t\t\t</span>\n\t\t\t\t\t\t\t\t\t<ng-container *ngIf="isEmea">\n\t\t\t\t\t\t\t\t\t\t<ng-container *ngIf="shippingAddress.country != \'US\'">\n\t\t\t\t\t\t\t\t\t\t\t<span *ngIf="shippingAddress.city"> {{shippingAddress.city}} <br />\n\t\t\t\t\t\t\t\t\t\t\t</span>\n\t\t\t\t\t\t\t\t\t\t\t<span *ngIf="shippingAddress.stateProvince"> {{shippingAddress.stateProvince}} <br />\n\t\t\t\t\t\t\t\t\t\t\t</span>\n\t\t\t\t\t\t\t\t\t\t\t<span *ngIf="shippingAddress.postalCode"> {{shippingAddress.postalCode}} <br />\n\t\t\t\t\t\t\t\t\t\t\t</span>\n\t\t\t\t\t\t\t\t\t\t\t<span *ngIf="shippingAddress.country"> {{shippingAddress.country}} <br />\n\t\t\t\t\t\t\t\t\t\t\t</span>\n\t\t\t\t\t\t\t\t\t\t</ng-container>\n\t\t\t\t\t\t\t\t\t</ng-container>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class="row lux-row" *ngIf="!(isSubdealer$ | async)">\n\t\t\t\t\t\t\t\t<div class="col-12">\n\t\t\t\t\t\t\t\t\t<div class="lux-label">Lux Button Engraving:</div>\n\t\t\t\t\t\t\t\t\t<div class="lux-value">\n\t\t\t\t\t\t\t\t\t\t<ng-container *ngIf="isFreeLuxEligibleUser; else standardPricing">\n\t\t\t\t\t\t\t\t\t\t\t<span class="lux-free">Free</span>\n\t\t\t\t\t\t\t\t\t\t</ng-container>\n\t\t\t\t\t\t\t\t\t\t<ng-template #standardPricing>\n\t\t\t\t\t\t\t\t\t\t\t<span class="standard-pricing">Standard Pricing.</span>\n\t\t\t\t\t\t\t\t\t\t\t<a href="https://control4.learnupon.com/content-details/87834/1" class="overridelegal learn-link">Learn more</a>\n\t\t\t\t\t\t\t\t\t\t\t<span class="learn-suffix"> about Free Lux Engraving</span>\n\t\t\t\t\t\t\t\t\t\t</ng-template>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="row" style="margin-top: 12.5px;" *ngIf="!company.isDistributor">\n\t\t\t\t\t\t<div class="col-sm-6" *ngIf="!(isMergedLoyaltyProgram$ | async) && (showAccountStatus$ | async)">\n\t\t\t\t\t\t\t<a routerLink="/marketing/branding">\n\t\t\t\t\t\t\t\t<h4 class="no-margin" style="padding-bottom: 12.5px;" title="See All Status Badges"> Status Badges </h4>\n\t\t\t\t\t\t\t</a>\n\t\t\t\t\t\t\t<c4-status-badge *ngIf="company.premierStatus"\n\t\t\t\t\t\t\t\t\t\t\t [type]="company.premierStatus | statusBadgeType">\n\t\t\t\t\t\t\t</c4-status-badge>\n\t\t\t\t\t\t\t<c4-status-badge *ngIf="company.isPinnacle" type="pinnacle-status"></c4-status-badge>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class="col-sm-6" *ngIf="(isMergedLoyaltyProgram$ | async) && (showAccountStatus$ | async)">\n\t\t\t\t\t\t\t<h4 class="no- bold" style="padding-bottom: 12.5px;" title="See All Status Badges"> Status Badges </h4>\n\t\t\t\t\t\t\t<p>If you would like to receive a digital copy of your Loyalty Rewards Badge, please reach out to your sales contact.</p>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t</div>\n\t</div>\n\t<div class="row">\n\t\t<div class="col-md-8">\n\t\t\t<div class="widget widget-fixed-height contact">\n\t\t\t\t<h3 class="widget-header-white">Contact Sales</h3>\n\t\t\t\t<div class="padding" *ngIf="!salesContacts">\n\t\t\t\t\t<c4-loading></c4-loading>\n\t\t\t\t</div>\n\t\t\t\t<div class="padding" *ngIf="salesContacts">\n\t\t\t\t\t<div class="row half-padding-bottom">\n\t\t\t\t\t\t<ng-container *ngIf="!isEmea">\n\t\t\t\t\t\t\t<div class="col-xl-4 col-lg-6 col-md-6">\n\t\t\t\t\t\t\t\t<h4 class="no-margin">Sales Support Team</h4>\n\t\t\t\t\t\t\t\t<p class="no-margin"><a href="tel:18884004072">888-400-4072 (opt 3)</a></p>\n\t\t\t\t\t\t\t\t<p class="half-padding-bottom truncate"><a href="mailto:International@adiglobal.com">International@adiglobal.com</a></p>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class="col-xl-4 col-lg-6 col-md-6">\n\t\t\t\t\t\t\t\t<h4 class="no-margin">Accounting Team</h4>\n\t\t\t\t\t\t\t\t<p class="no-margin"><a href="tel:18884004072">888-400-4072 (opt 2)</a></p>\n\t\t\t\t\t\t\t\t<p class="half-padding-bottom truncate"><a href="mailto:CreditDepartment@snapav.com">CreditDepartment@snapav.com</a></p>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</ng-container>\n\t\t\t\t\t\t<ng-container *ngIf="isEmea">\n\t\t\t\t\t\t\t<div class="col-xl-4 col-lg-6 col-md-6">\n\t\t\t\t\t\t\t\t<h4 class="no-margin">Sales Support Team</h4>\n\t\t\t\t\t\t\t\t<p class="no-margin"><a href="tel:4408001217702">+44 (0) 800 121 7702 (opt 2)</a></p>\n\t\t\t\t\t\t\t\t<p class="half-padding-bottom truncate"><a href="mailto:International@adiglobal.com">International@adiglobal.com</a></p>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class="col-xl-4 col-lg-6 col-md-6">\n\t\t\t\t\t\t\t\t<h4 class="no-margin">Accounting Team</h4>\n\t\t\t\t\t\t\t\t<p class="no-margin"><a href="tel:4408001217702">+44 (0) 800 121 7702 (opt 4)</a></p>\n\t\t\t\t\t\t\t\t<p class="half-padding-bottom truncate"><a href="mailto:accountsemea@control4.com">accountsemea@control4.com</a></p>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</ng-container>\n\t\t\t\t\t\t<div class="col-xl-4 col-lg-6 col-md-6" *ngIf="salesContacts.coreInsideRep">\n\t\t\t\t\t\t\t<h4 class="no-margin">{{salesContacts.coreInsideRep.firstName}} {{salesContacts.coreInsideRep.lastName}}</h4>\n\t\t\t\t\t\t\t<small>Inside Sales Manager</small>\n\t\t\t\t\t\t\t<br>\n\t\t\t\t\t\t\t<p class="no-margin"><a href="tel:{{salesContacts.coreInsideRep.phone}}">{{salesContacts.coreInsideRep.phone}}</a></p>\n\t\t\t\t\t\t\t<p class="half-padding-bottom truncate"><a\n\t\t\t\t\t\t\t\t   href="mailto:{{salesContacts.coreInsideRep.email}}">{{salesContacts.coreInsideRep.email}}</a></p>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div *ngIf="salesContacts.coreOutsideRep" class="col-xl-4 col-lg-6 col-md-6">\n\t\t\t\t\t\t\t<h4 class="no-margin">{{salesContacts.coreOutsideRep.firstName}} {{salesContacts.coreOutsideRep.lastName}}</h4>\n\t\t\t\t\t\t\t<small>Outside Sales Manager</small>\n\t\t\t\t\t\t\t<br>\n\t\t\t\t\t\t\t<p class="no-margin"><a href="tel:{{salesContacts.coreOutsideRep.phone}}">{{salesContacts.coreOutsideRep.phone}}</a></p>\n\t\t\t\t\t\t\t<p class="half-padding-bottom truncate"><a\n\t\t\t\t\t\t\t\t   href="mailto:{{salesContacts.coreOutsideRep.email}}">{{salesContacts.coreOutsideRep.email}}</a>\n\t\t\t\t\t\t\t</p>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div *ngIf="salesContacts.coreSalesEngineer" class="col-xl-4 col-lg-6 col-md-6">\n\t\t\t\t\t\t\t<h4 class="no-margin">{{salesContacts.coreSalesEngineer.firstName}} {{salesContacts.coreSalesEngineer.lastName}}</h4>\n\t\t\t\t\t\t\t<small>Sales Engineer</small>\n\t\t\t\t\t\t\t<br>\n\t\t\t\t\t\t\t<p class="no-margin"><a href="tel:{{salesContacts.coreSalesEngineer.phone}}">{{salesContacts.coreSalesEngineer.phone}}</a></p>\n\t\t\t\t\t\t\t<p class="half-padding-bottom truncate"><a\n\t\t\t\t\t\t\t\t   href="mailto:{{salesContacts.coreSalesEngineer.email}}">{{salesContacts.coreSalesEngineer.email}}</a>\n\t\t\t\t\t\t\t</p>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div *ngIf="salesContacts.localRep" class="col-xl-4 col-lg-6 col-md-6">\n\t\t\t\t\t\t\t<h4 class="no-margin">{{salesContacts.localRep.firstName}} {{salesContacts.localRep.lastName}}</h4>\n\t\t\t\t\t\t\t<small>Local Representative</small>\n\t\t\t\t\t\t\t<br>\n\t\t\t\t\t\t\t<p class="no-margin"><a href="tel:{{salesContacts.localRep.phone}}">{{salesContacts.localRep.phone}}</a></p>\n\t\t\t\t\t\t\t<p class="half-padding-bottom truncate"><a href="mailto:{{salesContacts.localRep.email}}">{{salesContacts.localRep.email}}</a>\n\t\t\t\t\t\t\t</p>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div *ngIf="salesContacts.nationalRep" class="col-xl-4 col-lg-6 col-md-6">\n\t\t\t\t\t\t\t<h4 class="no-margin">{{salesContacts.nationalRep.firstName}} {{salesContacts.nationalRep.lastName}}</h4>\n\t\t\t\t\t\t\t<small>National Representative</small>\n\t\t\t\t\t\t\t<br>\n\t\t\t\t\t\t\t<p class="no-margin"><a href="tel:{{salesContacts.nationalRep.phone}}">{{salesContacts.nationalRep.phone}}</a></p>\n\t\t\t\t\t\t\t<p class="half-padding-bottom truncate"><a href="mailto:{{salesContacts.nationalRep.email}}">{{salesContacts.nationalRep.email}}</a>\n\t\t\t\t\t\t\t</p>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div *ngIf="salesContacts.securityBdm" class="col-xl-4 col-lg-6 col-md-6">\n\t\t\t\t\t\t\t<h4 class="no-margin">{{salesContacts.securityBdm.firstName}} {{salesContacts.securityBdm.lastName}}</h4>\n\t\t\t\t\t\t\t<small>Outside Sales Manager</small>\n\t\t\t\t\t\t\t<br>\n\t\t\t\t\t\t\t<p class="no-margin"><a href="tel:{{salesContacts.securityBdm.phone}}">{{salesContacts.securityBdm.phone}}</a></p>\n\t\t\t\t\t\t\t<p class="half-padding-bottom truncate"><a href="mailto:{{salesContacts.securityBdm.email}}">{{salesContacts.securityBdm.email}}</a>\n\t\t\t\t\t\t\t</p>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div *ngIf="salesContacts.securityRep" class="col-xl-4 col-lg-6 col-md-6">\n\t\t\t\t\t\t\t<h4 class="no-margin">{{salesContacts.coreOutsideRep.firstName}} {{salesContacts.coreOutsideRep.lastName}}</h4>\n\t\t\t\t\t\t\t<small>Outside Sales Manager</small>\n\t\t\t\t\t\t\t<br>\n\t\t\t\t\t\t\t<p class="no-margin"><a href="tel:{{salesContacts.coreOutsideRep.phone}}">{{salesContacts.coreOutsideRep.phone}}</a></p>\n\t\t\t\t\t\t\t<p class="half-padding-bottom truncate"><a\n\t\t\t\t\t\t\t\t   href="mailto:{{salesContacts.coreOutsideRep.email}}">{{salesContacts.coreOutsideRep.email}}</a>\n\t\t\t\t\t\t\t</p>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t</div>\n\t\t<div class="col-md-4">\n\t\t\t<div class="widget widget-fixed-height contact">\n\t\t\t\t<h3 class="widget-header-white">Contact Web Team</h3>\n\t\t\t\t<div class="padding">\n\t\t\t\t\t<c4-portal-contact-us-form></c4-portal-contact-us-form>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t</div>\n\t</div>\n\t<c4-static-content id="shipping-options-policy"></c4-static-content>\n</div>\n<div class="padding" *ngIf="!company">\n\t<c4-loading></c4-loading>\n</div>'},"7VAY":function(t,e){t.exports=""},"8MoX":function(t,e){t.exports="a.text-grey i.fal {\n  margin: 5px 10px 0 5px;\n}"},GLwl:function(t,e){t.exports='<div id="makepaymentform" class="widget">\n\t<div class="row no-margin">\n\t\t<div class="col-10">\n\t\t\t<h2 *ngIf="!isEmea && !isCustomPayment" class="half-padding-top" style="padding-left:25px;">Pay Selected Invoices </h2>\n\t\t\t<h2 *ngIf="!isEmea && isCustomPayment" class="half-padding-top" style="padding-left:25px;">Payment On Account</h2>\n\t\t</div>\n\t\t<div class="col-2">\n\t\t\t<button test-id="cancelAccountBalancePaymentClick" type="button" class="block c4btn transparent" (click)="close()">Cancel</button>\n\t\t</div>\n\t</div>\n\t<div class="padding">\n\t\t<div *ngIf="!isCustomPayment" class="light-grey padding half-margin-bottom">\n\t\t\t<h4>Selected Invoices</h4>\n\t\t\t<div class="table">\n\t\t\t\t<div class="head d-xs-none">\n\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t<div class="col-sm-3">Invoice</div>\n\t\t\t\t\t\t<div class="col-sm-4">PO Reference</div>\n\t\t\t\t\t\t<div class="col-sm-3">Due</div>\n\t\t\t\t\t\t<div class="col-sm-2">Amount</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class="body">\n\t\t\t\t\t<div class="row" *ngFor="let invoice of selectedInvoices">\n\t\t\t\t\t\t<div class="col-sm-3 bold">\n\t\t\t\t\t\t\t<span class="d-block d-sm-none">Invoice</span> {{invoice.referenceNumber}}\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class="col-sm-4">\n\t\t\t\t\t\t\t<span class="d-block d-sm-none bold">PO Reference</span> {{invoice.customerReference}}\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class="col-sm-3">\n\t\t\t\t\t\t\t<span class="d-block d-sm-none bold">Due</span> {{invoice.dueDate | date: \'MMM dd, yyyy\'}}\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class="col-sm-2 col-6" *ngIf="payment.paymentType === \'Check\' && invoice.amount != invoice.earlyPayAmount">\n\t\t\t\t\t\t\t<span class="d-block d-sm-none bold">Amount</span>\n\t\t\t\t\t\t\t<span class="text-red strikethrough">{{invoice.amount | accounting: invoice.currency}}</span>\n\t\t\t\t\t\t\t<br />\n\t\t\t\t\t\t\t<span>{{invoice.earlyPayAmount | accounting: invoice.currency}}</span>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class="col-sm-2 col-6" *ngIf="payment.paymentType !== \'Check\' || invoice.amount == invoice.earlyPayAmount">\n\t\t\t\t\t\t\t<span class="d-block d-sm-none bold">Amount</span>\n\t\t\t\t\t\t\t<span>{{invoice.amount | accounting: invoice.currency}}</span>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="row bold">\n\t\t\t\t\t\t<div class="col-sm-3 offset-sm-7 col-6">Billing Total</div>\n\t\t\t\t\t\t<div class="col-sm-2 col-6">{{ getBillingTotal() | currency: currency}}</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t</div>\n\t\t<div class="half-padding-bottom" *ngIf="isCustomPayment">\n\t\t\t<h4 class="no-margin" style="padding-bottom: 12.5px;">Payment Amount</h4>\n\t\t\t<div class="row no-margin">\n\t\t\t\t<div class="col-1">\n\t\t\t\t\t<div class="input-label"> {{currency}} </div>\n\t\t\t\t</div>\n\t\t\t\t<div class="col-3">\n\t\t\t\t\t<input test-id="customPayment" id="customPayment" type="number" min="1" required c4Focus [(ngModel)]="customPayment" />\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t\t<small>Enter a custom payment amount more than {{1 | currency : currency}} to pay against your outstanding balance.</small>\n\t\t</div>\n\t\t<h4 class="no-margin" style="padding-bottom: 12.5px;">Billing</h4>\n\t\t<div class="row">\n\t\t\t<div class="col-sm-8 col-12">\n\t\t\t\t<select test-id="selectedBillingAddress" class="fs-block" [(ngModel)]="selectedAddress">\n\t\t\t\t\t<option disabled [ngValue]="undefined">Select Billing Address</option>\n\t\t\t\t\t<option *ngFor="let address of billingAddresses$ | async" [ngValue]="address"> {{ address.displayValue }} </option>\n\t\t\t\t</select>\n\t\t\t</div>\n\t\t</div>\n\t\t<div class="row">\n\t\t\t<div class="col-sm-6 col-12">\n\t\t\t\t<select test-id="selectedPaymentType" [ngModel]="payment.paymentType" *ngIf="selectedAddress" (ngModelChange)="changePaymentType($event)">\n\t\t\t\t\t<option disabled [value]="undefined">Select Payment Method</option>\n\t\t\t\t\t<option value="CreditCard">Credit Card</option>\n\t\t\t\t\t<option *ngIf="usCountryCodes.includes(selectedAddress.country)" value="Check">Check / Electronic Fund Transfer </option>\n\t\t\t\t</select>\n\t\t\t</div>\n\t\t</div>\n\t\t<form name="paymentForm" #paymentForm="ngForm" class="paymentoption half-padding-top">\n\t\t\t<div *ngIf="payment.paymentType == \'CreditCard\'">\n\t\t\t\t<h4>Credit Card</h4>\n\t\t\t\t<div class="row">\n\t\t\t\t\t<div class="col-sm-6 col-12">\n\t\t\t\t\t\t<select test-id="selectedCcType" name="cctype" required [ngModel]="selectedCardType"\n\t\t\t\t\t\t\t\t(ngModelChange)="changeCardType($event)" autocomplete="cc-type">\n\t\t\t\t\t\t\t<option disabled [value]="undefined">Select Card Type</option>\n\t\t\t\t\t\t\t<option *ngFor="let c of cardTypes" [ngValue]="c">{{c.description}}</option>\n\t\t\t\t\t\t</select>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="col-sm-6 d-xs-none">\n\t\t\t\t\t\t<ng-container *ngFor="let card of cardTypes">\n\t\t\t\t\t\t\t<a attr.test-id="changeCardTypeClick-{{card}}" *ngIf="card.icon" (click)="changeCardType(card)"\n\t\t\t\t\t\t\t   class="text-grey fab {{card.icon}}"\n\t\t\t\t\t\t\t   [class.active]="selectedCardType === card"></a>&nbsp;</ng-container>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class="row">\n\t\t\t\t\t<div class="col-sm-6">\n\t\t\t\t\t\t<mat-form-field style="width: 100%;">\n\t\t\t\t\t\t\t<input test-id="ccnumber" matInput type="text" name="ccnumber" placeholder="Credit Card Number" required\n\t\t\t\t\t\t\t\t   pattern="^[0-9]{1,16}$" [(ngModel)]="payment.creditCardData.creditCardNumber"\n\t\t\t\t\t\t\t\t   autocomplete="cc-number">\n\t\t\t\t\t\t</mat-form-field>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class="row">\n\t\t\t\t\t<div class="col-sm-6">\n\t\t\t\t\t\t<mat-form-field style="width: 100%;">\n\t\t\t\t\t\t\t<input test-id="nameoncard" matInput type="text" name="nameoncard" placeholder="Name On Card" required\n\t\t\t\t\t\t\t\t   pattern="^[A-Za-z ]{1,26}$" [(ngModel)]="payment.creditCardData.nameOnCard"\n\t\t\t\t\t\t\t\t   autocomplete="cc-name">\n\t\t\t\t\t\t</mat-form-field>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class="row">\n\t\t\t\t\t<div class="col-lg-3 col-md-3 col-sm-3 col-6">\n\t\t\t\t\t\t<select test-id="ccexpmonth" name="ccexpmonth" required [(ngModel)]="payment.creditCardData.expirationMonth"\n\t\t\t\t\t\t\t\tautocomplete="cc-exp-month">\n\t\t\t\t\t\t\t<option disabled [value]="undefined">Month</option>\n\t\t\t\t\t\t\t<option *ngFor="let month of creditCardService.creditCardMonths">{{month}}</option>\n\t\t\t\t\t\t</select>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="col-lg-3 col-md-3 col-sm-3 col-6">\n\t\t\t\t\t\t<select test-id="ccexpyear" name="ccexpyear" required [(ngModel)]="payment.creditCardData.expirationYear"\n\t\t\t\t\t\t\t\tautocomplete="cc-exp-year">\n\t\t\t\t\t\t\t<option disabled [value]="undefined">Year</option>\n\t\t\t\t\t\t\t<option *ngFor="let year of creditCardService.creditCardYears">{{year}}</option>\n\t\t\t\t\t\t</select>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class="row">\n\t\t\t\t\t<div class="col-sm-6 col-12">\n\t\t\t\t\t\t<mat-form-field>\n\t\t\t\t\t\t\t<input test-id="ccseccode" matInput name="ccseccode" type="text" placeholder="Security Code"\n\t\t\t\t\t\t\t\t   [maxlength]="payment.creditCardData.cardType | cvcLength" pattern="^[0-9]{1,4}$"\n\t\t\t\t\t\t\t\t   required [(ngModel)]="payment.creditCardData.securityCode" autocomplete="cc-csc">\n\t\t\t\t\t\t</mat-form-field>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t\t<div *ngIf="payment.paymentType === \'Check\'">\n\t\t\t\t<h4>Check / Electronic Fund Transfer</h4>\n\t\t\t\t<p><small>You have selected to pay via Check/EFT. You are limited to submit a maximum of three transaction payments per 24 hours. You can pay\n\t\t\t\t\t\tmultiple invoices per transaction or if you would like to pay each invoice individually, please contact the <a\n\t\t\t\t\t\t   href="mailto:International@adiglobal.com">Sales Support Team</a>.</small></p>\n\t\t\t\t<div class="row">\n\t\t\t\t\t<div class="col-sm-6">\n\t\t\t\t\t\t<mat-form-field>\n\t\t\t\t\t\t\t<input test-id="holdername" name="holderName" matInput class="fs-block" type="text" required placeholder="Account Holder Name"\n\t\t\t\t\t\t\t\t   [(ngModel)]="payment.eftData.accountHolder">\n\t\t\t\t\t\t</mat-form-field>\n\t\t\t\t\t\t<mat-form-field>\n\t\t\t\t\t\t\t<input test-id="routingNumber" name="routingNumber" matInput class="fs-block" type="text" required placeholder="Routing Number"\n\t\t\t\t\t\t\t\t   pattern="^[0-9]+$" [(ngModel)]="payment.eftData.routingNumber">\n\t\t\t\t\t\t</mat-form-field>\n\t\t\t\t\t\t<mat-form-field>\n\t\t\t\t\t\t\t<input test-id="accountNumber" name="accountNumber" matInput class="fs-block" type="text" required placeholder="Account Number"\n\t\t\t\t\t\t\t\t   [(ngModel)]="payment.eftData.accountNumber">\n\t\t\t\t\t\t</mat-form-field>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="col-sm-6">\n\t\t\t\t\t\t<img src="https://res.cloudinary.com/control4/image/upload/f_auto,q_auto,dpr_auto/check.jpg">\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t\t<div class="half-padding-bottom" *ngFor="let error of errors">\n\t\t\t\t<div class="text-red">{{error.errorMessage}}</div>\n\t\t\t</div>\n\t\t\t<div *ngIf="payment.paymentType && !showReviewPaymentArea">\n\t\t\t\t<button test-id="showReviewPaymentAreaClick" type="button"\n\t\t\t\t\t\t[disabled]="isSubmitting || (isCustomPayment && (!customPayment || customPayment < 1)) || paymentForm?.invalid"\n\t\t\t\t\t\t(click)="showReviewPaymentArea = true">Submit Payment</button>\n\t\t\t</div>\n\t\t\t<div class="row half-margin-top">\n\t\t\t\t<div class="col-sm-8" *ngIf="showReviewPaymentArea">\n\t\t\t\t\t<div class="alert alert-warning">\n\t\t\t\t\t\t<p>You are about to process a payment of <span class="bold"\n\t\t\t\t\t\t\t\t  *ngIf="isCustomPayment">{{customPayment.toFixed(2) | currency : currency}}</span><span class="bold"\n\t\t\t\t\t\t\t\t  *ngIf="!isCustomPayment">{{getBillingTotal() | currency : currency}}</span>. It can take up to 30 minutes for your payment to\n\t\t\t\t\t\t\tprocess and reflect on your account. To avoid duplicate transactions, do not attempt to process payment more than once.</p>\n\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t<div class="col-sm-6">\n\t\t\t\t\t\t\t\t<button test-id="submitPaymentClick" type="button" class="c4btn block" [disabled]="isSubmitting"\n\t\t\t\t\t\t\t\t\t\t(click)="submitPayment()">Submit Payment</button>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class="col-sm-6">\n\t\t\t\t\t\t\t\t<button test-id="cancelAccountBalancePaymentClickBottom" type="button" class="block c4btn grey"\n\t\t\t\t\t\t\t\t\t\t(click)="showReviewPaymentArea = false">Cancel</button>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t</form>\n\t</div>\n</div>'},L21a:function(t,e){t.exports=""},LG0m:function(t,e){t.exports='<div class="profileimg half-margin-bottom" [ngStyle]="style"></div>'},OUBc:function(t,e){t.exports='<div class="padding">\n\t<h1>Price List Export Tool</h1>\n\t<div class="widget">\n\t\t<div class="padding">\n\t\t\t<div>\n\t\t\t\t<p>This tool exports a complete list of available online store products. The price list includes the SKU, product name, and pricing based on\n\t\t\t\t\tyour selections below.</p>\n\t\t\t\t<div class="row half-margin-bottom">\n\t\t\t\t\t<div class="col-sm-4">\n\t\t\t\t\t\t<h3>Products</h3>\n\t\t\t\t\t\t<label>\n\t\t\t\t\t\t\t<input test-id="includeControl4ProductsCheckbox" type="checkbox" [ngModel]="filter.includeControl4Products"\n\t\t\t\t\t\t\t\t   (ngModelChange)="updateIncludeControl4Products($event)" />{{ brandName$ | async }} </label>\n\t\t\t\t\t\t<label>\n\t\t\t\t\t\t\t<input test-id="includePartnerProductsCheckbox" type="checkbox" [ngModel]="filter.includePartnerProducts"\n\t\t\t\t\t\t\t\t   (ngModelChange)="updateIncludePartnerProducts($event)" />Partner </label>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="col-sm-4">\n\t\t\t\t\t\t<h3>Pricing</h3>\n\t\t\t\t\t\t<label>\n\t\t\t\t\t\t\t<input test-id="includeDealerPricingCheckbox" type="checkbox" [disabled]="!showMsrp" [ngModel]="filter.includeDealerPricing"\n\t\t\t\t\t\t\t\t   (ngModelChange)="updateIncludeDealerPricing($event)" />\n\t\t\t\t\t\t\t<span>{{ isDistributor ? "Distributor" : "Dealer" }} Cost</span>\n\t\t\t\t\t\t</label>\n\t\t\t\t\t\t<label *ngIf="showMsrp">\n\t\t\t\t\t\t\t<input test-id="includeMsrpPricingCheckbox" type="checkbox" [ngModel]="filter.includeMsrpPricing"\n\t\t\t\t\t\t\t\t   (ngModelChange)="updateIncludeMsrp($event)" />\n\t\t\t\t\t\t\t<span>MSRP</span>\n\t\t\t\t\t\t</label>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class="row no-margin" *ngIf="errors?.length">\n\t\t\t\t\t<div class="col-sm-6">\n\t\t\t\t\t\t<div class="alert alert-warning half-margin-bottom">\n\t\t\t\t\t\t\t<div *ngFor="let error of errors">{{error}}</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class="row">\n\t\t\t\t\t<div class="col-sm-3">\n\t\t\t\t\t\t<br><button test-id="downloadXlsClick" class="block" (click)="downloadXls()" [disabled]="!valid" [title]="getHoverErrorText()"\n\t\t\t\t\t\t\t\ttrackCategory="Price List"\n\t\t\t\t\t\t\t\tc4Track="Export" trackLabel="XLS">\n\t\t\t\t\t\t\t<h3 class="text-white">XLS</h3>\n\t\t\t\t\t\t</button>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="col-sm-3">\n\t\t\t\t\t\t<br><button test-id="downloadCsvClick" class="block" (click)="downloadCsv()" [disabled]="!valid" [title]="getHoverErrorText()"\n\t\t\t\t\t\t\t\ttrackCategory="Price List"\n\t\t\t\t\t\t\t\tc4Track="Export" trackLabel="CSV">\n\t\t\t\t\t\t\t<h3 class="text-white">CSV</h3>\n\t\t\t\t\t\t</button>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<br />\n\t\t\t</div>\n\t\t</div>\n\t</div>\n</div>'},QdIW:function(t,e){t.exports=""},Ui1t:function(t,e){t.exports='<div class="padding">\n\t<h1>Orders</h1>\n\t<form class="dark" (ngSubmit)="globalSearch()">\n\t\t<div class="row no-margin">\n\t\t\t<div class="col-md-7">\n\t\t\t\t<mat-form-field>\n\t\t\t\t\t<input test-id="orderSearch" matInput type="text" placeholder="Order Number / PO Search" name="searchText"\n\t\t\t\t\t\t   [ngModel]="filter.searchText" (ngModelChange)="updateSearchFilter($event)">\n\t\t\t\t</mat-form-field>\n\t\t\t</div>\n\t\t\t<div class="col-md-2 col-4">\n\t\t\t\t<mat-form-field>\n\t\t\t\t\t<input test-id="startDateFilter" matInput type="text" placeholder="Start Date" name="startDate" [ngModel]="startDateString"\n\t\t\t\t\t\t   (ngModelChange)="updateStartDate($event)">\n\t\t\t\t</mat-form-field>\n\t\t\t</div>\n\t\t\t<div class="col-md-2 col-4">\n\t\t\t\t<mat-form-field>\n\t\t\t\t\t<input test-id="endDateFilter" matInput type="text" placeholder="End Date" name="endDate" [ngModel]="endDateString"\n\t\t\t\t\t\t   (ngModelChange)="updateEndDate($event)">\n\t\t\t\t</mat-form-field>\n\t\t\t</div>\n\t\t\t<div class="col-md-1 col-4">\n\t\t\t\t<button test-id="searchOrdersClick" type="submit" class="block grey"><i class="fal fa-search"></i></button>\n\t\t\t</div>\n\t\t</div>\n\t</form>\n\t<div class="row">\n\t\t<div class="col-lg-12">\n\t\t\t<div class="widget">\n\t\t\t\t<h3 class="widget-header-white">Order Details</h3>\n\t\t\t\t<div class="padding">\n\t\t\t\t\t<c4-loading *ngIf="!loaded"></c4-loading>\n\t\t\t\t\t<div class="padding light-grey" *ngIf="loaded && viewOrders"> Viewing order<span *ngIf="viewOrders.length > 1">s</span>\n\t\t\t\t\t\t{{ viewOrders.join(\', \') }} <a href="javascript:void" class="pull-right" (click)="clearQueryParams()">view all</a>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="table" *ngIf="loaded">\n\t\t\t\t\t\t<div class="head d-xs-none">\n\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t<div class="col-sm-3">Order</div>\n\t\t\t\t\t\t\t\t<div class="col-sm-2">Date</div>\n\t\t\t\t\t\t\t\t<div class="col-sm-2">Amount</div>\n\t\t\t\t\t\t\t\t<div class="col-sm-5"></div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class="body">\n\t\t\t\t\t\t\t<div class="row" *ngFor="let order of filteredOrders | paging: pagingInfo; index as i">\n\t\t\t\t\t\t\t\t<div class="col-12">\n\t\t\t\t\t\t\t\t\t<div class="row" test-id="ordersRow" attr.test-meta="orderLine-{{i}}" id="order-line-{{order.webOrderId}}">\n\t\t\t\t\t\t\t\t\t\t<div class="col-sm-3">\n\t\t\t\t\t\t\t\t\t\t\t<p class="bold no-margin" attr.test-meta="orderID-{{i}}">Order {{order.webOrderId}}</p>\n\t\t\t\t\t\t\t\t\t\t\t<p class="no-margin" attr.test-meta="orderName-{{i}}"><small>{{order.orderType}} &mdash; {{order.poNumber}}</small>\n\t\t\t\t\t\t\t\t\t\t\t</p>\n\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t\t<div class="col-sm-2" style="padding-top:20px;">\n\t\t\t\t\t\t\t\t\t\t\t<p class="no-margin" attr.test-meta="orderDate-{{i}}">{{order.orderDate | date: \'MMM dd, yyyy\'}}</p>\n\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t\t<div class="col-sm-2" style="padding-top:20px;">\n\t\t\t\t\t\t\t\t\t\t\t<p class="no-margin" attr.test-meta="orderTotal-{{i}}">{{order.total | currency: (currency$ | async)}}</p>\n\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t\t<div class="col-sm-5">\n\t\t\t\t\t\t\t\t\t\t\t<div class="row no-margin">\n\t\t\t\t\t\t\t\t\t\t\t\t<div\n\t\t\t\t\t\t\t\t\t\t\t\t\t [class]="(isNonEmeaInternational$ | async) ? \'col-sm-3 col-12\' : \'col-6\'">\n\t\t\t\t\t\t\t\t\t\t\t\t\t<button test-id="showOrderDetailsClick" [disabled]="!detailsLoaded"\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\tid="order-detail-display-{{order.webOrderId}}"\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t(click)="showOrderDetails(order)"\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\tclass="transparent block no-margin">\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t<i\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t   [ngClass]="[\'fal\', selectedWebOrderId == order.webOrderId ? \'fa-chevron-up\' : \'fa-chevron-down\']"></i>Details\n\t\t\t\t\t\t\t\t\t\t\t\t\t</button>\n\t\t\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t\t\t\t<div\n\t\t\t\t\t\t\t\t\t\t\t\t\t [class]="(isNonEmeaInternational$ | async) ? \'col-sm-4 col-6\' : \'col-6\'">\n\t\t\t\t\t\t\t\t\t\t\t\t\t<a id="order-print-{{order.webOrderId}}" test-id="orderPrint"\n\t\t\t\t\t\t\t\t\t\t\t\t\t   [routerLink]="[\'/print/invoice/\', order.webOrderId]"\n\t\t\t\t\t\t\t\t\t\t\t\t\t   target="_blank"\n\t\t\t\t\t\t\t\t\t\t\t\t\t   class="c4btn block light-grey text-dark no-margin"><i\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t   class="fal fa-print"></i>Order </a>\n\t\t\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t\t\t\t<div class="col-sm-4 col-6" *ngIf="isNonEmeaInternational$ | async">\n\t\t\t\t\t\t\t\t\t\t\t\t\t<a [routerLink]="[\'/print/proforma/\', order.webOrderId]"\n\t\t\t\t\t\t\t\t\t\t\t\t\t   target="_blank"\n\t\t\t\t\t\t\t\t\t\t\t\t\t   class="c4btn block light-grey text-dark no-margin">Proforma</a>\n\t\t\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<div *ngIf="selectedWebOrderId === order.webOrderId">\n\t\t\t\t\t\t\t\t\t\t<c4-loading *ngIf="!selectedWebOrderDetails"></c4-loading>\n\t\t\t\t\t\t\t\t\t\t<div *ngIf="selectedWebOrderDetails" class="padding-left half-margin-top">\n\t\t\t\t\t\t\t\t\t\t\t<div class="table" style="background-color: transparent;">\n\t\t\t\t\t\t\t\t\t\t\t\t<div class="head d-xs-none">\n\t\t\t\t\t\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t<div class="col-sm-4">Item</div>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t<div class="col-sm-3">Warehouse</div>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t<div class="col-sm-2">Status</div>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t<div class="col-sm-1 text-center">Qty</div>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t<div class="col-sm-2 text-right">Price</div>\n\t\t\t\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t\t\t\t<div class="body">\n\t\t\t\t\t\t\t\t\t\t\t\t\t<div class="row"\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t *ngFor="let orderDetail of selectedWebOrderDetails">\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t<div class="col-sm-4">\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<p class="no-margin"><a\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t   routerLink="/product/{{orderDetail.sku}}"\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t   target="_blank">{{orderDetail.productName}}</a>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t</p>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<small class="block">\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<ul class="no-style">\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<li>{{orderDetail.sku}}</li>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t</ul>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<ul class="no-style half-margin-top">\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<li *ngIf="orderDetail.paintManufacturer">Paint Manufacturer:\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t{{orderDetail.paintManufacturer}}</li>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<li *ngIf="orderDetail.paintCode">Paint Code: {{orderDetail.paintCode}}</li>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<li *ngIf="orderDetail.veneerFinish">Veneer Finish: {{orderDetail.veneerFinish}}</li>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<li *ngIf="orderDetail.grillType">Grill Type: {{orderDetail.grillType}}</li>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<li *ngIf="orderDetail.grillPaintCode">Grill Paint Code: {{orderDetail.grillPaintCode}}</li>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<li *ngIf="orderDetail.mountType">Mount Type: {{orderDetail.mountType}}</li>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<li *ngIf="orderDetail.width">Size: {{orderDetail.width}}&quot;</li>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t</ul>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t</small>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t<div class="col-sm-3"> {{orderDetail.warehouse}} </div>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t<div class="col-sm-2"> {{orderDetail.lineStatus}} <small class="block"><a\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t   [href]="orderDetail.trackingUrl"\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t   target="_blank"\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t   title="Track this package">{{orderDetail.trackingNumber}}</a></small>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t<div class="col-sm-1 text-center d-xs-none"> {{orderDetail.quantity}}</div>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t<div class="col-sm-2 text-right">\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<span class="d-block d-sm-none">{{orderDetail.quantity}} x </span>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<del class="block text-red"\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t *ngIf="orderDetail.unitDiscount">{{orderDetail.unitPrice | currency:\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t(currency$ | async)}}</del> {{orderDetail.unitPrice - orderDetail.unitDiscount | currency: (currency$ | async)}} </div>\n\t\t\t\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\