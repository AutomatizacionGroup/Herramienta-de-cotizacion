\t\t[disabled]="!personalEmail.valid || !editableSfInfo.contact.personalEmail || personalEmailInUse">Verify</button>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class="col-12" *ngIf="profileForm.hasError(\'pattern\', \'personalEmail\')">\n\t\t\t\t\t\t\t\t<div class="alert alert-warning no-margin">\n\t\t\t\t\t\t\t\t\t<p>Please enter a valid email address for your home email.</p>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class="row" *ngIf="editableSfInfo.contact">\n\t\t\t\t\t\t\t<div class="col-4">\n\t\t\t\t\t\t\t\t<strong>Mobile</strong>\n\t\t\t\t\t\t\t\t<span *ngIf="editableSfInfo.contact?.mobilePhoneVerified"\n\t\t\t\t\t\t\t\t\t  title="Phone number verified"><i\n\t\t\t\t\t\t\t\t\t   class="fas fa-check-circle text-success"></i></span>\n\t\t\t\t\t\t\t\t<span *ngIf="!editableSfInfo.contact?.mobilePhoneVerified"\n\t\t\t\t\t\t\t\t\t  title="Phone number not yet verified"><i\n\t\t\t\t\t\t\t\t\t   class="fas fa-exclamation-circle text-warning"></i><small>{{ verifyingEmail ? \'Check email\' : \'Not yet verified\' }}</small></span>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class="col-8">\n\t\t\t\t\t\t\t\t<div class="alert alert-warning" *ngIf="numberInUse && !verifyingPhone">\n\t\t\t\t\t\t\t\t\t<p>This number is already associated with another user. If you verify this number, it will be removed from their profile.\n\t\t\t\t\t\t\t\t\t</p>\n\t\t\t\t\t\t\t\t\t<ul class="inline">\n\t\t\t\t\t\t\t\t\t\t<li><button test-id="continuePhoneVerificationClick" type="button"\n\t\t\t\t\t\t\t\t\t\t\t\t\t(click)="beginPhoneVerification()">Continue</button>\n\t\t\t\t\t\t\t\t\t\t</li>\n\t\t\t\t\t\t\t\t\t\t<li><button test-id="retryPhoneVerificationClick" type="button" class="transparent"\n\t\t\t\t\t\t\t\t\t\t\t\t\t(click)="retryPhoneVerification()">Cancel</button></li>\n\t\t\t\t\t\t\t\t\t</ul>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="row no-margin">\n\t\t\t\t\t\t\t\t\t<div class="col-sm-6 col-8">\n\t\t\t\t\t\t\t\t\t\t<mat-form-field class="no-margin">\n\t\t\t\t\t\t\t\t\t\t\t<input test-id="mobilePhone" class="fs-block" matInput type="tel" placeholder="Mobile Phone"\n\t\t\t\t\t\t\t\t\t\t\t\t   [(ngModel)]="editableSfInfo.contact.mobilePhone" name="mobilePhone"\n\t\t\t\t\t\t\t\t\t\t\t\t   #mobilePhone="ngModel" [pattern]="phoneRegex"\n\t\t\t\t\t\t\t\t\t\t\t\t   [disabled]="verifyingPhone" (ngModelChange)="updateVerifications()"\n\t\t\t\t\t\t\t\t\t\t\t\t   (keydown.enter)="beginPhoneVerification()">\n\t\t\t\t\t\t\t\t\t\t</mat-form-field>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<div class="col-sm-6 col-4">\n\t\t\t\t\t\t\t\t\t\t<button test-id="beginPhoneVerificationClick" type="button" class="grey no-margin"\n\t\t\t\t\t\t\t\t\t\t\t\t(click)="beginPhoneVerification()"\n\t\t\t\t\t\t\t\t\t\t\t\t*ngIf="(!editableSfInfo.contact.mobilePhoneVerified || mobilePhone.dirty) && !numberInUse && !verifyingPhone"\n\t\t\t\t\t\t\t\t\t\t\t\t[disabled]="!mobilePhone.valid || !editableSfInfo.contact.mobilePhone">Verify</button>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="alert alert-warning no-margin"\n\t\t\t\t\t\t\t\t\t *ngIf="!verifyingPhone && !mobilePhone.valid && (!editableSfInfo.contact?.mobilePhoneVerified || mobilePhone.dirty)">\n\t\t\t\t\t\t\t\t\t<p>Provide full number beginning with country code.</p>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div *ngIf="verifyingPhone" class="half-margin-top">\n\t\t\t\t\t\t\t\t\t<h4 class="no-margin">Verify Number</h4>\n\t\t\t\t\t\t\t\t\t<p class="no-margin"><small>We sent a message with a verification code to {{editableSfInfo.contact.mobilePhone}}. Please\n\t\t\t\t\t\t\t\t\t\t\tverify this mobile number by providing the verification code in the space below. If you do not receive the code\n\t\t\t\t\t\t\t\t\t\t\twithin a few minutes, please checked the number provided and click resend.</small></p>\n\t\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t\t<div class="col-sm-4">\n\t\t\t\t\t\t\t\t\t\t\t<mat-form-field class="no-margin">\n\t\t\t\t\t\t\t\t\t\t\t\t<input test-id="phoneVerificationCode" class="fs-block" matInput type="text" name="verificationcode"\n\t\t\t\t\t\t\t\t\t\t\t\t\t   class="no-margin" maxlength="6" placeholder="Verification Code"\n\t\t\t\t\t\t\t\t\t\t\t\t\t   [(ngModel)]="phoneVerificationCode" #verificationCode="ngModel"\n\t\t\t\t\t\t\t\t\t\t\t\t\t   [pattern]="verificationCodeRegex"\n\t\t\t\t\t\t\t\t\t\t\t\t\t   (keydown.enter)="confirmPhoneVerification()" />\n\t\t\t\t\t\t\t\t\t\t\t</mat-form-field>\n\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t\t<div class="col-sm-8"\n\t\t\t\t\t\t\t\t\t\t\t *ngIf="(editableSfInfo.contact.mobilePhone && !editableSfInfo.contact.mobilePhoneVerified) || mobilePhone.dirty">\n\t\t\t\t\t\t\t\t\t\t\t<ul class="inline">\n\t\t\t\t\t\t\t\t\t\t\t\t<li><button test-id="confirmPhoneVerificationClick" type="button" class="grey" *ngIf="verifyingPhone"\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t(click)="confirmPhoneVerification()"\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t[disabled]="!phoneVerificationCode || !verificationCode.valid">Confirm</button>\n\t\t\t\t\t\t\t\t\t\t\t\t</li>\n\t\t\t\t\t\t\t\t\t\t\t\t<li><button test-id="sendNewCodeClick" type="button" class="transparent" *ngIf="verifyingPhone"\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t(click)="retryPhoneVerification()">Send New Code</button></li>\n\t\t\t\t\t\t\t\t\t\t\t</ul>\n\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class="row" *ngIf="editableSfInfo.contact">\n\t\t\t\t\t\t\t<div class="col-4">\n\t\t\t\t\t\t\t\t<strong>Communication Preferences</strong>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class="col-8">\n\t\t\t\t\t\t\t\t<div class="table">\n\t\t\t\t\t\t\t\t\t<div class="head">\n\t\t\t\t\t\t\t\t\t\t<div class="row no-margin">\n\t\t\t\t\t\t\t\t\t\t\t<div class="col-2 offset-6 text-center">Work Email</div>\n\t\t\t\t\t\t\t\t\t\t\t<div class="col-2 text-center">Home Email</div>\n\t\t\t\t\t\t\t\t\t\t\t<div class="col-2 text-center">No Email</div>\n\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<div class="body">\n\t\t\t\t\t\t\t\t\t\t<div class="row no-margin">\n\t\t\t\t\t\t\t\t\t\t\t<div class="col-6"> Account <small class="block">Events related to your user account, such as password resets, name\n\t\t\t\t\t\t\t\t\t\t\t\t\tchanges, subscriptions changes, etc.)</small>\n\t\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t\t\t<div class="col-2 text-center">\n\t\t\t\t\t\t\t\t\t\t\t\t<label class="inline">\n\t\t\t\t\t\t\t\t\t\t\t\t\t<input test-id="workEmailCommunicationPreferenceCheckbox" type="checkbox"\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t   [checked]="!!editableUser.email"\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t   disabled>\n\t\t\t\t\t\t\t\t\t\t\t\t</label>\n\t\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t\t\t<div class="col-2 text-center">\n\t\t\t\t\t\t\t\t\t\t\t\t<label class="inline">\n\t\t\t\t\t\t\t\t\t\t\t\t\t<input test-id="personalEmailCommunicationPreferenceCheckbox" type="checkbox"\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t   [checked]="!!editableSfInfo.contact.personalEmail" disabled>\n\t\t\t\t\t\t\t\t\t\t\t\t</label>\n\t\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t\t\t<div class="col-2 text-center">\n\t\t\t\t\t\t\t\t\t\t\t\t<a href="javascript:;" class="text-grey">\n\t\t\t\t\t\t\t\t\t\t\t\t\t<i class="fas fa-question-circle"></i>\n\t\t\t\t\t\t\t\t\t\t\t\t\t<c4-tooltip> You cannot opt out of Account communications. They are required for your user account. We show\n\t\t\t\t\t\t\t\t\t\t\t\t\t\tthis non-optional item to make clear that some communications are necessary for having an account with\n\t\t\t\t\t\t\t\t\t\t\t\t\t\tControl4. </c4-tooltip>\n\t\t\t\t\t\t\t\t\t\t\t\t</a>\n\t\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t\t<div class="row no-margin">\n\t\t\t\t\t\t\t\t\t\t\t<div class="col-6"> Business <small class="block">Dealer newsletters, dealer emails, promotions, product and\n\t\t\t\t\t\t\t\t\t\t\t\t\tservices announcements, press releases.</small>\n\t\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t\t\t<div class="col-2 text-center">\n\t\t\t\t\t\t\t\t\t\t\t\t<label class="inline">\n\t\t\t\t\t\t\t\t\t\t\t\t\t<input test-id="bizCommWorkPreferenceCheckbox" type="checkbox" name="bizCommWork"\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t   [(ngModel)]="editableSfInfo.contact.bizCommWorkEmail">\n\t\t\t\t\t\t\t\t\t\t\t\t</label>\n\t\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t\t\t<div class="col-2 text-center">\n\t\t\t\t\t\t\t\t\t\t\t\t<label class="inline">\n\t\t\t\t\t\t\t\t\t\t\t\t\t<input test-id="bizCommHomePreferenceCheckbox" type="checkbox" name="bizCommHome"\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t   [(ngModel)]="editableSfInfo.contact.bizCommPersonalEmail"\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t   [disabled]="!editableSfInfo.contact.personalEmailVerified">\n\t\t\t\t\t\t\t\t\t\t\t\t</label>\n\t\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t\t\t<div class="col-2 text-center">\n\t\t\t\t\t\t\t\t\t\t\t\t<label class="inline">\n\t\t\t\t\t\t\t\t\t\t\t\t\t<input test-id="bizCommOptoutCheckbox" type="checkbox" name="bizCommOptout"\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t   (click)="toggleBizCommOptout()"\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t   [checked]="!editableSfInfo.contact.bizCommWorkEmail && !editableSfInfo.contact.bizCommPersonalEmail">\n\t\t\t\t\t\t\t\t\t\t\t\t</label>\n\t\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t\t<div class="row no-margin">\n\t\t\t\t\t\t\t\t\t\t\t<div class="col-6"> Technical <small class="block">Education announcements, knowledgebase subscriptions</small>\n\t\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t\t\t<div class="col-2 text-center">\n\t\t\t\t\t\t\t\t\t\t\t\t<label class="inline">\n\t\t\t\t\t\t\t\t\t\t\t\t\t<input test-id="techCommWorkPreferenceCheckbox" type="checkbox" name="techCommWork"\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t   [(ngModel)]="editableSfInfo.contact.techCommWorkEmail">\n\t\t\t\t\t\t\t\t\t\t\t\t</label>\n\t\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t\t\t<div class="col-2 text-center">\n\t\t\t\t\t\t\t\t\t\t\t\t<label class="inline">\n\t\t\t\t\t\t\t\t\t\t\t\t\t<input test-id="techCommHomePreferenceCheckbox" type="checkbox" name="techCommHome"\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t   [(ngModel)]="editableSfInfo.contact.techCommPersonalEmail"\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t   [disabled]="!editableSfInfo.contact.personalEmailVerified">\n\t\t\t\t\t\t\t\t\t\t\t\t</label>\n\t\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t\t\t<div class="col-2 text-center">\n\t\t\t\t\t\t\t\t\t\t\t\t<label class="inline">\n\t\t\t\t\t\t\t\t\t\t\t\t\t<input test-id="techCommOptoutCheckbox" type="checkbox" name="techCommOptout"\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t   (click)="toggleTechCommOptout()"\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t   [checked]="!editableSfInfo.contact.techCommWorkEmail && !editableSfInfo.contact.techCommPersonalEmail">\n\t\t\t\t\t\t\t\t\t\t\t\t</label>\n\t\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t\t<div class="row no-margin">\n\t\t\t\t\t\t\t\t\t\t\t<div class="col-6"> Urgent <small class="block">Service outages and product issues that will affect owners, support\n\t\t\t\t\t\t\t\t\t\t\t\t\tcase updates, and other time-sensitive communications.</small>\n\t\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t\t\t<div class="col-2 text-center">\n\t\t\t\t\t\t\t\t\t\t\t\t<label class="inline">\n\t\t\t\t\t\t\t\t\t\t\t\t\t<input test-id="urgentCommWorkPreferenceCheckbox" type="checkbox" name="urgentCommWork"\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t   [(ngModel)]="editableSfInfo.contact.urgentCommWorkEmail"\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t   (ngModelChange)="enforceUrgentCommPrefs(true, $event)">\n\t\t\t\t\t\t\t\t\t\t\t\t</label>\n\t\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t\t\t<div class="col-2 text-center">\n\t\t\t\t\t\t\t\t\t\t\t\t<label class="inline">\n\t\t\t\t\t\t\t\t\t\t\t\t\t<input test-id="urgentCommHomePreferenceCheckbox" type="checkbox" name="urgentCommHome"\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t   [(ngModel)]="editableSfInfo.contact.urgentCommPersonalEmail"\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t   (ngModelChange)="enforceUrgentCommPrefs(false, $event)"\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t   [disabled]="!editableSfInfo.contact.personalEmailVerified">\n\t\t\t\t\t\t\t\t\t\t\t\t</label>\n\t\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t\t\t<div class="col-2 text-center">\n\t\t\t\t\t\t\t\t\t\t\t\t<a href="javascript:;" class="text-grey">\n\t\t\t\t\t\t\t\t\t\t\t\t\t<i class="fas fa-question-circle"></i>\n\t\t\t\t\t\t\t\t\t\t\t\t\t<c4-tooltip> You must have at least one email address that receives Urgent Issue messages. </c4-tooltip>\n\t\t\t\t\t\t\t\t\t\t\t\t</a>\n\t\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class="row" *ngIf="editableSfInfo.user">\n\t\t\t\t\t\t\t<div class="col-4">\n\t\t\t\t\t\t\t\t<strong>Language</strong>\n\t\t\t\t\t\t\t\t<sup>\n\t\t\t\t\t\t\t\t\t<a href="javascript:;" class="text-grey">\n\t\t\t\t\t\t\t\t\t\t<i class="fas fa-question-circle"></i>\n\t\t\t\t\t\t\t\t\t\t<c4-tooltip> As a global company, Control4 uses English as a primary language. When you select a language other than\n\t\t\t\t\t\t\t\t\t\t\tEnglish, content in that language will display only if it is available. Most content will still default to English.\n\t\t\t\t\t\t\t\t\t\t</c4-tooltip>\n\t\t\t\t\t\t\t\t\t</a>\n\t\t\t\t\t\t\t\t</sup>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class="col-8 col-sm-4">\n\t\t\t\t\t\t\t\t<select test-id="preferredLanguage" [(ngModel)]="selectedLanguage" [ngModelOptions]="{standalone: true}">\n\t\t\t\t\t\t\t\t\t<option disabled="disabled" [ngValue]="null">Select Preferred Language</option>\n\t\t\t\t\t\t\t\t\t<option *ngFor="let lang of languages" [ngValue]="lang">{{lang.name}}</option>\n\t\t\t\t\t\t\t\t</select>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class="alert alert-warning"\n\t\t\t\t\t\t\t *ngIf="loaded && (!editableSfInfo.user || !editableSfInfo.contact)">\n\t\t\t\t\t\t\t<p>There was a problem loading a portion of your profile. Please contact <a *ngIf="(useWebhelpEmail$ | async)"\n\t\t\t\t\t\t\t\t   href="mailto:webhelp@control4.com">webhelp@control4.com</a>\n\t\t\t\t\t\t\t\t<a *ngIf="!(useWebhelpEmail$ | async)" href="mailto:onlineordering@control4.com">onlineordering@control4.com</a> for assistance.\n\t\t\t\t\t\t\t</p>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t\t<div class="alert alert-warning" *ngIf="mobileNumberDirty || workEmailDirty || homeEmailDirty">\n\t\t\t\t<p>Email and phone number fields will not be saved until they are verified.</p>\n\t\t\t</div>\n\t\t\t<button test-id="saveUserClick" class="no-margin" type="submit"\n\t\t\t\t\t[disabled]="!profileForm?.valid || workEmailInUse || personalEmailInUse || saving"\n\t\t\t\t\t*ngIf="editableSfInfo.contact || editableSfInfo.user"><i class="fal fa-check"></i>Save</button>\n\t\t\t<button test-id="cancelUserProfileEditClick" type="button" class="no-margin"\n\t\t\t\t\t[ngClass]="{ \'transparent\': editableSfInfo.contact || editableSfInfo.user }" (click)="cancel()"\n\t\t\t\t\t[disabled]="saving"><i class="fal fa-times"></i>Cancel</button>\n\t\t</div>\n\t</div>\n</form>'},"nk8+":function(t,e){t.exports=".lux-row {\n  margin-top: 12px;\n  margin-bottom: 10px;\n}\n.lux-row .col-12 .lux-label {\n  display: block;\n  font-weight: 700;\n  color: #222;\n  font-size: 13px;\n  margin-bottom: 4px;\n}\n.lux-row .col-12 .lux-value {\n  font-size: 13px;\n  color: #333;\n  line-height: 1.5;\n}\n.lux-row .col-12 .lux-value .lux-free {\n  font-weight: 400;\n  color: #000;\n}\n.lux-row .col-12 .lux-value .standard-pricing {\n  color: #333;\n}\n.lux-row .col-12 .lux-value .learn-link {\n  margin-left: 4px;\n  color: #c43b3b;\n  text-decoration: underline;\n  font-weight: 600;\n  font-size: 12.5px;\n}\n.lux-row .col-12 .lux-value .learn-link:hover {\n  color: #9d2f2f;\n}\n.lux-row .col-12 .lux-value .learn-suffix {\n  margin-left: 4px;\n  color: #666;\n  font-size: 12.5px;\n}"},oaRm:function(t,e){t.exports='<div class="widget">\n\t<h3 class="widget-header-grey">Edit Dealer</h3>\n\t<div class="absolute top block text-right">\n\t\t<button test-id="cancelSubdealerEditClick" class="transparent " (click)="cancel()">Cancel</button>\n\t</div>\n\t<div class="padding">\n\t\t<form name="editSubDealerForm" #editSubDealerForm="ngForm" (ngSubmit)="save()">\n\t\t\t<h3>Dealer</h3>\n\t\t\t<div class="row">\n\t\t\t\t<div class="col-sm-6">\n\t\t\t\t\t<mat-form-field>\n\t\t\t\t\t\t<input test-id="company" matInput type="text" placeholder="Dealer Name" [(ngModel)]="subdealer.company"\n\t\t\t\t\t\t\t   name="company" required>\n\t\t\t\t\t</mat-form-field>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t\t<div class="row">\n\t\t\t\t<div *ngIf="!(isMergedLoyaltyProgram$ | async)" class="col-sm-6">\n\t\t\t\t\t<select test-id="dealerStatus" [(ngModel)]="subdealer.dealerStatus" name="dealerStatus" required>\n\t\t\t\t\t\t<option [value]="undefined" disabled>Status</option>\n\t\t\t\t\t\t<option value="4 None">Authorized</option>\n\t\t\t\t\t\t<option value="2 Gold">Gold</option>\n\t\t\t\t\t\t<option value="1 Platinum">Platinum</option>\n\t\t\t\t\t\t<option value="0 Diamond">Diamond</option>\n\t\t\t\t\t</select>\n\t\t\t\t</div>\n\t\t\t\t<div *ngIf="(isMergedLoyaltyProgram$ | async)" class="col-sm-6">\n\t\t\t\t\t<select test-id="dealerStatus" [(ngModel)]="subdealer.dealerStatus" name="dealerStatus" required>\n\t\t\t\t\t\t<option [value]="undefined" disabled>Status</option>\n\t\t\t\t\t\t<option value="Partner">Partner</option>\n\t\t\t\t\t\t<option value="Bronze">Bronze</option>\n\t\t\t\t\t\t<option value="Silver">Silver</option>\n\t\t\t\t\t\t<option value="Gold">Gold</option>\n\t\t\t\t\t\t<option value="Platinum">Platinum</option>\n\t\t\t\t\t\t<option value="Diamond">Diamond</option>\n\t\t\t\t\t</select>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t\t<h3>Contact</h3>\n\t\t\t<div class="row">\n\t\t\t\t<div class="col-sm-6">\n\t\t\t\t\t<mat-form-field class="fs-block">\n\t\t\t\t\t\t<input test-id="email" matInput type="email" placeholder="Email" [(ngModel)]="subdealer.email" name="email"\n\t\t\t\t\t\t\t   required>\n\t\t\t\t\t</mat-form-field>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t\t<div class="row">\n\t\t\t\t<div class="col-sm-6">\n\t\t\t\t\t<mat-form-field class="fs-block">\n\t\t\t\t\t\t<input test-id="phone" matInput type="text" placeholder="Phone" [(ngModel)]="subdealer.phone" name="phone">\n\t\t\t\t\t</mat-form-field>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t\t<div class="row">\n\t\t\t\t<div class="col-sm-6">\n\t\t\t\t\t<mat-form-field>\n\t\t\t\t\t\t<input test-id="website" matInput type="text" placeholder="Website" [(ngModel)]="subdealer.website"\n\t\t\t\t\t\t\t   name="website">\n\t\t\t\t\t</mat-form-field>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t\t<h3>Address</h3>\n\t\t\t<div class="row">\n\t\t\t\t<div class="col-sm-6">\n\t\t\t\t\t<mat-form-field class="fs-block">\n\t\t\t\t\t\t<input test-id="address" type="text" matInput placeholder="Address" [(ngModel)]="subdealer.address"\n\t\t\t\t\t\t\t   name="address">\n\t\t\t\t\t</mat-form-field>\n\t\t\t\t</div>\n\t\t\t\t<div class="col-sm-3">\n\t\t\t\t\t<mat-form-field class="fs-block">\n\t\t\t\t\t\t<input test-id="address2" matInput type="text" placeholder="Suite/Room" [(ngModel)]="subdealer.address2"\n\t\t\t\t\t\t\t   name="address2">\n\t\t\t\t\t</mat-form-field>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t\t<div class="row">\n\t\t\t\t<div class="col-sm-6">\n\t\t\t\t\t<mat-form-field class="fs-block">\n\t\t\t\t\t\t<input test-id="city" matInput type="text" placeholder="City" [(ngModel)]="subdealer.city" name="city">\n\t\t\t\t\t</mat-form-field>\n\t\t\t\t</div>\n\t\t\t\t<div class="col-sm-3">\n\t\t\t\t\t<mat-form-field class="fs-block">\n\t\t\t\t\t\t<input test-id="state" matInput type="text" placeholder="State/Province" [(ngModel)]="subdealer.state"\n\t\t\t\t\t\t\t   name="state">\n\t\t\t\t\t</mat-form-field>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t\t<div class="row">\n\t\t\t\t<div class="col-sm-3">\n\t\t\t\t\t<mat-form-field class="fs-block">\n\t\t\t\t\t\t<input test-id="postalCode" matInput type="text" placeholder="Postal Code" [(ngModel)]="subdealer.zip" name="zip">\n\t\t\t\t\t</mat-form-field>\n\t\t\t\t</div>\n\t\t\t\t<div class="col-sm-6" class="fs-block">\n\t\t\t\t\t<select test-id="country" [(ngModel)]="subdealer.country" name="countryCode">\n\t\t\t\t\t\t<option [value]="undefined" disabled>Country</option>\n\t\t\t\t\t\t<option *ngFor="let country of countryCodes$ | async" [value]="country.countryAbbr"> {{ country.countryName }}</option>\n\t\t\t\t\t</select>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t\t<div class="row half-padding-bottom">\n\t\t\t\t<div class="col-sm-6">\n\t\t\t\t\t<h4>Verify Address</h4>\n\t\t\t\t\t<p><small>To ensure this dealer is discoverable using the dealer locator, please verify that the address above geolocates properly using the\n\t\t\t\t\t\t\tmap generated here.</small></p>\n\t\t\t\t\t<p><small>If it does not geolocate, please edit the address above or provide the specific latitude and longitude coordinates.</small></p>\n\t\t\t\t\t<div *ngIf="showLatLong">\n\t\t\t\t\t\t<mat-form-field>\n\t\t\t\t\t\t\t<input test-id="latitude" matInput type="text" placeholder="Latitude" [(ngModel)]="subdealer.latitude"\n\t\t\t\t\t\t\t\t   name="latitude">\n\t\t\t\t\t\t</mat-form-field>\n\t\t\t\t\t\t<mat-form-field>\n\t\t\t\t\t\t\t<input test-id="longitude" matInput type="text" placeholder="Longitude" [(ngModel)]="subdealer.longitude"\n\t\t\t\t\t\t\t\t   name="longitude">\n\t\t\t\t\t\t</mat-form-field>\n\t\t\t\t\t</div>\n\t\t\t\t\t<button test-id="verifyAddressClick" type="button" (click)="verifyAddress()" class="grey"><i\n\t\t\t\t\t\t   class="fal fa-map-marker"></i>{{verifyAddressButtonText()}}</button>\n\t\t\t\t\t<label class="half-margin-top" *ngIf="addressVerified">\n\t\t\t\t\t\t<input test-id="publishedCheckbox" type="checkbox" [(ngModel)]="subdealer.published" name="published" /> Visible on dealer locator\n\t\t\t\t\t</label>\n\t\t\t\t</div>\n\t\t\t\t<div class="col-sm-6">\n\t\t\t\t\t<agm-map *ngIf="addressVerified" style="height: 400px" [longitude]="subdealer.longitude"\n\t\t\t\t\t\t\t [latitude]="subdealer.latitude" [scrollwheel]="false" [zoom]="16">\n\t\t\t\t\t\t<agm-marker [longitude]="subdealer.longitude" [latitude]="subdealer.latitude"></agm-marker>\n\t\t\t\t\t</agm-map>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t\t<button test-id="submitSubdealerClick" type="submit" [disabled]="!addressVerified || saving || !editSubDealerForm.valid">Save</button>\n\t\t\t<button test-id="cancelSubdealerEditClickBottom" type="button" class="white" (click)="cancel()">Cancel</button>\n\t\t</form>\n\t</div>\n</div>\n'},piwC:function(t,e){t.exports='<div class="padding">\n\t<h1>Balance And Payments</h1>\n\t<div class="row">\n\t\t<div class="col-md-8">\n\t\t\t<c4-account-balance-payment [selectedInvoices]="selectedInvoices" [isCustomPayment]="isCustomPayment"\n\t\t\t\t\t\t\t\t\t\t(display)="showPayment = $event" *ngIf="showPayment && (areInvoicesPayable$ | async)">\n\t\t\t</c4-account-balance-payment>\n\t\t\t<div id="invoicetable" class="widget" *ngIf="!showPayment">\n\t\t\t\t<h3 class="widget-header-white">Invoices and Credits</h3>\n\t\t\t\t<c4-loading *ngIf="loading"></c4-loading>\n\t\t\t\t<div class="padding" *ngIf="!loading">\n\t\t\t\t\t<div class="row half-margin-bottom" *ngIf="areInvoicesPayable$ | async">\n\t\t\t\t\t\t<ng-container>\n\t\t\t\t\t\t\t<div class="col-sm-6">\n\t\t\t\t\t\t\t\t<button test-id="paySelectedInvoicesClick" type="button" class="grey block" (click)="setupPayments()">Pay Selected\n\t\t\t\t\t\t\t\t\tInvoices</button>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class="col-sm-6">\n\t\t\t\t\t\t\t\t<button test-id="paymentOnAccountClick" type="button" class="grey block" (click)="setupPayments(true)">Payment On\n\t\t\t\t\t\t\t\t\tAccount</button>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</ng-container>\n\t\t\t\t\t\t<div class="col-sm-12">\n\t\t\t\t\t\t\t<p><small>Select specific invoices you would like to pay and then click on "Pay Selected Invoices" or pay down your account balance\n\t\t\t\t\t\t\t\t\twith "Payment On Account". If you would like to apply a credit on your account to an unpaid invoice, please contact the <a\n\t\t\t\t\t\t\t\t\t   href="mailto:CreditDepartment@snapav.com">Accounting Team</a>.</small></p>\n\t\t\t\t\t\t\t<p *ngIf="isTriad$ | async"><small> *Triad Speakers historical sales data is not available prior to the introduction of online\n\t\t\t\t\t\t\t\t\tsales.</small></p>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="row half-margin-bottom" *ngIf="areInvoicesPayable$ | async">\n\t\t\t\t\t\t<div class="col-md-6">\n\t\t\t\t\t\t\t<label><input test-id="showOnlyPayableInvoicesCheckbox" type="checkbox" [(ngModel)]="showUnpaidInvoices">Only show online payable\n\t\t\t\t\t\t\t\tinvoices</label>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="table">\n\t\t\t\t\t\t<div class="head">\n\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t<div class="col-lg-1" *ngIf="areInvoicesPayable$ | async">\n\t\t\t\t\t\t\t\t\t<label title="Select all unpaid invoices"><input test-id="allUnpaidInvoicesCheckbox" type="checkbox"\n\t\t\t\t\t\t\t\t\t\t\t   [ngModel]="selectAll" (ngModelChange)="toggleAll($event)"><span\n\t\t\t\t\t\t\t\t\t\t\t  class="d-lg-none">Select all unpaid invoices</span></label>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="col-lg-11 visible-lg">\n\t\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t\t<div class="col-sm-3">Invoice</div>\n\t\t\t\t\t\t\t\t\t\t<div class="col-sm-4">PO Reference</div>\n\t\t\t\t\t\t\t\t\t\t<div class="col-sm-3">Due</div>\n\t\t\t\t\t\t\t\t\t\t<div class="col-sm-2 text-right">Amount</div>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class="body">\n\t\t\t\t\t\t\t<ng-container *ngFor="let invoice of balanceItems; index as i">\n\t\t\t\t\t\t\t\t<div attr.test-id="invoiceRow" attr.test-meta="id:{{invoice.customerReference || invoice.lineMemo}}" class="row"\n\t\t\t\t\t\t\t\t\t id="invoice-{{invoice.customerReference || invoice.lineMemo}}"\n\t\t\t\t\t\t\t\t\t *ngIf="isSelectable(invoice) || !showUnpaidInvoices">\n\t\t\t\t\t\t\t\t\t<div class="col-sm-1 col-2" *ngIf="areInvoicesPayable$ | async">\n\t\t\t\t\t\t\t\t\t\t<label *ngIf="isSelectable(invoice)" title="Select this invoice"><input\n\t\t\t\t\t\t\t\t\t\t\t\t   [(ngModel)]="invoice.isSelected" attr.test-meta="selectInvoiceCheckbox-{{i}}" type="checkbox"></label>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<div class="col-sm-11 col-10">\n\t\t\t\t\t\t\t\t\t\t<div class="row" attr.test-meta="invoiceData-{{i}}">\n\t\t\t\t\t\t\t\t\t\t\t<div class="col-lg-3 col-sm-4" attr.test-meta="invoiceID-{{i}}"><span class="bold"\n\t\t\t\t\t\t\t\t\t\t\t\t\t  [class.text-success]="(invoice.transactionType == \'Payment\' || invoice.transactionType == \'Credit\')"\n\t\t\t\t\t\t\t\t\t\t\t\t\t  [class.text-danger]="(isSelectable(invoice))">{{invoice.referenceNumber}}</span>\n\t\t\t\t\t\t\t\t\t\t\t\t&nbsp;<small>{{invoice.transactionType}}</small></div>\n\t\t\t\t\t\t\t\t\t\t\t<div class="col-lg-4 col-sm-8" attr.test-meta="invoiceReference-{{i}}"> {{invoice.customerReference ||\n\t\t\t\t\t\t\t\t\t\t\t\tinvoice.lineMemo}} </div>\n\t\t\t\t\t\t\t\t\t\t\t<div class="col-lg-3 col-6" attr.test-meta="invoiceDueDate-{{i}}">{{invoice.dueDate | date: \'MMM dd, yyyy\'}} </div>\n\t\t\t\t\t\t\t\t\t\t\t<div class="col-lg-2 col-6 text-right" attr.test-meta="invoiceAmount-{{i}}"> {{invoice.amount |\n\t\t\t\t\t\t\t\t\t\t\t\taccounting:invoice.currency}}</div>\n\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</ng-container>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t</div>\n\t\t<div *ngIf="!loading" class="col-md-4">\n\t\t\t<div>\n\t\t\t\t<c4-account-balance-widget [hideFlyout]="true"></c4-account-balance-widget>\n\t\t\t</div>\n\t\t</div>\n\t</div>\n</div>'},qemW:function(t,e){t.exports='<div class="padding">\n\t<h1>Microsite</h1>\n\t<div class="widget padding">\n\t\t<h2>Customize your<br>\n\t\t\t<span class="bold">dealer microsite</span></h2>\n\t\t<p>The Control4 microsites have been completely redesigned to provide customers with more information about your\n\t\t\tbusiness and the projects you work on. This new design looks great on a mobile device, desktop, or even a\n\t\t\ttablet and puts your company front and center, highlighting your showroom, past and current projects, and\n\t\t\tmembers of your team. To get the most benefit from this tool, we recommend you thoroughly update your\n\t\t\tmicrosite to accurately represent your company and the services you provide. Where possible, add project\n\t\t\tpictures and team pictures to demonstrate your experience and quality work.</p>\n\t\t<c4-microsite-list [editMode]="true"></c4-microsite-list>\n\t</div>\n</div>'},rJIr:function(t,e){t.exports='<div class="padding">\n\t<h1>User Management</h1>\n\t<div class="row" *ngIf="!displayEdit">\n\t\t<div class="col-sm-8">\n\t\t\t<form class="dark no-margin" (ngSubmit)="search()">\n\t\t\t\t<div class="row no-margin">\n\t\t\t\t\t<div [className]="canGlobalSearch ? \'col-7\' : \'col-10\'">\n\t\t\t\t\t\t<mat-form-field style="width: 100%;">\n\t\t\t\t\t\t\t<input test-id="searchUsername" matInput [(ngModel)]="searchUsername" class="no-margin" name="searchUsername"\n\t\t\t\t\t\t\t\t   placeholder="Search by username, email, or technician ID">\n\t\t\t\t\t\t</mat-form-field>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="col-3" *ngIf="canGlobalSearch">\n\t\t\t\t\t\t<div class="placeholder-wrapper">\n\t\t\t\t\t\t\t<div class="placeholder-text">Dealer ID</div>\n\t\t\t\t\t\t\t<mat-form-field>\n\t\t\t\t\t\t\t\t<input test-id="dealerId" matInput type="text" placeholder="Dealer ID" class="no-margin"\n\t\t\t\t\t\t\t\t\t   name="searchDealerId" [(ngModel)]="searchDealerId">\n\t\t\t\t\t\t\t</mat-form-field>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="col-2">\n\t\t\t\t\t\t<button test-id="searchUserClick" type="submit" class="block grey no-margin" [disabled]="searching"><i\n\t\t\t\t\t\t\t   class="fal fa-search"></i></button>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</form>\n\t\t</div>\n\t\t<div class="col-sm-2">\n\t\t\t<button test-id="beginEditNewUserClick" class="block" (click)="beginEditNewUser()"><i class="fal fa-plus"></i>New User</button>\n\t\t</div>\n\t\t<div class="col-sm-2">\n\t\t\t<button test-id="exportUsersClick" class="light-grey no-margin block" (click)="exportUsers()" [disabled]="canGlobalSearch"><i\n\t\t\t\t   class="fal fa-arrow-to-bottom"></i>Export Users</button>\n\t\t</div>\n\t</div>\n\t<c4-user-edit *ngIf="displayEdit" (saved)="handleUpdate($event)" (removed)="handleUpdate()" [user]="editUser">\n\t</c4-user-edit>\n\t<div class="widget" *ngIf="!displayEdit">\n\t\t<div class="padding">\n\t\t\t<div *ngIf="!users">\n\t\t\t\t<p class="no-margin"><small>Please search for users above.</small></p>\n\t\t\t</div>\n\t\t\t<div class="table table-hover" *ngIf="users">\n\t\t\t\t<div class="head d-xs-none">\n\t\t\t\t\t<div class="row half-padding" style="padding-bottom: 0; padding-top: 0;">\n\t\t\t\t\t\t<div class="col-md-3 col-sm-2">Name</div>\n\t\t\t\t\t\t<div class="col-md-3 col-sm-4">Username</div>\n\t\t\t\t\t\t<div class="col-md-3 col-sm-4" *ngIf="!canGlobalSearch && !(isDistributor$ | async)">Email</div>\n\t\t\t\t\t\t<div class="col-md-3 col-sm-4" *ngIf="canGlobalSearch || (isDistributor$ | async)">Dealer</div>\n\t\t\t\t\t\t<div class="col-md-1 col-sm-2" *ngIf="hasImpersonation$ | async">Status</div>\n\t\t\t\t\t\t<div class="col-md-1 col-sm-2" *ngIf="!(hasImpersonation$ | async)">Technician ID</div>\n\t\t\t\t\t\t<div class="col-md-2">\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class="body">\n\t\t\t\t\t<div class="row half-padding" style="padding-bottom: 0; padding-top: 0;" id="user-{{user.userId}}" *ngFor="let user of users; index as i"\n\t\t\t\t\t\t [class.text-grey]="!user.isActive" (click)="beginEditUser(user)">\n\t\t\t\t\t\t<div class="col-md-3 col-sm-2 col-6 fs-block">{{user | fullname }}</div>\n\t\t\t\t\t\t<div class="col-md-3 col-sm-4 d-xs-none"\n\t\t\t\t\t\t\t style="text-overflow: ellipsis; overflow: hidden;">{{user.loginName}}</div>\n\t\t\t\t\t\t<div class="col-md-3 col-sm-4 d-xs-none fs-block"\n\t\t\t\t\t\t\t style="text-overflow: ellipsis; overflow: hidden;"\n\t\t\t\t\t\t\t *ngIf="!canGlobalSearch && !(isDistributor$ | async)">{{user.email}}</div>\n\t\t\t\t\t\t<div class="col-md-3 col-sm-4 d-xs-none"\n\t\t\t\t\t\t\t *ngIf="canGlobalSearch || (isDistributor$ | async)"> {{user.subDealerId || user.parentAccountId || user.accountId}} </div>\n\t\t\t\t\t\t<div class="col-md-1 col-sm-2 col-6" *ngIf="hasImpersonation$ | async">\n\t\t\t\t\t\t\t<span *ngIf="user.isActive"><i class="fal fa-check"></i>Active</span>\n\t\t\t\t\t\t\t<span *ngIf="!user.isActive"><i class="fal fa-times"></i>Inactive</span>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class="col-md-1 col-sm-2 col-6" *ngIf="!(hasImpersonation$ | async)"> {{ user.technicianId }} </div>\n\t\t\t\t\t\t<div class="col-md-2 col-12">\n\t\t\t\t\t\t\t<button attr.test-id="editUserClick-{{i}}" class="outline dark block" id="user-edit-{{user.userId}}"><i\n\t\t\t\t\t\t\t\t   class="fal fa-pen-alt"></i>Edit</button>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class="pagination" *ngIf="pagingInfo.total">\n\t\t\t\t\t<c4-pager [info]="pagingInfo" (infoChange)="updatePage($event)"></c4-pager>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t</div>\n\t</div>\n</div>\n'},s09I:function(t,e){t.exports="label.checkbox-label input[type=checkbox] {\n  position: relative;\n  vertical-align: middle;\n  bottom: 1px;\n}"},s0o5:function(t,e){t.exports='<div class="padding">\n\t<div class="widget padding">\n\t\t<c4-loading *ngIf="!loaded"></c4-loading>\n\t\t<div class="row" *ngIf="loaded && !editing">\n\t\t\t<div class="col-lg-2 col-sm-4 col-12 margin-bottom half-padding-right">\n\t\t\t\t<c4-profile-img class="fs-block" [src]="sfInfo.user?.avatarUrl"></c4-profile-img>\n\t\t\t</div>\n\t\t\t<div class="col-lg-10 col-sm-8 col-12">\n\t\t\t\t<button test-id="editUserClick" type="button" class="light-grey absolute right top" (click)="beginEdit()"><i\n\t\t\t\t\t   class="fal fa-pen-alt"></i>Edit</button>\n\t\t\t\t<h1 class="half-margin-top no-margin fs-block" style="margin-right:100px;">{{user | fullname}}</h1>\n\t\t\t\t<p class="text-grey">\n\t\t\t\t\t<span *ngIf="user.jobTitle">{{user.jobTitle}}</span>\n\t\t\t\t\t<span *ngIf="!user.jobTitle"><small>Job title not set.</small></span>\n\t\t\t\t\t<sup>\n\t\t\t\t\t\t<a href="javascript:;" class="text-grey">\n\t\t\t\t\t\t\t<i class="fal fa-question-circle"></i>\n\t\t\t\t\t\t\t<c4-tooltip class="bottom"> Job title displayed here can be edited from User Management by a user who has the "User Management"\n\t\t\t\t\t\t\t\trole. </c4-tooltip>\n\t\t\t\t\t\t</a>\n\t\t\t\t\t</sup>\n\t\t\t\t</p>\n\t\t\t\t<div>\n\t\t\t\t\t<p><button test-id="changePasswordClick" type="button" class="grey" *ngIf="!displayPasswordReset"\n\t\t\t\t\t\t\t\t(click)="displayPasswordReset = true">Change Password</button></p>\n\t\t\t\t\t<c4-change-password (display)="displayPasswordReset = $event" *ngIf="displayPasswordReset">\n\t\t\t\t\t</c4-change-password>\n\t\t\t\t</div>\n\t\t\t\t<div class="table" *ngIf="!displayPasswordReset">\n\t\t\t\t\t<div class="body">\n\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t<div class="col-4">\n\t\t\t\t\t\t\t\t<strong>Username</strong>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class="col-8">\n\t\t\t\t\t\t\t\t<span class="fs-block" test-id="loginName" *ngIf="user.loginName">{{user.loginName}}</span>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t<div class="col-4">\n\t\t\t\t\t\t\t\t<strong>Work Email</strong>\n\t\t\t\t\t\t\t\t<span *ngIf="user.workEmailVerified" title="Work email verified"><i\n\t\t\t\t\t\t\t\t\t   class="fas fa-fw fa-check-circle text-success"></i></span>\n\t\t\t\t\t\t\t\t<span *ngIf="!user.workEmailVerified" title="Work email not yet verified"><i\n\t\t\t\t\t\t\t\t\t   class="fas fa-fw fa-exclamation-circle text-warning"></i><small>Not yet verified</small></span>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class="col-8">\n\t\t\t\t\t\t\t\t<span class="fs-block" test-id="userEmail" *ngIf="user.email">{{user.email}}</span>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t<div class="col-4">\n\t\t\t\t\t\t\t\t<strong>Home Email</strong>\n\t\t\t\t\t\t\t\t<span *ngIf="sfInfo.contact?.personalEmailVerified" title="Home email verified"><i\n\t\t\t\t\t\t\t\t\t   class="fas fa-fw fa-check-circle text-success"></i></span>\n\t\t\t\t\t\t\t\t<span *ngIf="!sfInfo.contact?.personalEmailVerified"\n\t\t\t\t\t\t\t\t\t  title="Home email not yet verified"><i\n\t\t\t\t\t\t\t\t\t   class="fas fa-fw fa-exclamation-circle text-warning"></i><small>Not yet verified</small></span>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class="col-8">\n\t\t\t\t\t\t\t\t<span class="fs-block" test-id="personalEmail"\n\t\t\t\t\t\t\t\t\t  *ngIf="sfInfo.contact?.personalEmail">{{sfInfo.contact.personalEmail}}</span>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t<div class="col-4">\n\t\t\t\t\t\t\t\t<strong>Mobile</strong>\n\t\t\t\t\t\t\t\t<span *ngIf="sfInfo.contact?.mobilePhoneVerified" title="Phone number verified"><i\n\t\t\t\t\t\t\t\t\t   class="fas fa-fw fa-check-circle text-success"></i></span>\n\t\t\t\t\t\t\t\t<span *ngIf="!sfInfo.contact?.mobilePhoneVerified"\n\t\t\t\t\t\t\t\t\t  title="Phone number not yet verified"><i\n\t\t\t\t\t\t\t\t\t   class="fas fa-fw fa-exclamation-circle text-warning"></i><small>Not yet verified</small></span>\n\t\t\t\t\t\t\t\t<p *ngIf="!user.mobilePhoneVerified"><small>Edit your profile to verify your mobile number.</small></p>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class="col-8">\n\t\t\t\t\t\t\t\t<p class="no-margin fs-block" test-id="mobilePhone"> {{sfInfo.contact?.mobilePhone || \'Add your mobile number (for Technical\n\t\t\t\t\t\t\t\t\tSupport)\'}} </p>\n\t\t\t\t\t\t\t\t<small><a class="text-grey" href="javascript:void(0);"\n\t\t\t\t\t\t\t\t\t   (click)="openMobilePhoneUseInfoPopup()">What does Control4 do with this information?</a></small>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t<div class="col-4">\n\t\t\t\t\t\t\t\t<strong>Communication Preferences</strong>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class="col-8">\n\t\t\t\t\t\t\t\t<ul class="no-style">\n\t\t\t\t\t\t\t\t\t<li><i class="fas fa-fw"\n\t\t\t\t\t\t\t\t\t\t   [ngClass]="user.email && sfInfo.contact?.personalEmail ? \'fa-check-circle text-success\' : \'fa-exclamation-circle text-warning\'"></i>\n\t\t\t\t\t\t\t\t\t\tAccount <small *ngIf="user.email">Work email</small>\n\t\t\t\t\t\t\t\t\t\t<small *ngIf="sfInfo.contact?.personalEmail"><span *ngIf="user.email">, </span>Home email</small>\n\t\t\t\t\t\t\t\t\t</li>\n\t\t\t\t\t\t\t\t\t<li><i class="fas fa-fw"\n\t\t\t\t\t\t\t\t\t\t   [ngClass]="sfInfo.contact?.bizCommWorkEmail || sfInfo.contact?.bizCommPersonalEmail ? \'fa-check-circle text-success\' : \'fa-times-circle text-grey\'"></i>\n\t\t\t\t\t\t\t\t\t\tBusiness <small *ngIf="sfInfo.contact?.bizCommWorkEmail">Work email</small>\n\t\t\t\t\t\t\t\t\t\t<small *ngIf="sfInfo.contact?.bizCommPersonalEmail"><span\n\t\t\t\t\t\t\t\t\t\t\t\t  *ngIf="sfInfo.contact?.bizCommWorkEmail">, </span>Home email</small>\n\t\t\t\t\t\t\t\t\t</li>\n\t\t\t\t\t\t\t\t\t<li><i class="fas fa-fw"\n\t\t\t\t\t\t\t\t\t\t   [ngClass]="sfInfo.contact?.techCommWorkEmail || sfInfo.contact?.techCommPersonalEmail ? \'fa-check-circle text-success\' : \'fa-times-circle text-grey\'"></i>\n\t\t\t\t\t\t\t\t\t\tTechnical <small *ngIf="sfInfo.contact?.techCommWorkEmail">Work email</small>\n\t\t\t\t\t\t\t\t\t\t<small *ngIf="sfInfo.contact?.techCommPersonalEmail"><span\n\t\t\t\t\t\t\t\t\t\t\t\t  *ngIf="sfInfo.contact?.techCommWorkEmail">, </span>Home email</small>\n\t\t\t\t\t\t\t\t\t</li>\n\t\t\t\t\t\t\t\t\t<li><i class="fas fa-fw"\n\t\t\t\t\t\t\t\t\t\t   [ngClass]="sfInfo.contact?.urgentCommWorkEmail || sfInfo.contact?.urgentCommPersonalEmail ? \'fa-check-circle text-success\' : \'fa-times-circle text-grey\'"></i>\n\t\t\t\t\t\t\t\t\t\tUrgent <small *ngIf="sfInfo.contact?.urgentCommWorkEmail">Work email</small>\n\t\t\t\t\t\t\t\t\t\t<small *ngIf="sfInfo.contact?.urgentCommPersonalEmail"><span\n\t\t\t\t\t\t\t\t\t\t\t\t  *ngIf="sfInfo.contact?.urgentCommWorkEmail">, </span>Home email</small>\n\t\t\t\t\t\t\t\t\t</li>\n\t\t\t\t\t\t\t\t</ul>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<ng-container>\n\t\t\t\t\t\t\t<div class="row" *ngIf="isApCertified || (isControl4 | async)">\n\t\t\t\t\t\t\t\t<div class="col-4">\n\t\t\t\t\t\t\t\t\t<strong>Support</strong>\n\t\t\t\t\t\t\t\t\t<span>\n\t\t\t\t\t\t\t\t\t\t<i class="fas fa-check-circle text-success"></i>\n\t\t\t\t\t\t\t\t\t</span>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="col-8">\n\t\t\t\t\t\t\t\t\t<span>\n\t\t\t\t\t\t\t\t\t\t<p>You are Automation Programmer certified. You are authorized to use Control4 Support via phone <span class="nobr">and\n\t\t\t\t\t\t\t\t\t\t\t\tchat.</span></p>\n\t\t\t\t\t\t\t\t\t</span>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class="row" *ngIf="!isApCertified && !isControl4 | async">\n\t\t\t\t\t\t\t\t<div class="col-4">\n\t\t\t\t\t\t\t\t\t<strong>Support</strong>\n\t\t\t\t\t\t\t\t\t<span>\n\t\t\t\t\t\t\t\t\t\t<i class="fas fa-exclamation-circle text-warning"></i>\n\t\t\t\t\t\t\t\t\t</span>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="col-8">\n\t\t\t\t\t\t\t\t\t<span>\n\t\t\t\t\t\t\t\t\t\t<p class="no-margin">You are not authorized to contact Control4 Support by phone or chat.</p>\n\t\t\t\t\t\t\t\t\t\t<p><small>Using phone or chat for support for Control4-related issues requires the Automation Programmer\n\t\t\t\t\t\t\t\t\t\t\t\tcertification.</small></p>\n\t\t\t\t\t\t\t\t\t</span>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</ng-container>\n\t\t\t\t\t\t<div class="row" *ngIf="technicianId">\n\t\t\t\t\t\t\t<div class="col-4">\n\t\t\t\t\t\t\t\t<strong>Technician ID</strong>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class="col-8" test-id="technicianId"> {{ technicianId }} </div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t<div class="col-4">\n\t\t\t\t\t\t\t\t<strong>Language</strong>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class="col-8">\n\t\t\t\t\t\t\t\t<p class="no-margin" test-id="selectedLanguage"> {{ selectedLanguage?.name }} </p>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t<div class="col-12">\n\t\t\t\t\t\t\t\t<strong class="block half-margin-bottom">Certifications</strong>\n\t\t\t\t\t\t\t\t<c4-user-certifications></c4-user-certifications>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t\t<p><small>We are fixing some of our records. If you\u2019re missing certifications on your profile, <span class="nobr"> contact <a\n\t\t\t\t\t\t\t\t   href="mailto:education@control4.com">education@control4.com</a>.</span></small>\n\t\t\t\t\t</p>\n\t\t\t\t\t<button test-id="editProfileClick" type="button" class="light-grey text-dark" (click)="beginEdit()"><i\n\t\t\t\t\t\t   class="fal fa-pen-alt"></i>Edit Profile</button>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t</div>\n\t\t<div class="row" *ngIf="loaded && editing">\n\t\t\t<c4-user-profile-edit [user]="user" [sfInfo]="sfInfo" (display)="editing = $event">\n\t\t\t</c4-user-profile-edit>\n\t\t</div>\n\t</div>\n</div>'},"t/Zo":function(t,e){t.exports=""},uu9g:function(t,e){t.exports=""}}]);