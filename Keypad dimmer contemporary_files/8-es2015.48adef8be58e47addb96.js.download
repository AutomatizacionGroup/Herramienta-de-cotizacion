\t\t\t\t\t</li>\n\t\t\t\t\t\t\t\t\t</ul>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="row no-margin">\n\t\t\t\t\t\t\t\t\t<div class="col-sm-6 col-8">\n\t\t\t\t\t\t\t\t\t\t<mat-form-field class="no-margin fs-block">\n\t\t\t\t\t\t\t\t\t\t\t<input test-id="workEmail" matInput type="email" placeholder="Work Email" class="no-margin"\n\t\t\t\t\t\t\t\t\t\t\t\t   name="workEmail" [(ngModel)]="editableUser.email" [pattern]="emailRegex"\n\t\t\t\t\t\t\t\t\t\t\t\t   maxlength="80" #workEmail="ngModel" [disabled]="workEmailInUse"\n\t\t\t\t\t\t\t\t\t\t\t\t   (ngModelChange)="updateVerifications()"\n\t\t\t\t\t\t\t\t\t\t\t\t   (keydown.enter)="beginEmailVerification(false)" required>\n\t\t\t\t\t\t\t\t\t\t</mat-form-field>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<div class="col-sm-6 col-4">\n\t\t\t\t\t\t\t\t\t\t<button test-id="beginEmailVerificationClick" type="button" class="grey no-margin"\n\t\t\t\t\t\t\t\t\t\t\t\t(click)="beginEmailVerification(false)"\n\t\t\t\t\t\t\t\t\t\t\t\t*ngIf="(!editableUser.workEmailVerified || workEmail.dirty) && !verifyingEmail"\n\t\t\t\t\t\t\t\t\t\t\t\t[disabled]="!workEmail.valid || !editableUser.email || workEmailInUse">Verify</button>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class="col-12" *ngIf="profileForm.hasError(\'pattern\', \'workEmail\')">\n\t\t\t\t\t\t\t\t<div class="alert alert-warning no-margin">\n\t\t\t\t\t\t\t\t\t<p>Please enter a valid email address for your work email.</p>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class="row" *ngIf="editableSfInfo.contact">\n\t\t\t\t\t\t\t<div class="col-4">\n\t\t\t\t\t\t\t\t<strong>Home Email</strong>\n\t\t\t\t\t\t\t\t<span *ngIf="editableSfInfo.contact.personalEmailVerified"\n\t\t\t\t\t\t\t\t\t  title="Home email verified"><i class="fas fa-check-circle text-success"></i></span>\n\t\t\t\t\t\t\t\t<span *ngIf="!editableSfInfo.contact.personalEmailVerified"\n\t\t\t\t\t\t\t\t\t  title="Home email not