top: 0;\n  left: 0;\n  width: 100%;\n  height: calc(100% - 50px);\n  display: block;\n}\n\n.ad-options + .location-quick-view {\n  width: 100%;\n  height: 50px;\n  position: absolute;\n  bottom: 0;\n  left: 0;\n  text-align: center;\n}\n\n.ad-options + .location-quick-view img,\n.ad-options + .location-quick-view i {\n  display: inline-block;\n  height: 22px;\n  margin: 0 10px;\n}"},buQn:function(t,e){t.exports=".sort-view {\n  -webkit-transition: box-shadow 0.2s;\n  transition: box-shadow 0.2s;\n  overflow: hidden;\n}\n\n.sort-view:hover {\n  z-index: 1;\n  box-shadow: 0px 0px 25px 0px rgba(0, 0, 0, 0.5);\n}\n\n.sort-view:hover .overlay {\n  display: inline-block;\n}\n\n.sort-view:hover .overlay .c4btn i {\n  color: #fafafa;\n}\n\n.list-view:hover .overlay {\n  background-color: rgba(0, 0, 0, 0.6);\n  position: absolute;\n  top: 0;\n  bottom: 0;\n  height: calc(100% - 50px);\n  width: 100%;\n  display: block;\n}\n\n.overlay {\n  display: none;\n  z-index: 999;\n  width: 100%;\n  height: 100%;\n  position: absolute;\n  top: 0;\n}\n\n.overlay .row {\n  position: absolute;\n  bottom: 0;\n  left: 0;\n  right: 0;\n}\n\n.overlay .c4btn.slide-sort {\n  z-index: 999;\n  width: 100px;\n  height: calc(100% / 3);\n  margin-right: 0;\n}\n\n.overlay .c4btn.slide-sort.top:nth-child(2) {\n  top: calc(100% / 3);\n}\n\n.overlay .c4btn.slide-sort.bottom:first-child {\n  bottom: calc(100% / 3);\n}\n\n.overlay .c4btn.ad-sort {\n  z-index: 999;\n  width: calc(100% / 3);\n  height: 100px;\n  margin-bottom: 0;\n}\n\n.overlay .c4btn.ad-sort.left:nth-child(2) {\n  left: calc(100% / 3);\n}\n\n.overlay .c4btn.ad-sort.right:first-child {\n  right: calc(100% / 3);\n}"},czHA:function(t,e){t.exports='<div class="padding">\n\t<h1>{{messageType}} Management</h1>\n\t<div class="widget">\n\t\t<div class="padding">\n\t\t\t<div class="row half-padding-bottom">\n\t\t\t\t<div class="col-sm-3 col-12">\n\t\t\t\t\t<c4-enum-checkbox test-id="portalFilterCheckboxes" (click)="filterPropaganda()" [labelMap]="portalNames" [(value)]="portalFilter">\n\t\t\t\t\t</c4-enum-checkbox>\n\t\t\t\t</div>\n\t\t\t\t<div *ngIf="isSlide" class="col-sm-3 col-12">\n\t\t\t\t\t<c4-enum-checkbox test-id="propagandaFilterCheckboxes" (click)="filterPropaganda()" [labelMap]="pageNames" [(value)]="pageFilter">\n\t\t\t\t\t</c4-enum-checkbox>\n\t\t\t\t</div>\n\t\t\t\t<div [ngClass]="isSlide ? \'col-sm-3 col-12\' : \'col-sm-6 col-12\'">\n\t\t\t\t\t<label>\n\t\t\t\t\t\t<input test-id="propagandaisDraftCheckbox" [(ngModel)]="showDrafts" (ngModelChange)="filterPropaganda()" type="checkbox"> Draft\n\t\t\t\t\t</label>\n\t\t\t\t\t<label>\n\t\t\t\t\t\t<input test-id="propagandaIsLiveCheckbox" [(ngModel)]="showScheduled" (ngModelChange)="filterPropaganda()" type="checkbox"> Live\n\t\t\t\t\t</label>\n\t\t\t\t\t<label>\n\t\t\t\t\t\t<input test-id="propagandaIsArchivedCheckbox" [(ngModel)]="showArchived" (ngModelChange)="filterPropaganda()" type="checkbox">\n\t\t\t\t\t\tArchived </label>\n\t\t\t\t</div>\n\t\t\t\t<div class="col-sm-3 col-12">\n\t\t\t\t\t<button test-id="createNewPropagandaClick" (click)="setPropaganda(0)" class="c4btn grey block"><i class="fal fa-plus"></i>New\n\t\t\t\t\t\t{{messageType}}</button>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t\t<div class="row">\n\t\t\t\t<div class="half-padding-bottom" *ngFor="let propaganda of filteredProps | paging: pagingInfo; index as i"\n\t\t\t\t\t [ngClass]="isSlide ? \'col-12\' : \'col-sm-4\'">\n\t\t\t\t\t<div class="list-view">\n\t\t\t\t\t\t<c4-propaganda [height]="height" [propaganda]="propaganda"></c4-propaganda>\n\t\t\t\t\t\t<div class="overlay hidden" [ngClass]="isSlide ? \'slide-options\' : \'ad-options\'">\n\t\t\t\t\t\t\t<button attr.test-id="editSortClick-{{i}}" (click)="editSort()" class="c4btn dark-grey no-margin absolute"\n\t\t\t\t\t\t\t\t\t[ngClass]="isSlide ? \'top right\' : \'bottom left\'"><i\n\t\t\t\t\t\t\t\t   class="fal fa-lg fa-arrows-v"></i></button>\n\t\t\t\t\t\t\t<button attr.test-id="setPropagandaClick-{{i}}" (click)="setPropaganda(propaganda.id)"\n\t\t\t\t\t\t\t\t\tclass="c4btn dark-grey no-margin absolute"\n\t\t\t\t\t\t\t\t\t[ngClass]="isSlide ? \'vertically-center right\' : \'bottom center\'"><i\n\t\t\t\t\t\t\t\t   class="fal fa-lg fa-pen-alt"></i></button>\n\t\t\t\t\t\t\t<button attr.test-id="archivePropagandaClick-{{i}}" (click)="archivePropaganda(propaganda)"\n\t\t\t\t\t\t\t\t\t[disabled]="propaganda.scheduleType === ScheduleType.Archive"\n\t\t\t\t\t\t\t\t\tclass="c4btn dark-grey no-margin absolute bottom right"><i\n\t\t\t\t\t\t\t\t   class="fal fa-lg fa-archive"></i></button>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class="location-quick-view darker-grey text-center">\n\t\t\t\t\t\t\t<div class="vertically-center text-center">\n\t\t\t\t\t\t\t\t<img alt="Control4" *ngIf="propaganda.visibleInPortals | control4Visible"\n\t\t\t\t\t\t\t\t\t src="//res.cloudinary.com/control4/image/upload/static-pages/portal-logos/control4_favicon_logo_white.png">\n\t\t\t\t\t\t\t\t<img alt="Pakedge" *ngIf="propaganda.visibleInPortals | pakedgeVisible"\n\t\t\t\t\t\t\t\t\t src="//res.cloudinary.com/control4/image/upload/static-pages/portal-logos/pakedge_favicon_logo_white.png">\n\t\t\t\t\t\t\t\t<img alt="Triad" *ngIf="propaganda.visibleInPortals | triadVisible"\n\t\t\t\t\t\t\t\t\t src="//res.cloudinary.com/control4/image/upload/static-pages/portal-logos/triad_favicon_white.png">\n\t\t\t\t\t\t\t\t<i *ngIf="isInPage(propaganda, Pages.Home)" class="fal fa-fw fa-lg fa-home"></i>\n\t\t\t\t\t\t\t\t<i *ngIf="isInPage(propaganda, Pages.Product)"\n\t\t\t\t\t\t\t\t   class="fal fa-fw fa-lg fa-shopping-cart"></i>\n\t\t\t\t\t\t\t\t<i class="fa-fw fa-lg" *ngIf="propaganda | propagandaStatusIcon"\n\t\t\t\t\t\t\t\t   [ngClass]="propaganda | propagandaStatusIcon"></i>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t</div>\n\t\t<div class="pagination">\n\t\t\t<c4-pager [(info)]="pagingInfo"></c4-pager>\n\t\t</div>\n\t</div>\n</div>'},i7Em:function(t,e){t.exports='<div class="padding">\n\t<div class="row no-margin">\n\t\t<div class="col-md-10">\n\t\t\t<h1>{{messageType}} Management</h1>\n\t\t</div>\n\t\t<div class="col-md-1">\n\t\t\t<button test-id="setPropTypeAdClick" class="block transparent toggle" (click)="setPropType(PropagandaType.Ad)" [class.active]="!isSlide"><i\n\t\t\t\t   class="fas fa-square"></i> Ad</button>\n\t\t</div>\n\t\t<div class="col-md-1">\n\t\t\t<button test-id="setPropTypeSlideClick" class="block transparent toggle" (click)="setPropType(PropagandaType.Slide)"\n\t\t\t\t\t[class.active]="isSlide"><i\n\t\t\t\t   class="fas fa-rectangle-wide"></i>Slide</button>\n\t\t</div>\n\t</div>\n\t<c4-loading *ngIf="!loaded"></c4-loading>\n\t<div *ngIf="loaded" class="widget">\n\t\t<div class="padding">\n\t\t\t<div class="row no-margin">\n\t\t\t\t<div [ngClass]="isSlide ? \'col-lg-11 col-10\' : \'col-sm-4 offset-sm-3 col-10\'"\n\t\t\t\t\t [style.height]="height + \'px\'">\n\t\t\t\t\t<c4-propaganda [height]="height" [propaganda]="prop"></c4-propaganda>\n\t\t\t\t</div>\n\t\t\t\t<div class="col-lg-1 col-2" [style.height]="height + \'px\'">\n\t\t\t\t\t\x3c!-- class="" --\x3e\n\t\t\t\t\t<button test-id="propAlignmentTopClick" (click)="prop.vAligned = Alignment.Top"\n\t\t\t\t\t\t\t[ngClass]="prop.vAligned === Alignment.Top ? \'light-grey\' : \'transparent\'" class="block no-margin text-dark"\n\t\t\t\t\t\t\tstyle="height: 33.33%;">\n\t\t\t\t\t\t<i class="fal fa-long-arrow-up"></i>\n\t\t\t\t\t</button>\n\t\t\t\t\t\x3c!-- class="vertically-center" --\x3e\n\t\t\t\t\t<button test-id="propAlignmentVerticallyCenteredClick" (click)="prop.vAligned = Alignment.Center"\n\t\t\t\t\t\t\t[ngClass]="prop.vAligned === Alignment.Center ? \'light-grey\' : \'transparent\'"\n\t\t\t\t\t\t\tclass="block no-margin text-dark" style="height: 33.33%;">\n\t\t\t\t\t\t<i class="fal fa-arrows-v"></i>\n\t\t\t\t\t</button>\n\t\t\t\t\t\x3c!-- class="absolute bottom" --\x3e\n\t\t\t\t\t<button test-id="propAlignmentBottomClick" (click)="prop.vAligned = Alignment.Bottom"\n\t\t\t\t\t\t\t[ngClass]="prop.vAligned === Alignment.Bottom ? \'light-grey\' : \'transparent\'"\n\t\t\t\t\t\t\tclass="block no-margin text-dark" style="height: 33.33%;">\n\t\t\t\t\t\t<i class="fal fa-long-arrow-down"></i>\n\t\t\t\t\t</button>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t\t<div class="row no-margin">\n\t\t\t\t<div class="col-lg-11 col-10">\n\t\t\t\t\t<div class="row no-margin">\n\t\t\t\t\t\t<div class="col-md-2 offset-md-3 col-4">\n\t\t\t\t\t\t\t<button test-id="propAlignmentLeftClick" (click)="prop.aligned = Alignment.Left"\n\t\t\t\t\t\t\t\t\t[ngClass]="prop.aligned === Alignment.Left ? \'light-grey\' : \'transparent\'" class="block">\n\t\t\t\t\t\t\t\t<i class="fal fa-align-left"></i>\n\t\t\t\t\t\t\t</button>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class="col-md-2 col-4">\n\t\t\t\t\t\t\t<button test-id="propAlignmentHorizontallyCenteredClick" (click)="prop.aligned = Alignment.Center"\n\t\t\t\t\t\t\t\t\t[ngClass]="prop.aligned === Alignment.Center ? \'light-grey\' : \'transparent\'" class="block">\n\t\t\t\t\t\t\t\t<i class="fal fa-align-center"></i>\n\t\t\t\t\t\t\t</button>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class="col-md-2 col-4">\n\t\t\t\t\t\t\t<button test-id="propAlignmentRightClick" (click)="prop.aligned = Alignment.Right"\n\t\t\t\t\t\t\t\t\t[ngClass]="prop.aligned === Alignment.Right ? \'light-grey\' : \'transparent\'" class="block">\n\t\t\t\t\t\t\t\t<i class="fal fa-align-right"></i>\n\t\t\t\t\t\t\t</button>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t\t<mat-form-field>\n\t\t\t\t<input test-id="backgroundUrl" matInput type="text" placeholder="Background Url" [(ngModel)]="prop.mediaUrl">\n\t\t\t</mat-form-field>\n\t\t\t<div *ngFor="let line of prop.lines">\n\t\t\t\t<div class="row no-margin">\n\t\t\t\t\t<div class="col-sm-6">\n\t\t\t\t\t\t<mat-form-field>\n\t\t\t\t\t\t\t<input test-id="lineText" matInput type="text" maxlength="200" placeholder="Text" [(ngModel)]="line.text">\n\t\t\t\t\t\t</mat-form-field>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="col-sm-3">\n\t\t\t\t\t\t<mat-form-field>\n\t\t\t\t\t\t\t<input test-id="lineClass" matInput type="text" maxlength="200" placeholder="Class" [(ngModel)]="line.class">\n\t\t\t\t\t\t</mat-form-field>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="col-sm-1">\n\t\t\t\t\t\t<select test-id="selectedLineTag" [(ngModel)]="line.tag">\n\t\t\t\t\t\t\t<option value="h1">H1</option>\n\t\t\t\t\t\t\t<option value="h2">H2</option>\n\t\t\t\t\t\t\t<option value="h3">H3</option>\n\t\t\t\t\t\t\t<option value="p">P</option>\n\t\t\t\t\t\t</select>\n\t\t\t\t\t</div>\n\t\t\t\t\t<c4-control-color class="col-sm-2" [controlType]="ControlTypes.Text" [(color)]="line.color">\n\t\t\t\t\t</c4-control-color>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t\t<div class="row">\n\t\t\t\t<div class="col-sm-7">\n\t\t\t\t\t<div class="row no-margin">\n\t\t\t\t\t\t<div class="col-sm-5">\n\t\t\t\t\t\t\t<mat-form-field>\n\t\t\t\t\t\t\t\t<input test-id="buttonText" matInput type="text" maxlength="50" placeholder="Click Text" [(ngModel)]="prop.buttonText">\n\t\t\t\t\t\t\t</mat-form-field>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class="col-sm-3">\n\t\t\t\t\t\t\t<mat-form-field>\n\t\t\t\t\t\t\t\t<input test-id="buttonClass" matInput type="text" maxlength="200" placeholder="Class" [(ngModel)]="prop.buttonClass">\n\t\t\t\t\t\t\t</mat-form-field>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<c4-control-color class="col-sm-3 button-color" [controlType]="ControlTypes.Click"\n\t\t\t\t\t\t\t\t\t\t  [(color)]="prop.buttonColor"></c4-control-color>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class="col-sm-5">\n\t\t\t\t\t<mat-form-field>\n\t\t\t\t\t\t<input test-id="buttonUrl" matInput type="text" placeholder="Click Link" maxlength="100" [(ngModel)]="prop.buttonUrl">\n\t\t\t\t\t</mat-form-field>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t\t<div class="row half-padding-top">\n\t\t\t\t<div class="col-sm-6">\n\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t<div class="col-sm-6">\n\t\t\t\t\t\t\t<h4>Portal Visibility</h4>\n\t\t\t\t\t\t\t<c4-enum-checkbox test-id="visibleInPortalsCheckboxes" [labelMap]="PortalNames" [(value)]="prop.visibleInPortals">\n\t\t\t\t\t\t\t</c4-enum-checkbox>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class="col-sm-6" *ngIf="isSlide">\n\t\t\t\t\t\t\t<h4>Page Visibility</h4>\n\t\t\t\t\t\t\t<c4-enum-checkbox test-id="visibleInPagesCheckboxes" [labelMap]="PageNames" [(value)]="prop.visibleInPages"></c4-enum-checkbox>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class="col-sm-3">\n\t\t\t\t\t<h4>Dealer Visibility</h4>\n\t\t\t\t\t<label>\n\t\t\t\t\t\t<input test-id="hasDealersCheckbox" type="checkbox" [(ngModel)]="hasDealers">Only Visible to Specific Dealers </label>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t\t<div *ngIf="hasDealers">\n\t\t\t\t<h4 class="half-padding-top">Specific Dealers</h4>\n\t\t\t\t<textarea test-id="dealers" [(ngModel)]="dealers"></textarea>\n\t\t\t</div>\n\t\t\t<div class="row half-padding-top" *ngIf="!isSlide">\n\t\t\t\t<div class="col-12">\n\t\t\t\t\t<h4>Product Visibility</h4>\n\t\t\t\t\t<small>*By default, the ad will appear universally if no skus or categories are set.</small>\n\t\t\t\t\t<c4-category-select [categories]="prop.categories" (categoriesChange)="prop.categories = $event"></c4-category-select>\n\t\t\t\t\t<c4-category-tags [categories]="prop.categories" [removable]="true" (categoriesChange)="prop.categories = $event"></c4-category-tags>\n\t\t\t\t\t<c4-product-select (productChange)="addProductSku($event)" [singleProduct]="true">\n\t\t\t\t\t</c4-product-select>\n\t\t\t\t\t<c4-product-tags [products]="prop.productSkus" [removable]="true"></c4-product-tags>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t\t<div class="half-padding-top">\n\t\t\t\t<c4-scheduler [type]="prop.scheduleType" [start]="prop.startDate" [end]="prop.endDate"\n\t\t\t\t\t\t\t  (scheduleChange)="updateSchedule($event)" class="block"></c4-scheduler>\n\t\t\t</div>\n\t\t\t<div class="row half-padding-top no-margin">\n\t\t\t\t<div class="offset-sm-8 col-sm-2">\n\t\t\t\t\t<button test-id="showManagementPageClick" (click)="showManagementPage()" class="c4btn block white">Cancel</button>\n\t\t\t\t</div>\n\t\t\t\t<div class="col-sm-2">\n\t\t\t\t\t<button test-id="savePropagandaClick" (click)="savePropaganda()" class="c4btn block">Save</button>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t</div>\n\t</div>\n</div>'}}]);