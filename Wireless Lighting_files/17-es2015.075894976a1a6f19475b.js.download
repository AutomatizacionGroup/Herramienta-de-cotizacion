(window.webpackJsonp=window.webpackJsonp||[]).push([[17],{"+ZsF":function(t,e){t.exports=""},"/oiK":function(t,e){t.exports='<div class="padding">\n\t<h1 class="no-margin">{{selectedVariant?.name}}</h1>\n\t<h4 class="text-grey">{{selectedVariant?.sku}}</h4>\n\t<div class="row">\n\t\t<div class="col-md-8">\n\t\t\t<div class="widget product-img">\n\t\t\t\t<div class="padding">\n\t\t\t\t\t<c4-carousel [height]="350" [showArrows]="false">\n\t\t\t\t\t\t<div id="product-image" class="c4-slide engraving-slide" #c4Slide>\n\t\t\t\t\t\t\t<c4-cloudinary ngClass="slide-img"\n\t\t\t\t\t\t\t\t\t\t   transformations="c=limit, h=1800, q=auto, f=auto, dpr=auto, w=2700"\n\t\t\t\t\t\t\t\t\t\t   [media]="selectedVariant?.media | primaryImage"></c4-cloudinary>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<c4-engraving-overlay [keycap]="keycap" [sku]="selectedVariant?.sku" class="engraving-overlay">\n\t\t\t\t\t\t</c4-engraving-overlay>\n\t\t\t\t\t</c4-carousel>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t\t<c4-engraving-summary [sku]="selectedVariant?.sku" [keycapAdded]="keycapAdded" [variantOptions]="variantOptions"></c4-engraving-summary>\n\t\t\t<div id="description" class="widget">\n\t\t\t\t<h3 class="widget-header-grey">Description</h3>\n\t\t\t\t<div class="padding">\n\t\t\t\t\t<c4-loading *ngIf="!selectedType"></c4-loading>\n\t\t\t\t\t<div class="description force-font" [innerHTML]="selectedType?.description | safeHtml"></div>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t</div>\n\t\t<div class="col-md-4">\n\t\t\t<div class="widget">\n\t\t\t\t<div class="padding light-grey form dark" style="background-color: #e8e8e8;">\n\t\t\t\t\t<c4-loading *ngIf="!loaded"></c4-loading>\n\t\t\t\t\t<p class="small-caps text-blue" style="margin-bottom: 3px;">Keycap</p>\n\t\t\t\t\t<div class="row no-margin" *ngIf="showContemporaryEngraverOptions">\n\t\t\t\t\t\t<div class="col-6">\n\t\t\t\t\t\t\t<button test-id="styleTraditionalClick" class="white block" [ngClass]="{\'active\':selectedStyle===1}"\n\t\t\t\t\t\t\t\t\t(click)="changeSelectedStyle(false)"> Traditional </button>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class="col-6">\n\t\t\t\t\t\t\t<button test-id="styleContemporaryClick" class="white block" [ngClass]="{\'active\':selectedStyle===2}"\n\t\t\t\t\t\t\t\t\t(click)="changeSelectedStyle(true)"> Contemporary </button>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div *ngIf="selectedStyle || !showContemporaryEngraverOptions">\n\t\t\t\t\t\t<select test-id="selectedType" [(ngModel)]="selectedType" *ngIf="types?.length > 1" (ngModelChange)="onTypeChange($event)">\n\t\t\t\t\t\t\t<option selected disabled [value]="undefined">Type</option>\n\t\t\t\t\t\t\t<option *ngFor="let type of types" [ngValue]="type">{{type.parentName}}</option>\n\t\t\t\t\t\t</select>\n\t\t\t\t\t\t<select test-id="selectedColor" [(ngModel)]="selectedColor" *ngIf="selectedType?.colors?.length > 1"\n\t\t\t\t\t\t\t\t(ngModelChange)="onColorChange($event)">\n\t\t\t\t\t\t\t<option selected disabled [value]="undefined">Color</option>\n\t\t\t\t\t\t\t<option *ngFor="let color of selectedType?.colors" [ngValue]="color">{{color.displayValue}} </option>\n\t\t\t\t\t\t</select>\n\t\t\t\t\t\t<div *ngIf="false && displayLegacyEngravingMessage" class="padding white"\n\t\t\t\t\t\t\t style="margin-bottom: 10px;">\n\t\t\t\t\t\t\t<p><small>The button engraving process for black and brown buttons has changed, improving the legibility in daylight and when\n\t\t\t\t\t\t\t\t\tback-lit. The button colors have not changed, but the engraving is distinctly different. <br /><br />In order to match\n\t\t\t\t\t\t\t\t\tinstalled keycaps engraved prior to November 1, 2018, select Legacy Black (C4-EBD1H-OL) or Legacy Brown (C4-EBD1H-BB). For\n\t\t\t\t\t\t\t\t\tengravings done with the new process, order buttons in Black (C4-EBD1H-BL) or Brown (C4-EBD1H-BR).</small></p>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<c4-engraving-input [sku]="selectedVariant?.sku" [keycap]="keycap"></c4-engraving-input>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class="padding">\n\t\t\t\t\t<div class="half-margin-bottom">\n\t\t\t\t\t\t<div class="text-right">\n\t\t\t\t\t\t\t<i class="fal fa-server fa-rotate-180 text-warning"></i>Built to Order <small\n\t\t\t\t\t\t\t\t   class="block">{{this.stockMessage}}</small>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div *ngIf="canViewPricing" class="row">\n\t\t\t\t\t\t<div class="col-md-5 col-sm-3 col-5">\n\t\t\t\t\t\t\t<input test-id="quantity" type="number" name="name" placeholder="QTY" value="1" min="1" max="9999" class=""\n\t\t\t\t\t\t\t\t   [(ngModel)]="quantity"\n\t\t\t\t\t\t\t\t   [disabled]="selectedVariant?.dealerPrice === 0 || selectedVariant?.isDisplayOnly">\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div *ngIf="selectedVariant?.msrp && isMsrp$ | async" class="col-md-7 col-sm-9 col-7 text-right">\n\t\t\t\t\t\t\t<no-br>\n\t\t\t\t\t\t\t\t<h2 class="no-margin"><span class="text-grey">MSRP </span><strong>{{selectedVariant?.msrp | currency:currencySymbol}}</strong>\n\t\t\t\t\t\t\t\t</h2>\n\t\t\t\t\t\t\t</no-br>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div *ngIf="!(isMsrp$ | async)" class="col-md-7 col-sm-9 col-7 text-right">\n\t\t\t\t\t\t\t<h2 class="no-margin bold">{{selectedVariant?.dealerPrice\n\t\t\t\t\t\t\t\t| currency:currencySymbol}}</h2>\n\t\t\t\t\t\t\t<small *ngIf="loaded && selectedVariant?.msrp">MSRP {{selectedVariant?.msrp | currency:currencySymbol}}</small>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<c4-product-add-to-cart classes="block no-border-radius-top" [disabled]="!enableAddToCart()"\n\t\t\t\t\t\t\t\t\t\t[onClick]="addToCart"></c4-product-add-to-cart>\n\t\t\t</div>\n\t\t\t<c4-propaganda [height]="400" *ngIf="!(isMsrp$ | async)" [propaganda]="propaganda" propagandaType="Ad"\n\t\t\t\t\t\t   pageType="Product" classes="half-margin-bottom"></c4-propaganda>\n\t\t\t<div class="widget" *ngIf="recommendedCategories?.length">\n\t\t\t\t<h3 class="widget-header-white">Recommended Categories</h3>\n\t\t\t\t<div *ngFor="let rc of recommendedCategories">\n\t\t\t\t\t<c4-category-card [category]="rc.catalogsCategory" section="Recommended Categories">\n\t\t\t\t\t</c4-category-card>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t\t<div class="widget" *ngIf="(recommendedProducts$ | async)?.length">\n\t\t\t\t<h3 class="widget-header-white">Recommended Products</h3>\n\t\t\t\t<div *ngFor="let csp of recommendedProducts$ | async; index as i">\n\t\t\t\t\t<c4-product-card attr.test-id="c4-product-card-{{i}}" [product]="csp" section="Recommended Products"></c4-product-card>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t</div>\n\t</div>\n</div>'},"6nA/":function(t,e){t.exports='<div *ngIf="info">\n\t<div class="half-padding-bottom" *ngIf="info.techSupportInfo">\n\t\t<h3>Technical Support Information</h3>\n\t\t<div *ngFor="let techSupport of info.techSupportInfo">\n\t\t\t<p class="force-font" [innerHTML]="techSupport | safeHtml"></p>\n\t\t</div>\n\t</div>\n\t<div class="half-padding-bottom" *ngIf="info.warrantyInfo">\n\t\t<h3>Warranty Information</h3>\n\t\t<div *ngFor="let warranty of info.warrantyInfo">\n\t\t\t<p class="force-font" [innerHTML]="warranty | safeHtml"></p>\n\t\t</div>\n\t</div>\n\t<div class="half-padding-bottom" *ngIf="info.rmaInfo">\n\t\t<h3>RMA Information</h3>\n\t\t<div *ngFor="let rma of info.rmaInfo">\n\t\t\t<p class="force-font" [innerHTML]="rma | safeHtml"></p>\n\t\t</div>\n\t</div>\n</div>\n<div *ngIf="!info">\n\t<p>There is currently no support information for this product.</p>\n</div>'},"7syG":function(t,e){t.exports='<div class="widget" *ngIf="manualKeycaps().length > 0">\n\t<h3 class="widget-header-grey">Manual Keycaps</h3>\n\t<div class="table padding no-margin">\n\t\t<div class="head d-xs-none">\n\t\t\t<div class="row">\n\t\t\t\t<div class="col-sm-2 bold">Type</div>\n\t\t\t\t<div class="col-sm-2 bold" *ngIf="(enableContemporaryKeycapsUploadXML$ | async)">Style</div>\n\t\t\t\t<div class="col-sm-2 bold">Color</div>\n\t\t\t\t<div class="col-sm-2 bold">Label</div>\n\t\t\t\t<div class="col-sm-2 bold text-center">Qty</div>\n\t\t\t\t<div class="col-sm-1"></div>\n\t\t\t</div>\n\t\t</div>\n\t\t<div class="body">\n\t\t\t<div class="row" *ngFor="let manual of manualKeycaps(); index as i">\n\t\t\t\t<ng-container *ngIf="manual.editMode">\n\t\t\t\t\t<div class="col-sm-2">\n\t\t\t\t\t\t<select attr.test-id="selectedManualType-{{i}}" disabled>\n\t\t\t\t\t\t\t<option selected>{{manual.type}}</option>\n\t\t\t\t\t\t</select>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="col-sm-2" *ngIf="(enableContemporaryKeycapsUploadXML$ | async)">\n\t\t\t\t\t\t<input disabled type="text" value="{{manual.getKeycapStyle()}}" />\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="col-sm-2">\n\t\t\t\t\t\t<select attr.test-id="selectedManualColor{{i}}" [(ngModel)]="manual.color">\n\t\t\t\t\t\t\t<option disabled [value]="undefined">Color</option>\n\t\t\t\t\t\t\t<option *ngFor="let color of manual.colors" [ngValue]="color">{{color.displayValue}} </option>\n\t\t\t\t\t\t</select>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="col-sm-2">\n\t\t\t\t\t\t<div class="row no-margin">\n\t\t\t\t\t\t\t<div class="col-12">\n\t\t\t\t\t\t\t\t<mat-form-field>\n\t\t\t\t\t\t\t\t\t<input attr.test-id="topLine{{i}}" matInput type="text" name="name" placeholder="Line 1" value="Home" min="1"\n\t\t\t\t\t\t\t\t\t\t   max="20" class="" [(ngModel)]="manual.topLine"\n\t\t\t\t\t\t\t\t\t\t   (change)="checkLength(manual,true)"\n\t\t\t\t\t\t\t\t\t\t   [ngStyle]="{\'font-family\': !manual.isGen3() ? \'c4keycaps\' : \'\'}">\n\t\t\t\t\t\t\t\t</mat-form-field>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class="row no-margin">\n\t\t\t\t\t\t\t<div class="col-12">\n\t\t\t\t\t\t\t\t<mat-form-field>\n\t\t\t\t\t\t\t\t\t<input attr.test-id="bottomLine{{i}}" matInput type="text" class="no-margin" name="name" placeholder="Line 2"\n\t\t\t\t\t\t\t\t\t\t   min="1" max="20" [(ngModel)]="manual.bottomLine"\n\t\t\t\t\t\t\t\t\t\t   (change)="checkLength(manual,false)"\n\t\t\t\t\t\t\t\t\t\t   [disabled]="manual.type===\'Single\' || manual.topLine == \'\' || manual.icon !=null && manual.icon>0"\n\t\t\t\t\t\t\t\t\t\t   [ngStyle]="{\'font-family\': !manual.isGen3() ? \'c4keycaps\' : \'\'}">\n\t\t\t\t\t\t\t\t</mat-form-field>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="col-sm-2">\n\t\t\t\t\t\t<input attr.test-id="quantity-{{i}}" type="number" name="name" placeholder="QTY" min="0" max="9999" class=""\n\t\t\t\t\t\t\t   [(ngModel)]="manual.quantity">\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="col-sm-2">\n\t\t\t\t\t\t<button attr.test-id="updateKeycapItemClick-{{i}}" class="c4btn block" [disabled]="!enableUpdateCart(manual)"\n\t\t\t\t\t\t\t\t(click)="updateKeycapItem(manual)">{{manual.quantity\n\t\t\t\t\t\t\t> 0 ? "Save" : "Remove"}}</button>\n\t\t\t\t\t\t<button attr.test-id="cancelUpdateKeycapItemClick-{{i}}" class="c4btn block transparent no-margin"\n\t\t\t\t\t\t\t\t(click)="manual.cancelEdit()">Cancel</button>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="col-sm-12" style="padding-top: 0;">\n\t\t\t\t\t\t<div class="alert alert-warning no-margin" *ngIf="manual.line1Error || manual.line2Error"> You&apos;ve exceeded the maximum keycap\n\t\t\t\t\t\t\tengraving length. Please revise your entry.</div>\n\t\t\t\t\t</div>\n\t\t\t\t</ng-container>\n\t\t\t\t<ng-container *ngIf="!manual.editMode">\n\t\t\t\t\t<div class="col-sm-2">{{manual.type}}</div>\n\t\t\t\t\t<div class="col-sm-2" *ngIf="(enableContemporaryKeycapsUploadXML$ | async)">{{manual.getKeycapStyle()}}</div>\n\t\t\t\t\t<div class="col-sm-2">{{manual.color.displayValue}}</div>\n\t\t\t\t\t<div class="col-sm-2">\n\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t<div class="col-12">\n\t\t\t\t\t\t\t\t<span class="symbol" *ngIf="!manual.isGen3()">{{manual.topLine}}</span>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class="col-12" *ngIf="manual.isGen3()">\n\t\t\t\t\t\t\t\t<div style="font-size: 16px; width: 150px;">\n\t\t\t\t\t\t\t\t\t<span *ngIf="manual.icon && manual.icon > 0" style="position: relative; top: -8px;"\n\t\t\t\t\t\t\t\t\t\t  [ngStyle]="{\'float\': manual.position}"\n\t\t\t\t\t\t\t\t\t\t  class="symbols symbols-{{manual.icon}}"></span>\n\t\t\t\t\t\t\t\t\t<span style="margin-left: 6px;">{{manual.topLine}}</span>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div style="position: absolute; top: 30px; color: #999;" *ngIf="manual.icon > 0">\n\t\t\t\t\t\t\t\t\t<i class="fal fa-chevron-left clickable" *ngIf="manual.topLine"\n\t\t\t\t\t\t\t\t\t   (click)="togglePosition(manual, \'left\')" title="Move icon left"></i>\n\t\t\t\t\t\t\t\t\t<i class="fal fa-times clickable" style="color: #af4148;"\n\t\t\t\t\t\t\t\t\t   [ngStyle]="{\'margin-left\':!(manual.topLine)?\'12px\':\'\'}"\n\t\t\t\t\t\t\t\t\t   (click)="removeIcon(manual)" title="Remove icon"></i>\n\t\t\t\t\t\t\t\t\t<i class="fal fa-chevron-right clickable" *ngIf="manual.topLine"\n\t\t\t\t\t\t\t\t\t   (click)="togglePosition(manual, \'right\')" title="Move icon right"></i>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class="row" *ngIf="manual.bottomLine">\n\t\t\t\t\t\t\t<div class="col-12">\n\t\t\t\t\t\t\t\t<span class="symbol" *ngIf="!manual.isGen3()">{{manual.bottomLine}}</span>\n\t\t\t\t\t\t\t\t<span style="margin-left: 5px; font-size: 16px; width: 150px;"\n\t\t\t\t\t\t\t\t\t  *ngIf="manual.isGen3()">{{manual.bottomLine}}</span>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="col-sm-2 col-4 text-center">{{manual.quantity}}</div>\n\t\t\t\t\t<div class="col-sm-1 col-4">\n\t\t\t\t\t\t<button attr.test-id="startEditClick-{{i}}" class="c4btn block transparent" (click)="manual.startEdit()"><i\n\t\t\t\t\t\t\t   class="fal fa-pen-alt"></i></button>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="col-sm-1 col-4">\n\t\t\t\t\t\t<button attr.test-id="removeKeycapItemClick-{{i}}" class="c4btn block transparent" (click)="removeKeycapItem(manual)"><i\n\t\t\t\t\t\t\t   class="fal fa-trash"></i></button>\n\t\t\t\t\t</div>\n\t\t\t\t</ng-container>\n\t\t\t</div>\n\t\t</div>\n\t</div>\n</div>\n<div class="widget" *ngIf="isPageGen3()">\n\t<h3 class="widget-header-grey">Composer Keycaps</h3>\n\t<div class="absolute top block text-right">\n\t\t<button test-id="uploadComposerXml" (click)="showDragDrop = !showDragDrop"><i class="fal fa-arrow-to-top"></i><span\n\t\t\t\t  class="d-xs-none">Upload Composer</span> XML</button>\n\t</div>\n\t<div *ngIf="showDragDrop" class="row no-margin padding">\n\t\t<c4-engraving-xml-upload allow="xml" url="/KeypadOrder/UploadFiles" files="Files"></c4-engraving-xml-upload>\n\t</div>\n\t<div class="padding" *ngIf="composerKeycaps().length <= 0">There are no composer keycaps in your cart. Upload a composer XML to begin a composer keycap\n\t\torder.</div>\n\t<div class="table padding no-margin" *ngIf="composerKeycaps().length > 0">\n\t\t<div class="head d-xs-none">\n\t\t\t<div class="row">\n\t\t\t\t<div class="col-sm-2 bold">Type</div>\n\t\t\t\t<div class="col-sm-2 bold" *ngIf="(enableContemporaryKeycapsUploadXML$ | async)">Style</div>\n\t\t\t\t<div class="col-sm-2 bold">Color</div>\n\t\t\t\t<div class="col-sm-3 bold">Label</div>\n\t\t\t\t<div class="col-sm-3 bold">Location</div>\n\t\t\t</div>\n\t\t</div>\n\t\t<div class="body">\n\t\t\t<div class="row" *ngFor="let composer of composerKeycaps()">\n\t\t\t\t<div class="col-sm-2">{{composer.type}}</div>\n\t\t\t\t<div class="col-sm-2" *ngIf="(enableContemporaryKeycapsUploadXML$ | async)">{{composer.getKeycapStyle()}}</div>\n\t\t\t\t<div class="col-sm-2">{{composer.color.displayValue}}</div>\n\t\t\t\t<div class="col-sm-3">\n\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t<div class="col-12">\n\t\t\t\t\t\t\t<span style="font-size: 16px;">\n\t\t\t\t\t\t\t\t<span *ngIf="composer.icon && composer.icon > 0" style="position: relative; top: -8px;"\n\t\t\t\t\t\t\t\t\t  [ngStyle]="{\'float\': composer.position}"\n\t\t\t\t\t\t\t\t\t  class="symbols symbols-{{composer.icon}}"></span>\n\t\t\t\t\t\t\t\t<span style="margin-left: 6px;">{{composer.topLine}}</span>\n\t\t\t\t\t\t\t</span>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="row" *ngIf="composer.bottomLine">\n\t\t\t\t\t\t<span style="margin-left: 20px;">{{composer.bottomLine}}</span>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class="col-sm-3">{{composer.location}}</div>\n\t\t\t</div>\n\t\t</div>\n\t</div>\n</div>\n'},"9QoG":function(t,e){t.exports='<div class="engraving-old" *ngIf="keycap && !keycap.isGen3()" [ngStyle]="keycapTopStyle()">\n\t<div>{{keycap.topLine?.toUpperCase() | keycapText:keycapMaxLength()}}</div>\n\t<div>{{keycap.bottomLine?.toUpperCase() | keycapText:keycapMaxLength()}}</div>\n</div>\n<div class="engraving-gen-three" *ngIf="keycap && keycap.isGen3()" [ngStyle]="keycapTopStyle()">\n\t<div class="engraving-icon symbols {{keycap.position}} " [ngStyle]="symbolFloat()" *ngIf="keycap.icon!=0" [ngClass]="getIconColor()"></div>\n\t<div class="engraving-line-one" [ngClass]="{\'has-icon\':keycap.icon}">{{keycap.topLine |\n\t\tkeycapText:keycapMaxLength()}}</div>\n\t<div class="engraving-line-two">{{keycap.bottomLine | keycapText:keycapMaxLength()}}</div>\n</div>'},BeSb:function(t,e){t.exports='<div class="padding">\n\t<h2 class="lowercase no-margin">{{product?.name}}</h2>\n\t<p>{{displaySku}}</p>\n\t<div class="row">\n\t\t<div class="col-md-8">\n\t\t\t<div class="widget product-img">\n\t\t\t\t<div class="padding">\n\t\t\t\t\t<c4-carousel [height]="350" [showArrows]="true" [load]="reloadImages">\n\t\t\t\t\t\t<div *ngFor="let media of sliderImages" class="c4-slide" #c4Slide>\n\t\t\t\t\t\t\t<c4-cloudinary ngClass="slide-img" transformations="c=limit, h=700, q=auto, f=auto, w=1400"\n\t\t\t\t\t\t\t\t\t\t   zoomTransformations="c=limit, f=auto, q=auto, w=2700, h=1050" [media]="media">\n\t\t\t\t\t\t\t</c4-cloudinary>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</c4-carousel>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t\t<c4-add-to-cart-widget *ngIf="product" [hidden]="!(isMobile$ | async)" [product]="product"\n\t\t\t\t\t\t\t\t   [(customizedSku)]="customizedSku"></c4-add-to-cart-widget>\n\t\t\t<c4-product-firmware *ngIf="showFirmware20$ | async" [firmware]="product?.latestFirmware"\n\t\t\t\t\t\t\t\t [sku]="product?.sku"></c4-product-firmware>\n\t\t\t<div id="description" class="widget" *ngIf="!product || product.description">\n\t\t\t\t<h3 class="widget-header-white">Description</h3>\n\t\t\t\t<div class="padding">\n\t\t\t\t\t<c4-loading *ngIf="!product"></c4-loading>\n\t\t\t\t\t<div *ngIf="product?.description" class="description force-font"\n\t\t\t\t\t\t [innerHTML]="product?.description | safeHtml"></div>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t\t<div id="features" class="widget" *ngIf="!product || product.features">\n\t\t\t\t<h3 class="widget-header-white">Features</h3>\n\t\t\t\t<div class="padding">\n\t\t\t\t\t<c4-loading *ngIf="!product"></c4-loading>\n\t\t\t\t\t<div class="force-font" [innerHtml]="product?.features | safeHtml"></div>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t\t<div id="specifications" class="widget" *ngIf="!specSheets || specSheets.length">\n\t\t\t\t<h3 class="widget-header-white">Specifications</h3>\n\t\t\t\t<div class="padding">\n\t\t\t\t\t<c4-loading *ngIf="!specSheets"></c4-loading>\n\t\t\t\t\t<div *ngFor="let sheet of specSheets">\n\t\t\t\t\t\t<a [href]="sheet | cloudinaryUrl: \'q=auto\'">\n\t\t\t\t\t\t\t<img [src]="sheet | cloudinaryUrl: \'q=auto\'" />\n\t\t\t\t\t\t</a>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t\t<div id="videos" class="widget" *ngIf="!product || product.videos.length">\n\t\t\t\t<h3 class="widget-header-white">Videos</h3>\n\t\t\t\t<div class="padding">\n\t\t\t\t\t<c4-loading *ngIf="!product"></c4-loading>\n\t\t\t\t\t<c4-product-video-list [videos]="product?.videos"></c4-product-video-list>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t\t<div id="support" class="widget" *ngIf="!product || product.supportInfo">\n\t\t\t\t<h3 class="widget-header-white">Support</h3>\n\t\t\t\t<div class="padding">\n\t\t\t\t\t<c4-loading *ngIf="!product"></c4-loading>\n\t\t\t\t\t<c4-support-info *ngIf="product" [info]="product?.supportInfo"></c4-support-info>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t\t<div id="downloads" class="widget" *ngIf="!productDownloads || productDownloads.length">\n\t\t\t\t<h3 class="widget-header-white">Downloads</h3>\n\t\t\t\t<div class="padding">\n\t\t\t\t\t<c4-loading *ngIf="!productDownloads"></c4-loading>\n\t\t\t\t\t<ul class="no-margin">\n\t\t\t\t\t\t<li class="clearfix ng-scope" *ngFor="let download of productDownloads">\n\t\t\t\t\t\t\t<a [href]="download | cloudinaryUrl">{{download.name}}</a>\n\t\t\t\t\t\t</li>\n\t\t\t\t\t</ul>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t\t<c4-product-firmware-old *ngIf="!(showFirmware20$ | async)" [releaseNotes]="product?.releaseNotes"\n\t\t\t\t\t\t\t\t\t [firmware]="firmware"></c4-product-firmware-old>\n\t\t</div>\n\t\t<div class="col-md-4">\n\t\t\t<c4-add-to-cart-widget *ngIf="product" [hidden]="isMobile$ | async" class="widget" [product]="product"\n\t\t\t\t\t\t\t\t   [(customizedSku)]="customizedSku"></c4-add-to-cart-widget>\n\t\t\t<div class="alert alert-warning"\n\t\t\t\t *ngIf="product?.partnerName && product?.partnerShippingMinimum > 0 && product?.partnerShippingCost > 0">\n\t\t\t\t<div>This product will incur an additional shipping charge of <strong>{{product?.partnerShippingCost |\n\t\t\t\t\t\tcurrency: (currency$ | async)}}</strong> from <strong>{{product?.partnerName}}</strong> if you don\'t have\n\t\t\t\t\t<strong>{{product?.partnerShippingMinimum | currency:(currency$ | async)}}</strong> of product from {{product?.partnerName}} in your cart.\n\t\t\t\t\tThis allows {{brandName$ | async}} to offer hundreds of low-priced partner products that would be cost-prohibitive to ship on their own.\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t\t<c4-propaganda [height]="400" *ngIf="propaganda && !(isMsrp$ | async)" [propaganda]="propaganda"\n\t\t\t\t\t\t   propagandaType="Ad" pageType="Product" classes="half-margin-bottom"></c4-propaganda>\n\t\t\t<div class="widget" *ngIf="recommendedCategories?.length">\n\t\t\t\t<h3 class="widget-header-white">Recommended Categories</h3>\n\t\t\t\t<div *ngFor="let rc of recommendedCategories">\n\t\t\t\t\t<c4-category-card [category]="rc.catalogsCategory" section="Recommended Categories">\n\t\t\t\t\t</c4-category-card>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t\t<div class="widget" *ngIf="(recommendedProducts$ | async)?.length">\n\t\t\t\t<h3 class="widget-header-white">Recommended Products</h3>\n\t\t\t\t<div *ngFor="let csp of recommendedProducts$ | async; index as i">\n\t\t\t\t\t<c4-product-card attr.test-id="c4-product-card-{{i}}" [product]="csp" section="Recommended Products"></c4-product-card>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t</div>\n\t</div>\n</div>'},CMkU:function(t,e){t.exports=".fileInput {\n  width: 0.1px;\n  height: 0.1px;\n  opacity: 0;\n  overflow: hidden;\n  position: absolute;\n  z-index: -1;\n}"},D5nt:function(t,e){t.exports=""},E8MT:function(t,e){t.exports=""},Eogn:function(t,e){t.exports='div .engraving-overlay {\n  font-weight: bold;\n  z-index: 1000;\n  top: 0;\n}\n\ndiv .engraving-gen-three {\n  letter-spacing: normal;\n  line-height: 20px;\n  padding-top: 22px !important;\n}\n\ndiv .engraving-old {\n  font-family: c4keycaps;\n}\n\n.engraving-icon {\n  top: -9px;\n}\n\n.engraving-icon-remove {\n  color: #af4148;\n}\n\n.engraving-icon-btn-collection {\n  position: relative;\n  top: 38px;\n  color: #999;\n  width: 80px;\n  font-size: 17px;\n}\n\n.engraving-line-one {\n  overflow: hidden;\n  white-space: nowrap;\n  max-width: 122px;\n  display: inline-block;\n}\n\n.engraving-line-one.has-icon {\n  max-width: 90px;\n}\n\n.engraving-line-two {\n  overflow: hidden;\n  white-space: nowrap;\n  max-width: 122px;\n}\n\n@font-face {\n  font-family: "Gotham";\n  src: url(\'Gotham-Book.b61df993dabc0406618f.otf\') format("opentype"), url(\'Gotham-Book.34255f684028c1a325b2.woff2\') format("woff2"), url(\'Gotham-Book.86ba59ef46c737f3dedd.ttf\') format("truetype");\n  font-weight: normal;\n}\n\n@font-face {\n  font-family: "HanSansSC";\n  src: url(\'SourceHanSansSC-VF.ttf.46ec2a5a255d40f31618.woff2\') format("woff2"), url(\'SourceHanSansSC-VF.otf.9e2fe135c5ad488b2d22.woff2\') form