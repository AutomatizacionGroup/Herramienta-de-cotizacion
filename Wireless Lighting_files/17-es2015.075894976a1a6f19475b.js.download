tatus.stockStatusType)}} <small>{{stockStatus.count}}</small></span>\n\t\t\t\t</label>\n\t\t\t</ng-container>\n\t\t</div>\n\t\t<div *ngFor="let filterGroup of filters | orderBy: [\'label\']; index as i">\n\t\t\t<ng-container *ngIf="filterGroup.filters?.length > 1">\n\t\t\t\t<h3 *ngIf="!(isMobile$ | async)">{{filterGroup.label}}</h3>\n\t\t\t\t<h3 *ngIf="isMobile$ | async"><a attr.test-id="selectFilterGroupClick-{{i}}" (click)="selectFilterGroup(filterGroup)">{{filterGroup.label}} <i\n\t\t\t\t\t\t   class="fal pull-right text-grey"\n\t\t\t\t\t\t   [ngClass]="filterGroup === selected ? \'fa-caret-down\' : \'fa-caret-right\'"\n\t\t\t\t\t\t   style="top: 4px;"></i></a></h3>\n\t\t\t\t<ng-container *ngFor="let filterItem of filterGroup.filters; index as j">\n\t\t\t\t\t<label c4Track="click" [trackLabel]="filterItem.label" trackCategory="Product Filter"\n\t\t\t\t\t\t   *ngIf="!(isMobile$ | async) || filterGroup === selected || (filter.filters | productFilterSelected: filterItem: filterGroup)">\n\t\t\t\t\t\t<input attr.test-id="filterGroupCheckbox-{{i}}-{{j}}" type="checkbox"\n\t\t\t\t\t\t\t   [ngModel]="filter.filters | productFilterSelected: filterItem: filterGroup"\n\t\t\t\t\t\t\t   (ngModelChange)="updateFilterGroup(filterGroup, filterItem)" />\n\t\t\t\t\t\t<i class="fal fa-check text-primary"></i>\n\t\t\t\t\t\t<span>{{filterItem.label}} <small>{{ filter | productFilterCount: filterItem: filterGroup: products }}</small></span>\n\t\t\t\t\t</label>\n\t\t\t\t</ng-container>\n\t\t\t</ng-container>\n\t\t</div>\n\t</div>\n</div>'},beFs:function(t,e){t.exports='<c4-propaganda [height]="350" propagandaType="Slide" pageType="Product"></c4-propaganda>\n<div class="padding">\n\t<c4-product-search title="Products"></c4-product-search>\n\t<c4-static-content id="product-landing-top-ish"></c4-static-content>\n\t<div class="row" *ngIf="false && !loaded">\n\t\t<div class="col-sm-12">\n\t\t\t<c4-loading></c4-loading>\n\t\t</div>\n\t</div>\n\t<ng-container *ngIf="(featuredProducts$ | async