es\' }" class="text-dark">\n\t\t\t\t\t\t<div class="col-8">Upgrade Requests</div>\n\t\t\t\t\t\t<div class="col-4 text-right">{{leadCounts.openUpgrades}}</div>\n\t\t\t\t\t</a>\n\t\t\t\t</div>\n\t\t\t\t<div class="row" *ngIf="leadCounts.openShowrooms > 0">\n\t\t\t\t\t<a routerLink="/dashboard/leads" [queryParams]="{ view: \'showrooms\' }" class="text-dark">\n\t\t\t\t\t\t<div class="col-8">Showroom Leads</div>\n\t\t\t\t\t\t<div class="col-4 text-right">{{leadCounts.openShowrooms}}</div>\n\t\t\t\t\t</a>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t</div>\n\t\t<div *ngIf="canSeeControllers" class="table table-small no-margin">\n\t\t\t<div class="head">\n\t\t\t\t<div class="row">\n\t\t\t\t\t<div class="col-8">\n\t\t\t\t\t\t<h4 class="uppercase no-margin">Customer Projects</h4>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t\t<div class="body">\n\t\t\t\t<div class="row">\n\t\t\t\t\t<a routerLink="/dashboard/controllers" class="text-dark">\n\t\t\t\t\t\t<div class="col-8">Outdated Controllers</div>\n\t\t\t\t\t\t<div class="col-4 text-right">{{controllerUpgrade | async}}</div>\n\t\t\t\t\t</a>\n\t\t\t\t</div>\n\t\t\t\t<div class="row">\n\t\t\t\t\t<a routerLink="/dashboard/licenses" class="text-dark">\n\t\t\t\t\t\t<div class="col-8">License Opportunities</div>\n\t\t\t\t\t\t<div class="col-4 text-right">{{licenseUpdate | async}}</div>\n\t\t\t\t\t</a>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t</div>\n\t\t<p>\n\t\t\t<small>You have leads and upgrade opportunities that you can access from the <a\n\t\t\t\t\trouterLink="/dashboard/leads">leads</a><span *ngIf="canSeeControllers">, <a\n\t\t\t\t\t\trouterLink="/dashboard/controllers">controllers</a>, and <a routerLink="/dashboard/licenses">licenses</a>\n\t\t\t\t\tdashboards</span>.\n\t\t\t</small>\n\t\t</p>\n\t</ng-container>\n</c4-widget>'},h3YM:function(t,e){t.exports='<c4-loading *ngIf="!loaded"></c4-loading>\n<ul class="no-style" *ngIf="loaded">\n\t<li>\n\t\t<div class="row">\n\t\t\t<div class="col-sm-9 col-10">\n\t\t\t\t<p class="no-margin">\