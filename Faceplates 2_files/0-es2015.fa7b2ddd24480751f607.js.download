(window.webpackJsonp=window.webpackJsonp||[]).push([[0],{"/U6v":function(t,e){t.exports="div.table > div.row, .table > div.row, div.table .body > div.row, .table .body > div.row, div.table > .row, .table > .row, div.table .body > .row, .table .body > .row {\n  min-height: 37.5px;\n}\n\ndiv.table > div.row div[class^=col-], .table > div.row div[class^=col-], div.table .body > div.row div[class^=col-], .table .body > div.row div[class^=col-], div.table > .row div[class^=col-], .table > .row div[class^=col-], div.table .body > .row div[class^=col-], .table .body > .row div[class^=col-] {\n  padding: 6px 0;\n}\n\n/* For Firefox */\n\ninput[type=number] {\n  -moz-appearance: textfield;\n}\n\n/* Webkit browsers like Safari and Chrome */\n\ninput[type=number]::-webkit-inner-spin-button,\ninput[type=number]::-webkit-outer-spin-button {\n  -webkit-appearance: none;\n  margin: 0;\n}\n\n.swap-animation.ng-enter, .swap-animation.ng-leave {\n  -webkit-transition: 0.2s linear all;\n  transition: 0.2s linear all;\n}\n\n.swap-animation.ng-enter {\n  left: -50px;\n}\n\n.swap-animation.ng-enter-active {\n  left: 0px;\n}\n\n.swap-animation.ng-leave {\n  left: 30px;\n}\n\n.swap-animation.ng-leave-active {\n  left: 100px;\n  opacity: 0;\n}\n\n.swap-animation.reverse.ng-leave {\n  left: -30px;\n}\n\n.swap-animation.reverse.ng-leave-active {\n  left: -100px;\n}\n\n.swap-animation.reverse.ng-enter {\n  left: 50px;\n}\n\n.swap-animation.reverse.ng-enter-active {\n  left: 0px;\n  opacity: 0;\n}\n\nh1 sup,\np sup,\nsmall sup {\n  line-height: 12px;\n}\n\n@media (min-width: 999px) {\n  .row.vir .col-md-6:first-child {\n    border-right: 1px solid rgba(0, 0, 0, 0.07);\n    padding-right: 25px;\n  }\n}"},"/YVK":function(t,e){t.exports='<div>\n\t<div *ngIf="!preview">\n\t\t<form>\n\t\t\t<h3>{{action}} a Testimonial</h3>\n\t\t\t<div class="half-padding-top">\n\t\t\t\t<div class="row no-margin">\n\t\t\t\t\t<mat-form-field class="col-sm-8">\n\t\t\t\t\t\t<input test-id="testimonialName" matInput type="text" placeholder="Name" name="name" [(ngModel)]="edit.name" required>\n\t\t\t\t\t</mat-form-field>\n\t\t\t\t\t<mat-form-field class="col-sm-4">\n\t\t\t\t\t\t<input test-id="testimonialLocation" matInput type="text" placeholder="State (Location)" name="state"\n\t\t\t\t\t\t\t   [(ngModel)]="edit.state">\n\t\t\t\t\t</mat-form-field>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t\t<div class="half-padding-top">\n\t\t\t\t<div class="placeholder-wrapper" [ngClass]="{\'placeholder-visible\' : edit.testimonialText}">\n\t\t\t\t\t<div class="placeholder-text" *ngIf="edit.testimonialText">Testimonial *</div>\n\t\t\t\t\t<textarea test-id="testimonialText" name="testimonial" [(ngModel)]="edit.testimonialText" placeholder="Testimonial *"\n\t\t\t\t\t\t\t  maxlength="250" required></textarea>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t</form>\n\t\t<div class="clearfix">\n\t\t\t<button test-id="saveTestimonialClick" class="pull-right" (click)="save()"\n\t\t\t\t\t[disabled]="!(edit.name?.trim() && edit.testimonialText?.trim())">Save</button>\n\t\t\t<button test-id="cancelEditTestimonialClick" class="grey pull-right" (click)="cancel()">Cancel</button>\n\t\t</div>\n\t</div>\n</div>'},"2WiM":function(t,e){t.exports='<div class="widget widget-fixed-height home">\n\t<h3 *ngIf="!hideHeader" class="widget-header-white">Premier Dealer</h3>\n\t<div class="padding">\n\t\t<c4-loading *ngIf="loading"></c4-loading>\n\t\t<div *ngIf="!loading && info?.valid">\n\t\t\t<h4 class="no-margin">&nbsp;</h4>\n\t\t\t<a routerLink="/marketing/branding">\n\t\t\t\t<h1 class="no-margin text-{{ info.currentStatus | lowercase }}">{{ info.currentStatus }}&nbsp;</h1>\n\t\t\t</a>\n\t\t\t<p class="no-margin" style="padding-bottom: 12.5px;">\n\t\t\t\t<small>Current Status</small>\n\t\t\t</p>\n\t\t\t<c4-goal-progress *ngIf="info.hasControllersGoal" label="Controllers Purchased This Year"\n\t\t\t\t\t\t\t  title="Controller Data For This Year" [earned]="info.controllersAmount" [nextMilestone]="info.maximumControllers"\n\t\t\t\t\t\t\t  [atMax]="info.controllersAtMax" [min]="info.minimumControllers"\n\t\t\t\t\t\t\t  [minLabel]="info.currentControllersGoalName" [max]="info.maximumControllers"\n\t\t\t\t\t\t\t  [maxLabel]="info.nextControllersGoalName" [percent]="info.controllersPercentComplete">\n\t\t\t</c4-goal-progress>\n\t\t\t<c4-goal-progress label="Net Purchases This Year" title="Net Purchase Data For This Year"\n\t\t\t\t\t\t\t  [earned]="info.salesAmount" [nextMilestone]="info.maximumSales" [atMax]="info.salesAtMax" [min]="info.minimumSales"\n\t\t\t\t\t\t\t  [minLabel]="info.currentSalesGoalName" [max]="info.maximumSales" [maxLabel]="info.nextSalesGoalName"\n\t\t\t\t\t\t\t  [percent]="info.salesPercentComplete" [currency]="currency$ | async">\n\t\t\t</c4-goal-progress>\n\t\t\t<p class="text-right no-margin half-margin-top">\n\t\t\t\t<small class="block" *ngIf="snapRewardsTier$ | async as tier">Snap Rewards Status: {{tier}}</small>\n\t\t\t\t<small>Updated <b>{{info.lastUpdated | distanceFromNow}}</b></small>\n\t\t\t</p>\n\t\t</div>\n\t</div>\n\t<a *ngIf="!hideFlyout" routerLink="/programs/premier-dealer" style="line-height: 50px;"\n\t   class="c4btn block light-grey absolute bottom no-margin" c4Track="Click Through" trackCategory="Home"\n\t   trackLabel="Learn About Dealer Status">Learn More</a>\n</div>'},"3LPl":function(t,e){t.exports=""},"4Uu5":function(t,e){t.exports="[name=hoursOfOperation] {\n  height: 175px;\n}\n\nul.inline-block {\n  padding: 0;\n  margin: 0;\n}\n\nul.inline-block li {\n  display: inline-block;\n}\n\n.card h3,\n.card p {\n  margin-top: 0;\n  margin-bottom: 0;\n  overflow: hidden;\n  text-overflow: ellipsis;\n}\n\n.card h3 {\n  height: 50px;\n}\n\n.card p {\n  height: 42px;\n}\n\n.c4close {\n  height: 30px;\n  width: 30px;\n  line-height: 30px;\n  font-weight: 300;\n  text-align: center;\n  border-radius: 50%;\n}\n\n.c4close::before {\n  color: transparent;\n  line-height: 30px;\n}\n\n:hover > .c4close::before {\n  color: #8a2432;\n}\n\n*:hover > .c4close {\n  background-color: #fff;\n  box-shadow: 0 5px 5px rgba(0, 0, 0, 0.2);\n}\n\n*:hover > .c4close:not(:hover)::before {\n  color: #6e6b6f;\n}"},"7iQL":function(t,e){t.exports='<div class="widget widget-fixed-height home">\n\t<h3 *ngIf="!hideHeader" class="widget-header-white">Rebates</h3>\n\t<div class="absolute top block text-right" *ngIf="generalProgress && enableModeling">\n\t\t<button test-id="toggleDisplayWindowClick" class="no-margin" [ngClass]="isModel ? \'light-grey\' : \'transparent\'" (click)="toggleDisplayWindow()"\n\t\t\t\tstyle="border-left: 1px solid #eee; width: 100px">{{isModel ? \'Back\' : \'Model\'}}</button>\n\t</div>\n\t<div class="padding" *ngIf="loading">\n\t\t<c4-loading *ngIf="loading"></c4-loading>\n\t</div>\n\t<div class="padding" *ngIf="!loading">\n\t\t<div *ngIf="!valid" class="vertically-center text-center" style="z-index: 1;">\n\t\t\t<p>No rebate data available.</p>\n\t\t</div>\n\t\t<div *ngIf="valid">\n\t\t\t<div [hidden]="isModel">\n\t\t\t\t<div class="row vir">\n\t\t\t\t\t<div class="col-sm-6" *ngIf="generalProgress && (showDealerRebate$ | async)">\n\t\t\t\t\t\t<h3 class="text-dark no-margin">Dealer Rebate</h3>\n\t\t\t\t\t\t<h1 class="text-right no-margin"\n\t\t\t\t\t\t\t[ngClass]="generalProgress.earnedReward ? \'text-success\' : \'text-red\'"> {{ generalProgress.earnedReward | currency: currencySymbol}}\n\t\t\t\t\t\t</h1>\n\t\t\t\t\t\t<p class="text-right no-margin truncate" style="padding-bottom: 12.5px;">\n\t\t\t\t\t\t\t<small>\n\t\t\t\t\t\t\t\t<span *ngIf="generalProgress.currentRewardPercent > 0">Rebate earned this quarter at</span>\n\t\t\t\t\t\t\t\t<span *ngIf="generalProgress.currentRewardPercent == 0">\n\t\t\t\t\t\t\t\t\t<strong>Requirements not met</strong> for </span>\n\t\t\t\t\t\t\t\t<span [class.bold]="generalProgress.currentRewardPercent">\n\t\t\t\t\t\t\t\t\t{{(generalProgress.currentRewardPercent || generalProgress.nextGoalReward) | percent: \'1.1\' }} </span> of <span\n\t\t\t\t\t\t\t\t\t  [class.bold]="generalProgress.currentRewardPercent"> {{ generalProgress.rewardableEarnings | currency: currencySymbol }}\n\t\t\t\t\t\t\t\t</span>.*</small>\n\t\t\t\t\t\t</p>\n\t\t\t\t\t\t<p class="no-margin truncate">\n\t\t\t\t\t\t\t<small>Quarterly Dealer Rebate Requirements</small>\n\t\t\t\t\t\t</p>\n\t\t\t\t\t\t<c4-goal-progress label="Net Purchases This Quarter"\n\t\t\t\t\t\t\t\t\t\t  [color]="generalProgress.minimumSales > 0 ? \'success\' : \'warning\'"\n\t\t\t\t\t\t\t\t\t\t  [atMax]="generalProgress.atMax" [currency]="currencySymbol"\n\t\t\t\t\t\t\t\t\t\t  [earned]="generalProgress.earnings" [min]="generalProgress.minimumSales"\n\t\t\t\t\t\t\t\t\t\t  [max]="generalProgress.maximumSales"\n\t\t\t\t\t\t\t\t\t\t  maxLabel="Earn {{generalProgress.nextGoalReward | percent: \'1.1\'}}" [precision]="1"\n\t\t\t\t\t\t\t\t\t\t  [percent]="generalProgress.percentComplete"></c4-goal-progress>\n\t\t\t\t\t\t<p *ngIf="generalProgress.atMax">\n\t\t\t\t\t\t\t<small>Quarter ends {{lastDayOfQuarter | date: \'MMM dd, yyyy\'}}. You have <span class="bold">{{daysLeftInQuarter}} day<span\n\t\t\t\t\t\t\t\t\t\t  *ngIf="daysLeftInQuarter > 1">s</span>\n\t\t\t\t\t\t\t\t</span> left of the quarter to maximize receiving top-tier <span\n\t\t\t\t\t\t\t\t\t  class="bold text-success">{{ generalProgress.currentRewardPercent | percent:\'1.1\'}} credit</span> rebate on all <span\n\t\t\t\t\t\t\t\t\t  style="white-space: nowrap">qualified sales <sup>\u2020</sup>.</span>\n\t\t\t\t\t\t\t</small>\n\t\t\t\t\t\t</p>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div [ngClass]="generalProgress && (showDealerRebate$ | async) ? \'col-sm-6\' : \'col-sm-12\'"\n\t\t\t\t\t\t *ngIf="triadProgress && (showTriadRebate$ | async)">\n\t\t\t\t\t\t<h3 class="text-dark no-margin">Triad Speakers Rebate </h3>\n\t\t\t\t\t\t<div>\n\t\t\t\t\t\t\t<h1 class="text-right no-margin"\n\t\t\t\t\t\t\t\t[ngClass]="triadProgress.earnedReward ? \'text-success\' : \'text-grey\'">{{\n\t\t\t\t\t\t\t\ttriadProgress.earnedReward | currency: currencySymbol}}</h1>\n\t\t\t\t\t\t\t<p class="text-right no-margin truncate" style="padding-bottom: 12.5px;">\n\t\t\t\t\t\t\t\t<small>\n\t\t\t\t\t\t\t\t\t<span *ngIf="triadProgress.currentRewardPercent > 0">Rebate earned this quarter at</span>\n\t\t\t\t\t\t\t\t\t<span *ngIf="triadProgress.currentRewardPercent == 0">\n\t\t\t\t\t\t\t\t\t\t<strong>Requirements not met</strong> for </span>\n\t\t\t\t\t\t\t\t\t<b>{{triadProgress.currentRewardPercent | percent: \'1.1\'}}</b> of\n\t\t\t\t\t\t\t\t\t<b>{{triadProgress.rewardableEarnings | currency: currencySymbol}}</b>.*</small>\n\t\t\t\t\t\t\t</p>\n\t\t\t\t\t\t\t<p class="no-margin truncate">\n\t\t\t\t\t\t\t\t<small>Triad Speakers Rebate Requirements</small>\n\t\t\t\t\t\t\t</p>\n\t\t\t\t\t\t\t<c4-goal-progress label="Net Purchases This Quarter"\n\t\t\t\t\t\t\t\t\t\t\t  [color]="triadProgress.minimumSales > 0 ? \'success\' : \'warning\'"\n\t\t\t\t\t\t\t\t\t\t\t  [atMax]="triadProgress.amountNeeded <= 0" [currency]="currencySymbol"\n\t\t\t\t\t\t\t\t\t\t\t  [earned]="triadProgress.earnings" [min]="triadProgress.minimumSales"\n\t\t\t\t\t\t\t\t\t\t\t  [max]="triadProgress.maximumSales"\n\t\t\t\t\t\t\t\t\t\t\t  maxLabel="Earn {{triadProgress.nextGoalReward | percent: \'1.1\'}}" [precision]="1"\n\t\t\t\t\t\t\t\t\t\t\t  [percent]="triadProgress.percentComplete"></c4-goal-progress>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class="row vir">\n\t\t\t\t\t<div class="col-md-6" *ngIf="generalProgress && (showDealerRebate$ | async)">\n\t\t\t\t\t\t<p *ngIf="generalProgress.atMax">\n\t\t\t\t\t\t\t<small>Quarter ends {{ lastDayOfQuarter | date: \'MMM dd, yyyy\' }}. You have <span class="bold">{{daysLeftInQuarter}} day<span\n\t\t\t\t\t\t\t\t\t\t  *ngIf="daysLeftInQuarter > 1">s</span>\n\t\t\t\t\t\t\t\t</span> left of the quarter to maximize receiving top-tier <span\n\t\t\t\t\t\t\t\t\t  class="bold text-success">{{generalProgress.currentRewardPercent | percent: \'1.1\' }} credit</span> rebate on all <span\n\t\t\t\t\t\t\t\t\t  style="white-space: nowrap">qualified purchases<sup>*</sup>.</span>\n\t\t\t\t\t\t\t</small>\n\t\t\t\t\t\t</p>\n\t\t\t\t\t\t<p *ngIf="!generalProgress.atMax">\n\t\t\t\t\t\t\t<small>Spend an additional <b>{{generalProgress.amountNeeded | currency: currencySymbol}}</b> to reach your next goal and get up to\n\t\t\t\t\t\t\t\tan additional <b>{{generalProgress.optimalNextGoalReward | currency: currencySymbol}}</b> back, an effective order discount\n\t\t\t\t\t\t\t\t<span style="white-space: nowrap">of <b>{{ generalProgress.optimalOrderDiscount | percent: \'1.1\' }}</b>.</span>\n\t\t\t\t\t\t\t</small>\n\t\t\t\t\t\t</p>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div [ngClass]="generalProgress && (showDealerRebate$ | async) ? \'col-md-6\' : \'col-md-12\'"\n\t\t\t\t\t\t *ngIf="triadProgress && (showTriadRebate$ | async)">\n\t\t\t\t\t\t<p class="no-margin" *ngIf="!triadProgress.atMax">\n\t\t\t\t\t\t\t<small>Spend an additional <b>{{triadProgress.amountNeeded | currency: currencySymbol}}</b> on <a\n\t\t\t\t\t\t\t\t   routerLink="/products/{{(isEmea$ | async) ? 1199 : 1530}}"\n\t\t\t\t\t\t\t\t   [queryParams]="{ filter: (isEmea$ | async) ? \'2_20\' : \'24_20\' }">qualified Triad Speakers purchases</a> to reach your next\n\t\t\t\t\t\t\t\tgoal and get an additional <b>{{triadProgress.optimalNextGoalReward | currency: currencySymbol}}</b> back, an effective order\n\t\t\t\t\t\t\t\tdiscount <span style=" white-space: nowrap">of <b>{{ triadProgress.optimalOrderDiscount | percent: \'1.1\' }}</b>.</span>\n\t\t\t\t\t\t\t</small>\n\t\t\t\t\t\t</p>\n\t\t\t\t\t\t<p *ngIf="triadProgress.atMax">\n\t\t\t\t\t\t\t<small>Quarter ends {{ lastDayOfQuarter | date: \'MMM dd, yyyy\' }}. You have <span class="bold">{{daysLeftInQuarter}} day<span\n\t\t\t\t\t\t\t\t\t\t  *ngIf="daysLeftInQuarter > 1">s</span>\n\t\t\t\t\t\t\t\t</span> left of the quarter to maximize receiving top-tier <span\n\t\t\t\t\t\t\t\t\t  class="bold text-success">{{triadProgress.currentRewardPercent | percent: \'1.1\' }} credit</span> rebate on all <span\n\t\t\t\t\t\t\t\t\t  style="white-space: nowrap">\n\t\t\t\t\t\t\t\t\t<a routerLink="/products/{{(isEmea$ | async) ? 1199 : 1530}}"\n\t\t\t\t\t\t\t\t\t   [queryParams]="{ filter: (isEmea$ | async) ? \'2_20\' : \'24_20\' }">qualified Triad Speakers\n\t\t\t\t\t\t\t\t\t\tpurchases</a><sup>*</sup>.</span>\n\t\t\t\t\t\t\t</small>\n\t\t\t\t\t\t</p>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<p class="text-right no-margin vir half-margin-top">\n\t\t\t\t\t<small class="block"> Updated <b>{{ lastUpdated | distanceFromNow }}</b>\n\t\t\t\t\t\t<br>*Restrictions apply. To learn more <a routerLink="/programs/rebate">click here</a>.</small>\n\t\t\t\t</p>\n\t\t\t</div>\n\t\t</div>\n\t</div>\n\t<div class="row block no-margin absolute bottom">\n\t\t<div [ngClass]="triadProgress ? \'col-md-6\' : \'col-md-12\'"\n\t\t\t *ngIf="generalProgress && (showDealerRebate$ | async)">\n\t\t\t<a *ngIf="!hideFlyout" routerLink="/programs/rebate" class="c4btn block light-grey no-margin"\n\t\t\t   c4Track="Click Through" trackCategory="Home" trackLabel="Learn About Our Rebate Programs">Learn More</a>\n\t\t</div>\n\t\t<div [ngClass]="generalProgress ? \'col-md-6\' : \'col-md-12\'" *ngIf="triadProgress && (showTriadRebate$ | async)">\n\t\t\t<a *ngIf="!hideFlyout" routerLink="/programs/triad-loyalty" class="c4btn block light-grey no-margin "\n\t\t\t   c4Track="Click Through" trackCategory="Home" trackLabel="Learn About Our Rebate Programs">Learn More</a>\n\t\t</div>\n\t</div>\n</div>'},BG2i:function(t,e){t.exports='<div>\n\t<h2 id="micrositeTop" class="no-margin half-margin-top"><span class="bold">Editing</span><br /> {{location.cardName}} <img\n\t\t\t *ngIf="location.isCertifiedShowroom"\n\t\t\t style="margin-left: 6px; vertical-align: text-top;"\n\t\t\t src="https://res.cloudinary.com/control4/image/upload/c_scale,h_30,f_auto,q_100/v1512145430/www/control4/C4-Certified-Badge.png" />\n\t</h2>\n\t<div class="table">\n\t\t<div class="body">\n\t\t\t<div class="row">\n\t\t\t\t<div class="col-sm-12">\n\t\t\t\t\t<ul class="no-style">\n\t\t\t\t\t\t<li class="bold">{{location.street}}</li>\n\t\t\t\t\t\t<li class="bold" *ngIf="location.block">{{location.block}}</li>\n\t\t\t\t\t\t<li class="bold">{{location.city}}<span *ngIf="location.state">, {{location.state}}</span>, {{location.zipCode}}</li>\n\t\t\t\t\t\t<li *ngIf="location.website">{{location.website}}</li>\n\t\t\t\t\t\t<li *ngIf="location.email">{{location.email}}</li>\n\t\t\t\t\t\t<li *ngIf="location.phone">{{location.phone}}</li>\n\t\t\t\t\t</ul>\n\t\t\t\t\t<small>To change address and contact information please contact the <a href="mailto:International@adiglobal.com">Sales Support\n\t\t\t\t\t\t\tTeam</a>.</small>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t</div>\n\t</div>\n\t<form novalidate>\n\t\t<div class="border-bottom half-margin-top half-padding-bottom">\n\t\t\t<h3 class="half-margin-bottom">Microsite Opt-Out</h3>\n\t\t\t<div class="row half-padding-bottom">\n\t\t\t\t<div class="col-sm-4">\n\t\t\t\t\t<span class="block">Participation</span>\n\t\t\t\t\t<small class="block">Your dealer locator locations are defaulted to enable microsites. If for any reason you\'d like to not have a microsite,\n\t\t\t\t\t\tplease uncheck.</small>\n\t\t\t\t</div>\n\t\t\t\t<div class="col-sm-8">\n\t\t\t\t\t<label><input test-id="isMicrositeParticipantRadio" [(ngModel)]="location.isMicrositeParticipant" name="isMicrositeParticipant"\n\t\t\t\t\t\t\t   [value]="true" type="radio" /> Yes, I would like a microsite for this location</label>\n\t\t\t\t\t<label><input test-id="isNotMicrositeParticipantRadio" [(ngModel)]="location.isMicrositeParticipant" name="isMicrositeParticipant"\n\t\t\t\t\t\t\t   [value]="false" type="radio" /> No, I would not like a microsite for this location</label>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t</div>\n\t\t<div *ngIf="location.isMicrositeParticipant">\n\t\t\t<div class="border-bottom half-margin-top half-padding-bottom">\n\t\t\t\t<h3 class="half-margin-bottom">Microsite URL</h3>\n\t\t\t\t<small class="block">Share this link via social media and email</small>\n\t\t\t\t<div class="row no-margin">\n\t\t\t\t\t<div class="col-sm-4 col-6">\n\t\t\t\t\t\t<input test-id="generatedWwwUrl" type="text" disabled [value]="generateWwwUrl()" />\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="col-sm-2 col-3">\n\t\t\t\t\t\t<button test-id="copyRsvpLink" class="c4btn no-margin block grey" title="Copy RSVP Link"\n\t\t\t\t\t\t\t\t(click)="createShareLink();"><i class="fal fa-link"></i>Copy</button>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="col-sm-4 col-3">\n\t\t\t\t\t\t<a class="c4btn transparent" target="_blank" [href]="generateWwwUrl()"><i\n\t\t\t\t\t\t\t   class="fal fa-external-link"></i>View</a>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t\t<div class="border-bottom half-margin-top half-padding-bottom" *ngIf="location.isCertifiedShowroom">\n\t\t\t\t<h3 class="half-margin-bottom">C4Yourself Event Details</h3>\n\t\t\t\t<div class="row half-padding-bottom">\n\t\t\t\t\t<div class="col-sm-4">\n\t\t\t\t\t\t<span class="block">Participation</span>\n\t\t\t\t\t\t<small class="block">RSVP page, lead capture, and event details</small>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="col-sm-8">\n\t\t\t\t\t\t<label><input test-id="isEventParticipantRadio" [(ngModel)]="location.isEventParticipant" name="isEventParticipant" [value]="true"\n\t\t\t\t\t\t\t\t   type="radio" /> Yes, this showroom is participating in C4Yourself Events.</label>\n\t\t\t\t\t\t<label><input test-id="isNotEventParticipantRadio" [(ngModel)]="location.isEventParticipant" name="isEventParticipant"\n\t\t\t\t\t\t\t\t   [value]="false" type="radio" /> No, this showroom is not participating.</label>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class="row" *ngIf="location.isEventParticipant">\n\t\t\t\t\t<div class="col-sm-8 offset-sm-4">\n\t\t\t\t\t\t<textarea test-id="eventDescription" class="block no-margin" maxlength="500"\n\t\t\t\t\t\t\t\t  placeholder="Additional event details, e.g. planned giveaways, food served, musical guests, special demonstrations"\n\t\t\t\t\t\t\t\t  name="eventDescription" [(ngModel)]="company.eventDescription"></textarea>\n\t\t\t\t\t\t<small class="block text-right">{{company.eventDescription?.length}} / 500 characters</small>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t\t<div class="border-bottom half-margin-top">\n\t\t\t\t<h3 class="half-margin-bottom">Company Details</h3>\n\t\t\t\t<div class="row half-padding-bottom">\n\t\t\t\t\t<div class="col-sm-4">\n\t\t\t\t\t\t<span class="block">Company Logo*</span>\n\t\t\t\t\t\t<small class="block">Accepted file types: PNG, SVG, EPS.<br />(logo will be displayed on a white background)</small>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="col-sm-8">\n\t\t\t\t\t\t<c4-file-upload test-id="c4-file-upload-logo" *ngIf="!company?.logo" classes="light-grey text-dark no-margin"\n\t\t\t\t\t\t\t\t\t\ttext="Upload Company Logo" [maxFiles]="1" preset="" [allowCamera]="false"\n\t\t\t\t\t\t\t\t\t\t(complete)="updateLogo($event)"></c4-file-upload>\n\t\t\t\t\t\t<div *ngIf="company?.logo">\n\t\t\t\t\t\t\t<div class="background-contain" style="height: 120px; width: 180px;"\n\t\t\t\t\t\t\t\t style.backgroundImage="url({{company.logo}})">\n\t\t\t\t\t\t\t\t<a href="javascript:;" test-id="cancelCompanyLogoUploadClick" class="c4close" (click)="company.logo = null"></a>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class="row half-padding-bottom">\n\t\t\t\t\t<div class="col-sm-4">\n\t\t\t\t\t\t<span class="block">Showroom Photo</span>\n\t\t\t\t\t\t<small class="block">Upload one photo showcasing your showroom. Accepted file types: JPG, PNG.<br />(photo will be oriented in\n\t\t\t\t\t\t\tlandscape)</small>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="col-sm-4">\n\t\t\t\t\t\t<c4-file-upload test-id="c4-file-upload-showroomImage" *ngIf="!company?.showroomImage" classes="light-grey text-dark no-margin"\n\t\t\t\t\t\t\t\t\t\ttext="Upload Showroom Photo" [maxFiles]="1" preset="" [allowCamera]="false"\n\t\t\t\t\t\t\t\t\t\t(complete)="updateShowroomImage($event)">\n\t\t\t\t\t\t</c4-file-upload>\n\t\t\t\t\t\t<ul class="inline-block" *ngIf="company?.showroomImage">\n\t\t\t\t\t\t\t<li>\n\t\t\t\t\t\t\t\t<a href="javascript:" test-id="cancelShowroomImageUploadClick" (click)="company.showroomImage = null" class="c4close"></a>\n\t\t\t\t\t\t\t\t<img src="{{company.showroomImage}}" />\n\t\t\t\t\t\t\t</li>\n\t\t\t\t\t\t</ul>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div id="associations" class="row half-padding-bottom">\n\t\t\t\t\t<div class="col-sm-4">\n\t\t\t\t\t\t<span class="block">Industry Associations</span>\n\t\t\t\t\t\t<small class="block">Select the industry/s that your showroom is associated with.</small>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="col-sm-8">\n\t\t\t\t\t\t<c4-enum-checkbox test-id="associationBadgeCheckboxes" [labelMap]="associationBadgeUrls" [(value)]="company.associations"\n\t\t\t\t\t\t\t\t\t\t  [areImages]=true>\n\t\t\t\t\t\t</c4-enum-checkbox>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class="row half-padding-bottom">\n\t\t\t\t\t<div class="col-sm-4">\n\t\t\t\t\t\t<span class="block">Hours</span>\n\t\t\t\t\t\t<small class="block">Hours of operation. Use a new line for each block of hours.<br> For example:<br>\n\t\t\t\t\t\t\t<br> Monday - Friday: 8am - 6pm<br> Saturday: 10am - 4pm<br> Closed Sunday</small>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="col-sm-8">\n\t\t\t\t\t\t<textarea test-id="hoursOfOperation" class="no-margin" maxlength="250"\n\t\t\t\t\t\t\t\t  placeholder="Example: Monday-Friday: 9 am - 5 pm etc." name="hoursOfOperation"\n\t\t\t\t\t\t\t\t  [(ngModel)]="company.hoursOfOperation"></textarea>\n\t\t\t\t\t\t<small class="block text-right">{{company.hoursOfOperation?.length}} / 250 characters</small>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class="row">\n\t\t\t\t\t<div class=col-sm-4></div>\n\t\t\t\t\t<div class=col-sm-8>\n\t\t\t\t\t\t<div class="row no-margin">\n\t\t\t\t\t\t\t<div class="col-12">\n\t\t\t\t\t\t\t\t<div class="alert alert-warning" *ngIf="!validGooglePlaceUrl">\n\t\t\t\t\t\t\t\t\t<p class="no-margin">{{googlePlaceURLError}}</p>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class="light-grey padding half-margin-bottom" *ngIf="showMap">\n\t\t\t\t\t<a class="c4close" test-id="toggleGoogleShareHelpClick" (click)="toggleGoogleShareHelp()"></a>\n\t\t\t\t\t<div class="row no-margin">\n\t\t\t\t\t\t<div class="col-sm-4 half-padding-right">\n\t\t\t\t\t\t\t<h4>How to find your Google Place URL</h4>\n\t\t\t\t\t\t\t<ol>\n\t\t\t\t\t\t\t\t<li>Find your company\'s Google Place business listing in <a\n\t\t\t\t\t\t\t\t\t   href="https://www.google.com/maps" target="_blank">Google Maps</a>. If you do not have a Google Place business listing,\n\t\t\t\t\t\t\t\t\tyou can <a\n\t\t\t\t\t\t\t\t\t   href="https://support.google.com/business/answer/2911778?hl=en"\n\t\t\t\t\t\t\t\t\t   target="_blank">create one here</a>.</li>\n\t\t\t\t\t\t\t\t<li>Once you have found your company, click "Share" and "Copy Link"</li>\n\t\t\t\t\t\t\t</ol>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class="col-sm-8">\n\t\t\t\t\t\t\t<img\n\t\t\t\t\t\t\t\t src="https://res.cloudinary.com/control4/image/upload/c_scale,f_auto,q_auto,w_800/v1540333365/google-place-share.png" />\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class="row half-padding-bottom">\n\t\t\t\t\t<div class="col-sm-4">\n\t\t\t\t\t\t<span class="block">Google Place</span>\n\t\t\t\t\t\t<small class="block">Google Place URL, <a href="javascript:;"\n\t\t\t\t\t\t\t   (click)="toggleGoogleShareHelp()">Where do I find this?</a></small>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="col-sm-8">\n\t\t\t\t\t\t<div class="row no-margin">\n\t\t\t\t\t\t\t<div class="col-2">\n\t\t\t\t\t\t\t\t<div class="input-label"><i class="fab fa-google"></i></div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class="col-10">\n\t\t\t\t\t\t\t\t<mat-form-field>\n\t\t\t\t\t\t\t\t\t<input test-id="googlePlace" matInput type="text" class="no-margin" maxlength="150" placeholder="Http://"\n\t\t\t\t\t\t\t\t\t\t   name="googlePlace" [(ngModel)]="company.googlePlace"\n\t\t\t\t\t\t\t\t\t\t   (ngModelChange)="validateGooglePlaceURL()" />\n\t\t\t\t\t\t\t\t</mat-form-field>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class="row half-padding-bottom">\n\t\t\t\t\t<div class="col-sm-4">\n\t\t\t\t\t\t<span class="block">About</span>\n\t\t\t\t\t\t<small class="block">What makes your company great?</small>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="col-sm-8">\n\t\t\t\t\t\t<textarea test-id="aboutUs" class="no-margin" maxlength="500" placeholder="What makes your company great?"\n\t\t\t\t\t\t\t\t  name="aboutUs" [(ngModel)]="company.aboutUs"></textarea>\n\t\t\t\t\t\t<small class="block text-right">{{company.aboutUs?.length}} / 500 characters</small>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class="row">\n\t\t\t\t\t<div class=col-sm-4></div>\n\t\t\t\t\t<div class=col-sm-8>\n\t\t\t\t\t\t<div class="row no-margin">\n\t\t\t\t\t\t\t<div class="col-12">\n\t\t\t\t\t\t\t\t<div class="alert alert-warning" *ngIf="!validSolutionCount">\n\t\t\t\t\t\t\t\t\t<p class="no-margin">{{control4SolutionsError}}</p>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div id="solutions" class="row half-padding-bottom">\n\t\t\t\t\t<div class="col-sm-4">\n\t\t\t\t\t\t<span class="block">Control4 Solutions Offered</span>\n\t\t\t\t\t\t<small class="block">Select between 4-8 solutions that you specialize in.</small>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="col-sm-8">\n\t\t\t\t\t\t<c4-enum-checkbox test-id="companySolutionCheckboxes" [labelMap]="solutionNames" [(value)]="company.solutions"\n\t\t\t\t\t\t\t\t\t\t  (change)="validateControl4SolutionCount()"></c4-enum-checkbox>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div id="galleryImages" class="row half-padding-bottom">\n\t\t\t\t\t<div class="col-sm-4">\n\t\t\t\t\t\t<span class="block">Gallery</span>\n\t\t\t\t\t\t<small class="block">Showcase additional showroom or project photos. We recommend a minimum of 3 and a maximum of 7 photos. Accepted\n\t\t\t\t\t\t\tfile types: JPG, PNG. Photos must be at least 600px tall.</small>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="col-sm-8">\n\t\t\t\t\t\t<c4-file-upload test-id="c4-file-upload-galleryImage" *ngIf="!galleryImage?.photoUrl" classes="light-grey no-margin text-dark"\n\t\t\t\t\t\t\t\t\t\ttext="Upload Gallery Image" [maxFiles]="1" preset="" [allowCamera]="false"\n\t\t\t\t\t\t\t\t\t\t(complete)="uploadGalleryImage($event)"></c4-file-upload>\n\t\t\t\t\t\t<div class="row" *ngIf="galleryImage?.photoUrl">\n\t\t\t\t\t\t\t<div class="col-5">\n\t\t\t\t\t\t\t\t<div class="background aspect one-to-one"\n\t\t\t\t\t\t\t\t\t style.backgroundImage="url({{galleryImage.photoUrl}})"></div>\n\t\t\t\t\t\t\t\t<p><small>{{galleryImage.caption}}</small></p>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class="col-3" *ngIf="galleryImage.photoUrl">\n\t\t\t\t\t\t\t\t<textarea test-id="galleryImageCaption" type="text" name="galleryImage" maxlength="100"\n\t\t\t\t\t\t\t\t\t\t  [(ngModel)]="galleryImage.caption" placeholder="Image Caption"></textarea>\n\t\t\t\t\t\t\t\t<p><small class="block text-right">{{galleryImage.caption?.length}} / 100 characters</small></p>\n\t\t\t\t\t\t\t\t<button test-id="addGalleryImageClick" class="dark-grey block" [disabled]="!galleryImage.photoUrl"\n\t\t\t\t\t\t\t\t\t\t(click)="addGalleryImage()"><i class="fal fa-check"></i>Add Gallery Image</button>\n\t\t\t\t\t\t\t\t<button test-id="cancelAddGalleryImageClick" class="transparent block" (click)="cancelGalleryImage()">Cancel</button>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class="half-margin-top" *ngIf="galleryImages?.length > 0">\n\t\t\t\t\t\t\t<ul class="inline-block">\n\t\t\t\t\t\t\t\t<li style="margin: 0 25px 25px 0;" *ngFor="let image of galleryImages; let i = index;">\n\t\t\t\t\t\t\t\t\t<div *ngIf="image?.photoUrl != \'\'">\n\t\t\t\t\t\t\t\t\t\t<a href="javascript:" attr.test-id="removeGalleryImageClick-{{i}}" (click)="removeGalleryImage(i)"\n\t\t\t\t\t\t\t\t\t\t   class="c4close"></a>\n\t\t\t\t\t\t\t\t\t\t<img class="block" style="height: 300px; width: auto;" [title]="image.caption"\n\t\t\t\t\t\t\t\t\t\t\t [src]="image.photoUrl" />\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t</li>\n\t\t\t\t\t\t\t</ul>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class="row half-padding-bottom">\n\t\t\t\t\t<div class="col-sm-4">\n\t\t\t\t\t\t<span class="block">Team Members</span>\n\t\t\t\t\t\t<small class="block">Showcase your employees</small>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="col-sm-8">\n\t\t\t\t\t\t<c4-file-upload test-id="c4-file-upload-employeeBioImage" *ngIf="!employeeBio?.photoUrl" classes="light-grey no-margin text-dark"\n\t\t\t\t\t\t\t\t\t\ttext="Upload Member Photo" [maxFiles]="1" preset="" [allowCamera]="false"\n\t\t\t\t\t\t\t\t\t\t(complete)="addEmployeeBioImage($event)"></c4-file-upload>\n\t\t\t\t\t\t<div class="half-margin-top">\n\t\t\t\t\t\t\t<div class="row" *ngIf="employeeBio?.photoUrl">\n\t\t\t\t\t\t\t\t<div class="col-md-3 col-6 half-margin-bottom">\n\t\t\t\t\t\t\t\t\t<mat-form-field>\n\t\t\t\t\t\t\t\t\t\t<input test-id="employeeBioName" matInput type="text" maxlength="32" name="employeeBio"\n\t\t\t\t\t\t\t\t\t\t\t   [(ngModel)]="employeeBio.name" placeholder="Name" />\n\t\t\t\t\t\t\t\t\t</mat-form-field>\n\t\t\t\t\t\t\t\t\t<mat-form-field>\n\t\t\t\t\t\t\t\t\t\t<input test-id="employeeBioDescription" matInput type="text" maxlength="50" name="employeeBioAttribute1"\n\t\t\t\t\t\t\t\t\t\t\t   [(ngModel)]="employeeBio.description" placeholder="Title or Role" />\n\t\t\t\t\t\t\t\t\t</mat-form-field>\n\t\t\t\t\t\t\t\t\t<button test-id="addTeamMemberClick" class="dark-grey block"\n\t\t\t\t\t\t\t\t\t\t\t[disabled]="!employeeBio.photoUrl || !employeeBio.name || !employeeBio.description"\n\t\t\t\t\t\t\t\t\t\t\t(click)="addEmployeeBio()"><i class="fal fa-check"></i>Add Team Member</button>\n\t\t\t\t\t\t\t\t\t<button test-id="cancelTeamMemberClick" class="transparent block" (click)="cancelEmployeeBio()">Cancel</button>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="col-6 half-margin-bottom">\n\t\t\t\t\t\t\t\t\t<div class="card shadow" style="width: 225px;">\n\t\t\t\t\t\t\t\t\t\t<div class="background aspect one-to-one"\n\t\t\t\t\t\t\t\t\t\t\t style.backgroundImage="url({{employeeBio.photoUrl}})"></div>\n\t\t\t\t\t\t\t\t\t\t<div class="padding">\n\t\t\t\t\t\t\t\t\t\t\t<h3>{{employeeBio.name}}</h3>\n\t\t\t\t\t\t\t\t\t\t\t<p>{{employeeBio.description}}</p>\n\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<ul class="inline-block" *ngIf="employeeBios?.length > 0">\n\t\t\t\t\t\t\t\t<li *ngFor="let bio of employeeBios; let i = index;"\n\t\t\t\t\t\t\t\t\tclass="half-padding-right half-padding-bottom">\n\t\t\t\t\t\t\t\t\t<div class="card shadow half-margin-bottom" *ngIf="bio?.name != \'\'"\n\t\t\t\t\t\t\t\t\t\t style="width: 225px;">\n\t\t\t\t\t\t\t\t\t\t<a href="javascript:;" attr.test-id="removeEmployeeBioClick-{{i}}" (click)="removeEmployeeBio(i)"\n\t\t\t\t\t\t\t\t\t\t   class="c4close"></a>\n\t\t\t\t\t\t\t\t\t\t<div class="background aspect one-to-one"\n\t\t\t\t\t\t\t\t\t\t\t style.backgroundImage="url({{bio.photoUrl}})"></div>\n\t\t\t\t\t\t\t\t\t\t<div class="padding">\n\t\t\t\t\t\t\t\t\t\t\t<h3>{{bio.name}}</h3>\n\t\t\t\t\t\t\t\t\t\t\t<p><small>{{bio.description}}</small></p>\n\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t</li>\n\t\t\t\t\t\t\t</ul>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t\t<div class="border-bottom half-margin-top">\n\t\t\t\t<h3 class="half-margin-bottom">Testimonials</h3>\n\t\t\t\t<div class="row half-padding-bottom">\n\t\t\t\t\t<div class="col-sm-4">\n\t\t\t\t\t\t<span class="block">Customer Testimonials</span>\n\t\t\t\t\t\t<small class="block">How do customers feel about your showroom? <br /> (please note that there is a limit of 4 testimonials)</small>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="col-sm-8">\n\t\t\t\t\t\t<c4-testimonial-list [dealerId]="location.dealerId" [lineNum]="location.lineNum"\n\t\t\t\t\t\t\t\t\t\t\t [testimonials]="customerTestimonials">\n\t\t\t\t\t\t</c4-testimonial-list>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t\t<div class="border-bottom half-margin-top">\n\t\t\t\t<h3 class="half-margin-bottom">Social Media</h3>\n\t\t\t\t<div class="row half-padding-bottom">\n\t\t\t\t\t<div class="col-sm-4">\n\t\t\t\t\t\t<span class="block">Blog</span>\n\t\t\t\t\t\t<small class="block">Blog URL</small>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="col-sm-8">\n\t\t\t\t\t\t<div class="row no-margin">\n\t\t\t\t\t\t\t<div class="col-2">\n\t\t\t\t\t\t\t\t<div class="input-label"><i class="fal fa-rss"></i></div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class="col-10">\n\t\t\t\t\t\t\t\t<mat-form-field *ngIf="blog">\n\t\t\t\t\t\t\t\t\t<input test-id="blogUrl" matInput type="text" class="no-margin" maxlength="100" placeholder="Http://"\n\t\t\t\t\t\t\t\t\t\t   name="blog" [(ngModel)]="blog.url" />\n\t\t\t\t\t\t\t\t</mat-form-field>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class="row half-padding-bottom">\n\t\t\t\t\t<div class="col-sm-4">\n\t\t\t\t\t\t<span class="block">Twitter</span>\n\t\t\t\t\t\t<small class="block">Profile URL</small>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="col-sm-8">\n\t\t\t\t\t\t<div class="row no-margin">\n\t\t\t\t\t\t\t<div class="col-2">\n\t\t\t\t\t\t\t\t<div class="input-label"><i class="fab fa-twitter"></i></div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class="col-10">\n\t\t\t\t\t\t\t\t<mat-form-field *ngIf="twitterProfile">\n\t\t\t\t\t\t\t\t\t<input test-id="twitterProfileUrl" matInput type="text" class="no-margin" maxlength="100" placeholder="Http://"\n\t\t\t\t\t\t\t\t\t\t   name="twitterProfile" [(ngModel)]="twitterProfile.url" />\n\t\t\t\t\t\t\t\t</mat-form-field>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="col-sm-7">\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class="row half-padding-bottom">\n\t\t\t\t\t<div class="col-sm-4">\n\t\t\t\t\t\t<span class="block">Facebook</span>\n\t\t\t\t\t\t<small class="block">Profile URL</small>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="col-sm-8">\n\t\t\t\t\t\t<div class="row no-margin">\n\t\t\t\t\t\t\t<div class="col-2">\n\t\t\t\t\t\t\t\t<div class="input-label"><i class="fab fa-facebook"></i></div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class="col-10">\n\t\t\t\t\t\t\t\t<mat-form-field *ngIf="facebookProfile">\n\t\t\t\t\t\t\t\t\t<input test-id="facebookProfileUrl" matInput type="text" class="no-margin" maxlength="100" placeholder="Http://"\n\t\t\t\t\t\t\t\t\t\t   name="facebook" [(ngModel)]="facebookProfile.url" />\n\t\t\t\t\t\t\t\t</mat-form-field>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class="row half-padding-bottom">\n\t\t\t\t\t<div class="col-sm-4">\n\t\t\t\t\t\t<span class="block">Instagram</span>\n\t\t\t\t\t\t<small class="block">Profile URL</small>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="col-sm-8">\n\t\t\t\t\t\t<div class="row no-margin">\n\t\t\t\t\t\t\t<div class="col-2">\n\t\t\t\t\t\t\t\t<div class="input-label"><i class="fab fa-instagram"></i></div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class="col-10">\n\t\t\t\t\t\t\t\t<mat-form-field *ngIf="instagramProfile">\n\t\t\t\t\t\t\t\t\t<input test-id="instagramProfileUrl" matInput type="text" class="no-margin" maxlength="100" placeholder="Http://"\n\t\t\t\t\t\t\t\t\t\t   name="instagram" [(ngModel)]="instagramProfile.url" />\n\t\t\t\t\t\t\t\t</mat-form-field>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class="row half-padding-bottom">\n\t\t\t\t\t<div class="col-sm-4">\n\t\t\t\t\t\t<span class="block">YouTube</span>\n\t\t\t\t\t\t<small class="block">Profile URL</small>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="col-sm-8">\n\t\t\t\t\t\t<div class="row no-margin">\n\t\t\t\t\t\t\t<div class="col-2">\n\t\t\t\t\t\t\t\t<div class="input-label"><i class="fab fa-youtube"></i></div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class="col-10">\n\t\t\t\t\t\t\t\t<mat-form-field *ngIf="youtubeProfile">\n\t\t\t\t\t\t\t\t\t<input test-id="youtubeProfileUrl" matInput type="text" class="no-margin" maxlength="100" placeholder="Http://"\n\t\t\t\t\t\t\t\t\t\t   name="youtube" [(ngModel)]="youtubeProfile.url" />\n\t\t\t\t\t\t\t\t</mat-form-field>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class="row half-padding-bottom">\n\t\t\t\t\t<div class="col-sm-4">\n\t\t\t\t\t\t<span class="block">Pinterest</span>\n\t\t\t\t\t\t<small class="block">Profile URL</small>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="col-sm-8">\n\t\t\t\t\t\t<div class="row no-margin">\n\t\t\t\t\t\t\t<div class="col-2">\n\t\t\t\t\t\t\t\t<div class="input-label"><i class="fab fa-pinterest"></i></div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class="col-10">\n\t\t\t\t\t\t\t\t<mat-form-field *ngIf="pinterestProfile">\n\t\t\t\t\t\t\t\t\t<input test-id="pinterestProfileUrl" matInput type="text" class="no-margin" maxlength="100" placeholder="Http://"\n\t\t\t\t\t\t\t\t\t\t   name="pinterest" [(ngModel)]="pinterestProfile.url" />\n\t\t\t\t\t\t\t\t</mat-form-field>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class="row half-padding-bottom">\n\t\t\t\t\t<div class="col-sm-4">\n\t\t\t\t\t\t<span class="block">LinkedIn</span>\n\t\t\t\t\t\t<small class="block">Profile URL</small>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="col-sm-8">\n\t\t\t\t\t\t<div class="row no-margin">\n\t\t\t\t\t\t\t<div class="col-2">\n\t\t\t\t\t\t\t\t<div class="input-label"><i class="fab fa-linkedin"></i></div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class="col-10">\n\t\t\t\t\t\t\t\t<mat-form-field *ngIf="linkedinProfile">\n\t\t\t\t\t\t\t\t\t<input test-id="linkedinProfileUrl" matInput type="text" class="no-margin" maxlength="100" placeholder="Http://"\n\t\t\t\t\t\t\t\t\t\t   name="linkedin" [(ngModel)]="linkedinProfile.url" />\n\t\t\t\t\t\t\t\t</mat-form-field>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t\t<div class="border-bottom half-margin-top">\n\t\t\t\t<h3 class="half-margin-bottom">Language</h3>\n\t\t\t\t<div class="row half-padding-bottom">\n\t\t\t\t\t<div class="col-sm-4">\n\t\t\t\t\t\t<span class="block">Microsite Language</span>\n\t\t\t\t\t\t<small class="block">Select a preferred language. This will control the translation of static copy. If your preferred language is not\n\t\t\t\t\t\t\tavailable, select "No Preference."</small>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="col-sm-8">\n\t\t\t\t\t\t<label><input test-id="englishRadio" name="language" [(ngModel)]="location.language" value="English" type="radio" /> English / No\n\t\t\t\t\t\t\tPreference</label>\n\t\t\t\t\t\t<label><input test-id="spanishRadio" name="language" [(ngModel)]="location.language" value="Spanish" type="radio" /> Spanish</label>\n\t\t\t\t\t\t<label><input test-id="germanRadio" name="language" [(ngModel)]="location.language" value="German" type="radio" /> German</label>\n\t\t\t\t\t\t<label><input test-id="chineseRadio" name="language" [(ngModel)]="location.language" value="Chinese" type="radio" /> Chinese</label>\n\t\t\t\t\t\t<label><input test-id="frenchRadio" name="language" [(ngModel)]="location.language" value="French Canadian"\n\t\t\t\t\t\t\t\t   type="radio" /> French Canadian</label>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t\t<div class="border-bottom half-margin-top" *ngIf="showFeatureYourProject">\n\t\t\t\t<h3 class="half-margin-bottom">Feature your project</h3>\n\t\t\t\t<div class="row half-padding-bottom">\n\t\t\t\t\t<div class="col-sm-4">\n\t\t\t\t\t\t<p>Submit your project to display on <a href="/marketing/featureproject"\n\t\t\t\t\t\t\t   target="_blank">Control4.com.</a> This information will be included on your microsite. <br />\n\t\t\t\t\t\t\t<small>Don\'t forget to save your microsite.</small>\n\t\t\t\t\t\t</p>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="col-sm-8">\n\t\t\t\t\t\t<a class="c4btn dark-grey" href="/marketing/featureproject" target="_blank">Feature your project</a>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t</div>\n\t</form>\n\t<div class="alert alert-warning" *ngIf="errors?.length">\n\t\t<p class="no-margin" *ngFor="let error of errors">{{error}}</p>\n\t</div>\n\t<ul class="inline-block">\n\t\t<li><button test-id="saveMicrositeClick" [disabled]="errors?.length > 0" (click)="submit()"><i class="fal fa-check"></i>Save Microsite</button>\n\t\t</li>\n\t\t<li><button test-id="cancelEditMicrositeClick" class="transparent" (click)="cancel()"><i class="fal fa-times"></i>Cancel</button></li>\n\t\t\x3c!--<li><a class="c4btn transparent" target="_blank" href="{{generateWwwUrl()}}"><i class="fal fa-external-link"></i>View</a></li>--\x3e\n\t</ul>\n</div>'},EqMe:function(t,e){t.exports=""},IGo8:function(t,e){t.exports=""},IZgx:function(t,e){t.exports='<div class="body">\n\t<div class="row" *ngFor="let location of locations; index as i">\n\t\t<div class="col-sm-4 col-8">\n\t\t\t<img *ngIf="location.isCentralizedLightingCertified"\n\t\t\t\t style="float: right; margin-right: 25px; vertical-align: top;"\n\t\t\t\t src="https://res.cloudinary.com/control4/image/upload/c_scale,h_50/certification_centralizedlighting2019.png" />\n\t\t\t<img *ngIf="location.isPcnaCertified"\n\t\t\t\t style="float: right; margin-right: 25px; vertical-align: top;"\n\t\t\t\t src="https://res.cloudinary.com/control4/image/upload/c_scale,h_50/pcna-logo-primary.png" />\n\t\t\t<img *ngIf="location.isCertifiedShowroom"\n\t\t\t\t style="float: right; margin-right: 25px; vertical-align: top;"\n\t\t\t\t src="https://res.cloudinary.com/control4/image/upload/c_scale,w_40,f_auto,q_100/v1512145430/www/control4/C4-Certified-Badge.png" />\n\t\t\t<span class="bold block">{{location.cardName}}</span>\n\t\t\t<small>\n\t\t\t\t<ul class="no-style">\n\t\t\t\t\t<li>{{location.street}}</li>\n\t\t\t\t\t<li *ngIf="location.block">{{location.block}}</li>\n\t\t\t\t\t<li>{{location.city}}<span *ngIf="location.state">, {{location.state}}</span>, {{location.zipCode}}</li>\n\t\t\t\t</ul>\n\t\t\t</small>\n\t\t</div>\n\t\t<div class="col-sm-4 col-6" *ngIf="!editMode">\n\t\t\t<input attr.test-id="generatedWwwUrl-{{i}}" type="text" [value]="generateWwwUrl(location)" />\n\t\t</div>\n\t\t<div class="col-sm-2 col-3" *ngIf="!editMode">\n\t\t\t<button attr.test-id="copyRsvpLinkClick-{{i}}" class="c4btn no-margin block grey" title="Copy RSVP Link"\n\t\t\t\t\t(click)="createShareLink(location);"><i class="fal fa-link"></i>Copy</button>\n\t\t</div>\n\t\t<div class="col-sm-2 col-3" *ngIf="!editMode">\n\t\t\t<a class="c4btn transparent block" target="_blank" [href]="generateWwwUrl(location)"><i\n\t\t\t\t   class="fal fa-external-link"></i>View</a>\n\t\t</div>\n\t\t<div class="col-sm-2 text-right" *ngIf="editMode">\n\t\t\t<progress [value]="location.percentageComplete" max="1" style="margin-top: 22px;"></progress>\n\t\t\t<small class=" block">{{location.percentageComplete | percent}} Complete</small>\n\t\t</div>\n\t\t<div class="col-sm-2 col-4 text-center" *ngIf="editMode">\n\t\t\t<span *ngIf="!location.isMicrositeParticipant">\n\t\t\t\t<i class="fal fa-2x fa-times text-grey"></i>\n\t\t\t\t<small class="block">Microsite Disabled</small>\n\t\t\t</span>\n\t\t\t<span *ngIf="location.isMicrositeParticipant">\n\t\t\t\t<i class="fal fa-2x fa-check text-success"></i>\n\t\t\t\t<small class="block">Microsite Enabled</small>\n\t\t\t</span>\n\t\t</div>\n\t\t<div class="col-sm-2 col-4" [ngClass]="(isSubdealer$ | async) ? \'col-sm-4\' : \'col-sm-2\'"\n\t\t\t *ngIf="editMode">\n\t\t\t<a class="c4btn no-margin block transparent" target="_blank"\n\t\t\t   *ngIf="location.isMicrositeParticipant" title="View microsite"\n\t\t\t   [href]="generateWwwUrl(location)"><i class="fal fa-external-link"></i>View</a>\n\t\t\t<div *ngIf="!location.isMicrositeParticipant" style="height: 50px;">\n\t\t\t\t<div class="vertically-center text-center half-padding-right">\n\t\t\t\t\t<small>Microsite must first be enabled before it can be&nbsp;viewed.</small>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t</div>\n\t\t<div class="col-sm-2 col-4" *ngIf="editMode && !(isSubdealer$ | async)">\n\t\t\t<button attr.test-id="editSelectedLocationClick-{{i}}" class="block no-margin light-grey text-dark" title="Edit"\n\t\t\t\t\t(click)="locationSelected.emit(location);"><i class="fal fa-pen-alt"></i>Edit</button>\n\t\t</div>\n\t</div>\n</div>'},LDXK:function(t,e){t.exports='<div class="row no-margin">\n\t<div class="col-sm-6">\n\t\t<h3 *ngIf="!testimonials?.length">There are no testimonials for this showroom.</h3>\n\t</div>\n\t<div class="col-sm-6 text-right">\n\t\t<button test-id="addTestimonialClick" href="javascript:;" class="c4btn light-grey" *ngIf="editIndex === null && !newTestimonial"\n\t\t\t\t[disabled]="testimonials?.length >= 4" (click)="beginAdd()"><i class="fal fa-plus"></i>Add Testimonial</button>\n\t</div>\n</div>\n<c4-testimonial-edit *ngIf="newTestimonial" class="row" [testimonial]="newTestimonial" (display)="newTestimonial = null"\n\t\t\t\t\t (testimonialChanged)="save($event)"></c4-testimonial-edit>\n<div class="table">\n\t<div class="body" *ngIf="!newTestimonial">\n\t\t<div [ngClass]="{\'row\':editIndex === null}" *ngFor="let testimonial of testimonials; let i = index;">\n\t\t\t<c4-testimonial-item attr.test-id="c4-testimonial-item-{{i}}" [testimonial]="testimonial" (testimonialChanged)="save($event, i)"\n\t\t\t\t\t\t\t\t (testimonialRemoved)="remove(i)" (editModeToggled)="editIndex = $event? i : null"\n\t\t\t\t\t\t\t\t *ngIf="editIndex === null || editIndex === i"></c4-testimonial-item>\n\t\t</div>\n\t</div>\n</div>'},LzfP:function(t,e){t.exports='<div class="widget widget-fixed-height home">\n\t<a routerLink="/account/orders" c4Track="Click Through" trackCategory="Home" trackLabel="Orders">\n\t\t<h3 class="widget-header-white">{{title}}</h3>\n\t</a>\n\t<c4-loading *ngIf="loading"></c4-loading>\n\t\x3c!-- THIS USES HIDDEN SO THE CANVAS IS AVAILABLE FOR CHART.JS --\x3e\n\t<div [hidden]="loading">\n\t\t<canvas id="order-history-chart" [class.small]="isTriadDealer$ | async">{{ chart }}</canvas>\n\t</div>\n\n\t<div *ngIf="isTriadDealer$ | async" class="padding absolute bottom left" style="padding-bottom: 10px;">\n\t\t<p>\n\t\t\t<small>*Triad Speakers historical sales data is not available prior to the introduction of online sales.</small>\n\t\t</p>\n\t</div>\n</div>'},NumY:function(t,e){t.exports=""},PCs5:function(t,e){t.exports='<div class="widget widget-fixed-height home">\n\t<a routerLink="/account/balance" c4Track="Click Through" trackCategory="Home" trackLabel="Balance">\n\t\t<h3 class="widget-header-white">Balance Total</h3>\n\t</a>\n\t<div class="padding">\n\t\t<c4-loading *ngIf="loading"></c4-loading>\n\t\t<div *ngIf="!loading">\n\t\t\t<h1 class="text-right no-margin" [class.text-success]="balanceDue > 0"\n\t\t\t\t[class.text-warning]="balanceDue < 0"> {{ balanceDue | accounting: (currency$ | async) }} </h1>\n\t\t\t<p class="text-right">\n\t\t\t\t<small>{{ balanceDue > 0 ? \'You currently have a credit\' : \'Total Due Now\' }}</small>\n\t\t\t</p>\n\t\t\t<div class="table no-margin">\n\t\t\t\t<div class="row">\n\t\t\t\t\t<div class="col-7">\n\t\t\t\t\t\t<b>Past Due</b>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="col-5 text-right bold"> {{ due | accounting: (currency$ | async) }} </div>\n\t\t\t\t</div>\n\t\t\t\t<div class="row">\n\t\t\t\t\t<div class="col-7">\n\t\t\t\t\t\t<b>Not Due</b>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="col-5 text-right bold"> {{ upcoming | accounting: (currency$ | async) }} </div>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t\t<p class="bottom">\n\t\t\t\t<small *ngIf="balanceDue > 0">If you would like to apply a credit on your account to an unpaid invoice, please contact the <a\n\t\t\t\t\t   href="mailto:customerservice@snapone.com">Sales Support Team</a>.</small>\n\t\t\t\t<small *ngIf="isTriadDealer$ | async">*Triad Speakers historical sales data is not available prior to the introduction of online sales. </small>\n\t\t\t</p>\n\t\t</div>\n\t</div>\n\t<ng-container *ngIf="!hideFlyout">\n\t\t<a routerLink="/account/balance" class="c4btn block grey absolute bottom no-margin no-border-radius-top"\n\t\t   c4Track="Click Through" trackCategory="Home" trackLabel="Balance Details">Balance Details</a>\n\t</ng-container>\n</div>'},"PO/C":function(t,e){t.exports=""},WZRU:function(t,e){t.exports='<h2 *ngIf="c4Yourself && showDefaultLocations && locations?.length <= 0"><b>YOUR RSVP LINK(S)</b></h2>\n<div *ngIf="!selectedLocation">\n\t<c4-loading *ngIf="loading"></c4-loading>\n\t<div *ngIf="(!loading && (locations?.length <= 0) || (c4Yourself && showC4YourselfLocations && eventParticipantLocations?.length <= 0))">\n\t\t<p>No microsite locations found.</p>\n\t</div>\n\t<div *ngIf="!loading && locations?.length > 0">\n\t\t<div *ngIf="!upgradeMicrositeOnly && showDefaultLocations" class="table half-margin-top">\n\t\t\t<c4-microsites [locations]="locations" [editMode]="editMode" (locationSelected)="selectedLocation = $event"></c4-microsites>\n\t\t</div>\n\t\t<div *ngIf="showSmartHomeOS3Upgrades">\n\t\t\t<br>\n\t\t\t<h2 *ngIf="!upgradeMicrositeOnly">Smart Home OS 3<br>\n\t\t\t\t<span class="bold">upgrade microsite</span></h2>\n\t\t\t<h3 *ngIf="upgradeMicrositeOnly" class="half-margin-top">Smart Home OS 3 Upgrade Microsite</h3>\n\t\t\t<div class="table" [class.half-margin-top]="!upgradeMicrositeOnly">\n\t\t\t\t<div class="body">\n\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t<div class="col-sm-4 col-8">\n\t\t\t\t\t\t\t<img *ngIf="upgradeLocation.isCentralizedLightingCertified"\n\t\t\t\t\t\t\t\t style="float: right; margin-right: 25px; vertical-align: top;"\n\t\t\t\t\t\t\t\t src="https://res.cloudinary.com/control4/image/upload/c_scale,h_50/certification_centralizedlighting2019.png" />\n\t\t\t\t\t\t\t<img *ngIf="upgradeLocation.isPcnaCertified"\n\t\t\t\t\t\t\t\t style="float: right; margin-right: 25px; vertical-align: top;"\n\t\t\t\t\t\t\t\t src="https://res.cloudinary.com/control4/image/upload/c_scale,h_50/pcna-logo-primary.png" />\n\t\t\t\t\t\t\t<img *ngIf="upgradeLocation.isCertifiedShowroom"\n\t\t\t\t\t\t\t\t style="float: right; margin-right: 25px; vertical-align: top;"\n\t\t\t\t\t\t\t\t src="https://res.cloudinary.com/control4/image/upload/c_scale,w_40,f_auto,q_100/v1512145430/www/control4/C4-Certified-Badge.png" />\n\t\t\t\t\t\t\t<span class="bold block">{{upgradeLocation.cardName}}</span>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class="col-sm-4 col-6">\n\t\t\t\t\t\t\t<input test-id="generatedUpgradeUrl" type="text" [value]="generateUpgradeUrl()" />\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class="col-sm-2 col-3">\n\t\t\t\t\t\t\t<button test-id="createUpgradeShareLinkClick" class="c4btn no-margin block grey" title="Copy Upgrade Link"\n\t\t\t\t\t\t\t\t\t(click)="createUpgradeShareLink();"><i class="fal fa-link"></i>Copy</button>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class="col-sm-2 col-3">\n\t\t\t\t\t\t\t<a class="c4btn transparent block" target="_blank" [href]="generateUpgradeUrl()"><i\n\t\t\t\t\t\t\t\t   class="fal fa-external-link"></i>View</a>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t</div>\n\t\t<div *ngIf="eventParticipantLocations?.length > 0 && showC4YourselfLocations">\n\t\t\t<br>\n\t\t\t<h2>YOUR HOME IS YOUR CASTLE<br>\n\t\t\t\t<span class="bold">#C4YOURSELF MICROSITE</span></h2>\n\t\t\t<div class="table" [class.half-margin-top]>\n\t\t\t\t<c4-microsites [locations]="eventParticipantLocations" [editMode]="false" [micrositeType]="micrositeTypes.C4Yourself"></c4-microsites>\n\t\t\t</div>\n\t\t</div>\n\t\t<div *ngIf="locations?.length > 0 && (showLightingMicrosite$ | async) && showLightingLocations">\n\t\t\t<br>\n\t\t\t<h2>SMART HOME LIGHTING IS A<br>\n\t\t\t\t<span class="bold">SMART HOME ESSENTIAL</span></h2>\n\t\t\t<div class="table" [class.half-margin-top]>\n\t\t\