(window.webpackJsonp=window.webpackJsonp||[]).push([[10],{"42j0":function(t,e){t.exports=""},OW06:function(t,e){t.exports=""},XRg6:function(t,e){t.exports='<form name="rmaForm" #rmaForm="ngForm" class="padding">\n\t<h1>New RMA</h1>\n\t<div class="row">\n\t\t<div class="col-sm-8">\n\t\t\t<c4-static-content class="col-md-12" id="new-rma-top"></c4-static-content>\n\t\t\t<div class="widget" *ngIf="!caseNumber">\n\t\t\t\t<h3 class="widget-header-white">RMA Details</h3>\n\t\t\t\t<div class="padding">\n\t\t\t\t\t<ul>\n\t\t\t\t\t\t<li>Online RMA requests are available for <strong>DEFECTIVE products only.</strong></li>\n\t\t\t\t\t\t<li>For returns on non-defective or unopened items please contact the <a href="mailto:International@adiglobal.com">Sales Support\n\t\t\t\t\t\t\t\tTeam</a>. </li>\n\t\t\t\t\t\t<li>Online RMA submissions may take up to 1 business day to process.</li>\n\t\t\t\t\t\t<li>If your RMA is urgent, please contact Technical Support by phone or online chat for processing.</li>\n\t\t\t\t\t</ul>\n\t\t\t\t\t<p>Important: Please take the time to add detailed notes for each item. <strong>A 30% Restocking Fee will be charged if we cannot reproduce\n\t\t\t\t\t\t\tthe reported issue.</strong></p>\n\t\t\t\t\t<form class="no-margin" (ngSubmit)="lookup()" *ngIf="!editItem && sfInfo?.account">\n\t\t\t\t\t\t<div class="row no-margin">\n\t\t\t\t\t\t\t<div class="col-sm-5 col-8">\n\t\t\t\t\t\t\t\t<mat-form-field>\n\t\t\t\t\t\t\t\t\t<input test-id="macAddress" matInput type="text" name="macAddress" placeholder="Mac Address"\n\t\t\t\t\t\t\t\t\t\t   class="no-margin" [(ngModel)]="lookupMac"\n\t\t\t\t\t\t\t\t\t\t   [disabled]="!editMode || lookingUpProduct" c4Focus>\n\t\t\t\t\t\t\t\t</mat-form-field>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class="col-sm-3 col-4">\n\t\t\t\t\t\t\t\t<button test-id="lookupProductClick" type="submit" class="grey block no-margin"\n\t\t\t\t\t\t\t\t\t\t[disabled]="!editMode || lookingUpProduct"><i class="fal"\n\t\t\t\t\t\t\t\t\t   [ngClass]="lookingUpProduct ? \'fa-spin fa-circle-notch\' : \'fa-search\'"></i>{{lookingUpProduct ? \'Searching\' : \'Lookup\n\t\t\t\t\t\t\t\t\tItem\'}}</button>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class="half-margin-top alert alert-warning" *ngIf="macLookupWarning">\n\t\t\t\t\t\t\t<p>{{macLookupWarning}}<br /></p>\n\t\t\t\t\t\t\t<ul *ngIf="errorSku" class="no-style">\n\t\t\t\t\t\t\t\t<li class="block bold">{{errorAddress}}</li>\n\t\t\t\t\t\t\t\t<li>{{errorSku}}</li>\n\t\t\t\t\t\t\t\t<li><small><i class="fal fa-times-circle"></i>Out of Warranty as of {{errorWarrantyDate | date:\'MMM dd, yyyy\'}}</small></li>\n\t\t\t\t\t\t\t</ul>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</form>\n\t\t\t\t\t<div class="row" *ngIf="editItem">\n\t\t\t\t\t\t<c4-rma-details [item]="editItem" [editable]="editMode" [projects]="projects"\n\t\t\t\t\t\t\t\t\t\t(editing)="onEdit($event)" (adding)="onAdded($event)" class="block"></c4-rma-details>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t\t<div class="widget" *ngIf="!caseNumber">\n\t\t\t\t<h3 class="widget-header-white">Account Information</h3>\n\t\t\t\t<div class="padding">\n\t\t\t\t\t<c4-loading *ngIf="!rmaInformation"></c4-loading>\n\t\t\t\t\t<div class="alert alert-warning" [ngClass]="{ \'no-margin\': !sfInfo?.account }" *ngIf="sfInfo && (!sfInfo.contact || !sfInfo.account)">\n\t\t\t\t\t\t<p>There was a problem loading <span *ngIf="sfInfo.account">a portion of </span>your account information. <span\n\t\t\t\t\t\t\t\t  *ngIf="sfInfo.account">Your case will associated to another person on your account.</span> Please contact <a\n\t\t\t\t\t\t\t   *ngIf="(useWebhelpEmail$ | async)" href="mailto:webhelp@control4.com">webhelp@control4.com</a>\n\t\t\t\t\t\t\t<a *ngIf="!(useWebhelpEmail$ | async)" href="mailto:onlineordering@control4.com">onlineordering@control4.com</a> for assistance with\n\t\t\t\t\t\t\tyour account<span\n\t\t\t\t\t\t\t\t  *ngIf="!sfInfo.account">&nbsp;before submitting your RMA</span>.\n\t\t\t\t\t\t</p>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="no-margin" *ngIf="sfInfo?.account">\n\t\t\t\t\t\t<div\n\t\t\t\t\t\t\t *ngIf="rmaInformation && !(rmaInformation.contactCompany && rmaInformation.contactName && rmaInformation.contactEmail && rmaInformation.contactPhone) && editMode || editContactInformation">\n\t\t\t\t\t\t\t<div class="row" *ngIf="!rmaInformation.contactCompany">\n\t\t\t\t\t\t\t\t<div class="col-4">\n\t\t\t\t\t\t\t\t\t<p>Account</p>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="col-sm-4 col-8">\n\t\t\t\t\t\t\t\t\t<mat-form-field>\n\t\t\t\t\t\t\t\t\t\t<input test-id="dealerId" matInput type="text" name="dealerId" placeholder="Dealer ID"\n\t\t\t\t\t\t\t\t\t\t\t   [(ngModel)]="rmaInformation.contactCompany"\n\t\t\t\t\t\t\t\t\t\t\t   [disabled]="rmaInformation.contactCompany" required>\n\t\t\t\t\t\t\t\t\t</mat-form-field>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t<div class="col-4">\n\t\t\t\t\t\t\t\t\t<p>Name</p>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="col-sm-4 col-8">\n\t\t\t\t\t\t\t\t\t<mat-form-field class="fs-block">\n\t\t\t\t\t\t\t\t\t\t<input test-id="contactName" matInput type="text" name="contactName" placeholder="Name"\n\t\t\t\t\t\t\t\t\t\t\t   [(ngModel)]="rmaInformation.contactName" required>\n\t\t\t\t\t\t\t\t\t</mat-form-field>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t<div class="col-4">\n\t\t\t\t\t\t\t\t\t<p>Email</p>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="col-sm-4 col-8">\n\t\t\t\t\t\t\t\t\t<mat-form-field class="fs-block">\n\t\t\t\t\t\t\t\t\t\t<input test-id="contactEmail" matInput type="email" name="contactEmail" placeholder="Email"\n\t\t\t\t\t\t\t\t\t\t\t   [(ngModel)]="rmaInformation.contactEmail" required>\n\t\t\t\t\t\t\t\t\t</mat-form-field>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t<div class="col-4">\n\t\t\t\t\t\t\t\t\t<p>Phone</p>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="col-sm-4 col-8">\n\t\t\t\t\t\t\t\t\t<mat-form-field class="fs-block">\n\t\t\t\t\t\t\t\t\t\t<input test-id="contactPhone" matInput type="tel" name="contactPhone" placeholder="Phone"\n\t\t\t\t\t\t\t\t\t\t\t   [(ngModel)]="rmaInformation.contactPhone" required>\n\t\t\t\t\t\t\t\t\t</mat-form-field>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div\n\t\t\t\t\t\t\t *ngIf="(rmaInformation?.contactCompany && rmaInformation?.contactName && rmaInformation?.contactEmail && rmaInformation?.contactPhone) && !editContactInformation || !editMode">\n\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t<div class="col-4">\n\t\t\t\t\t\t\t\t\t<p>Contact Information</p>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="col-sm-4 col-8">\n\t\t\t\t\t\t\t\t\t<ul class="no-style fs-block">\n\t\t\t\t\t\t\t\t\t\t<li>{{rmaInformation.contactName}}</li>\n\t\t\t\t\t\t\t\t\t\t<li>{{rmaInformation.contactEmail}}</li>\n\t\t\t\t\t\t\t\t\t\t<li>{{rmaInformation.contactPhone}}</li>\n\t\t\t\t\t\t\t\t\t</ul>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t<div class="col-push-4 col-8">\n\t\t\t\t\t\t\t\t\t<ul class="no-style">\n\t\t\t\t\t\t\t\t\t\t<li><small><a href="javascript:;" test-id="toggleContactInformationClick" (click)="toggleContactInformation()">Edit\n\t\t\t\t\t\t\t\t\t\t\t\t\tContact Information</a></small></li>\n\t\t\t\t\t\t\t\t\t</ul>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t\t<div class="widget" *ngIf="!caseNumber && sfInfo?.account">\n\t\t\t\t<h3 class="widget-header-white">Return Shipping</h3>\n\t\t\t\t<div class="padding">\n\t\t\t\t\t<c4-loading *ngIf="!rmaInformation"></c4-loading>\n\t\t\t\t\t<div class="no-margin" *ngIf="rmaInformation">\n\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t<div class="col-4">\n\t\t\t\t\t\t\t\t<p>Return Ship Method</p>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class="col-sm-4 col-8">\n\t\t\t\t\t\t\t\t<select test-id="selectedShippingMethod" name="shipMethod" [(ngModel)]="shipMethod" required>\n\t\t\t\t\t\t\t\t\t<option disabled [value]="undefined">Select Shipping Method</option>\n\t\t\t\t\t\t\t\t\t<option *ngFor="let s of shippingMethods" [ngValue]="s">{{s.displayValue}}</option>\n\t\t\t\t\t\t\t\t</select>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t<div class="col-4">\n\t\t\t\t\t\t\t\t<p>Return Address</p>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class="col-sm-4 col-8">\n\t\t\t\t\t\t\t\t<select test-id="selectedReturnAddress" name="returnAddress" [(ngModel)]="shippingAddress"\n\t\t\t\t\t\t\t\t\t\t(ngModelChange)="addressSelected($event)" required>\n\t\t\t\t\t\t\t\t\t<option disabled [value]="undefined">Select Address</option>\n\t\t\t\t\t\t\t\t\t<option *ngFor="let s of shippingAddresses" [ngValue]="s">{{s.displayValue}} </option>\n\t\t\t\t\t\t\t\t</select>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div *ngIf="shippingAddress?.id === 0 && editMode">\n\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t<div class="col-4">\n\t\t\t\t\t\t\t\t\t<p>Line 1</p>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="col-sm-4 col-8">\n\t\t\t\t\t\t\t\t\t<mat-form-field>\n\t\t\t\t\t\t\t\t\t\t<input test-id="address1" matInput type="text" name="addressLine1" placeholder="Address 1"\n\t\t\t\t\t\t\t\t\t\t\t   [(ngModel)]="shippingAddress.line1" [disabled]="!editMode" required>\n\t\t\t\t\t\t\t\t\t</mat-form-field>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t<div class="col-4">\n\t\t\t\t\t\t\t\t\t<p>Line 2</p>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="col-sm-4 col-8">\n\t\t\t\t\t\t\t\t\t<mat-form-field>\n\t\t\t\t\t\t\t\t\t\t<input test-id="address2" matInput type="text" name="addressLine2" placeholder="Address 2"\n\t\t\t\t\t\t\t\t\t\t\t   [(ngModel)]="shippingAddress.line2" [disabled]="!editMode">\n\t\t\t\t\t\t\t\t\t</mat-form-field>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t<div class="col-4">\n\t\t\t\t\t\t\t\t\t<p>City</p>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="col-sm-4 col-8">\n\t\t\t\t\t\t\t\t\t<mat-form-field>\n\t\t\t\t\t\t\t\t\t\t<input test-id="city" matInput type="text" name="city" placeholder="City"\n\t\t\t\t\t\t\t\t\t\t\t   [(ngModel)]="shippingAddress.city" [disabled]="!editMode" required>\n\t\t\t\t\t\t\t\t\t</mat-form-field>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t<div class="col-4">\n\t\t\t\t\t\t\t\t\t<p>State / Province</p>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="col-sm-4 col-8">\n\t\t\t\t\t\t\t\t\t<select test-id="selectedState" name="state" [(ngModel)]="selectedState" [disabled]="!editMode"\n\t\t\t\t\t\t\t\t\t\t\t(ngModelChange)="stateSelected($event)" required>\n\t\t\t\t\t\t\t\t\t\t<option [value]="undefined">State</option>\n\t\t\t\t\t\t\t\t\t\t<option *ngFor="let s of selectedCountry?.states" [ngValue]="s"> {{s.displayValue}}</option>\n\t\t\t\t\t\t\t\t\t</select>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t<div class="col-4">\n\t\t\t\t\t\t\t\t\t<p>Postal Code</p>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="col-sm-4 col-8">\n\t\t\t\t\t\t\t\t\t<mat-form-field>\n\t\t\t\t\t\t\t\t\t\t<input test-id="postalCode" matInput type="text" name="zip" placeholder="Zip"\n\t\t\t\t\t\t\t\t\t\t\t   [(ngModel)]="shippingAddress.postalCode" [disabled]="!editMode" required>\n\t\t\t\t\t\t\t\t\t</mat-form-field>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t<div class="col-4">\n\t\t\t\t\t\t\t\t\t<p>Country</p>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="col-sm-4 col-8">\n\t\t\t\t\t\t\t\t\t<select test-id="selectedCountry" class="no-margin" name="country" [(ngModel)]="selectedCountry"\n\t\t\t\t\t\t\t\t\t\t\t[disabled]="!editMode" (ngModelChange)="countrySelected($event)" required>\n\t\t\t\t\t\t\t\t\t\t<option [value]="undefined">Country</option>\n\t\t\t\t\t\t\t\t\t\t<option *ngFor="let s of countries.countries" [ngValue]="s">{{s.displayValue}} </option>\n\t\t\t\t\t\t\t\t\t</select>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class="half-margin-top" *ngIf="!editMode">\n\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t<div class="col-4">\n\t\t\t\t\t\t\t\t\t<p>Return Address</p>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="col-sm-4 col-8">\n\t\t\t\t\t\t\t\t\t<ul class="no-style">\n\t\t\t\t\t\t\t\t\t\t<li>{{shippingAddress.line1}}</li>\n\t\t\t\t\t\t\t\t\t\t<li>{{shippingAddress.line2}}</li>\n\t\t\t\t\t\t\t\t\t\t<li>{{shippingAddress.city}}<span *ngIf="selectedState.displayValue">, {{selectedState.displayValue}}</span></li>\n\t\t\t\t\t\t\t\t\t\t<li>{{shippingAddress.postalCode}}</li>\n\t\t\t\t\t\t\t\t\t\t<li>{{selectedCountry.displayValue}}</li>\n\t\t\t\t\t\t\t\t\t</ul>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t</div>\n\t\t<div class="col-sm-4">\n\t\t\t<div class="widget" *ngIf="!caseNumber && rmaItems.length > 0 && !caseNumber">\n\t\t\t\t<h3 class="widget-header-white">RMA Items</h3>\n\t\t\t\t<div class="padding">\n\t\t\t\t\t<div class="alert alert-warning no-margin half-margin-top" *ngIf="submitErrorMessage"> {{submitErrorMessage}} </div>\n\t\t\t\t\t<div class="table" *ngIf="rmaItems.length > 0">\n\t\t\t\t\t\t<div class="body">\n\t\t\t\t\t\t\t<div class="row" *ngFor="let rmaItem of rmaItems">\n\t\t\t\t\t\t\t\t<c4-rma-details [item]="rmaItem" [editable]="false" (editing)="onEdit($event)"\n\t\t\t\t\t\t\t\t\t\t\t\t(removed)="onRemoved($event)" class="block"></c4-rma-details>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t\t<input test-id="termsAcceptedCheckbox" type="checkbox" name="terms" [(ngModel)]="termsAccepted">I accept the <a href="javascript:;"\n\t\t\t\t\t   class="bold" (click)="showTerms=!showTerms">Online RMA Terms & Conditions</a>\n\t\t\t\t\t<div id="onlineterms" [hidden]="!showTerms">\n\t\t\t\t\t\t<a href="javascript:;" class="c4close" test-id="closeShowTermsClick" (click)="showTerms=false"></a>\n\t\t\t\t\t\t<div class="white" style="max-height: 600px; overflow-y: scroll;">\n\t\t\t\t\t\t\t<ol>\n\t\t\t\t\t\t\t\t<li>Control4 will not process your return unless you record the RMA number on the outside of each shipping box. Items with no\n\t\t\t\t\t\t\t\t\tRMA number on the box will be returned to you at your expense.</li>\n\t\t\t\t\t\t\t\t<li>A control4 RMA specialist will review your RMA request for accuracy before processing. Once approved, you will receive an\n\t\t\t\t\t\t\t\t\tRMA Email containing a PDF file. The PDF file must be printed and included in each shipping box. Any item returned without\n\t\t\t\t\t\t\t\t\tapproval will be returned at your expense. Please allow 1 full business day for review and approval.</li>\n\t\t\t\t\t\t\t\t<li>All RMA\'d items must be returned unless otherwise specified. Please include all of the associated accessories.</li>\n\t\t\t\t\t\t\t\t<li>Any item returned, where we cannot reproduce the described issue, will be charged a 30% restock fee.</li>\n\t\t\t\t\t\t\t\t<li>Additional charges will result from damaged products and/or missing accessories. </li>\n\t\t\t\t\t\t\t\t<li>All RMAs must be returned within 30 days or they expire. Any warranty terms originally committed in the expired RMA will not\n\t\t\t\t\t\t\t\t\tcarry over if the warranty conditions have changed.</li>\n\t\t\t\t\t\t\t</ol>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<button test-id="submitRmaClick" class="block no-border-radius-top" (click)="submitRma()"\n\t\t\t\t\t\t[disabled]="rmaItems.length <= 0 || !termsAccepted || !shipMethod || !shippingAddress || submittingRma || rmaForm?.invalid">Submit\n\t\t\t\t\tRMA</button>\n\t\t\t</div>\n\t\t</div>\n\t\t<div class="col-sm-12">\n\t\t\t<div class="widget" *ngIf="caseNumber">\n\t\t\t\t<h3 class="widget-header-white">Success</h3>\n\t\t\t\t<div class="padding">\n\t\t\t\t\t<div class="alert alert-success"> Your RMA has been successfully submitted. Your case number is <b>{{caseNumber}}</b>. <ul>\n\t\t\t\t\t\t\t<li>Please allow 1 full business day for review and approval.</li>\n\t\t\t\t\t\t\t<li>Once approved, you will receive an email confirming your RMA, which will contain a PDF file.</li>\n\t\t\t\t\t\t\t<li>Please print and include a copy of the PDF file in each shipping container.</li>\n\t\t\t\t\t\t\t<li>RMAs returned without approval will be returned at your expense.</li>\n\t\t\t\t\t\t</ul>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="row no-margin">\n\t\t\t\t\t\t<div class="col-sm-2">\n\t\t\t\t\t\t\t<a routerLink="/rma" class="c4btn dark-grey block"><i class="fal fa-arrow-left"></i>Return to RMA History</a>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class="col-sm-2">\n\t\t\t\t\t\t\t<button test-id="createNewRmaClick" class="light-grey block" (click)="reset()"><i class="fal fa-plus"></i>Create New RMA</button>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t</div>\n\t</div>\n</form>'},bVIy:function(t,e,s){"use strict";s.r(e);var n=s("SVse"),i=s("8Y7J"),a=s("s7LF"),o=s("HsOI"),l=s("ZwOa"),r=s("iTUp"),d=s("CHZp"),c=s("G8jr"),m=s("PCNd"),p=s("g1lH"),u=s("iInd"),h=s("flj8"),g=s("CVMR"),f=s("5bIB"),v=s("J4GY"),b=s("HDdC");class y{constructor(t){this.addressService=t,this.countries=[{selected:!0,displayValue:"United States",value:"US",states:[]},{selected:!1,displayValue:"Canada",value:"CA",states:[]}]}getCountry(t){return b.a.create(e=>{null==t&&(t=this.countries[0].value);let s=null;for(let n=0;n<this.countries.length;n++)if(this.countries[n].value===t||this.countries[n].displayValue===t){(s=this.countries[n]).states.length<=0?this.addressService.getAvailableStates(s.value).subscribe(t=>{if(t){s.states=[];for(let e=0;e<t.length;e++)s.states.push({selected:!1,displayValue:t[e].stateName,value:t[e].stateAbbr});e.next(s),e.comp