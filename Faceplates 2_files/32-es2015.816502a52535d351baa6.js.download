l-sm-4">\n\t\t</c4-enum-checkbox>\n\t\t<button test-id="saveAccountClick" type="button" [disabled]="saving" (click)="save()" class="no-margin"><i\n\t\t\t   class="fal fa-check"></i>Save</button>\n\t\t<button test-id="cancelAccountEditClickBottom" type="button" (click)="cancel()" class="transparent"><i class="fal fa-times"></i>Cancel</button>\n\t</div>\n</div>'},Lahh:function(t,e){t.exports=""},UaN1:function(t,e){t.exports=""},cwcB:function(t,e){t.exports='<div class="padding">\n\t<h1>Account Management</h1>\n\t<form class="dark no-margin" (ngSubmit)="search()" *ngIf="!displayEdit">\n\t\t<div class="row no-margin">\n\t\t\t<div class="col-10">\n\t\t\t\t<mat-form-field>\n\t\t\t\t\t<input test-id="accountSearch" matInput [(ngModel)]="searchText" class="no-margin" name="search"\n\t\t\t\t\t\t   placeholder="Search by Account ID or Name">\n\t\t\t\t</mat-form-field>\n\t\t\t</div>\n\t\t\t<div class="col-2">\n\t\t\t\t<button test-id="searchAccountClick" type="submit" class="block grey no-margin" [disabled]="searching"><i\n\t\t\t\t\t   class="fal fa-search"></i></button>\n\t\t\t</div>\n\t\t</div>\n\t</form>\n\t<c4-account-edit *ngIf="editing" (saved)="handleUpdate($event)" [account]="edit"></c4-account-edit>\n\t<div class="widget" *ngIf="!editing">\n\t\t<div class="padding">\n\t\t\t<div *ngIf="!accounts">\n\t\t\t\t<p class="no-margin"><small>Please search for accounts above.</small></p>\n\t\t\t</div>\n\t\t\t<div class="table table-hover" *ngIf="accounts">\n\t\t\t\t<div class="head d-xs-none">\n\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t<div class="col-sm-4">Name</div>\n\t\t\t\t\t\t<div class="col-sm-2">Account ID</div>\n\t\t\t\t\t\t<div class="col-sm-2">Account Roles</div>\n\t\t\t\t\t\t<div class="col-sm-4">Security Permissions</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class="body">\n\t\t\t\t\t<div class="row" id="account-{{account.id}}" *ngFor="let account of accounts; index as i" (click)="beginEdit(account)"\n\t\t\t\t\t\t [class.text-grey]="!account.isActive">\n\t\t\t\t\t\t<div class="col-sm-4 col-6 half-padding-top">{{account.accountName}}</div>\n\t\t\t\t\t\t<div class="col-sm-2 d-xs-none half-padding-top" style="text-overflow: ellipsis; overflow: hidden;"> {{account.id}}</div>\n\t\t\t\t\t\t<div class="col-sm-2 d-xs-none half-padding-top">\n\t\t\t\t\t\t\t<small [innerHTML]="account.accountRoles | enumDescription: accountRolesMap: \'<br>\' | safeHtml"></small>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class="col-sm-2 col-6 half-padding-top">\n\t\t\t\t\t\t\t<small\n\t\t\t\t\t\t\t\t   [innerHTML]="account.accountSecurityRoles | enumDescription: securityRolesMap: \'<br>\' | safeHtml"></small>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class="col-md-2 col-12">\n\t\t\t\t\t\t\t<button attr.test-id="editAccountClick-{{i}}" class="outline dark no-margin block" id="account-edit-{{account.id}}"><i\n\t\t\t\t\t\t\t\t   class="fal fa-pen-alt"></i>Edit</button>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class="pagination" *ngIf="pagingInfo.total">\n\t\t\t\t\t<c4-pager [info]="pagingInfo" (infoChange)="updatePage($event)"></c4-pager>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t</div>\n\t</div>\n</div>'}}]);