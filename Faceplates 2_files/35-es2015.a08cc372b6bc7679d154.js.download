:paramtypes",[o.a,i.b])],h);var p=s("iInd"),f=function(t,e,s,c){var a,n=arguments.length,r=n<3?e:null===c?c=Object.getOwnPropertyDescriptor(e,s):c;if("object"==typeof Reflect&&"function"==typeof Reflect.decorate)r=Reflect.decorate(t,e,s,c);else for(var o=t.length-1;o>=0;o--)(a=t[o])&&(r=(n<3?a(r):n>3?a(e,s,r):a(e,s))||r);return n>3&&r&&Object.defineProperty(e,s,r),r};const g=[{path:"",pathMatch:"full",component:h,data:{title:"EMEA Sync Management",requiredRole:s("X7Bb").l.InternalProductAdmin,checkForActiveUser:!0}}];let m=class{};m=f([Object(a.K)({imports:[p.h.forChild(g)],exports:[p.h]})],m),s.d(e,"CmsEmeaSyncModule",(function(){return b}));let b=class{};b=function(t,e,s,c){var a,n=arguments.length,r=n<3?e:null===c?c=Object.getOwnPropertyDescriptor(e,s):c;if("object"==typeof Reflect&&"function"==typeof Reflect.decorate)r=Reflect.decorate(t,e,s,c);else for(var o=t.length-1;o>=0;o--)(a=t[o])&&(r=(n<3?a(r):n>3?a(e,s,r):a(e,s))||r);return n>3&&r&&Object.defineProperty(e,s,r),r}([Object(a.K)({declarations:[h],imports:[c.b,n.b,m,r.a]})],b)},dw6O:function(t,e){t.exports='<div class="padding">\n\t<div class="row" style="margin-bottom: 10px;">\n\t\t<h1 class="col-sm-8">EMEA Sync Management</h1>\n\t</div>\n\t<div class="alert alert-warning">\n\t\t<p>The purpose of this CMS functionality is to sync data from US dealer portal to EMEA dealer portal to save duplicate manual entry for product assets\n\t\t\tlike images, spec sheets, downloads, videos, product descriptions, etc. This tool will not sync product categories as the category hierarchy\n\t\t\tcurrently differs between the US an EMEA dealer portals.</p>\n\t\t<p><b>Important Note:</b> This data gets pulled from the latest backup from the datawarehouse. Meaning that all data from the US dealer portal is about\n\t\t\ta day old. If you\'re not receive the results you expect for the SKUs you are syncing, wait a day and try again when the data has been refreshed.</p>\n\t</div>\n\t<div>\n\t\t<form class="dark" (ngSubmit)="searchProducts()">\n\t\t\t<div class="row no-margin">\n\t\t\t\t<div class="col-sm-11 col-8">\n\t\t\t\t\t<mat-form-field>\n\t\t\t\t\t\t<input test-id="skuSearch" matInput name="searchSkus" class="" type="text" placeholder="Skus for EMEA sync" [(ngModel)]="searchSkus"\n\t\t\t\t\t\t\t   [disabled]="searchingManufacturer || searchingCategory" autofocus>\n\t\t\t\t\t</mat-form-field>\n\t\t\t\t</div>\n\t\t\t\t<div class="col-sm-1 col-4">\n\t\t\t\t\t<button test-id="searchProductClick" type="submit" class="block grey" [disabled]="searching"><i class="fal fa-search"></i></button>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t</form>\n\t\t<div class="widget" *ngIf="(searching || searched) && !products">\n\t\t\t<h3 class="widget-header-white">Affected Products</h3>\n\t\t\t<div class="absolute top left block text-right d-none d-sm-block">\n\t\t\t\t<button test-id="clearSearchClick" class="transparent" (click)="clearSearch()" *ngIf="searched">Clear Search</button>\n\t\t\t\t<button test-id="editProductsClick" class="transparent" (click)="beginSyncProducts()"\n\t\t\t\t\t\t*ngIf="searchResults">Sync&nbsp;<b>{{searchResults.length}}</b>&nbsp;Products to EMEA</button>\n\t\t\t</div>\n\t\t\t<div class="padding">\n\t\t\t\t<p *ngIf="searching">Searching...</p>\n\t\t\t\t<p *ngIf="!searchResults && searched">No results found.</p>\n\t\t\t\t<p *ngIf="!searching && searchResults && searched">The following <b>{{searchResults.length}}</b> products will be synced to EMEA dealer portal.\n\t\t\t\t</p>\n\t\t\t</div>\n\t\t\t<div class="padding">\n\t\t\t\t<div class="table" *ngIf="searchResults">\n\t\t\t\t\t<div class="head d-none d-sm-block">\n\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t<div class="col-md-6 col-sm-5">Product</div>\n\t\t\t\t\t\t\t<div class="col-md-5 col-sm-5">Categories</div>\n\t\t\t\t\t\t\t<div class="col-md-1 col-sm-2 text-center">Available</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="body" *ngIf="!searching">\n\t\t\t\t\t\t<div class="row repeated-item" *ngFor="let product of searchResults">\n\t\t\t\t\t\t\t<div class="col-md-6 col-sm-5">\n\t\t\t\t\t\t\t\t<b>{{product.name}}</b><br />\n\t\t\t\t\t\t\t\t<small>{{product.sku}}</small>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class="col-md-5 col-sm-4">\n\t\t\t\t\t\t\t\t<span [title]="flattenCategories(product.categories)">{{flattenCategories(product.categories)}}</span>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class="col-md-1 col-sm-2 col-6 text-center">\n\t\t\t\t\t\t\t\t<span class="fal" [ngClass]="{\'fa-check\':product.isAvailable}"></span>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t</div>\n\t</div>\n\t<div *ngIf="success" class="alert alert-success">\n\t\t<p>The following skus have been successfully queued for sync. It can take some time for all SKUs to get updated. Anticipate at least 15 seconds per SKU\n\t\t\tbefore checking for updates.</p>\n\t\t<p>Estimated time to complete: <b>{{(searchResults.length * 15)/60}} minutes</b></p>\n\t\t<ul>\n\t\t\t<li *ngFor="let sku of searchResults"><b>{{sku.sku}}</b> {{sku.name}}</li>\n\t\t</ul>\n\t</div>\n</div>'},pGn9:function(t,e){t.exports=""}}]);