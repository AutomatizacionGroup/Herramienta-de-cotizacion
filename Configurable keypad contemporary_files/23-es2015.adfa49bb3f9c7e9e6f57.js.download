veValidate name="designServicesLead" #designServicesLead="ngForm"\n\t\t\t\t  (ngSubmit)="submit(designServicesLead)">\n\t\t\t\t<p>Submit answers to the following questions with as much detail as possible.</p>\n\t\t\t\t<div class="winnieThePooh"><input test-id="winnieThePooh" type="text" name="winnieThePooh" autocomplete="off"></div>\n\t\t\t\t<h4 class="half-margin-top half-margin-bottom">Contact Information</h4>\n\t\t\t\t<div>\n\t\t\t\t\t<div class="row half-margin-bottom">\n\t\t\t\t\t\t<div class="col-4">\n\t\t\t\t\t\t\t<p>Dealer ID<span class="text-primary">*</span></p>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class="col-8 col-sm-4">\n\t\t\t\t\t\t\t<mat-form-field>\n\t\t\t\t\t\t\t\t<input test-id="dealerId" matInput name="account" [(ngModel)]="info.dealerID" type="text"\n\t\t\t\t\t\t\t\t\t   placeholder="Dealer Account"\n\t\t\t\t\t\t\t\t\t   [ngClass]="{\'error\': designServicesLead?.account?.invalid && (submitted || designServicesLead.account.touched)}"\n\t\t\t\t\t\t\t\t\t   required>\n\t\t\t\t\t\t\t</mat-form-field>\n\t\t\t\t\t\t\t<input test-id="designServiceType" name="designServiceType" type="hidden" value="4"\n\t\t\t\t\t\t\t\t   [(ngModel)]="info.designServiceType" />\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="row half-margin-bottom">\n\t\t\t\t\t\t<div class="col-4">\n\t\t\t\t\t\t\t<p>First name<span class="text-primary">*</span></p>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class="col-8 col-sm-4">\n\t\t\t\t\t\t\t<mat-form-field class="fs-block">\n\t\t\t\t\t\t\t\t<input test-id="firstName" matInput name="firstName" [(ngModel)]="info.firstName" type="text"\n\t\t\t\t\t\t\t\t\t   [ngClass]="{\'error\': designServicesLead?.firstName?.invalid && (submitted || designServicesLead.firstName.touched)}"\n\t\t\t\t\t\t\t\t\t   placeholder="First Name" required maxlength="40">\n\t\t\t\t\t\t\t</mat-form-field>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="row half-margin-bottom">\n\t\t\t\t\t\t<div class="col-4">\n\t\t\t\t\t\t\t<p>Last name<span class="text-primary">*</span></p>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class="col-8 col-sm-4">\n\t\t\t\t\t\t\t<mat-form-field class="fs-block">\n\t\t\t\t\t\t\t\t<input test-id="lastName" matInput name="lastName" [(ngModel)]="info.lastName" type="text"\n\t\t\t\t\t\t\t\t\t   [ngClass]="{\'error\': designServicesLead?.lastName?.invalid && (submitted || designServicesLead.lastName.touched)}"\n\t\t\t\t\t\t\t\t\t   placeholder="Last Name" required maxlength="40">\n\t\t\t\t\t\t\t</mat-form-field>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="row half-margin-bottom">\n\t\t\t\t\t\t<div class="col-4">\n\t\t\t\t\t\t\t<p>Email<span class="text-primary">*</span></p>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class="col-8 col-sm-4">\n\t\t\t\t\t\t\t<mat-form-field class="fs-block">\n\t\t\t\t\t\t\t\t<input test-id="email" matInput name="email" [(ngModel)]="info.email" type="email" placeholder="Email"\n\t\t\t\t\t\t\t\t\t   [ngClass]="{\'error\': designServicesLead?.email?.invalid && (submitted || designServicesLead.email.touched)}"\n\t\t\t\t\t\t\t\t\t   required>\n\t\t\t\t\t\t\t</mat-form-field>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class="row half-margin-bottom">\n\t\t\t\t\t<div class="col-4">\n\t\t\t\t\t\t<p>Phone<span class="text-primary">*</span></p>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="col-8 col-sm-4">\n\t\t\t\t\t\t<mat-form-field class="fs-block">\n\t\t\t\t\t\t\t<input test-id="phone" matInput [(ngModel)]="info.phone" type="tel" placeholder="Phone"\n\t\t\t\t\t\t\t\t   [ngClass]="{\'error\': designServicesLead?.phone?.invalid && (submitted || designServicesLead.phone.touched)}"\n\t\t\t\t\t\t\t\t   name="phone" required>\n\t\t\t\t\t\t</mat-form-field>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<h4 class="half-margin-top half-margin-bottom">Project Information</h4>\n\t\t\t\t<div class="row half-margin-bottom">\n\t\t\t\t\t<div class="col-4">\n\t\t\t\t\t\t<p>Project name<span class="text-primary">*</span></p>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="col-8 col-sm-4">\n\t\t\t\t\t\t<mat-form-field>\n\t\t\t\t\t\t\t<input test-id="projectName" matInput name="projectName" [(ngModel)]="info.projectName" type="text"\n\t\t\t\t\t\t\t\t   placeholder="Project Name"\n\t\t\t\t\t\t\t\t   [ngClass]="{\'error\': designServicesLead?.projectName?.invalid && (submitted || designServicesLead.projectName.touched)}"\n\t\t\t\t\t\t\t\t   required maxlength="255">\n\t\t\t\t\t\t</mat-form-field>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class="row half-margin-bottom">\n\t\t\t\t\t<div class="col-4">\n\t\t\t\t\t\t<p>Estimated completion date<span class="text-primary">*</span></p>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="col-8 col-sm-4">\n\t\t\t\t\t\t<mat-form-field>\n\t\t\t\t\t\t\t<input test-id="completionDate" matInput name="completionDate" [(ngModel)]="completionDate" type="date"\n\t\t\t\t\t\t\t\t   placeholder="MM/DD/YYYY" [min]="getNow()" required\n\t\t\t\t\t\t\t\t   [ngClass]="{\'error\': designServicesLead?.completionDate?.invalid && (submitted || designServicesLead.completionDate.touched)}">\n\t\t\t\t\t\t</mat-form-field>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class="row half-margin-bottom">\n\t\t\t\t\t<div class="col-4">\n\t\t\t\t\t\t<p>Construction type<span class="text-primary">*</span></p>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="col-8 col-sm-4"\n\t\t\t\t\t\t [ngClass]="{\'error\': designServicesLead?.construction?.invalid && (submitted || designServicesLead.construction.touched)}">\n\t\t\t\t\t\t<p class="no-margin"><small>Select one</small></p>\n\t\t\t\t\t\t<label><input test-id="isNewConstructionRadio" name="construction" [(ngModel)]="info.constructionType" type="radio" value="0"\n\t\t\t\t\t\t\t\t   required> New Construction</label>\n\t\t\t\t\t\t<label><input test-id="isMajorRemodelRadio" name="construction" [(ngModel)]="info.constructionType" type="radio" value="1"\n\t\t\t\t\t\t\t\t   required> Major Remodel</label>\n\t\t\t\t\t\t<label><input test-id="isRetrofitRadio" name="construction" [(ngModel)]="info.constructionType" type="radio" value="2"\n\t\t\t\t\t\t\t\t   required> Retrofit</label>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class="row half-margin-bottom">\n\t\t\t\t\t<div class="col-4">\n\t\t\t\t\t\t<p>Theater type<span class="text-primary">*</span></p>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="col-8 col-sm-4"\n\t\t\t\t\t\t [ngClass]="{\'error\': designServicesLead?.theaterType?.invalid && (submitted || designServicesLead.theaterType.touched)}">\n\t\t\t\t\t\t<p class="no-margin"><small>Select one</small></p>\n\t\t\t\t\t\t<label><input test-id="isDedicatedTheaterRadio" name="theaterType" [(ngModel)]="info.theaterType" type="radio" value="0" required>\n\t\t\t\t\t\t\tDedicated</label>\n\t\t\t\t\t\t<label><input test-id="isMultipurposeTheaterRadio" name="theaterType" [(ngModel)]="info.theaterType" type="radio" value="1"\n\t\t\t\t\t\t\t\t   required> Multipurpose</label>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class="row half-margin-bottom">\n\t\t\t\t\t<div class="col-4">\n\t\t\t\t\t\t<p>Theater dimensions<span class="text-primary">*</span></p>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="col-8">\n\t\t\t\t\t\t<div class="row half-margin-bottom">\n\t\t\t\t\t\t\t<div class="col-3">\n\t\t\t\t\t\t\t\t<mat-form-field>\n\t\t\t\t\t\t\t\t\t<input test-id="theaterLength" matInput name="theaterLength" [(ngModel)]="info.theaterLength" type="number"\n\t\t\t\t\t\t\t\t\t\t   step="0.1" placeholder="Length" min="0"\n\t\t\t\t\t\t\t\t\t\t   [ngClass]="{\'error\': designServicesLead?.theaterLength?.invalid && (submitted || designServicesLead.theaterLength.touched)}"\n\t\t\t\t\t\t\t\t\t\t   required>\n\t\t\t\t\t\t\t\t</mat-form-field>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class="col-3">\n\t\t\t\t\t\t\t\t<mat-form-field>\n\t\t\t\t\t\t\t\t\t<input test-id="theaterWidth" matInput name="theaterWidth" [(ngModel)]="info.theaterWidth" type="number"\n\t\t\t\t\t\t\t\t\t\t   step="0.1" placeholder="Width" min="0"\n\t\t\t\t\t\t\t\t\t\t   [ngClass]="{\'error\': designServicesLead?.theaterWidth?.invalid && (submitted || designServicesLead.theaterWidth.touched)}"\n\t\t\t\t\t\t\t\t\t\t   required>\n\t\t\t\t\t\t\t\t</mat-form-field>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class="col-3">\n\t\t\t\t\t\t\t\t<mat-form-field>\n\t\t\t\t\t\t\t\t\t<input test-id="theaterHeight" matInput name="theaterHeight" [(ngModel)]="info.theaterHeight" type="number"\n\t\t\t\t\t\t\t\t\t\t   step="0.1" placeholder="Height" min="0"\n\t\t\t\t\t\t\t\t\t\t   [ngClass]="{\'error\': designServicesLead?.theaterHeight?.invalid && (submitted || designServicesLead.theaterHeight.touched)}"\n\t\t\t\t\t\t\t\t\t\t   required>\n\t\t\t\t\t\t\t\t</mat-form-field>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class="col-3">\n\t\t\t\t\t\t\t\t<select test-id="selectedTheaterUnits" [(ngModel)]="info.theaterUnits" name="theaterUnits"\n\t\t\t\t\t\t\t\t\t\t[ngClass]="{\'error\': designServicesLead?.theaterUnits?.invalid && (submitted || designServicesLead.theaterUnits.touched)}"\n\t\t\t\t\t\t\t\t\t\trequired>\n\t\t\t\t\t\t\t\t\t<option>Inches</option>\n\t\t\t\t\t\t\t\t\t<option>Feet</option>\n\t\t\t\t\t\t\t\t\t<option>Centimeters</option>\n\t\t\t\t\t\t\t\t\t<option>Meters</option>\n\t\t\t\t\t\t\t\t</select>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class="row half-margin-bottom">\n\t\t\t\t\t<div class="col-4">\n\t\t\t\t\t\t<p class="no-margin">Theater Seating<span class="text-primary">*</span></p>\n\t\t\t\t\t\t<p><small>Describe seating, specify seating locations with distances and sizes of risers.</small></p>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="col-8 col-xl-4">\n\t\t\t\t\t\t<textarea test-id="theaterSeatingDescription" name="seating" [(ngModel)]="info.theaterSeating" placeholder="Describe seating"\n\t\t\t\t\t\t\t\t  [ngClass]="{\'error\': designServicesLead?.seating?.invalid && (submitted || designServicesLead.seating.touched)}"\n\t\t\t\t\t\t\t\t  maxlength="5000" required></textarea>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class="row half-margin-bottom">\n\t\t\t\t\t<div class="col-4">\n\t\t\t\t\t\t<p>Display type<span class="text-primary">*</span></p>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="col-8">\n\t\t\t\t\t\t<mat-form-field>\n\t\t\t\t\t\t\t<input test-id="theaterDisplayType" matInput name="display" [(ngModel)]="info.theaterDisplayType" type="text"\n\t\t\t\t\t\t\t\t   placeholder="Flat panel TV, Projector with acoustic screen, etc."\n\t\t\t\t\t\t\t\t   [ngClass]="{\'error\': designServicesLead?.display?.invalid && (submitted || designServicesLead.display.touched)}"\n\t\t\t\t\t\t\t\t   required maxlength="5000">\n\t\t\t\t\t\t</mat-form-field>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class="row half-margin-bottom">\n\t\t\t\t\t<div class="col-4">\n\t\t\t\t\t\t<p>Display size and aspect ratio<span class="text-primary">*</span></p>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="col-8">\n\t\t\t\t\t\t<div class="row half-margin-bottom">\n\t\t\t\t\t\t\t<div class="col-3">\n\t\t\t\t\t\t\t\t<mat-form-field>\n\t\t\t\t\t\t\t\t\t<input test-id="displayWidth" matInput name="displayWidth" [(ngModel)]="info.displayWidth"\n\t\t\t\t\t\t\t\t\t\t   [ngClass]="{\'error\': designServicesLead?.displayWidth?.invalid && (submitted || designServicesLead.displayWidth.touched)}"\n\t\t\t\t\t\t\t\t\t\t   type="number" step="0.1" placeholder="Width" min="0" required>\n\t\t\t\t\t\t\t\t</mat-form-field>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class="col-3">\n\t\t\t\t\t\t\t\t<mat-form-field>\n\t\t\t\t\t\t\t\t\t<input test-id="displayHeight" matInput name="displayHeight" [(ngModel)]="info.displayHeight"\n\t\t\t\t\t\t\t\t\t\t   [ngClass]="{\'error\': designServicesLead?.displayHeight?.invalid && (submitted || designServicesLead.displayHeight.touched)}"\n\t\t\t\t\t\t\t\t\t\t   type="number" step="0.1" placeholder="Height" min="0" required>\n\t\t\t\t\t\t\t\t</mat-form-field>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class="col-3">\n\t\t\t\t\t\t\t\t<select test-id="selectedDisplayUnits" [(ngModel)]="info.displayUnits" name="displayUnits"\n\t\t\t\t\t\t\t\t\t\t[ngClass]="{\'error\': designServicesLead?.displayUnits?.invalid && (submitted || designServicesLead.displayUnits.touched)}">\n\t\t\t\t\t\t\t\t\t<option>Inches</option>\n\t\t\t\t\t\t\t\t\t<option>Feet</option>\n\t\t\t\t\t\t\t\t\t<option>Centimeters</option>\n\t\t\t\t\t\t\t\t\t<option>Meters</option>\n\t\t\t\t\t\t\t\t</select>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class="col-3">\n\t\t\t\t\t\t\t\t<select test-id="selectedAspectRatio" name="aspectRatio" [(ngModel)]="info.aspectRatio"\n\t\t\t\t\t\t\t\t\t\t[ngClass]="{\'error\': designServicesLead?.aspectRatio?.invalid && (submitted || designServicesLead.aspectRatio.touched)}"\n\t\t\t\t\t\t\t\t\t\trequired>\n\t\t\t\t\t\t\t\t\t<option selected disabled [value]="undefined">Aspect Ratio</option>\n\t\t\t\t\t\t\t\t\t<option value="16:9">16:9</option>\n\t\t\t\t\t\t\t\t\t<option value="4:3">4:3</option>\n\t\t\t\t\t\t\t\t\t<option value="21:9">21:9</option>\n\t\t\t\t\t\t\t\t</select>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class="row half-margin-bottom">\n\t\t\t\t\t<div class="col-4">\n\t\t\t\t\t\t<p class="no-margin">Speaker layout<span class="text-primary">*</span></p>\n\t\t\t\t\t\t<p><small>Specify number of main speakers, number of subwoofers, number of Atmos height speakers, etc.</small></p>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="col-8 col-xl-4">\n\t\t\t\t\t\t<textarea test-id="theaterSpeakerLayoutDescription" name="layout" [(ngModel)]="info.theaterSpeakerLayout"\n\t\t\t\t\t\t\t\t  placeholder="7.1.1 Surround, 5.4.2 Surround, Atmos, etc."\n\t\t\t\t\t\t\t\t  [ngClass]="{\'error\': designServicesLead?.layout?.invalid && (submitted || designServicesLead.layout.touched)}"\n\t\t\t\t\t\t\t\t  maxlength="5000" required></textarea>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class="row half-margin-bottom">\n\t\t\t\t\t<div class="col-4">\n\t\t\t\t\t\t<p>Preferred maximum volume<span class="text-primary">*</span></p>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="col-8 col-sm-4">\n\t\t\t\t\t\t<select test-id="selectedMaxVolume" name="maxVol" [(ngModel)]="info.theaterMaxVolume"\n\t\t\t\t\t\t\t\t[ngClass]="{\'error\': designServicesLead?.maxVol?.invalid && (submitted || designServicesLead.maxVol.touched)}"\n\t\t\t\t\t\t\t\trequired>\n\t\t\t\t\t\t\t<option selected [value]="undefined" disabled>Select One</option>\n\t\t\t\t\t\t\t<option value="1">1. Foreground</option>\n\t\t\t\t\t\t\t<option value="2">2. Shout To Be Heard</option>\n\t\t\t\t\t\t\t<option value="3">3. Cinematic Reference, Too Loud For Conversation</option>\n\t\t\t\t\t\t\t<option value="0">I don\'t know</option>\n\t\t\t\t\t\t</select>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class="row half-margin-bottom">\n\t\t\t\t\t<div class="col-4">\n\t\t\t\t\t\t<p>Speaker line<span class="text-primary">*</span></p>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="col-8 col-sm-4">\n\t\t\t\t\t\t<select test-id="selectedSpeakerLine" name="speakerLine" [(ngModel)]="info.theaterSpeakerLine"\n\t\t\t\t\t\t\t\t[ngClass]="{\'error\': designServicesLead?.speakerLine?.invalid && (submitted || designServicesLead.speakerLine.touched)}"\n\t\t\t\t\t\t\t\trequired>\n\t\t\t\t\t\t\t<option selected [value]="undefined" disabled>Select One</option>\n\t\t\t\t\t\t\t<option value="1">Bronze (Good)</option>\n\t\t\t\t\t\t\t<option value="2">Silver or Gold (Better)</option>\n\t\t\t\t\t\t\t<option value="3">Platinum or Cinema Reference (Best)</option>\n\t\t\t\t\t\t\t<option value="0">I don\'t know</option>\n\t\t\t\t\t\t</select>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class="row half-margin-bottom">\n\t\t\t\t\t<div class="col-4">\n\t\t\t\t\t\t<p class="no-margin">Approximate customer budget<span class="text-primary">*</span></p>\n\t\t\t\t\t\t<p><small>*Numbers only</small></p>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="col-8 col-sm-4">\n\t\t\t\t\t\t<div class="row no-margin">\n\t\t\t\t\t\t\t<div class="col-3">\n\t\t\t\t\t\t\t\t<div class="light-grey text-center">\n\t\t\t\t\t\t\t\t\t<i class="fal fa-dollar-sign" style="line-height: 50px;"></i> <span\n\t\t\t\t\t\t\t\t\t\t  class="text-grey">USD</span>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class="col-9">\n\t\t\t\t\t\t\t\t<mat-form-field>\n\t\t\t\t\t\t\t\t\t<input test-id="theaterCustomerBudget" matInput name="budget" [(ngModel)]="info.theaterCustomerBudget" type="number"\n\t\t\t\t\t\t\t\t\t\t   placeholder="Approximate customer budget" min="0"\n\t\t\t\t\t\t\t\t\t\t   [ngClass]="{\'error\': designServicesLead?.budget?.invalid && (submitted || designServicesLead.budget.touched)}"\n\t\t\t\t\t\t\t\t\t\t   required>\n\t\t\t\t\t\t\t\t</mat-form-field>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class="row half-margin-bottom">\n\t\t\t\t\t<div class="col-4">\n\t\t\t\t\t\t<p>Speaker placement</p>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="col-8 col-sm-4">\n\t\t\t\t\t\t<input test-id="projectTheaterSpeakerPlacement" type="hidden" name="projectTheaterSpeakerPlacement">\n\t\t\t\t\t\t<p class="no-margin"><small>Select all that apply</small></p>\n\t\t\t\t\t\t<label *ngFor="let placement of placementChoices"><input test-id="placementOptionCheckbox" type="checkbox" [value]="placement"\n\t\t\t\t\t\t\t\t   [checked]="selectedPlacements.indexOf(placement) > -1"\n\t\t\t\t\t\t\t\t   (click)="togglePlacement(placement)"> {{placement}}</label>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class="row half-margin-bottom">\n\t\t\t\t\t<div class="col-4">\n\t\t\t\t\t\t<p class="no-margin">Electronics<span class="text-primary">*</span></p>\n\t\t\t\t\t\t<p><small>Describe audio and video electronics brands and models, indicate whether each model is already specified or being\n\t\t\t\t\t\t\t\tconsidered.</small></p>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="col-8 col-xl-4">\n\t\t\t\t\t\t<textarea test-id="theaterElectronicsDescription" name="electronics" [(ngModel)]="info.theaterElectronics"\n\t\t\t\t\t\t\t\t  placeholder="Describe electronics brands and models"\n\t\t\t\t\t\t\t\t  [ngClass]="{\'error\': designServicesLead?.electronics?.invalid && (submitted || designServicesLead.electronics.touched)}"\n\t\t\t\t\t\t\t\t  maxlength="5000" required></textarea>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class="row half-margin-bottom">\n\t\t\t\t\t<div class="col-4">\n\t\t\t\t\t\t<p class="no-margin">Challenges<span class="text-primary">*</span></p>\n\t\t\t\t\t\t<p><small>Describe any obstacles or any other unusual features. Are any other third-party designers or architects involved, if so please\n\t\t\t\t\t\t\t\tspecify. If speakers are to be in-cabinet, in-wall or in-ceiling, note physical constraints. For example, all wall and ceiling\n\t\t\t\t\t\t\t\tmounting depths, width or length. Which direction do ceiling joists run?</small></p>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="col-8 col-xl-4">\n\t\t\t\t\t\t<textarea test-id="theaterChallengesDescription" name="challenges" [(ngModel)]="info.theaterChallenges"\n\t\t\t\t\t\t\t\t  placeholder="Describe challenges"\n\t\t\t\t\t\t\t\t  [ngClass]="{\'error\': designServicesLead?.theaterChallenges?.invalid && (submitted || designServicesLead.theaterChallenges.touched)}"\n\t\t\t\t\t\t\t\t  maxlength="5000" required></textarea>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class="row half-margin-bottom">\n\t\t\t\t\t<div class="col-4">\n\t\t\t\t\t\t<p class="no-margin">Are you able to provide a floor plan with elevations?<span class="text-primary">*</span></p>\n\t\t\t\t\t\t<p><small>Only 5 files can be submitted per upload.</small></p>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="col-8 col-sm-4">\n\t\t\t\t\t\t<p class="no-margin"><small>Select one</small></p>\n\t\t\t\t\t\t<label><input test-id="theaterFloorplanIsAvailableRadio" name="theaterFloorplanAvailable"\n\t\t\t\t\t\t\t\t   [(ngModel)]="info.theaterFloorplanAvailable"\n\t\t\t\t\t\t\t\t   type="radio" [value]="true"> Yes</label>\n\t\t\t\t\t\t<label><input test-id="theaterFloorplanUnavailableRadio" name="theaterFloorplanAvailable"\n\t\t\t\t\t\t\t\t   [(ngModel)]="info.theaterFloorplanAvailable"\n\t\t\t\t\t\t\t\t   type="radio" [value]="false"> No</label>\n\t\t\t\t\t\t<div *ngIf="info.theaterFloorplanAvailable">\n\t\t\t\t\t\t\t<c4-file-upload folder="design-service-images" text="Upload Floorplan" maxFiles="5"\n\t\t\t\t\t\t\t\t\t\t\tfileFormats="jpeg,jpg,png,pdf" (complete)="saveMedia($event)" [files]="fileQueue"\n\t\t\t\t\t\t\t\t\t\t\tclasses="grey"></c4-file-upload>\n\t\t\t\t\t\t\t<div class="half-margin-top half-margin-bottom" *ngFor="let file of fileQueue">\n\t\t\t\t\t\t\t\t<a [href]="file.secure_url" target="_blank">{{file.original_filename}}</a>\n\t\t\t\t\t\t\t\t<i class="fal fa-trash hover" alt="remove" (click)="deleteMedia(file)"></i>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<p class="no-margin"><small>Or, provide a downloadable floor plan URL</small></p>\n\t\t\t\t\t\t\t<mat-form-field *ngIf="fileQueue.length == 0">\n\t\t\t\t\t\t\t\t<input test-id="theaterFloorplanUpload" matInput name="projectTheaterFloorplan" [(ngModel)]="info.theaterFloorplan"\n\t\t\t\t\t\t\t\t\t   [ngClass]="{\'error\': designServicesLead?.projectTheaterFloorplan?.invalid && (submitted || designServicesLead.projectTheaterFloorplan.touched)}"\n\t\t\t\t\t\t\t\t\t   type="text" placeholder="Google Drive, Box, Dropbox, etc." maxlength="5000">\n\t\t\t\t\t\t\t</mat-form-field>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<p><small><a\n\t\t\t\t\t\t\t\t   href="https://res.cloudinary.com/control4/image/upload/v1506095790/static-pages/design-services/designservice-example-floor-plan.pdf"\n\t\t\t\t\t\t\t\t   target="_blank">See Example Floor Plan</a></small></p>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class="alert alert-danger" *ngIf="designServicesLead?.invalid">Please complete all required fields. <br>If you\'re having issues with this\n\t\t\t\t\tform please <a\n\t\t\t\t\t   [href]="\'mailto:dbailey@control4.com?subject=Design%20Service%20Troubleshooting&cc=onlineordering@control4.com&body=\'+info.firstName+\'%2C%0D%0AIf%20you%27re%20having%20a%20technical%20issue%2C%20please%20describe%20the%20issue%2C%20operating%20system%2C%20and%20internet%20browser%20along%20with%20attached%20screenshots%20to%20help%20us%20assist%20you.%20We%20will%20get%20back%20with%20you%20as%20soon%20as%20possible.%0D%0A%0D%0AThank%20you%2C%0D%0AThe%20Control4%20Design%20Service%20Team\'">contact\n\t\t\t\t\t\tus.</a></div>\n\t\t\t\t<div class="alert alert-danger" *ngIf="showError">An error occurred during the lead submission process. </div>\n\t\t\t\t<button test-id="submitDesignServiceRequest" type="submit" [disabled]="designServicesLead.invalid">Submit Design Service Request</button>\n\t\t\t</form>\n\t\t</div>\n\t</div>\n</div>'},woMX:function(t,e){t.exports=""},yxHf:function(t,e){t.exports='<div class="padding">\n\t<div class="widget padding">\n\t\t<h1>Lighting Design Service</h1>\n\t\t\x3c!-- <p>This free service provides Triad/Control4 Dealers with a detailed project-specific Lighting BOM. Once a BOM is agreed on, on request we can provide\n\t\t\tplans and placement details. Please allow for at least one week after submission to receive detailed BOM. Whole Home Lighting projects are quite\n\t\t\ttechnical. Quality, output levels and costs vary wildly. To keep the process efficient, we need a clear understanding of the project\u2019s scope and\n\t\t\tgoals plus construction or design details that may limit certain options. The more info we have the better job we can do for you.</p> --\x3e\n\t\t<div id="thank-you" *ngIf="displayThankYou">\n\t\t\t<div class="alert alert-success">\n\t\t\t\t<h2>Thank you</h2>\n\t\t\t\t<p>Your request was submitted successfully. We will be contacting you shortly with more information.</p>\n\t\t\t</div>\n\t\t</div>\n\t\t<div class="alert alert-warning">\n\t\t\t<h4>This design service has been discontinued</h4>\n\t\t\t<p>The <a\n\t\t\t\t   routerLink="/design-services/home-theater-speaker-design-service">home theater design service</a> will remain available and we\u2019ll continue to\n\t\t\t\tprocess submissions. We\u2019re always evaluating the services and tools that we provide dealers to support their business. We have redirected\n\t\t\t\tresources to develop new services and we look forward to sharing them with you when\u2019re they\u2019re ready.</p>\n\t\t</div>\n\t\t<div class="form-wrapper fade" *ngIf="!displayThankYou && false">\n\t\t\t<form ngNativeValidate name="designServicesLead" #designServicesLead="ngForm"\n\t\t\t\t  (ngSubmit)="submit(designServicesLead)">\n\t\t\t\t<p>Submit answers to the following questions with as much detail as possible.</p>\n\t\t\t\t<div class="winnieThePooh"><input test-id="winnieThePooh" type="text" name="winnieThePooh" autocomplete="off"></div>\n\t\t\t\t<h4 class="half-margin-top half-margin-bottom">Contact Information</h4>\n\t\t\t\t<div>\n\t\t\t\t\t<div class="row half-margin-bottom">\n\t\t\t\t\t\t<div class="col-4">\n\t\t\t\t\t\t\t<p>Dealer ID<span class="text-primary">*</span></p>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class="col-8 col-sm-4">\n\t\t\t\t\t\t\t<mat-form-field>\n\t\t\t\t\t\t\t\t<input test-id="dealerId" matInput name="account" [(ngModel)]="info.dealerID" type="text"\n\t\t\t\t\t\t\t\t\t   placeholder="Dealer Account"\n\t\t\t\t\t\t\t\t\t   [ngClass]="{\'error\': designServicesLead?.account?.invalid && (submitted || designServicesLead.account.$touched)}"\n\t\t\t\t\t\t\t\t\t   required>\n\t\t\t\t\t\t\t</mat-form-field>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="row half-margin-bottom">\n\t\t\t\t\t\t<div class="col-4">\n\t\t\t\t\t\t\t<p>First name<span class="text-primary">*</span></p>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class="col-8 col-sm-4">\n\t\t\t\t\t\t\t<mat-form-field class="fs-block">\n\t\t\t\t\t\t\t\t<input test-id="firstName" matInput name="firstName" [(ngModel)]="info.firstName" type="text"\n\t\t\t\t\t\t\t\t\t   [ngClass]="{\'error\': designServicesLead?.firstName?.invalid && (submitted || designServicesLead.firstName.$touched)}"\n\t\t\t\t\t\t\t\t\t   placeholder="First Name" required maxlength="40">\n\t\t\t\t\t\t\t</mat-form-field>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="row half-margin-bottom">\n\t\t\t\t\t\t<div class="col-4">\n\t\t\t\t\t\t\t<p>Last name<span class="text-primary">*</span></p>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class="col-8 col-sm-4">\n\t\t\t\t\t\t\t<mat-form-field class="fs-block">\n\t\t\t\t\t\t\t\t<input test-id="lastName" matInput name="lastName" [(ngModel)]="info.lastName" type="text"\n\t\t\t\t\t\t\t\t\t   [ngClass]="{\'error\': designServicesLead?.lastName?.invalid && (submitted || designServicesLead.lastName.$touched)}"\n\t\t\t\t\t\t\t\t\t   placeholder="Last Name" required maxlength="40">\n\t\t\t\t\t\t\t</mat-form-field>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="row half-margin-bottom">\n\t\t\t\t\t\t<div class="col-4">\n\t\t\t\t\t\t\t<p>Email<span class="text-primary">*</span></p>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class="col-8 col-sm-4">\n\t\t\t\t\t\t\t<mat-form-field class="fs-block">\n\t\t\t\t\t\t\t\t<input test-id="email" matInput name="email" [(ngModel)]="info.email" type="email" placeholder="Email"\n\t\t\t\t\t\t\t\t\t   [ngClass]="{\'error\': designServicesLead?.email?.invalid && (submitted || designServicesLead.email.$touched)}"\n\t\t\t\t\t\t\t\t\t   required>\n\t\t\t\t\t\t\t</mat-form-field>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class="row half-margin-bottom">\n\t\t\t\t\t<div class="col-4">\n\t\t\t\t\t\t<p>Phone<span class="text-primary">*</span></p>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="col-8 col-sm-4">\n\t\t\t\t\t\t<mat-form-field class="fs-block">\n\t\t\t\t\t\t\t<input test-id="phone" matInput name="phone" [(ngModel)]="info.phone" type="tel"\n\t\t\t\t\t\t\t\t   [ngClass]="{\'error\': designServicesLead?.phone?.invalid && (submitted || designServicesLead.phone.$touched)}"\n\t\t\t\t\t\t\t\t   required placeholder="Phone">\n\t\t\t\t\t\t</mat-form-field>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<h4 class="half-margin-top half-margin-bottom">Project Information</h4>\n\t\t\t\t<div class="row half-margin-bottom">\n\t\t\t\t\t<div class="col-4">\n\t\t\t\t\t\t<p>Project name<span class="text-primary">*</span></p>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="col-8 col-sm-4">\n\t\t\t\t\t\t<mat-form-field>\n\t\t\t\t\t\t\t<input test-id="projectName" matInput name="projectName" [(ngModel)]="info.projectName" type="text"\n\t\t\t\t\t\t\t\t   placeholder="Project Name"\n\t\t\t\t\t\t\t\t   [ngClass]="{\'error\': designServicesLead?.projectName?.invalid && (submitted || designServicesLead.projectName.$touched)}"\n\t\t\t\t\t\t\t\t   required maxlength="255">\n\t\t\t\t\t\t</mat-form-field>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class="row half-margin-bottom">\n\t\t\t\t\t<div class="col-4">\n\t\t\t\t\t\t<p>Estimated completion date<span class="text-primary">*</span></p>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="col-8 col-sm-4">\n\t\t\t\t\t\t<mat-form-field>\n\t\t\t\t\t\t\t<input test-id="completionDate" matInput name="completionDate" [(ngModel)]="completionDate" type="date"\n\t\t\t\t\t\t\t\t   placeholder="MM/DD/YYYY" [min]="getNow()"\n\t\t\t\t\t\t\t\t   [ngClass]="{\'error\': designServicesLead?.completionDate?.invalid && (submitted || designServicesLead.completionDate.$touched)}"\n\t\t\t\t\t\t\t\t   required>\n\t\t\t\t\t\t</mat-form-field>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class="row half-margin-bottom half-margin-top-i">\n\t\t\t\t\t<div class="col-4">\n\t\t\t\t\t\t<p>Construction type<span class="text-primary">*</span></p>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="col-8 col-sm-4"\n\t\t\t\t\t\t [ngClass]="{\'error\': designServicesLead?.construction?.invalid && (submitted || designServicesLead.construction.$touched)}">\n\t\t\t\t\t\t<p class="no-margin"><small>Select one</small></p>\n\t\t\t\t\t\t<label><input test-id="isNewConstructionRadio" name="construction" [(ngModel)]="info.constructionType" type="radio" value="0"\n\t\t\t\t\t\t\t\t   required> New Construction</label>\n\t\t\t\t\t\t<label><input test-id="isMajorRemodelRadio" name="construction" [(ngModel)]="info.constructionType" type="radio" value="1"\n\t\t\t\t\t\t\t\t   required> Major Remodel</label>\n\t\t\t\t\t\t<label><input test-id="isRetrofitRadio" name="construction" [(ngModel)]="info.constructionType" type="radio" value="2"\n\t\t\t\t\t\t\t\t   required> Retrofit</label>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class="row half-margin-bottom half-margin-top-i">\n\t\t\t\t\t<div class="col-4">\n\t\t\t\t\t\t<p>Type of Lighting Design<span class="text-primary">*</span></p>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="col-4">\n\t\t\t\t\t\t<p class="no-margin"><small>Select one</small></p>\n\t\t\t\t\t\t<label><input test-id="isWirelessLightingRadio" name="lightDesignType" [(ngModel)]="info.lightingDesignType" type="radio"\n\t\t\t\t\t\t\t\t   value="wireless" required />Wireless</label>\n\t\t\t\t\t\t<label><input test-id="isCentralizedLightingRadio" name="lightDesignType" [(ngModel)]="info.lightingDesignType" type="radio"\n\t\t\t\t\t\t\t\t   value="centralized" required />Centralized (Panelized)</label>\n\t\t\t\t\t\t<label><input test-id="isWirelessCentralizedLightingRadio" name="lightDesignType" [(ngModel)]="info.lightingDesignType"\n\t\t\t\t\t\t\t\t   type="radio"\n\t\t\t\t\t\t\t\t   value="both" required />Both (Two separate bill of materials)</label>\n\t\t\t\t\t\t<label><input test-id="unknownLightingTypeRadio" name="lightDesignType" [(ngModel)]="info.lightingDesignType" type="radio"\n\t\t\t\t\t\t\t\t   value="I don\'t know" required />I don\'t know </label>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class="row margin-bottom half-margin-top-i" *ngIf="info.lightingDesignType != \'wireless\'">\n\t\t\t\t\t<div class="col-4">\n\t\t\t\t\t\t<p>Central Lighting Design:<span class="text-primary">*</span></p>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="col-8">\n\t\t\t\t\t\t<p class="no-margin"><small>Select one</small></p>\n\t\t\t\t\t\t<label><input test-id="fullyCentralizedNoZigbeeRadio" name="centralDesignType" [(ngModel)]="info.centralDesignType" type="radio"\n\t\t\t\t\t\t\t\t   value="Fully centralized with no Zigbee keypads" required />Fully centralized with no Zigbee keypads</label>\n\t\t\t\t\t\t<label><input test-id="fullyCentralizedAllZigbeeRadio" name="centralDesignType" [(ngModel)]="info.centralDesignType" type="radio"\n\t\t\t\t\t\t\t\t   value="Fully centralized with all wireless Zigbee keypads" required />Fully centralized with all wireless Zigbee\n\t\t\t\t\t\t\tkeypads</label>\n\t\t\t\t\t\t<label><input test-id="partiallyCentralizedHalfZigbeeRadio" name="centralDesignType" [(ngModel)]="info.centralDesignType"\n\t\t\t\t\t\t\t\t   type="radio"\n\t\t\t\t\t\t\t\t   value="Partially centralized with 50% wireless Zigbee keypad and 50% wired keypad"\n\t\t\t\t\t\t\t\t   required />Partially centralized with 50% wireless Zigbee keypad and 50% wired keypad</label>\n\t\t\t\t\t\t<label><input test-id="partiallyCentralizedWithWirelessInSecondaryRoomsRadio" name="centralDesignType"\n\t\t\t\t\t\t\t\t   [(ngModel)]="info.centralDesignType" type="radio"\n\t\t\t\t\t\t\t\t   value="Partially centralized with wireless lighting in secondary rooms and wired keypads in common areas"\n\t\t\t\t\t\t\t\t   required />Partially centralized with wireless lighting in secondary rooms and wired keypads in common areas</label>\n\t\t\t\t\t\t<label><input test-id="unknownCentralDesignTypeRadio" name="centralDesignType" [(ngModel)]="info.centralDesignType" type="radio"\n\t\t\t\t\t\t\t\t   value="i don\'t know" required /> I don\'t know </label>\n\t\t\t\t\t\t<label><input test-id="specialRequestCentralDesignTypeRadio" name="centralDesignType" [(ngModel)]="info.centralDesignType"\n\t\t\t\t\t\t\t\t   type="radio"\n\t\t\t\t\t\t\t\t   value="special request" required />Special request</label>\n\t\t\t\t\t\t<div *ngIf="info.centralDesignType == \'special request\'" class="row">\n\t\t\t\t\t\t\t<div class="col-12 col-xl-6">\n\t\t\t\t\t\t\t\t<textarea test-id="centralDesignSpecialRequest" name="centralDesignSpecialRequest"\n\t\t\t\t\t\t\t\t\t\t  [(ngModel)]="info.centralDesignSpecialRequest" placeholder="Special Request"\n\t\t\t\t\t\t\t\t\t\t  maxlength="7500" class="half-margin-top"></textarea>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class="row margin-bottom half-margin-top-i">\n\t\t\t\t\t<div class="col-4">\n\t\t\t\t\t\t<p>Are we designing for an entire or a partial project?<span class="text-primary">*</span></p>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="col-4">\n\t\t\t\t\t\t<p class="no-margin"><small>Select one</small></p>\n\t\t\t\t\t\t<label><input test-id="entireProjectRadio" name="projectSize" [(ngModel)]="info.lightingProjectSize" type="radio"\n\t\t\t\t\t\t\t\t   value="entire project" required />Entire Project</label>\n\t\t\t\t\t\t<label><input test-id="partialProjectRadio" name="projectSize" [(ngModel)]="info.lightingProjectSize" type="radio"\n\t\t\t\t\t\t\t\t   value="partial project" required />Partial Project</label>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class="row half-margin-bottom-i half-margin-top-i">\n\t\t\t\t\t<div class="col-4">\n\t\t\t\t\t\t<p class="no-margin">Are you able to provide an electrical floor plan, elevations, drawings, and/or photographs of the space?<span\n\t\t\t\t\t\t\t\t  class="text-primary">*</span></p>\n\t\t\t\t\t\t<p><small>Only 5 files can be submitted per upload.</small></p>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="col-8 col-sm-4">\n\t\t\t\t\t\t<p class="no-margin"><small>Select one</small></p>\n\t\t\t\t\t\t<label><input test-id="lightingFloorplanIsAvailableRadio" name="lightingFloorplanAvailable"\n\t\t\t\t\t\t\t\t   [(ngModel)]="info.lightingFloorplanAvailable"\n\t\t\t\t\t\t\t\t   type="radio" [value]="true"> Yes</label>\n\t\t\t\t\t\t<label><input test-id="lightingFloorplanUnavailableRadio" name="lightingFloorplanAvailable"\n\t\t\t\t\t\t\t\t   [(ngModel)]="info.lightingFloorplanAvailable"\n\t\t\t\t\t\t\t\t   type="radio" [value]="false"> No</label>\n\t\t\t\t\t\t<div *ngIf="info.lightingFloorplanAvailable">\n\t\t\t\t\t\t\t<c4-file-upload folder="design-service-images" text="Upload Files" maxFiles="5"\n\t\t\t\t\t\t\t\t\t\t\tfileFormats="jpeg,jpg,png,pdf" (complete)="saveMedia($event)" [files]="fileQueue"\n\t\t\t\t\t\t\t\t\t\t\tclasses="grey half-margin-top"></c4-file-upload>\n\t\t\t\t\t\t\t<div class="half-margin-top half-margin-bottom" *ngFor="let file of fileQueue">\n\t\t\t\t\t\t\t\t<a [href]="file.secure_url" target="_blank">{{file.original_filename}}</a>\n\t\t\t\t\t\t\t\t<i class="fal fa-trash hover" alt="remove" (click)="deleteMedia(file)"></i>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<p class="no-margin"><small>Accepted file types: jpeg, jpg, png, pdf, and zip. If you have more than 5 or file type .dwg, please zip\n\t\t\t\t\t\t\t\t\tfiles before uploading.</small></p>\n\t\t\t\t\t\t\t<p class="no-margin"><small>Or, please provide a downloadable floor plan URL</small></p>\n\t\t\t\t\t\t\t<mat-form-field *ngIf="fileQueue.length == 0">\n\t\t\t\t\t\t\t\t<input test-id="audioFloorplanUpload" matInput name="projectaudioFloorplan" [(ngModel)]="info.lightingFloorplan"\n\t\t\t\t\t\t\t\t\t   [ngClass]="{\'error\': designServicesLead?.projectaudioFloorplan?.invalid && (submitted || designServicesLead.projectaudioFloorplan.touched)}"\n\t\t\t\t\t\t\t\t\t   type="text" placeholder="Google Drive, Box, Dropbox, etc." maxlength="5000">\n\t\t\t\t\t\t\t</mat-form-field>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<p><small><a href="https://res.cloudinary.com/control4/image/upload/v1522871617/Floor_Plan.png"\n\t\t\t\t\t\t\t\t   target="_blank">See Example Floor Plan</a></small></p>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div *ngIf="info.lightingProjectSize == \'partial project\'">\n\t\t\t\t\t<h3 class="margin-top">Add Rooms of Project</h3>\n\t\t\t\t\t<div class="row half-margin-bottom">\n\t\t\t\t\t\t<div class="col-sm-3">\n\t\t\t\t\t\t\t<mat-form-field>\n\t\t\t\t\t\t\t\t<input test-id="roomName" matInput type="text" placeholder="Room Name" id="roomName" name="roomName"\n\t\t\t\t\t\t\t\t\t   [(ngModel)]="newLightingZone.roomName" maxlength="255" />\n\t\t\t\t\t\t\t</mat-form-field>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class="col-sm-2">\n\t\t\t\t\t\t\t<div class="placeholder-wrapper" [ngClass]="{\'placeholder-visible\' : lightingLoadQty}">\n\t\t\t\t\t\t\t\t<div class="placeholder-text" *ngIf="lightingLoadQty">Lighting Qty</div>\n\t\t\t\t\t\t\t\t<select test-id="lightingLoadQty" id="lightingLoadQty" name="lightingLoadQty" [(ngModel)]="lightingLoadQty">\n\t\t\t\t\t\t\t\t\t<option select disabled [value]="undefined">Lighting Load Qty</option>\n\t\t\t\t\t\t\t\t\t<option *ngFor="let light of lightQtys" [value]="light.value">{{light.label}} </option>\n\t\t\t\t\t\t\t\t</select>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class="col-sm-2">\n\t\t\t\t\t\t\t<div class="placeholder-wrapper" [ngClass]="{\'placeholder-visible\' : lighting3wayLoadQty}">\n\t\t\t\t\t\t\t\t<div class="placeholder-text" *ngIf="lighting3wayLoadQty">3 way lighting Qty</div>\n\t\t\t\t\t\t\t\t<select test-id="threeWayLightingLoadQty" id="3wayLightingLoadQty" name="3wayLightingLoadQty"\n\t\t\t\t\t\t\t\t\t\t[(ngModel)]="lighting3wayLoadQty">\n\t\t\t\t\t\t\t\t\t<option selected disabled [value]="undefined">3 Way Lighting Load Qty</option>\n\t\t\t\t\t\t\t\t\t<option *ngFor="let light of lightQtys" [value]="light.value">{{light.label}} </option>\n\t\t\t\t\t\t\t\t</select>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class="col-sm-2">\n\t\t\t\t\t\t\t<label><input test-id="newZoneIsDimmableCheckbox" id="dimmable" type="checkbox" value="true" name="dimmable"\n\t\t\t\t\t\t\t\t\t   [(ngModel)]="newLightingZone.isDimmable">Zone is dimmable? </label>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t\t<button test-id="addLightingRoomClick" type="button" (click)="addLightingRoom();" class="c4btn light-grey text-dark"><i\n\t\t\t\t\t\t   class="fal fa-plus"></i> Add Room</button>\n\t\t\t\t\t<div class="row margin-top half-margin-bottom" data-show-on-hover="#saveRoom"\n\t\t\t\t\t\t *ngFor="let zone of createdLightingZones; let i = index;">\n\t\t\t\t\t\t<div class="col-sm-3">\n\t\t\t\t\t\t\t<mat-form-field>\n\t\t\t\t\t\t\t\t<input attr.test-id="zoneRoomName-{{i}}" matInput [(ngModel)]="zone.roomName" name="roomName{{i}}" type="text"\n\t\t\t\t\t\t\t\t\t   (ngModelChange)="calculateLightingTotals();" placeholder="Room Name"\n\t\t\t\t\t\t\t\t\t   [value]="zone.roomName" />\n\t\t\t\t\t\t\t</mat-form-field>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class="col-sm-2">\n\t\t\t\t\t\t\t<select attr.test-id="selectedLoads-{{i}}" name="selectedLoads{{i}}" [(ngModel)]="zone.selectedLoads"\n\t\t\t\t\t\t\t\t\t(ngModelChange)="calculateLightingTotals();">\n\t\t\t\t\t\t\t\t<option disabled selected [value]="undefined"># of lighting loads</option>\n\t\t\t\t\t\t\t\t<option *ngFor="let light of lightQtys" [value]="light.value">{{light.label}}</option>\n\t\t\t\t\t\t\t</select>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class="col-sm-2">\n\t\t\t\t\t\t\t<select attr.test-id="selectedThreeWayLoads-{{i}}" name="selected3WayLoads{{i}}" [(ngModel)]="zone.selected3wayLoads"\n\t\t\t\t\t\t\t\t\t(ngModelChange)="calculateLightingTotals();">\n\t\t\t\t\t\t\t\t<option disabled selected [value]="undefined"># of 3 way lighting loads</option>\n\t\t\t\t\t\t\t\t<option *ngFor="let light of lightQtys" [value]="light.value">{{light.label}}</option>\n\t\t\t\t\t\t\t</select>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class="col-sm-2">\n\t\t\t\t\t\t\t<label><input attr.test-id="zoneIsDimmableCheckbox-{{i}}" name="isDimmable{{i}}" [(ngModel)]="zone.isDimmable"\n\t\t\t\t\t\t\t\t\t   (checked)="zone.isDimmable" (ngModelChange)="calculateLightingTotals();"\n\t\t\t\t\t\t\t\t\t   type="checkbox">Zone has dimmable lighting?</label>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class="edit-item col-sm-2">\n\t\t\t\t\t\t\t<button attr.test-id="removeLightingRoomClick-{{i}}" type="button" (click)="removeLightingRoom(i);"\n\t\t\t\t\t\t\t\t\tclass="block c4btn light-grey text-dark"><i class="fal fa-minus"></i>Remove</button>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t\t<h3 class="margin-top">Lighting Project Overview</h3>\n\t\t\t\t\t<div class="half-margin-bottom">\n\t\t\t\t\t\t<div class="table">\n\t\t\t\t\t\t\t<div class="body">\n\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t<div class="col-sm-2">\n\t\t\t\t\t\t\t\t\t\t<mat-form-field>\n\t\t\t\t\t\t\t\t\t\t\t<input test-id="totalZones" matInput [value]="lightingZoneTotals.totalZones"\n\t\t\t\t\t\t\t\t\t\t\t\t   [(ngModel)]="lightingZoneTotals.totalZones" readonly type="text"\n\t\t\t\t\t\t\t\t\t\t\t\t   name="totalZones" />\n\t\t\t\t\t\t\t\t\t\t</mat-form-field>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<div class="col-sm-2">\n\t\t\t\t\t\t\t\t\t\t<mat-form-field>\n\t\t\t\t\t\t\t\t\t\t\t<input test-id="totalLights" matInput [value]="lightingZoneTotals.totalLightingLoads"\n\t\t\t\t\t\t\t\t\t\t\t\t   [(ngModel)]="lightingZoneTotals.totalLightingLoads" readonly type="text"\n\t\t\t\t\t\t\t\t\t\t\t\t   name="totalLights" />\n\t\t\t\t\t\t\t\t\t\t</mat-form-field>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<div class="col-sm-2">\n\t\t\t\t\t\t\t\t\t\t<mat-form-field>\n\t\t\t\t\t\t\t\t\t\t\t<input test-id="totalThreeWay" matInput [value]="lightingZoneTotals.totalThreeWayLightingLoads"\n\t\t\t\t\t\t\t\t\t\t\t\t   [(ngModel)]="lightingZoneTotals.totalThreeWayLightingLoads" readonly\n\t\t\t\t\t\t\t\t\t\t\t\t   type="text" name="total3Way" />\n\t\t\t\t\t\t\t\t\t\t</mat-form-field>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<div class="col-sm-2">\n\t\t\t\t\t\t\t\t\t\t<mat-form-field>\n\t\t\t\t\t\t\t\t\t\t\t<input test-id="totalDimmable" matInput [value]="lightingZoneTotals.totalDimmable"\n\t\t\t\t\t\t\t\t\t\t\t\t   [(ngModel)]="lightingZoneTotals.totalDimmable" readonly type="text"\n\t\t\t\t\t\t\t\t\t\t\t\t   name="totalDimmable" />\n\t\t\t\t\t\t\t\t\t\t</mat-form-field>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<hr>\n\t\t\t\t<div style="margin-top: 25px;" class="row half-margin-bottom">\n\t\t\t\t\t<div class="col-4">\n\t\t\t\t\t\t<p>Project Dimming Type<span class="text-primary">*</span></p>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="col-4">\n\t\t\t\t\t\t<select test-id="selectedDimingType" name="dimingType" [(ngModel)]="info.dimmingType">\n\t\t\t\t\t\t\t<option selected [value]="undefined" disabled>Select Dimming Type </option>\n\t\t\t\t\t\t\t<option value="phase-cut">Phase-cut dimming (most common)</option>\n\t\t\t\t\t\t\t<option value="0-10 Volt">0-10 Volt Dimming</option>\n\t\t\t\t\t\t\t<option value="mixture">Mixture of both</option>\n\t\t\t\t\t\t\t<option value="i don\'t know">I don\'t know --will assume phasecut dimming</option>\n\t\t\t\t\t\t</select>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class="row half-margin-bottom">\n\t\t\t\t\t<div class="col-4">\n\t\t\t\t\t\t<p class="no-margin">Challenges, Special Comments, or Architects involved?<span class="text-primary">*</span></p>\n\t\t\t\t\t\t<p><small>Describe any obstacles or any other unusual features. Are any other third-party designers or architects involved, if so please\n\t\t\t\t\t\t\t\tspecify. If speakers are to be in-cabinet, in-wall or in-ceiling, note physical constraints. For example, all wall and ceiling\n\t\t\t\t\t\t\t\tmounting depths, width or length. Which direction do ceiling joists run?</small></p>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="col-8">\n\t\t\t\t\t\t<label class="half-margin-bottom"><input test-id="hasChallengesCheckbox" name="challengesCheck" type="checkbox"\n\t\t\t\t\t\t\t\t   [(ngModel)]="challengesCheck">Challenges?</label>\n\t\t\t\t\t\t\x3c!-- <div class="placeholder-wrapper" [ngClass]="{\'placeholder-visible\' : info.lightingChallenges}"> --\x3e\n\t\t\t\t\t\t\x3c!-- <div class="placeholder-text" *ngIf="info.lightingChallenges">Describe Challenges</div> --\x3e\n\t\t\t\t\t\t<textarea test-id="lightingChallengesDescription" *ngIf="challengesCheck" name="challenges" [(ngModel)]="info.lightingChallenges"\n\t\t\t\t\t\t\t\t  placeholder="Describe challenges" class="half-margin-top"\n\t\t\t\t\t\t\t\t  [ngClass]="{\'error\': designServicesLead?.challenges?.invalid && (submitted || designServicesLead.challenges.$touched)}"\n\t\t\t\t\t\t\t\t  maxlength="7500"></textarea>\n\t\t\t\t\t\t\x3c!-- </div> --\x3e\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class="alert alert-danger half-margin-top" *ngIf="designServicesLead?.invalid">Please complete all required fields. <br>If you\'re having\n\t\t\t\t\tissues with this form please <a\n\t\t\t\t\t   [href]="\'mailto:dbailey@control4.com?subject=Design%20Service%20Troubleshooting&cc=onlineordering@control4.com&body=\'+info.firstName+\'%2C%0D%0AIf%20you%27re%20having%20a%20technical%20issue%2C%20please%20describe%20the%20issue%2C%20operating%20system%2C%20and%20internet%20browser%20along%20with%20attached%20screenshots%20to%20help%20us%20assist%20you.%20We%20will%20get%20back%20with%20you%20as%20soon%20as%20possible.%0D%0A%0D%0AThank%20you%2C%0D%0AThe%20Control4%20Design%20Service%20Team\'">contact\n\t\t\t\t\t\tus.</a></div>\n\t\t\t\t<div class="alert alert-danger" *ngIf="showError">An error occurred during the lead submission process. </div>\n\t\t\t\t<button test-id="submitDesignServicesRequest" type="submit" [disabled]="designServicesLead.invalid" class="half-margin-top"\n\t\t\t\t\t\t(click)="submitted=true">Submit Design Service Request</button>\n\t\t\t</form>\n\t\t</div>\n\t</div>\n</div>'}}]);