(window.webpackJsonp=window.webpackJsonp||[]).push([[23],{"1AaY":function(t,e){t.exports='<div class="padding">\n\t<h1>System Design Tools</h1>\n\t<div class="widget">\n\t\t<div class="padding">\n\t\t\t<div *ngIf="docs" class="table table-hover half-margin-top">\n\t\t\t\t<div *ngFor="let doc of docs" class="row resource padding">\n\t\t\t\t\t<div class="col-3 col-sm-2">\n\t\t\t\t\t\t<a [href]="doc.latest_link" target="_blank">\n\t\t\t\t\t\t\t<img [src]="doc.thumb_url" style="max-height: 180px;">\n\t\t\t\t\t\t</a>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="col-7 col-sm-8">\n\t\t\t\t\t\t<a [href]="doc.latest_link" target="blank">{{ doc.product_name}} {{ doc.doc_type }}\n\t\t\t\t\t\t\t{{ doc.language_name }}</a>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="col-2 text-right">\n\t\t\t\t\t\t<a *ngIf="doc.sku" title="Add to Cart" class="c4btn grey block"\n\t\t\t\t\t\t\trouterLink="/checkout/addproduct/{{ doc.sku }}">\n\t\t\t\t\t\t\t<i class="fal fa-shopping-cart"></i>Add to Cart\n\t\t\t\t\t\t</a>\n\t\t\t\t\t\t<a *ngIf="!doc.external_link" title="Download" class="c4btn grey block" target="_blank"\n\t\t\t\t\t\t\t[href]="doc.latest_link">\n\t\t\t\t\t\t\t<i class="fal fa-arrow-to-bottom"></i>Download\n\t\t\t\t\t\t</a>\n\t\t\t\t\t\t<a *ngIf="doc.external_link" title="Visit" class="c4btn grey block"\n\t\t\t\t\t\t\t[routerLink]="doc.latest_link">\n\t\t\t\t\t\t\t<i class="fal fa-external-link"></i>Visit\n\t\t\t\t\t\t</a>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t</div>\n\t</div>\n</div>'},"4Mhb":function(t,e){t.exports="label:last-child {\n  margin-bottom: 13px;\n}\n\ntextarea.error,\ninput.error,\nselect.error,\ndiv.error {\n  background-color: #fbe2a5 !important;\n}\n\n.edit-item {\n  display: none !important;\n}\n\n.row:hover .edit-item {\n  display: inline-block !important;\n}"},"8IJ2":function(t,e){t.exports="label:last-child {\n  margin-bottom: 13px;\n}\n\ntextarea.error,\ninput.error,\nselect.error,\ndiv.error {\n  background-color: #fbe2a5 !important;\n}\n\n.edit-item {\n  display: none !important;\n}\n\n.row:hover .edit-item {\n  display: inline-block !important;\n}"},BCBM:function(t,e){t.exports="label:last-child {\n  margin-bottom: 13px;\n}\n\ntextarea.error,\ninput.error,\nselect.error,\ndiv.error {\n  background-color: #fbe2a5 !important;\n}\n\n.edit-item {\n  display: none !important;\n}\n\n.row:hover .edit-item {\n  display: inline-block !important;\n}"},CdcK:function(t,e){t.exports='<div class="padding">\n\t<div class="widget padding">\n\t\t<h1>Network Design Service</h1>\n\t\t\x3c!-- <p>This free service provides Pakedge/Control4 Dealers with a detailed project-specific Network BOM. Once a BOM is agreed on, on request we can provide\n\t\t\tplans and placement details. Please allow for at least one week after submission to receive detailed BOM.</p>\n\t\t<p>Whole Home Networking projects are quite technical. To keep the process efficient, we need a clear understanding of the project\u2019s scope and goals\n\t\t\tplus construction or design details that may limit certain network options. The more info we have the better job we can do for you.</p> --\x3e\n\t\t<div id="thank-you" *ngIf="displayThankYou">\n\t\t\t<div class="alert alert-success">\n\t\t\t\t<h2>Thank you</h2>\n\t\t\t\t<p>Your request was submitted successfully. We will be contacting you shortly with more information.</p>\n\t\t\t</div>\n\t\t</div>\n\t\t<div class="alert alert-warning">\n\t\t\t<h4>This design service has been discontinued</h4>\n\t\t\t<p>The <a\n\t\t\t\t   routerLink="/design-services/home-theater-speaker-design-service">home theater design service</a> will remain available and we\u2019ll continue to\n\t\t\t\tprocess submissions. We\u2019re always evaluating the services and tools that we provide dealers to support their business. We have redirected\n\t\t\t\tresources to develop new services and we look forward to sharing them with you when\u2019re they\u2019re ready.</p>\n\t\t</div>\n\t\t<div class="form-wrapper fade" *ngIf="!displayThankYou && false">\n\t\t\t<form ngNativeValidate name="designServicesLead" #designServicesLead="ngForm">\n\t\t\t\t<p>Submit answers to the following questions with as much detail as possible.</p>\n\t\t\t\t<div class="winnieThePooh"><input test-id="winnieThePooh" type="text" name="winnieThePooh" autocomplete="off"></div>\n\t\t\t\t<h4 class="half-margin-top half-margin-bottom">Contact Information</h4>\n\t\t\t\t<div>\n\t\t\t\t\t<div class="row half-margin-bottom">\n\t\t\t\t\t\t<div class="col-4">\n\t\t\t\t\t\t\t<p>Dealer ID<span class="text-primary">*</span></p>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class="col-8 col-sm-4">\n\t\t\t\t\t\t\t<mat-form-field>\n\t\t\t\t\t\t\t\t<input test-id="dealerId" matInput name="account" [(ngModel)]="info.dealerID" type="text"\n\t\t\t\t\t\t\t\t\t   placeholder="Dealer Account"\n\t\t\t\t\t\t\t\t\t   [ngClass]="{\'error\': designServicesLead?.account?.invalid && (submitted || designServicesLead.account.touched)}"\n\t\t\t\t\t\t\t\t\t   required>\n\t\t\t\t\t\t\t</mat-form-field>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="row half-margin-bottom">\n\t\t\t\t\t\t<div class="col-4">\n\t\t\t\t\t\t\t<p>First name<span class="text-primary">*</span></p>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class="col-8 col-sm-4">\n\t\t\t\t\t\t\t<mat-form-field class="fs-block">\n\t\t\t\t\t\t\t\t<input test-id="firstName" matInput name="firstName" [(ngModel)]="info.firstName" type="text"\n\t\t\t\t\t\t\t\t\t   [ngClass]="{\'error\': designServicesLead?.firstName?.invalid && (submitted || designServicesLead.firstName.touched)}"\n\t\t\t\t\t\t\t\t\t   placeholder="First Name" required maxlength="40">\n\t\t\t\t\t\t\t</mat-form-field>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="row half-margin-bottom">\n\t\t\t\t\t\t<div class="col-4">\n\t\t\t\t\t\t\t<p>Last name<span class="text-primary">*</span></p>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class="col-8 col-sm-4">\n\t\t\t\t\t\t\t<mat-form-field class="fs-block">\n\t\t\t\t\t\t\t\t<input test-id="lastName" matInput name="lastName" [(ngModel)]="info.lastName" type="text"\n\t\t\t\t\t\t\t\t\t   [ngClass]="{\'error\': designServicesLead?.lastName?.invalid && (submitted || designServicesLead.lastName.touched)}"\n\t\t\t\t\t\t\t\t\t   placeholder="Last Name" required maxlength="40">\n\t\t\t\t\t\t\t</mat-form-field>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="row half-margin-bottom">\n\t\t\t\t\t\t<div class="col-4">\n\t\t\t\t\t\t\t<p>Email<span class="text-primary">*</span></p>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class="col-8 col-sm-4">\n\t\t\t\t\t\t\t<mat-form-field class="fs-block">\n\t\t\t\t\t\t\t\t<input test-id="email" matInput name="email" [(ngModel)]="info.email" type="email" placeholder="Email"\n\t\t\t\t\t\t\t\t\t   [ngClass]="{\'error\': designServicesLead?.email?.invalid && (submitted || designServicesLead.email.touched)}"\n\t\t\t\t\t\t\t\t\t   required>\n\t\t\t\t\t\t\t</mat-form-field>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class="row half-margin-bottom">\n\t\t\t\t\t<div class="col-4">\n\t\t\t\t\t\t<p>Phone<span class="text-primary">*</span></p>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="col-8 col-sm-4">\n\t\t\t\t\t\t<mat-form-field class="fs-block">\n\t\t\t\t\t\t\t<input test-id="phone" matInput [(ngModel)]="info.phone" type="tel"\n\t\t\t\t\t\t\t\t   [ngClass]="{\'error\': designServicesLead?.phone?.invalid && (submitted || designServicesLead.phone.touched)}"\n\t\t\t\t\t\t\t\t   required placeholder="Phone" name="phone">\n\t\t\t\t\t\t</mat-form-field>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<h4 class="half-margin-top half-margin-bottom">Project Information</h4>\n\t\t\t\t<div class="row half-margin-bottom">\n\t\t\t\t\t<div class="col-4">\n\t\t\t\t\t\t<p>Project name<span class="text-primary">*</span></p>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="col-8 col-sm-4">\n\t\t\t\t\t\t<mat-form-field>\n\t\t\t\t\t\t\t<input test-id="projectName" matInput name="projectName" [(ngModel)]="info.projectName" type="text"\n\t\t\t\t\t\t\t\t   placeholder="Project Name"\n\t\t\t\t\t\t\t\t   [ngClass]="{\'error\': designServicesLead?.projectName?.invalid && (submitted || designServicesLead.projectName.touched)}"\n\t\t\t\t\t\t\t\t   required maxlength="255">\n\t\t\t\t\t\t</mat-form-field>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class="row half-margin-bottom">\n\t\t\t\t\t<div class="col-4">\n\t\t\t\t\t\t<p>Estimated completion date<span class="text-primary">*</span></p>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="col-8 col-sm-4">\n\t\t\t\t\t\t<mat-form-field>\n\t\t\t\t\t\t\t<input test-id="completionDate" matInput name="completionDate" [(ngModel)]="completionDate" type="date"\n\t\t\t\t\t\t\t\t   placeholder="MM/DD/YYYY" [min]="getNow()" required\n\t\t\t\t\t\t\t\t   [ngClass]="{\'error\': designServicesLead?.completionDate?.invalid && (submitted || designServicesLead.completionDate.touched)}">\n\t\t\t\t\t\t</mat-form-field>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class="row half-margin-bottom">\n\t\t\t\t\t<div class="col-4">\n\t\t\t\t\t\t<p>Construction type<span class="text-primary">*</span></p>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="col-8 col-sm-4"\n\t\t\t\t\t\t [ngClass]="{\'error\': designServicesLead?.construction?.invalid && (submitted || designServicesLead.construction.touched)}">\n\t\t\t\t\t\t<p class="no-margin"><small>Select one</small></p>\n\t\t\t\t\t\t<label><input test-id="isNewConstructionRadio" name="construction" [(ngModel)]="info.constructionType" type="radio" value="0"\n\t\t\t\t\t\t\t\t   required> New Construction</label>\n\t\t\t\t\t\t<label><input test-id="isMajorRemodelRadio" name="construction" [(ngModel)]="info.constructionType" type="radio" value="1"\n\t\t\t\t\t\t\t\t   required> Major Remodel</label>\n\t\t\t\t\t\t<label><input test-id="isRetrofitRadio" name="construction" [(ngModel)]="info.constructionType" type="radio" value="2"\n\t\t\t\t\t\t\t\t   required> Retrofit</label>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class="row half-margin-bottom">\n\t\t\t\t\t<div class="col-4">\n\t\t\t\t\t\t<p>What is the square footage/meters of home?</p>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="col-2 col-sm-2">\n\t\t\t\t\t\t<mat-form-field>\n\t\t\t\t\t\t\t<input test-id="networkHomeSize" matInput name="networkHomeSize" [(ngModel)]="info.networkHomeSize" type="number"\n\t\t\t\t\t\t\t\t   step="0.1" min="0" placeholder="Total Area"\n\t\t\t\t\t\t\t\t   [ngClass]="{\'error\': designServicesLead?.networkHomeSize?.invalid && (submitted || designServicesLead.networkHomeSize.touched)}"\n\t\t\t\t\t\t\t\t   required />\n\t\t\t\t\t\t</mat-form-field>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="col-2 col-sm-2">\n\t\t\t\t\t\t<select test-id="selectedNetworkHomeSizeUnit" name="networkHomeSizeUnit" [(ngModel)]="info.networkHomeSizeUnit"\n\t\t\t\t\t\t\t\t[ngClass]="{\'error\': designServicesLead?.networkHomeSizeUnit?.invalid && (submitted || designServicesLead.networkHomeSizeUnit.touched)}"\n\t\t\t\t\t\t\t\trequired>\n\t\t\t\t\t\t\t<option selected disabled [value]="undefined">Select Unit</option>\n\t\t\t\t\t\t\t<option *ngFor="let measurement of homeMeasurement" [value]="measurement.value"> {{measurement.label}}</option>\n\t\t\t\t\t\t</select>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class="row margin-bottom">\n\t\t\t\t\t<div class="col-4">\n\t\t\t\t\t\t<p>What is the primary interior wall structure material? </p>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="col-4">\n\t\t\t\t\t\t<select test-id="selectedNetworkInteriorWallMaterial" name="networkInteriorWallMaterial"\n\t\t\t\t\t\t\t\t[(ngModel)]="info.networkInteriorWallMaterial"\n\t\t\t\t\t\t\t\t[ngClass]="{\'error\': designServicesLead?.networkInteriorWallMaterial?.invalid && (submitted || designServicesLead.networkInteriorWallMaterial.touched)}"\n\t\t\t\t\t\t\t\trequired>\n\t\t\t\t\t\t\t<option disabled [value]="undefined" selected>Select Wall Material </option>\n\t\t\t\t\t\t\t<option *ngFor="let material of structureMaterials" [value]="material.value"> {{material.label}}</option>\n\t\t\t\t\t\t</select>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class="row margin-bottom">\n\t\t\t\t\t<div class="col-4">\n\t\t\t\t\t\t<p>What is the primary interior ceiling structure material? </p>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="col-4">\n\t\t\t\t\t\t<select test-id="selectedNetworkCeilingMaterial" name="networkCeilingMaterial" [(ngModel)]="info.networkCeilingMaterial"\n\t\t\t\t\t\t\t\t[ngClass]="{\'error\': designServicesLead?.networkCeilingMaterial?.invalid && (submitted || designServicesLead.networkCeilingMaterial.touched)}"\n\t\t\t\t\t\t\t\trequired>\n\t\t\t\t\t\t\t<option selected disabled [value]="undefined">Select Ceiling Material </option>\n\t\t\t\t\t\t\t<option *ngFor="let material of structureMaterials" [value]="material.value"> {{material.label}}</option>\n\t\t\t\t\t\t</select>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class="row half-margin-bottom">\n\t\t\t\t\t<div class="col-4">\n\t\t\t\t\t\t<p>What is the environment type?</p>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="col-8 col-sm-4">\n\t\t\t\t\t\t<select test-id="selectedNetworkEnvironment" name="networkEnvironment" [(ngModel)]="info.networkEnvironment"\n\t\t\t\t\t\t\t\t[ngClass]="{\'error\': designServicesLead?.networkEnvironment?.invalid && (submitted || designServicesLead.networkEnvironment.touched)}">\n\t\t\t\t\t\t\t<option [value]="undefined" selected disabled>Select Environment</option>\n\t\t\t\t\t\t\t<option value="low density">Rural - low density</option>\n\t\t\t\t\t\t\t<option value="medium density">Suburban - medium density</option>\n\t\t\t\t\t\t\t<option value="high density">Urban - high density</option>\n\t\t\t\t\t\t</select>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class="row half-margin-bottom">\n\t\t\t\t\t<div class="col-4">\n\t\t\t\t\t\t<p>How many floors in the project?</p>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="col-8 col-sm-4">\n\t\t\t\t\t\t<select test-id="selectedNetworkFloors" name="networkFloors" [(ngModel)]="info.networkFloors"\n\t\t\t\t\t\t\t\t[ngClass]="{\'error\': designServicesLead?.networkFloors?.invalid && (submitted || designServicesLead.networkFloors.touched)}"\n\t\t\t\t\t\t\t\trequired>\n\t\t\t\t\t\t\t<option selected disabled [value]="undefined">Select Number of Floors</option>\n\t\t\t\t\t\t\t<option *ngFor="let quantity of quantities" [value]="quantity.value">{{quantity.label}} </option>\n\t\t\t\t\t\t</select>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class="row half-margin-bottom">\n\t\t\t\t\t<div class="col-4">\n\t\t\t\t\t\t<p>Do you need outdoor wireless coverage?</p>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="col-8 col-sm-4">\n\t\t\t\t\t\t<label><input test-id="needsOutdoorWirelessCoverageCheckbox" type="checkbox" id="networkOutdoor" name="networkOutdoor" value="true"\n\t\t\t\t\t\t\t\t   [(ngModel)]="info.networkOutdoor" />Outdoor?</label>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class="row half-margin-bottom">\n\t\t\t\t\t<div class="col-sm-4">\n\t\t\t\t\t\t<p>What is the network speed?</p>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="col-sm-2">\n\t\t\t\t\t\t<mat-form-field>\n\t\t\t\t\t\t\t<input test-id="networkSpeed" matInput type="number" placeholder="Network Speed" name="networkSpeed" step="0.1"\n\t\t\t\t\t\t\t\t   [(ngModel)]="info.networkSpeed" min="0" max="1000"\n\t\t\t\t\t\t\t\t   [ngClass]="{\'error\': designServicesLead?.networkSpeed && (submitted || designServicesLead.networkSpeed.touched)}"\n\t\t\t\t\t\t\t\t   required>\n\t\t\t\t\t\t</mat-form-field>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="col-sm-2">\n\t\t\t\t\t\t<select test-id="selectedNetworkSpeedUnit" name="networkSpeedUnit" [(ngModel)]="info.networkSpeedUnit"\n\t\t\t\t\t\t\t\t[ngClass]="{\'error\': designServicesLead?.networkSpeedUnit && (submitted || designServicesLead.networkSpeedUnit.touched)}"\n\t\t\t\t\t\t\t\trequired>\n\t\t\t\t\t\t\t<option selected disabled [value]="undefined">Select Speed Unit </option>\n\t\t\t\t\t\t\t<option *ngFor="let speed of internetSpeed" [value]="speed.value">{{speed.label}}</option>\n\t\t\t\t\t\t</select>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class="row half-margin-bottom">\n\t\t\t\t\t<div class="col-sm-4">\n\t\t\t\t\t\t<p>What is the maximum number of users and wireless devices that will be used on the network at anygiven time (on average and during\n\t\t\t\t\t\t\tpeak usage)?</p>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="col-sm-4">\n\t\t\t\t\t\t<select test-id="selectedNetworkPeakUsage" name="networkPeakUsage" [(ngModel)]="info.networkPeakUsage"\n\t\t\t\t\t\t\t\t[ngClass]="{\'error\': designServicesLead?.networkPeakUsage && (submitted || designServicesLead.networkPeakUsage.touched)}"\n\t\t\t\t\t\t\t\trequired>\n\t\t\t\t\t\t\t<option selected disabled [value]="undefined">Select Number of Devices</option>\n\t\t\t\t\t\t\t<option *ngFor="let deviceUse of devicesUsing" [value]="deviceUse.value">{{deviceUse.label}} </option>\n\t\t\t\t\t\t</select>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<h3 class="margin-top half-margin-bottom">Number of <i>wireless</i> smart devices on the network?</h3>\n\t\t\t\t<div class="row half-margin-bottom">\n\t\t\t\t\t<div class="col-4">\n\t\t\t\t\t\t<p>Number of high-throughput wireless devices (e.g. smart phones, tablets, HD cameras)</p>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="col-8 col-sm-4">\n\t\t\t\t\t\t<mat-form-field>\n\t\t\t\t\t\t\t<input test-id="networkWirelessHighThroughputDevicesQty" matInput type="number" step="1" placeholder="Number of Devices"\n\t\t\t\t\t\t\t\t   name="networkWirelessHighThroughputDevices"\n\t\t\t\t\t\t\t\t   [(ngModel)]="info.networkWirelessHighThroughputDevices" min="0" value="0"\n\t\t\t\t\t\t\t\t   [ngClass]="{\'error\': designServicesLead?.networkWirelessHighThroughputDevices && (submitted || designServicesLead.networkWirelessHighThroughputDevices.touched)}"\n\t\t\t\t\t\t\t\t   required />\n\t\t\t\t\t\t</mat-form-field>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class="row half-margin-bottom">\n\t\t\t\t\t<div class="col-4">\n\t\t\t\t\t\t<p>Number of low-throughput wireless devices (e.g. lights, locks, Amazon Echos, SD cameras )</p>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="col-8 col-sm-4">\n\t\t\t\t\t\t<mat-form-field>\n\t\t\t\t\t\t\t<input test-id="networkWirelessLowThroughputDevicesQty" matInput type="number" step="1" placeholder="Number of Devices"\n\t\t\t\t\t\t\t\t   name="networkWirelessLowThroughputDevices"\n\t\t\t\t\t\t\t\t   [(ngModel)]="info.networkWirelessLowThroughputDevices" min="0" value="0"\n\t\t\t\t\t\t\t\t   [ngClass]="{\'error\': designServicesLead?.networkWirelessLowThroughputDevices && (submitted || designServicesLead.networkWirelessLowThroughputDevices.touched)}"\n\t\t\t\t\t\t\t\t   required />\n\t\t\t\t\t\t</mat-form-field>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class="row half-margin-bottom">\n\t\t\t\t\t<div class="col-4">\n\t\t\t\t\t\t<b>Total wireless devices: {{(info.networkWirelessLowThroughputDevices || 0) +\n\t\t\t\t\t\t\t(info.networkWirelessHighThroughputDevices || 0)}}</b>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<h3 class="margin-top half-margin-bottom">Number of <i>hardwired</i> smart devices on the network?</h3>\n\t\t\t\t<div class="row half-margin-bottom">\n\t\t\t\t\t<div class="col-4">\n\t\t\t\t\t\t<p>Number of high-throughput wired devices (e.g. HD cameras, smart TVs, gaming PCs)</p>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="col-8 col-sm-4">\n\t\t\t\t\t\t<mat-form-field>\n\t\t\t\t\t\t\t<input test-id="networkWiredHighThroughputDevicesQty" matInput type="number" step="1" name="networkWiredHighThroughputDevices"\n\t\t\t\t\t\t\t\t   placeholder="Number of Devices" [(ngModel)]="info.networkWiredHighThroughputDevices"\n\t\t\t\t\t\t\t\t   min="0" value="0"\n\t\t\t\t\t\t\t\t   [ngClass]="{\'error\': designServicesLead?.networkWiredHighThroughputDevices && (submitted || designServicesLead.networkWiredHighThroughputDevices.touched)}"\n\t\t\t\t\t\t\t\t   required />\n\t\t\t\t\t\t</mat-form-field>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class="row half-margin-bottom">\n\t\t\t\t\t<div class="col-4">\n\t\t\t\t\t\t<p>Number of low-throughput wired devices (e.g. SD cameras, C4 touchscreen, PC)</p>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="col-8 col-sm-4">\n\t\t\t\t\t\t<mat-form-field>\n\t\t\t\t\t\t\t<input test-id="networkWiredLowThroughputDevicesQty" matInput type="number" step="1" name="networkWiredLowThroughputDevices"\n\t\t\t\t\t\t\t\t   placeholder="Number of Devices" [(ngModel)]="info.networkWiredLowThroughputDevices"\n\t\t\t\t\t\t\t\t   min="0" value="0"\n\t\t\t\t\t\t\t\t   [ngClass]="{\'error\': designServicesLead?.networkWiredLowThroughputDevices && (submitted || designServicesLead.networkWiredLowThroughputDevices.touched)}"\n\t\t\t\t\t\t\t\t   required />\n\t\t\t\t\t\t</mat-form-field>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class="row half-margin-bottom">\n\t\t\t\t\t<div class="col-4">\n\t\t\t\t\t\t<b>Total Hardwired Devices: {{(info.networkWiredHighThroughputDevices || 0) +\n\t\t\t\t\t\t\t(info.networkWiredLowThroughputDevices || 0)}}</b>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<h3 class="margin-top half-margin-bottom">Ports and PoE</h3>\n\t\t\t\t<div class="row half-margin-bottom">\n\t\t\t\t\t<div class="col-4">\n\t\t\t\t\t\t<p>Out of {{(info.networkWiredHighThroughputDevices || 0) + (info.networkWiredLowThroughputDevices || 0)}}, how many are PoE and how\n\t\t\t\t\t\t\tmany are PoE+? <small>Combined number of PoE and PoE+ cannot exceed {{(info.networkWiredHighThroughputDevices || 0) +\n\t\t\t\t\t\t\t\t(info.networkWiredLowThroughputDevices || 0)}}, as specified above.</small></p>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="col-8 col-sm-4">\n\t\t\t\t\t\t<input test-id="numberOfPoE" type="number" placeholder="Number of PoE" step="1" min="0"\n\t\t\t\t\t\t\t   max="{{info.networkWiredHighThroughputDevices + info.networkWiredLowThroughputDevices - info.networkPoEPlus}}"\n\t\t\t\t\t\t\t   name="networkPoE" [(ngModel)]="info.networkPoE" value="0"\n\t\t\t\t\t\t\t   (ngModelChange)="calculateWattage()" />\n\t\t\t\t\t\t<input test-id="numberOfPoEPlus" type="number" step="1" min="0"\n\t\t\t\t\t\t\t   [max]="info.networkWiredHighThroughputDevices + info.networkWiredLowThroughputDevices - info.networkPoE"\n\t\t\t\t\t\t\t   name="networkPoEPlus" [(ngModel)]="info.networkPoEPlus" placeholder="Number of PoE+"\n\t\t\t\t\t\t\t   (ngModelChange)="calculateWattage()" value="0" />\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class="row half-margin-bottom">\n\t\t\t\t\t<div class="col-4">\n\t\t\t\t\t\t<b>Estimated Total PoE/PoE+ wattage requirement: {{networkPoeWattageEstimate}}W</b>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<h3 class="margin-top half-margin-bottom">Secondary Switches</h3>\n\t\t\t\t<div class="row half-margin-bottom">\n\t\t\t\t\t<div class="col-4 offset-4">\n\t\t\t\t\t\t<label>\n\t\t\t\t\t\t\t<input test-id="secondaryLocationNeedsASwitchCheckbox" type="checkbox" value="true" name="networkSecondarySwitch"\n\t\t\t\t\t\t\t\t   [(ngModel)]="info.networkSecondarySwitch" /> Are there any secondary locations in home needing a switch? </label>\n\t\t\t\t\t\t<label *ngIf="info.networkSecondarySwitch">\n\t\t\t\t\t\t\t<input test-id="switchesAreManagedCheckbox" type="checkbox" name="networkManagedSwitchs" checked value="true"\n\t\t\t\t\t\t\t\t   [(ngModel)]="info.networkSecondaryManagedSwitch" /> Are these switches managed? </label>\n\t\t\t\t\t\t<label *ngIf="info.networkSecondarySwitch"><input test-id="secondarySwitchesHavePoEDevicesCheckbox" type="checkbox"\n\t\t\t\t\t\t\t\t   name="networkSecondarySwitchPoE" value="true"\n\t\t\t\t\t\t\t\t   [(ngModel)]="info.networkSecondarySwitchPoE" />Do these switches have attached PoE/PoE+ devices? </label>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class="row half-margin-bottom" *ngIf="info.networkSecondarySwitch">\n\t\t\t\t\t<div class="col-sm-4">\n\t\t\t\t\t\t<p>How many secondary switches are needed? </p>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="col-sm-4">\n\t\t\t\t\t\t<select test-id="networkSecondarySwitchQty" name="networkSecondarySwitchQty" [(ngModel)]="info.networkSecondarySwitchQty">\n\t\t\t\t\t\t\t<option selected disabled [value]="undefined">Switch Qty</option>\n\t\t\t\t\t\t\t<option *ngFor="let quantity of quantities" [value]="quantity.value">{{quantity.label}} </option>\n\t\t\t\t\t\t</select>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class="row margin-top half-margin-bottom">\n\t\t\t\t\t<div class="col-4 offset-4">\n\t\t\t\t\t\t<label>\n\t\t\t\t\t\t\t<input test-id="advancedManagementFeaturesRequiredCheckbox" type="checkbox" value="true" name="networkingAdvancedManagement"\n\t\t\t\t\t\t\t\t   [(ngModel)]="info.networkAdvancedManagement" /> Do you require advanced management features (e.g. VLANs, STP, IGMP Snooping,\n\t\t\t\t\t\t\tetc) </label>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<h3 class="half-margin-bottom">Other Details</h3>\n\t\t\t\t<div class="row half-margin-bottom">\n\t\t\t\t\t<div class="col-4"> Any aesthetic requirement for access points? </div>\n\t\t\t\t\t<div class="col-4">\n\t\t\t\t\t\t<select test-id="selectedNetworkAesthetic" name="networkAesthetic" [(ngModel)]="info.networkAesthetic"\n\t\t\t\t\t\t\t\t[ngClass]="{\'error\': designServicesLead?.networkAesthetic && (submitted || designServicesLead.networkAesthetic.touched)}">\n\t\t\t\t\t\t\t<option selected disabled [value]="undefined">Select Type </option>\n\t\t\t\t\t\t\t<option selected value="flush mounted">Flush Mounted</option>\n\t\t\t\t\t\t\t<option value="surface mounted">Surface Mounted</option>\n\t\t\t\t\t\t</select>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class="row half-margin-bottom">\n\t\t\t\t\t<div class="col-4">\n\t\t\t\t\t\t<p class="no-margin">Are you able to provide a floor plan?<span class="text-primary">*</span></p>\n\t\t\t\t\t\t<p><small>Only 5 files can be submitted per upload.</small></p>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="col-8 col-sm-4">\n\t\t\t\t\t\t<p class="no-margin"><small>Select one</small></p>\n\t\t\t\t\t\t<label><input test-id="networkFloorplanIsAvailableRadio" name="networkFloorplanAvailable"\n\t\t\t\t\t\t\t\t   [(ngModel)]="info.networkFloorplanAvailable"\n\t\t\t\t\t\t\t\t   type="radio" [value]="true" required> Yes</label>\n\t\t\t\t\t\t<label><input test-id="networkFloorplanUnavailableRadio" name="networkFloorplanAvailable"\n\t\t\t\t\t\t\t\t   [(ngModel)]="info.networkFloorplanAvailable"\n\t\t\t\t\t\t\t\t   type="radio" [value]="false" required> No</label>\n\t\t\t\t\t\t<div class="half-margin-top" *ngIf="info.networkFloorplanAvailable">\n\t\t\t\t\t\t\t<small>Accepted file types: jpeg, jpg, png, pdf, zip.\xa0\xa0</small>\n\t\t\t\t\t\t\t<c4-file-upload folder="design-service-images" text="Upload Floorplan" maxFiles="5"\n\t\t\t\t\t\t\t\t\t\t\tfileFormats="jpeg,jpg,png,pdf,zip" (complete)="saveMedia($event)" [files]="fileQueue"\n\t\t\t\t\t\t\t\t\t\t\tclasses="grey"></c4-file-upload>\n\t\t\t\t\t\t\t<div class="half-margin-top half-margin-bottom" *ngFor="let file of fileQueue">\n\t\t\t\t\t\t\t\t<a [href]="file.secure_url" target="_blank">{{file.original_filename}}</a>\n\t\t\t\t\t\t\t\t<i class="fal fa-trash hover" alt="remove" (click)="deleteMedia(file)"></i>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<p class="no-margin"><small>Or, provide a downloadable floor plan URL</small></p>\n\t\t\t\t\t\t\t<mat-form-field *ngIf="fileQueue.length == 0">\n\t\t\t\t\t\t\t\t<input test-id="projectNetworkFloorplanUpload" matInput name="projectnetworkFloorplan" [(ngModel)]="info.networkFloorplan"\n\t\t\t\t\t\t\t\t\t   [ngClass]="{\'error\': designServicesLead?.projectNetworkFloorplan?.invalid && (submitted || designServicesLead.projectNetworkFloorplan.touched)}"\n\t\t\t\t\t\t\t\t\t   type="text" placeholder="Google Drive, Box, Dropbox, etc." maxlength="5000">\n\t\t\t\t\t\t\t</mat-form-field>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<p><small><a\n\t\t\t\t\t\t\t\t   href="https://res.cloudinary.com/control4/image/upload/v1506095790/static-pages/design-services/designservice-example-floor-plan.pdf"\n\t\t\t\t\t\t\t\t   target="_blank">See Example Floor Plan</a></small></p>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class="row half-margin-bottom">\n\t\t\t\t\t<div class="col-4">\n\t\t\t\t\t\t<p class="no-margin">Challenges, Special Comments, or Architects involved?</p>\n\t\t\t\t\t\t<p><small>Describe any obstacles or any other unusual features. Are any other third-party designers or architects involved, if so please\n\t\t\t\t\t\t\t\tspecify. If speakers are to be in-cabinet, in-wall or in-ceiling, note physical constraints. For example, all wall and ceiling\n\t\t\t\t\t\t\t\tmounting depths, width or length. Which direction do ceiling joists run?</small></p>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="col-8 col-xl-4">\n\t\t\t\t\t\t<label class="half-margin-bottom"><input test-id="hasChallengesCheckbox" type="checkbox" name="challengesCheck"\n\t\t\t\t\t\t\t\t   [(ngModel)]="challengesCheck">Challenges?</label>\n\t\t\t\t\t\t<textarea test-id="networkChallengesDescription" *ngIf="challengesCheck" maxlength="5000" name="challenges" class="half-margin-top"\n\t\t\t\t\t\t\t\t  [(ngModel)]="info.networkChallenges" placeholder="Describe challenges"\n\t\t\t\t\t\t\t\t  [ngClass]="{\'error\': designServicesLead?.challenges?.invalid && (submitted || designServicesLead.challenges.touched)}"></textarea>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class="alert alert-danger" *ngIf="designServicesLead?.invalid">Please complete all required fields. <br>If you\'re having issues with this\n\t\t\t\t\tform please <a\n\t\t\t\t\t   [href]="\'mailto:dbailey@control4.com?subject=Design%20Service%20Troubleshooting&cc=onlineordering@control4.com&body=\'+info.firstName+\'%2C%0D%0AIf%20you%27re%20having%20a%20technical%20issue%2C%20please%20describe%20the%20issue%2C%20operating%20system%2C%20and%20internet%20browser%20along%20with%20attached%20screenshots%20to%20help%20us%20assist%20you.%20We%20will%20get%20back%20with%20you%20as%20soon%20as%20possible.%0D%0A%0D%0AThank%20you%2C%0D%0AThe%20Control4%20Design%20Service%20Team\'">contact\n\t\t\t\t\t\tus.</a></div>\n\t\t\t\t<div class="alert alert-danger" *ngIf="showError">An error occurred during the lead submission process. </div>\n\t\t\t\t<button test-id="submitDesignServiceRequestClick" class="half-margin-top" [disabled]="designServicesLead?.invalid || !validPOE()"\n\t\t\t\t\t\t(click)="submit(designServicesLead)">Submit Design Service Request</button>\n\t\t\t</form>\n\t\t</div>\n\t</div>\n</div>'},"J/41":function(t,e){t.exports='<div class="padding">\n\t<div class="widget padding">\n\t\t<h1>Speaker Design Service For Whole Home Audio</h1>\n\t\t\x3c!-- <p>This free service provides Triad/Control4 Dealers with a detailed project-specific Speaker BOM. Once a BOM is agreed on, on request we can provide\n\t\t\tplans marked with speaker placement details. Please allow for at least one week after submission to receive detailed BOM.</p>\n\t\t<p>Whole Home Audio projects are quite technical. Quality, output levels and costs vary wildly. To keep the process efficient, we need a clear\n\t\t\tunderstanding of the project\u2019s scope and goals plus construction or design details that may limit certain speaker options or placement. The more\n\t\t\tinfo we have the better job Triad\u2019s Home audio design experts can do for you.</p> --\x3e\n\t\t<div id="thank-you" *ngIf="displayThankYou">\n\t\t\t<div class="alert alert-success">\n\t\t\t\t<h2>Thank you</h2>\n\t\t\t\t<p>Your request was submitted successfully. We will be contacting you shortly with more information.</p>\n\t\t\t</div>\n\t\t</div>\n\t\t<div class="alert alert-warning">\n\t\t\t<h4>This design service has been discontinued</h4>\n\t\t\t<p>The <a\n\t\t\t\t   routerLink="/design-services/home-theater-speaker-design-service">home theater design service</a> will remain available and we\u2019ll continue to\n\t\t\t\tprocess submissions. We\u2019re always evaluating the services and tools that we provide dealers to support their business. We have redirected\n\t\t\t\tresources to develop new services and we look forward to sharing them with you when\u2019re they\u2019re ready.</p>\n\t\t</div>\n\t\t<div class="form-wrapper fade" *ngIf="!displayThankYou && false">\n\t\t\t<form ngNativeValidate name="designServicesLead" #designServicesLead="ngForm"\n\t\t\t\t  (ngSubmit)="submit(designServicesLead)">\n\t\t\t\t<p>Submit answers to the following questions with as much detail as possible.</p>\n\t\t\t\t<div class="winnieThePooh"><input test-id="winnieThePooh" type="text" name="winnieThePooh" autocomplete="off"></div>\n\t\t\t\t<h4 class="half-margin-top half-margin-bottom">Contact Information</h4>\n\t\t\t\t<div>\n\t\t\t\t\t<div class="row half-margin-bottom">\n\t\t\t\t\t\t<div class="col-4">\n\t\t\t\t\t\t\t<p>Dealer ID<span class="text-primary">*</span></p>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class="col-8 col-sm-4">\n\t\t\t\t\t\t\t<mat-form-field>\n\t\t\t\t\t\t\t\t<input test-id="dealerID" matInput name="account" [(ngModel)]="info.dealerID" type="text"\n\t\t\t\t\t\t\t\t\t   placeholder="Dealer Account"\n\t\t\t\t\t\t\t\t\t   [ngClass]="{\'error\': designServicesLead?.account?.invalid && (submitted || designServicesLead.account.touched)}"\n\t\t\t\t\t\t\t\t\t   required>\n\t\t\t\t\t\t\t</mat-form-field>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="row half-margin-bottom">\n\t\t\t\t\t\t<div class="col-4">\n\t\t\t\t\t\t\t<p>First name<span class="text-primary">*</span></p>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class="col-8 col-sm-4">\n\t\t\t\t\t\t\t<mat-form-field class="fs-block">\n\t\t\t\t\t\t\t\t<input test-id="firstName" matInput name="firstName" [(ngModel)]="info.firstName" type="text"\n\t\t\t\t\t\t\t\t\t   [ngClass]="{\'error\': designServicesLead?.firstName?.invalid && (submitted || designServicesLead.firstName.touched)}"\n\t\t\t\t\t\t\t\t\t   placeholder="First Name" required maxlength="40">\n\t\t\t\t\t\t\t</mat-form-field>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="row half-margin-bottom">\n\t\t\t\t\t\t<div class="col-4">\n\t\t\t\t\t\t\t<p>Last name<span class="text-primary">*</span></p>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class="col-8 col-sm-4">\n\t\t\t\t\t\t\t<mat-form-field class="fs-block">\n\t\t\t\t\t\t\t\t<input test-id="lastName" matInput name="lastName" [(ngModel)]="info.lastName" type="text"\n\t\t\t\t\t\t\t\t\t   [ngClass]="{\'error\': designServicesLead?.lastName?.invalid && (submitted || designServicesLead.lastName.touched)}"\n\t\t\t\t\t\t\t\t\t   placeholder="Last Name" required maxlength="40">\n\t\t\t\t\t\t\t</mat-form-field>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="row half-margin-bottom">\n\t\t\t\t\t\t<div class="col-4">\n\t\t\t\t\t\t\t<p>Email<span class="text-primary">*</span></p>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class="col-8 col-sm-4">\n\t\t\t\t\t\t\t<mat-form-field class="fs-block">\n\t\t\t\t\t\t\t\t<input test-id="email" matInput name="email" [(ngModel)]="info.email" type="email" placeholder="Email"\n\t\t\t\t\t\t\t\t\t   [ngClass]="{\'error\': designServicesLead?.email?.invalid && (submitted || designServicesLead.email.touched)}"\n\t\t\t\t\t\t\t\t\t   required>\n\t\t\t\t\t\t\t</mat-form-field>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class="row half-margin-bottom">\n\t\t\t\t\t<div class="col-4">\n\t\t\t\t\t\t<p>Phone<span class="text-primary">*</span></p>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="col-8 col-sm-4">\n\t\t\t\t\t\t<mat-form-field class="fs-block">\n\t\t\t\t\t\t\t<input test-id="phone" matInput [(ngModel)]="info.phone" name="phone" type="tel"\n\t\t\t\t\t\t\t\t   [ngClass]="{\'error\': designServicesLead?.phone?.invalid && (submitted || designServicesLead.phone.touched)}"\n\t\t\t\t\t\t\t\t   required placeholder="Phone">\n\t\t\t\t\t\t</mat-form-field>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<h4 class="half-margin-top half-margin-bottom">Project Information</h4>\n\t\t\t\t<div class="row half-margin-bottom">\n\t\t\t\t\t<div class="col-4">\n\t\t\t\t\t\t<p>Project name<span class="text-primary">*</span></p>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="col-8 col-sm-4">\n\t\t\t\t\t\t<mat-form-field>\n\t\t\t\t\t\t\t<input test-id="projectName" matInput name="projectName" [(ngModel)]="info.projectName" type="text"\n\t\t\t\t\t\t\t\t   placeholder="Project Name"\n\t\t\t\t\t\t\t\t   [ngClass]="{\'error\': designServicesLead?.projectName?.invalid && (submitted || designServicesLead.projectName.touched)}"\n\t\t\t\t\t\t\t\t   required maxlength="255">\n\t\t\t\t\t\t</mat-form-field>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class="row half-margin-bottom">\n\t\t\t\t\t<div class="col-4">\n\t\t\t\t\t\t<p>Estimated completion date<span class="text-primary">*</span></p>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="col-8 col-sm-4">\n\t\t\t\t\t\t<mat-form-field>\n\t\t\t\t\t\t\t<input test-id="completionDate" matInput name="completionDate" required [(ngModel)]="completionDate" type="date"\n\t\t\t\t\t\t\t\t   placeholder="MM/DD/YYYY" [min]="getNow()">\n\t\t\t\t\t\t</mat-form-field>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class="row half-margin-bottom">\n\t\t\t\t\t<div class="col-4">\n\t\t\t\t\t\t<p>Construction type<span class="text-primary">*</span></p>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="col-8 col-sm-4"\n\t\t\t\t\t\t [ngClass]="{\'error\': designServicesLead?.construction?.invalid && (submitted || designServicesLead.construction.touched)}">\n\t\t\t\t\t\t<p class="no-margin"><small>Select one</small></p>\n\t\t\t\t\t\t<label><input test-id="isNewConstructionRadio" name="construction" [(ngModel)]="info.constructionType" type="radio" value="0"\n\t\t\t\t\t\t\t\t   required> New Construction</label>\n\t\t\t\t\t\t<label><input test-id="isMajorRemodelRadio" name="construction" [(ngModel)]="info.constructionType" type="radio" value="1"\n\t\t\t\t\t\t\t\t   required> Major Remodel</label>\n\t\t\t\t\t\t<label><input test-id="isRetrofitRadio" name="construction" [(ngModel)]="info.constructionType" type="radio" value="2"\n\t\t\t\t\t\t\t\t   required> Retrofit</label>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<h3 class="margin-top half-margin-bottom">Add Rooms of Project</h3>\n\t\t\t\t<div class="alert alert-warning">\n\t\t\t\t\t<p>Please do not include <b>home theater</b> selections. To build a home theater go to this page <i>after</i> you\'re finished here! <a\n\t\t\t\t\t\t   routerLink="/design-services/home-theater-speaker-design-service"\n\t\t\t\t\t\t   target="_blank">Home Theater Design</a></p>\n\t\t\t\t\t<p># Speaker Pair is a required field</p>\n\t\t\t\t</div>\n\t\t\t\t<div class="row margin-top half-margin-bottom" data-show-on-hover="#saveRoom"\n\t\t\t\t\t *ngFor="let zone of createdAVZones; let i = index;">\n\t\t\t\t\t<div class="col-sm-3">\n\t\t\t\t\t\t<mat-form-field>\n\t\t\t\t\t\t\t<input attr.test-id="roomName-{{i}}" matInput [(ngModel)]="zone.roomName" name="roomName{{i}}" type="text"\n\t\t\t\t\t\t\t\t   (ngModelChange)="calculateAudioTotals();" placeholder="Room Name"\n\t\t\t\t\t\t\t\t   [value]="zone.roomName" />\n\t\t\t\t\t\t</mat-form-field>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="col-sm-2">\n\t\t\t\t\t\t<select attr.test-id="selectedPair-{{i}}" [(ngModel)]="zone.selectedPair" name="selectedPair{{i}}"\n\t\t\t\t\t\t\t\t(ngModelChange)="calculateAudioTotals();">\n\t\t\t\t\t\t\t<option selected disabled [value]="undefined"># Speaker Pair</option>\n\t\t\t\t\t\t\t<option *ngFor="let speaker of speakerQtys" [value]="speaker.value">{{speaker.label}} </option>\n\t\t\t\t\t\t</select>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="col-sm-3">\n\t\t\t\t\t\t<label><input attr.test-id="hasTvCheckbox-{{i}}" [(ngModel)]="zone.hasTv" name="hasTv{{i}}" [checked]="zone.hasTv"\n\t\t\t\t\t\t\t\t   (ngModelChange)="calculateAudioTotals();" (click)="uncheckTVIntegrations(i);"\n\t\t\t\t\t\t\t\t   type="checkbox">Zone has T.V. integration</label>\n\t\t\t\t\t\t<label *ngIf="zone.hasTv"><input attr.test-id="hasSurroundSoundCheckbox-{{i}}" [(ngModel)]="zone.hasSurroundSound"\n\t\t\t\t\t\t\t\t   name="hasSurroundSound{{i}}" (ngModelChange)="calculateAudioTotals();"\n\t\t\t\t\t\t\t\t   [checked]="zone.hasSurroundSound" type="checkbox">Zone has surround sound</label>\n\t\t\t\t\t\t<label *ngIf="zone.hasTv"><input attr.test-id="hasOnScreenNavigatorCheckbox-{{i}}" [(ngModel)]="zone.hasOnscreenNavigator"\n\t\t\t\t\t\t\t\t   name="hasOnscreenNavigator{{i}}" (ngModelChange)="calculateAudioTotals();"\n\t\t\t\t\t\t\t\t   [checked]="zone.hasOnscreenNavigator" type="checkbox">Include on-screen navigator</label>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="col-sm-2">\n\t\t\t\t\t\t<label><input attr.test-id="zoneIsOutdoorCheckbox-{{i}}" [(ngModel)]="zone.outdoor" type="checkbox" name="outdoor{{i}}" value="true"\n\t\t\t\t\t\t\t\t   [checked]="zone.outdoor" (ngModelChange)="calculateAudioTotals();">Is the zone outdoors?</label>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="edit-item col-sm-2">\n\t\t\t\t\t\t<button attr.test-id="removeAudioRoom-{{i}}" type="button" (click)="removeAudioRoom(i);" class="block c4btn light-grey text-dark"><i\n\t\t\t\t\t\t\t   class="fa fa-minus"></i>Remove</button>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<hr>\n\t\t\t\t<div class="row half-margin-bottom">\n\t\t\t\t\t<div class="col-sm-3">\n\t\t\t\t\t\t<mat-form-field>\n\t\t\t\t\t\t\t<input test-id="newAudioZoneRoomName" matInput [(ngModel)]="newAudioZone.roomName" id="roomType" type="text"\n\t\t\t\t\t\t\t\t   name="roomName" placeholder="Room Name" value="newAudioZone.roomName" />\n\t\t\t\t\t\t</mat-form-field>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="col-sm-2">\n\t\t\t\t\t\t<div class="placeholder-wrapper" [ngClass]="{\'placeholder-visible\' : speakerPairQty}">\n\t\t\t\t\t\t\t<div class="placeholder-text" *ngIf="speakerPairQty">Speaker Pair Qty</div>\n\t\t\t\t\t\t\t<select test-id="speakerPairQty" id="speakerPairQty" name="speakePairQty" [(ngModel)]="speakerPairQty">\n\t\t\t\t\t\t\t\t<option selected disabled [value]="undefined"># Speaker Pair</option>\n\t\t\t\t\t\t\t\t<option *ngFor="let speaker of speakerQtys" [value]="speaker.value">{{speaker.label}} </option>\n\t\t\t\t\t\t\t</select>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<small>A speaker pair is comprised of two speakers for left and right stereo</small>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="col-sm-3">\n\t\t\t\t\t\t<label><input test-id="roomHasTvIntegrationCheckbox" id="tvandsound" type="checkbox" value="true" name="hasTv"\n\t\t\t\t\t\t\t\t   [(ngModel)]="newAudioZone.hasTv" (click)="uncheckTVIntegrations();">Room has T.V. integration</label>\n\t\t\t\t\t\t<label *ngIf="newAudioZone.hasTv"><input test-id="roomHasSurroundSoundCheckbox" type="checkbox"\n\t\t\t\t\t\t\t\t   [(ngModel)]="newAudioZone.hasSurroundSound" name="hasSurroundSound">Room has surround sound</label>\n\t\t\t\t\t\t<label *ngIf="newAudioZone.hasTv"><input test-id="roomHasOnScreenNavigatorCheckbox" [(ngModel)]="newAudioZone.hasOnscreenNavigator"\n\t\t\t\t\t\t\t\t   name="hasOnscreenNavigator" [checked]="newAudioZone.hasOnscreenNavigator"\n\t\t\t\t\t\t\t\t   type="checkbox">Include on-screen navigator</label>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="col-sm-2">\n\t\t\t\t\t\t<label><input test-id="newZoneIsOutdoorCheckbox" [(ngModel)]="newAudioZone.outdoor" type="checkbox" value="true"\n\t\t\t\t\t\t\t\t   name="isOutdoor" />Is the zone outdoors?</label>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<button test-id="addAudioRoom" type="button" (click)="addAudioRoom();" [disabled]="!speakerPairQty"\n\t\t\t\t\t\tclass="c4btn light-grey text-dark"><i class="fa fa-plus"></i> Add Room</button><br>\n\t\t\t\t<h3 class="margin-top">Project\'s Calculated Totals</h3>\n\t\t\t\t<div class="half-margin-bottom">\n\t\t\t\t\t<div class="table">\n\t\t\t\t\t\t<div class="body">\n\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t<div class="col-sm-2">\n\t\t\t\t\t\t\t\t\t<mat-form-field>\n\t\t\t\t\t\t\t\t\t\t<input test-id="totalZones" matInput [value]="AVZoneTotals.totalZones"\n\t\t\t\t\t\t\t\t\t\t\t   [ngModel]="AVZoneTotals.totalZones" readonly type="text" name="totalZones"\n\t\t\t\t\t\t\t\t\t\t\t   placeholder="# of Rooms" />\n\t\t\t\t\t\t\t\t\t</mat-form-field>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="col-sm-2">\n\t\t\t\t\t\t\t\t\t<mat-form-field>\n\t\t\t\t\t\t\t\t\t\t<input test-id="totalSpeakers" matInput [value]="AVZoneTotals.totalSpeakerPair"\n\t\t\t\t\t\t\t\t\t\t\t   [ngModel]="AVZoneTotals.totalSpeakerPair" readonly type="text"\n\t\t\t\t\t\t\t\t\t\t\t   name="totalSpeaker" placeholder="# of Speakers" />\n\t\t\t\t\t\t\t\t\t</mat-form-field>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="col-sm-2">\n\t\t\t\t\t\t\t\t\t<mat-form-field>\n\t\t\t\t\t\t\t\t\t\t<input test-id="totalWithTv" matInput [value]="AVZoneTotals.totalWithTv"\n\t\t\t\t\t\t\t\t\t\t\t   [ngModel]="AVZoneTotals.totalWithTv" readonly type="text" name="totalWithTv"\n\t\t\t\t\t\t\t\t\t\t\t   placeholder="# With Tv" />\n\t\t\t\t\t\t\t\t\t</mat-form-field>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="col-sm-2">\n\t\t\t\t\t\t\t\t\t<mat-form-field>\n\t\t\t\t\t\t\t\t\t\t<input test-id="totalSurroundSound" matInput [value]="AVZoneTotals.totalSurroundSound"\n\t\t\t\t\t\t\t\t\t\t\t   [ngModel]="AVZoneTotals.totalSurroundSound" readonly type="text"\n\t\t\t\t\t\t\t\t\t\t\t   name="totalSurroundSound" placeholder="# of Surround Sound" />\n\t\t\t\t\t\t\t\t\t</mat-form-field>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="col-sm-2">\n\t\t\t\t\t\t\t\t\t<mat-form-field>\n\t\t\t\t\t\t\t\t\t\t<input test-id="numberOfOutdoorZones" matInput [value]="AVZoneTotals.totalOutdoor"\n\t\t\t\t\t\t\t\t\t\t\t   [ngModel]="AVZoneTotals.totalOutdoor" readonly type="text" name="hasOutdoor"\n\t\t\t\t\t\t\t\t\t\t\t   placeholder="# of Outdoor Zones" />\n\t\t\t\t\t\t\t\t\t</mat-form-field>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="col-sm-2">\n\t\t\t\t\t\t\t\t\t<mat-form-field>\n\t\t\t\t\t\t\t\t\t\t<input test-id="totalOnscreenNav" matInput [value]="AVZoneTotals.totalOnscreenNav"\n\t\t\t\t\t\t\t\t\t\t\t   [ngModel]="AVZoneTotals.totalOnscreenNav" readonly type="text"\n\t\t\t\t\t\t\t\t\t\t\t   name="onscreenNav" placeholder="# of On-Screen Navigators" />\n\t\t\t\t\t\t\t\t\t</mat-form-field>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<hr>\n\t\t\t\t<div style="margin-top: 25px;" class="row half-margin-bottom">\n\t\t\t\t\t<div class="col-4">\n\t\t\t\t\t\t<p class="no-margin">Speaker layout<span class="text-primary">*</span></p>\n\t\t\t\t\t\t<p><small>Specify number of main speakers pairs, number of subwoofers, number of Atmos height speakers, etc.</small></p>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="col-8 col-xl-4">\n\t\t\t\t\t\t<textarea test-id="audioSpeakerLayout" name="layout" [(ngModel)]="info.audioSpeakerLayout" maxlength="5000"\n\t\t\t\t\t\t\t\t  placeholder="7.1.1 Surround, 5.4.2 Surround, Atmos, etc."\n\t\t\t\t\t\t\t\t  [ngClass]="{\'error\': designServicesLead?.layout?.invalid && (submitted || designServicesLead.layout.touched)}"\n\t\t\t\t\t\t\t\t  required></textarea>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class="row half-margin-bottom">\n\t\t\t\t\t<div class="col-4">\n\t\t\t\t\t\t<p>How will these TV\'s receive video input?<span class="text-primary">*</span></p>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="col-3 col-sm-4">\n\t\t\t\t\t\t<select test-id="selectedAudioTvInput" name="tvInput" [(ngModel)]="info.audioTvInput" required>\n\t\t\t\t\t\t\t<option value="local source">Local Source</option>\n\t\t\t\t\t\t\t<option value="central distribution">Central Distribution</option>\n\t\t\t\t\t\t\t<option [value]="undefined" disabled selected>TV Input</option>\n\t\t\t\t\t\t</select>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class="row half-margin-bottom">\n\t\t\t\t\t<div class="col-4">\n\t\t\t\t\t\t<p>Preferred maximum volume<span class="text-primary">*</span></p>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="col-8 col-sm-4">\n\t\t\t\t\t\t<select test-id="selectedMaxVolume" name="maxVol" [(ngModel)]="info.audioMaxVolume"\n\t\t\t\t\t\t\t\t[ngClass]="{\'error\': designServicesLead?.maxVol?.invalid && (submitted || designServicesLead.maxVol.touched)}"\n\t\t\t\t\t\t\t\trequired>\n\t\t\t\t\t\t\t<option [value]="undefined" disabled>Select One</option>\n\t\t\t\t\t\t\t<option value="1">1. Foreground</option>\n\t\t\t\t\t\t\t<option value="2">2. Shout To Be Heard</option>\n\t\t\t\t\t\t\t<option value="3">3. Cinematic Reference, Too Loud For Conversation</option>\n\t\t\t\t\t\t\t<option value="0">I don\'t know</option>\n\t\t\t\t\t\t</select>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class="row half-margin-bottom">\n\t\t\t\t\t<div class="col-4">\n\t\t\t\t\t\t<p>Speaker line<span class="text-primary">*</span></p>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="col-8 col-sm-4">\n\t\t\t\t\t\t<select test-id="selectedSpeakerLine" name="speakerLine" [(ngModel)]="info.audioSpeakerLine"\n\t\t\t\t\t\t\t\t[ngClass]="{\'error\': designServicesLead?.speakerLine?.invalid && (submitted || designServicesLead.speakerLine.touched)}"\n\t\t\t\t\t\t\t\trequired>\n\t\t\t\t\t\t\t<option [value]="undefined" disabled>Select One</option>\n\t\t\t\t\t\t\t<option value="1">Bronze (Good)</option>\n\t\t\t\t\t\t\t<option value="2">Silver or Gold (Better)</option>\n\t\t\t\t\t\t\t<option value="3">Platinum or Cinema Reference (Best)</option>\n\t\t\t\t\t\t\t<option value="0">I don\'t know</option>\n\t\t\t\t\t\t</select>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class="row half-margin-bottom">\n\t\t\t\t\t<div class="col-4">\n\t\t\t\t\t\t<p class="no-margin">Approximate customer budget<span class="text-primary">*</span></p>\n\t\t\t\t\t\t<p><small>*Numbers only</small></p>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="col-8 col-sm-4">\n\t\t\t\t\t\t<div class="row no-margin">\n\t\t\t\t\t\t\t<div class="col-3">\n\t\t\t\t\t\t\t\t<div class="light-grey text-center">\n\t\t\t\t\t\t\t\t\t<i class="fal fa-dollar-sign" style="line-height: 50px;"></i> <span\n\t\t\t\t\t\t\t\t\t\t  class="text-grey">USD</span>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class="col-9">\n\t\t\t\t\t\t\t\t<div class="placeholder-wrapper"\n\t\t\t\t\t\t\t\t\t [ngClass]="{\'placeholder-visible\' : info.audioCustomerBudget}">\n\t\t\t\t\t\t\t\t\t<div class="placeholder-text" *ngIf="info.audioCustomerBudget">Approximate customer Budget</div>\n\t\t\t\t\t\t\t\t\t<input test-id="budget" name="budget" [(ngModel)]="info.audioCustomerBudget" type="number"\n\t\t\t\t\t\t\t\t\t\t   placeholder="Approximate customer budget" min="0"\n\t\t\t\t\t\t\t\t\t\t   [ngClass]="{\'error\': designServicesLead?.budget?.invalid && (submitted || designServicesLead.budget.touched)}"\n\t\t\t\t\t\t\t\t\t\t   required>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class="row half-margin-bottom">\n\t\t\t\t\t<div class="col-4">\n\t\t\t\t\t\t<p>Speaker placement<span class="text-primary">*</span></p>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="col-8 col-sm-4">\n\t\t\t\t\t\t<p class="no-margin"><small>Select all that apply</small></p>\n\t\t\t\t\t\t<label *ngFor="let placement of placementChoices"><input test-id="speakerPlacementOptionCheckbox" type="checkbox"\n\t\t\t\t\t\t\t\t   [value]="placement"\n\t\t\t\t\t\t\t\t   [checked]="selectedPlacements.indexOf(placement) > -1"\n\t\t\t\t\t\t\t\t   (click)="togglePlacement(placement)"> {{placement}}</label>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class="row half-margin-bottom">\n\t\t\t\t\t<div class="col-4">\n\t\t\t\t\t\t<p>How many configurable keypads are needed?</p>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="col-4">\n\t\t\t\t\t\t<div class="placeholder-wrapper"\n\t\t\t\t\t\t\t [ngClass]="{\'placeholder-visible\' : info.audioConfigurableKeypad}">\n\t\t\t\t\t\t\t<div class="placeholder-text" *ngIf="info.audioConfigurableKeypad">Qty</div>\n\t\t\t\t\t\t\t<input test-id="keypadQty" type="number" name="keypads" min="0" step="1" value="0" placeholder="Qty"\n\t\t\t\t\t\t\t\t   [(ngModel)]="info.audioConfigurableKeypad" required />\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class="row half-margin-bottom">\n\t\t\t\t\t<div class="col-4">\n\t\t\t\t\t\t<p>How many 10" in-wall touchscreens?</p>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="col-8 col-sm-4">\n\t\t\t\t\t\t<div class="placeholder-wrapper" [ngClass]="{\'placeholder-visible\' : info.audioTenInchInWall}">\n\t\t\t\t\t\t\t<div class="placeholder-text" *ngIf="info.audioTenInchInWall">Qty</div>\n\t\t\t\t\t\t\t<input test-id="tenInchInWallTouchscreenQty" type="number" name="audioTenInchInWall" min="0" step="1" value="0"\n\t\t\t\t\t\t\t\t   [(ngModel)]="info.audioTenInchInWall" placeholder="Qty" required />\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class="row half-margin-bottom">\n\t\t\t\t\t<div class="col-4">\n\t\t\t\t\t\t<p> How many 7" in-wall touchscreens?</p>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="col-8 col-sm-4">\n\t\t\t\t\t\t<div class="placeholder-wrapper"\n\t\t\t\t\t\t\t [ngClass]="{\'placeholder-visible\' : info.audioSevenInchInWall}">\n\t\t\t\t\t\t\t<div class="placeholder-text" *ngIf="info.audioSevenInchInWall">Qty</div>\n\t\t\t\t\t\t\t<input test-id="sevenInchInWallTouchscreenQty" type="number" name="audioSevenInchInWall" min="0" step="1" value="0"\n\t\t\t\t\t\t\t\t   [(ngModel)]="info.audioSevenInchInWall" placeholder="Qty" required />\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class="row half-margin-bottom">\n\t\t\t\t\t<div class="col-4">\n\t\t\t\t\t\t<p> How many 10" portable touchscreens?</p>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="col-8 col-sm-4">\n\t\t\t\t\t\t<div class="placeholder-wrapper"\n\t\t\t\t\t\t\t [ngClass]="{\'placeholder-visible\' : info.audioTenInchPortable}">\n\t\t\t\t\t\t\t<div class="placeholder-text" *ngIf="info.audioTenInchPortable">Qty</div>\n\t\t\t\t\t\t\t<input test-id="tenInchPortableTouchscreenQty" type="number" name="audioTenInchPortable" min="0" value="0" step="1"\n\t\t\t\t\t\t\t\t   placeholder="Qty" [(ngModel)]="info.audioTenInchPortable" required />\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class="row half-margin-bottom">\n\t\t\t\t\t<div class="col-4">\n\t\t\t\t\t\t<p>How many 7" portable touchscreens?</p>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="col-8 col-sm-4">\n\t\t\t\t\t\t<div class="placeholder-wrapper"\n\t\t\t\t\t\t\t [ngClass]="{\'placeholder-visible\' : info.audioSevenInchPortable}">\n\t\t\t\t\t\t\t<div class="placeholder-text" *ngIf="info.audioSevenInchPortable">Qty</div>\n\t\t\t\t\t\t\t<input test-id="sevenInchPortableTouchscreenQty" type="number" name="audioSevenInchPortable" value="0" placeholder="Qty" min="0"\n\t\t\t\t\t\t\t\t   step="1" [(ngModel)]="info.audioSevenInchPortable" required />\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class="row half-margin-bottom" *ngIf="info.audioSevenInchPortable > 0">\n\t\t\t\t\t<div class="col-4">\n\t\t\t\t\t\t<p>Select touch screen color</p>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="col-8 col-sm-4">\n\t\t\t\t\t\t<select test-id="audioTouchscreenColor" name="audioTouchscreenColor" [(ngModel)]="info.audioTouchscreenColor">\n\t\t\t\t\t\t\t<option selected value="white">White</option>\n\t\t\t\t\t\t\t<option value="black">Black</option>\n\t\t\t\t\t\t\t<option [value]="undefined" disabled>Color</option>\n\t\t\t\t\t\t</select>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class="row half-margin-bottom">\n\t\t\t\t\t<div class="col-4">\n\t\t\t\t\t\t<p>How many numerical keypad door stations?</p>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="col-8 col-sm-4">\n\t\t\t\t\t\t<div class="placeholder-wrapper" [ngClass]="{\'placeholder-visible\' : info.audioDoorStations}">\n\t\t\t\t\t\t\t<div class="placeholder-text" *ngIf="info.audioDoorStations">Qty</div>\n\t\t\t\t\t\t\t<input test-id="keypadDoorStationQty" name="doorStations" type="number" value="0" min="0" placeholder="Qty" step="1"\n\t\t\t\t\t\t\t\t   [(ngModel)]="info.audioDoorStations" required />\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class="row half-margin-bottom" *ngIf="info.audioDoorStations > 0">\n\t\t\t\t\t<div class="col-4">\n\t\t\t\t\t\t<p>Door station keypad style:</p>\n