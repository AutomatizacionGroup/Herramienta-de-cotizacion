>{{facility.value}}</h4>\n\t\t<ng-container *ngIf="filteredSchedule.sessions | educationSession:facility.value as sessions">\n\t\t\t<div *ngFor="let session of sessions"> {{session.startDate | date}} - {{session.endDate | date}} <small>{{session.seatsAvailable}} open seat<span\n\t\t\t\t\t\t  *ngIf="session.seatsAvailable !== 1">s</span></small>\n\t\t\t</div>\n\t\t\t<ng-container *ngIf="!sessions.length">\n\t\t\t\t<p>No classes available</p>\n\t\t\t</ng-container>\n\t\t</ng-container>\n\t</div>\n</div>'},Jn9o:function(t,e){t.exports=".aspect:before {\n  background-color: rgba(0, 0, 0, 0.25);\n}\n\n.widget.widget-fixed-height {\n  height: 300px;\n  max-height: 300px;\n}\n\niframe, video {\n  height: 300px;\n  max-height: 300px;\n}"},NBun:function(t,e,n){"use strict";n.d(e,"a",(function(){return o}));var s=n("IheW"),i=n("8Y7J"),a=function(t,e,n,s){var i,a=arguments.length,r=a<3?e:null===s?s=Object.getOwnPropertyDescriptor(e,n):s;if("object"==typeof Reflect&&"function"==typeof Reflect.decorate)r=Reflect.decorate(t,e,n,s);else for(var o=t.length-1;o>=0;o--)(i=t[o])&&(r=(a<3?i(r):a>3?i(e,n,r):i(e,n))||r);return a>3&&r&&Object.defineProperty(e,n,r),r},r=function(t,e){if("object"==typeof Reflect&&"function"==typeof Reflect.metadata)return Reflect.metadata(t,e)};let o=class{constructor(t){this.http=t}getShowroomPosters(t){const e=(new s.d).append("group",t);return this.http.get("api/content/GetShowroomPosters",{params:e})}getVideos(){return this.http.get("api/content/GetVideos")}getVideosFilterByParentTag(t){return this.http.get("api/content/GetMarketingVideosParentTagFilter",{params:{tag:t}})}getVideosFilterBySubTag(t){return this.http.get("api/content/GetMarketingVideosSubTagFilter",{params:{tag:t}})}removeStaticPage(t){const e=(new s.d).append("id",t.toString());return this.http.delete("api/content/DeleteStaticPage",{params:e})}saveStaticPage(t){return this.http.post("api/content/SaveStaticPage",t)}searchStaticPages(t,e,n){let i=new s.d;return n&&(i=i.append("pageType",n.