 {\n  padding: 20px;\n}\n/* \u{1f501} Responsive layout for small screens */\n@media screen and (max-width: 768px) {\n  .form-header,\n.trainee-row {\n    -webkit-box-orient: vertical;\n    -webkit-box-direction: normal;\n            flex-direction: column;\n    -webkit-box-align: start;\n            align-items: flex-start;\n  }\n\n  .col-45,\n.col-18,\n.col-5 {\n    -webkit-box-flex: 1;\n            flex: 1 1 100%;\n    text-align: left;\n  }\n\n  .remove-btn {\n    width: auto;\n  }\n}'},lbX0:function(t,e){t.exports=".table {\n  padding: 0px !important;\n  margin: 0px;\n}\n.table.active {\n  border: 2px solid;\n  border-top: 0;\n}\n.table.authorized.active {\n  border-color: rgba(138, 36, 50, 0.8);\n}\n.table.authorized .header {\n  background-color: rgba(138, 36, 50, 0.8);\n}\n.table.gold.active {\n  border-color: rgba(151, 117, 33, 0.8);\n}\n.table.gold .header {\n  background-color: rgba(151, 117, 33, 0.8);\n}\n.table.platinum.active {\n  border-color: rgba(0, 0, 0, 0.8);\n}\n.table.platinum .header {\n  background-color: rgba(0, 0, 0, 0.8);\n}\n.table.diamond.active {\n  border-color: rgba(34, 113, 203, 0.8);\n}\n.table.diamond .header {\n  background-color: rgba(34, 113, 203, 0.8);\n}\n.table .header {\n  color: white;\n}\n@media (min-width: 767px) {\n  div.table .row div[class^=col-]:not(:first-child) {\n    text-align: center;\n  }\n}"},nM7G:function(t,e){t.exports='<div *ngIf="brandName$ | async as brandName">\n\t<h3 class="uppercase">2020 {{ brandName }} Premier Dealer Benefits</h3>\n\t<div *ngIf="showAccountStatus$ | async">\n\t\t<div class="table">\n\t\t\t<div class="row">\n\t\t\t\t<div class="col-sm-4 status-col">\n\t\t\t\t\t<div class="head">\n\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t<div class="col-sm-12">&nbsp;</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="body">\n\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t<div class="col-sm-12">Dealer rebate</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t<div class="col-sm-12">Triad speakers rebate</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t<div class="col-sm-12">Triad speakers discount</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t<div class="col-sm-12">Ground freight Included</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class="row" *ngIf="brandName === \'Control4\'">\n\t\t\t\t\t\t\t<div class="col-sm-12">Dealer locator</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t<div class="col-sm-12">Design &amp; proposal Services</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class="row" *ngIf="brandName !== \'Triad\'">\n\t\t\t\t\t\t\t<div class="col-sm-12">Premier dealer support</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class="row" *ngIf="brandName !== \'Triad\'">\n\t\t\t\t\t\t\t<div class="col-sm-12">No-Hassle online product replacement policy</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div *ngFor="let benefit of benefits$ | async"\n\t\t\t\t\t [ngClass]="[\'col-sm-2 no-padding status-col\', benefit.tierName.toLowerCase()]"\n\t\t\t\t\t [class.active]="benefit.tierName.toLowerCase() == (currentStatus$ | async)">\n\t\t\t\t\t<div class="head">\n\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t<div class="col-sm-12 header">{{benefit.tierName}}</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="body">\n\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t<div class="col-sm-12" *ngIf="benefit.maximumDealerRebate > 0">Up to {{benefit.maximumDealerRebate | percent}}</div>\n\t\t\t\t\t\t\t<div class="col-sm-12" *ngIf="benefit.maximumDealerRebate == 0">&mdash;</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t<div class="col-sm-12" *ngIf="benefit.maximumTriadDealerRebate > 0">Up to {{benefit.maximumTriadDealerRebate | percent}}</div>\n\t\t\t\t\t\t\t<div class="col-sm-12" *ngIf="benefit.maximumTriadDealerRebate == 0">&mdash;</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t<div class="col-sm-12" *ngIf="benefit.maximumTriadDealerRebate > 0">Up to {{benefit.maximumTriadDealerRebate | percent}}</div>\n\t\t\t\t\t\t\t<div class="col-sm-12" *ngIf="benefit.maximumTriadDealerRebate == 0">&mdash;</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t<div class="col-sm-12"\n\t\t\t\t\t\t\t\t *ngIf="benefit.freeShippingMinimum != null && benefit.freeShippingMinimum > 0"> Orders over\n\t\t\t\t\t\t\t\t{{benefit.freeShippingMinimum | shortCurrency: (currencySymbol$ | async) : 2}} </div>\n\t\t\t\t\t\t\t<div class="col-sm-12"\n\t\t\t\t\t\t\t\t *ngIf="benefit.freeShippingMinimum != null && benefit.freeShippingMinimum == 0"> Included </div>\n\t\t\t\t\t\t\t<div class="col-sm-12" *ngIf="benefit.freeShippingMinimum == null">&mdash;</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class="row" *ngIf="brandName === \'Control4\'">\n\t\t\t\t\t\t\t<div class="col-sm-12" *ngIf="benefit.inDealerLocator"><i\n\t\t\t\t\t\t\t\t   class="fas fa-check text-success"></i></div>\n\t\t\t\t\t\t\t<div class="col-sm-12" *ngIf="!benefit.inDealerLocator">&mdash;</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t<div class="col-sm-12">{{benefit.designProposalServices}}</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class="row" *ngIf="brandName !== \'Triad\'">\n\t\t\t\t\t\t\t<div class="col-sm-12" *ngIf="benefit.isPremierTechSupport"><i\n\t\t\t\t\t\t\t\t   class="fas fa-check text-success"></i>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class="col-sm-12" *ngIf="!benefit.isPremierTechSupport">Standard</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class="row" *ngIf="brandName !== \'Triad\'">\n\t\t\t\t\t\t\t<div class="col-sm-12" *ngIf="benefit.canSubmitOnlineRma"><i\n\t\t\t\t\t\t\t\t   class="fas fa-check text-success"></i></div>\n\t\t\t\t\t\t\t<div class="col-sm-12" *ngIf="!benefit.canSubmitOnlineRma">&mdash;</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t</div>\n\t</div>\n\t<div *ngIf="!(showAccountStatus$ | async)">Dealer status benefits will be available soon. </div>\n</div>'},oeHC:function(t,e){t.exports=""},"t+ig":function(t,e){t.exports='<div id="register" class="widget padding" *ngIf="canPurchase">\n\t<div class="alert alert-warning">\n\t\t<ul class="no-style">\n\t\t\t<h4>These trainees have already been added to another cart</h4>\n\t\t\t<li *ngFor="let trainee of pendingTrainees">{{trainee.fullName}}</li>\n\t\t</ul>\n\t</div>\n\t<c4-loading *ngIf="!orderId"></c4-loading>\n\t<div class="row">\n\t\t<div class="col-lg-8">\n\t\t\t<div class="loader-overlay" *ngIf="isLoading">\n\t\t\t\t<mat-spinner color="primary" diameter="30" aria-label="Loading"></mat-spinner>\n\t\t\t</div>\n\t\t\t<div class="form-wrapper form dark light-grey padding">\n\t\t\t\t<c4-loading *ngIf="!product"></c4-loading>\n\t\t\t\t<ng-container *ngIf="confirmLoaded">\n\t\t\t\t\t<a href="javascript:;" class="c4close" test-id="resetDisplayTotalsClick" (click)="resetDisplayTotals()"></a>\n\t\t\t\t</ng-container>\n\t\t\t\t<div [hidden]="state !== \'trainees\'" *ngIf="product">\n\t\t\t\t\t<h2 class="bold">{{title}}</h2>\n\t\t\t\t\t<form>\n\t\t\t\t\t\t<div class="row no-margin margin-bottom" *ngIf="availableTrainees?.length">\n\t\t\t\t\t\t\t<div [class]="(useNewC4CTChanges$ | async) ? \'col-sm-6\' : \'col-sm-9\'">\n\t\t\t\t\t\t\t\t<select test-id="selectedTrainees" id="trainee-select" name="trainee" [(ngModel)]="selectedTrainee">\n\t\t\t\t\t\t\t\t\t<option [value]="undefined">Select Trainee(s)</option>\n\t\t\t\t\t\t\t\t\t<option *ngFor="let available of availableTrainees" [ngValue]="available">{{available.fullName + \' (\' + (available.email |\n\t\t\t\t\t\t\t\t\t\tlowercase) + \')\'}}</option>\n\t\t\t\t\t\t\t\t</select>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class="col-sm-3">\n\t\t\t\t\t\t\t\t<button test-id="addNewTraineeClick" class="block no-margin" (click)="addNewTrainee()"\n\t\t\t\t\t\t\t\t\t\t[disabled]="!selectedTrainee">Register User</button>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\x3c!-- <div *ngIf="selectedTrainees?.length" class="half-margin-top">\n\t\t\t\t\t\t\t<h4>Trainee(s)</h4>\n\t\t\t\t\t\t\t<ul class="no-style half-margin-top half-margin-bottom half-padding-left">\n\t\t\t\t\t\t\t\t<li *ngFor="let selected of selectedTrainees"><i\n\t\t\t\t\t\t\t\t\t   *ngIf="((useNewC4CTChanges$ | async))"\n\t\t\t\t\t\t\t\t\t   class="fas fa-exclamation-circle text-danger"></i>{{selected.fullName}} <small>({{selected.email}})</small>\n\t\t\t\t\t\t\t\t\t<small>({{ selected.userId === currentuser ? c4ctkitdisplay : (selected.currentStatus === 60 ? \'Recertification\' :\n\t\t\t\t\t\t\t\t\t\t\'Certification\') }})</small>&nbsp; &nbsp; <small><a\n\t\t\t\t\t\t\t\t\t\t   href="javascript:;"\n\t\t\t\t\t\t\t\t\t\t   (click)="removeTrainee(selected)">Remove</a></small>\n\t\t\t\t\t\t\t\t</li>\n\t\t\t\t\t\t\t</ul>\n\t\t\t\t\t\t</div> --\x3e\n\t\t\t\t\t\t<p></p>\n\t\t\t\t\t\t<div class="training-form" *ngIf="selectedTrainees?.length">\n\t\t\t\t\t\t\t<div class="form-header">\n\t\t\t\t\t\t\t\t<div class="col-45">Trainee(s)</div>\n\t\t\t\t\t\t\t\t<div class="col-5">C4CT</div>\n\t\t\t\t\t\t\t\t<div class="col-18">C4CT Shared\n\t\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="col-5">Remove</div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class="form-header" *ngIf="priceObject.isPriceLoading">\n\t\t\t\t\t\t\t\t<div class="col-45"></div>\n\t\t\t\t\t\t\t\t<div class="col-5"><span class="amount"><small>&nbsp;</small> <br> {{ priceObject.Kit | currency:(currency$ | async)}}</span></div>\n\t\t\t\t\t\t\t\t<div class="col-18"><span class="amount"><small>(Equipment not included)</small> <br> {{ priceObject.Share | currency:(currency$ | async)}}</span></div>\n\t\t\t\t\t\t\t\t<div class="col-5"></div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div\n\t\t\t\t\t\t\t\t class="trainee-row"\n\t\t\t\t\t\t\t\t style="font-weight: normal;"\n\t\t\t\t\t\t\t\t *ngFor="let trainee of selectedTrainees; let i = index">\n\t\t\t\t\t\t\t\t<div class="col-45 trainee-info"> {{ trainee.fullName }} - {{ trainee.email }} </div>\n\t\t\t\t\t\t\t\t<div class="col-5">\n\t\t\t\t\t\t\t\t\t<input title="C4CT"\n\t\t\t\t\t\t\t\t\t\t   [id]="\'c4ct \' + trainee.userId"\n\t\t\t\t\t\t\t\t\t\t   type="radio"\n\t\t\t\t\t\t\t\t\t\t   [name]="\'c4ct\' + i"\n\t\t\t\t\t\t\t\t\t\t   [value]="\'c4ct \' + trainee.userId"\n\t\t\t\t\t\t\t\t\t\t   [(ngModel)]="trainee.selectedCertType"\n\t\t\t\t\t\t\t\t\t\t   (change)="onCertChange(trainee, certificateType.Kit)" />\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="col-18">\n\t\t\t\t\t\t\t\t\t<input\n\t\t\t\t\t\t\t\t\t\t   title="Share Equipment"\n\t\t\t\t\t\t\t\t\t\t   [id]="\'share \' + trainee.userId"\n\t\t\t\t\t\t\t\t\t\t   type="radio"\n\t\t\t\t\t\t\t\t\t\t   [name]="\'c4ct\' + i"\n\t\t\t\t\t\t\t\t\t\t   [value]="\'share \' + trainee.userId"\n\t\t\t\t\t\t\t\t\t\t   [(ngModel)]="trainee.selectedCertType"\n\t\t\t\t\t\t\t\t\t\t   (change)="onCertChange(trainee, certificateType.Register)" />\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="col-5">\n\t\t\t\t\t\t\t\t\t<div class="remove-btn">\n\t\t\t\t\t\t\t\t\t\t<button type="button" title="Remove" (click)="removeTrainee(trainee)" class="btn-remove"> x </button>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<p></p>\n\t\t\t\t\t\t<p></p>\n\t\t\t\t\t\t\x3c!-- <div class="row">\n\t\t\t\t\t\t\t<p><small><strong> How many kit equipments do you need?</strong><br> \u201cYou can purchase one kit for each technician taking the C4CT\n\t\t\t\t\t\t\t\t\tcertification or multiple technicians can share and reuse the same kit. Please note that multiple technicians cannot use one\n\t\t\t\t\t\t\t\t\tkit at the same time, but they can take the course in succession. In addition, Recertification does not require a C4CT Kit.\u201d\n\t\t\t\t\t\t\t\t</small></p>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t<p><small><strong>Kit Quantity</strong></small></p>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t<p>\n\t\t\t\t\t\t\t\t<input type="number" name="namequantity" (change)="onQuantityChange($event)" [(ngModel)]="c4ctkitsku"\n\t\t\t\t\t\t\t\t\t   class="col-sm-12" placeholder="insert quantity" min="0" minlength="1" />\n\t\t\t\t\t\t\t\t<span *ngIf="c4ctAddToCartErrorMessage"><small style="color: red;"> {{ c4ctAddToCartErrorMessage }} </small></span>\n\t\t\t\t\t\t\t\t<span *ngIf="quantityValidationMessage"><small style="color: red;"> {{ quantityValidationMessage }} </small></span>\n\t\t\t\t\t\t\t</p>\n\t\t\t\t\t\t</div> --\x3e\n\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t<p><b>C4CT vs. C4CT Shared</b></p>\n\t\t\t\t\t\t\t<p>C4CT includes a full equipment kit and access to the courses and exam for a single technician. C4CT Shared provides access to the courses and exam for an\n\t\t\t\t\t\t\t\tadditional technician. In order to purchase C4CT Shared, a previous purchase of at least one full equipment kit is required. </p>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<p></p>\n\t\t\t\t\t\t<p></p>\n\t\t\t\t\t\t<p><small>Technicians must be registered with their legal name.\u2014 The C4CT exam is conducted by a 3rd party proctoring service and\n\t\t\t\t\t\t\t\tgovernment issued ID will be used to verify the trainee\'s identity before testing. You can update your technicians name in the\n\t\t\t\t\t\t\t\tUser Management section of the Dealer Portal. Trainees must be registered within portal user management prior to registration.\n\t\t\t\t\t\t\t\tIf the user you wish to enroll does not appear in this list, please first Create New User in User Management. Once complete,\n\t\t\t\t\t\t\t\treturn to this page and refresh this list.</small></p>\n\t\t\t\t\t\t<p></p>\n\t\t\t\t\t\t<p>\n\t\t\t\t\t\t</p>\n\t\t\t\t\t\t<c4-shipping-form [orderId]="totals.orderId" *ngIf="selectedTrainees?.length">\n\t\t\t\t\t\t</c4-shipping-form>\n\t\t\t\t\t\t<div class="alert alert-warning" *ngIf="((useNewC4CTChanges$ | async) && selectedTraineeHasOldC4CT)">\n\t\t\t\t\t\t\t<p>Trainees marked with a <i class="fas fa-exclamation-circle text-danger"></i> must be removed and re-registered. The Pakedge\n\t\t\t\t\t\t\t\tversion of C4CT is no longer available.</p>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div *ngIf="quantityValidationMessage" style="color:red;">{{quantityValidationMessage}}</div>\n\t\t\t\t\t\t<button test-id="continueToPaymentClick" (click)="proceedToBilling()"\n\t\t\t\t\t\t\t\t[disabled]="(c4ctAddToCartErrorMessage !== \'\' || quantityValidationMessage !== \'\') || (selectedTrainees?.length == 0)"\n\t\t\t\t\t\t\t\tclass="half-margin-top">Continue to Payment <i class="fal fa-arrow-right"></i></button>\n\t\t\t\t\t</form>\n\t\t\t\t</div>\n\t\t\t\t<div *ngIf="state === \'billing\'">\n\t\t\t\t\t<div class="half-margin-bottom">\n\t\t\t\t\t\t<h4>Registration</h4>\n\t\t\t\t\t\t<div class="row half-margin-bottom">\n\t\t\t\t\t\t\t<div class="col-sm-4">\n\t\t\t\t\t\t\t\t<small>\n\t\t\t\t\t\t\t\t\t<strong>Trainee(s)</strong>\n\t\t\t\t\t\t\t\t\t<ul *ngFor="let row of summarySelectedTrainees" class="no-style">\n\t\t\t\t\t\t\t\t\t\t<li *ngFor="let selected of row"> {{selected}} </li>\n\t\t\t\t\t\t\t\t\t</ul>\n\t\t\t\t\t\t\t\t</small>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class="col-sm-4">\n\t\t\t\t\t\t\t\t<small>\n\t\t\t\t\t\t\t\t\t<strong>Shipping</strong>\n\t\t\t\t\t\t\t\t\t<ul class="no-style">\n\t\t\t\t\t\t\t\t\t\t<li *ngIf="selectedShippingAddress$ | async as address"> {{address.displayValue}}</li>\n\t\t\t\t\t\t\t\t\t\t<li>{{totals.shipping?.selectedShippingMethod?.name}}</li>\n\t\t\t\t\t\t\t\t\t</ul>\n\t\t\t\t\t\t\t\t</small>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<small><a href="javascript:;" test-id="backToTraineesAndShippingClick" (click)="state = \'trainees\'"><i\n\t\t\t\t\t\t\t\t   class="fa fa-long-arrow-left"></i> Back To Trainees and Shipping</a></small>\n\t\t\t\t\t</div>\n\t\t\t\t\t<c4-billing-form [orderId]="totals.orderId"></c4-billing-form>\n\t\t\t\t\t<p class="no-margin" [hidden]="!canProceed"><small>By placing this order, you agree to the <a\n\t\t\t\t\t\t\t   href="javascript:;" (click)="showTermsOfUse()">terms of use</a>.</small></p>\n\t\t\t\t\t<div class="half-padding-top">\n\t\t\t\t\t\t<button test-id="completePcnaRegistration" (click)="placeOrder()" [disabled]="!canProceed"><i\n\t\t\t\t\t\t\t   class="fa fa-check"></i>Complete C4CT Registration</button>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div *ngIf="state === \'confirm\'">\n\t\t\t\t\t<c4-loading *ngIf="!confirmLoaded"></c4-loading>\n\t\t\t\t\t<div *ngIf="confirmLoaded">\n\t\t\t\t\t\t<h2>Registration Confirmed</h2>\n\t\t\t\t\t\t<p>You have successfully registered for the C4CT Certification training. A confirmation email where you\n\t\t\t\t\t\t\tfind information on beginning the training has been sent to you and the following trainee(s):</p>\n\t\t\t\t\t\t<div class="row half-margin-bottom half-padding-left">\n\t\t\t\t\t\t\t<div class="col-sm-5">\n\t\t\t\t\t\t\t\t<small>\n\t\t\t\t\t\t\t\t\t<ul class="no-style">\n\t\t\t\t\t\t\t\t\t\t<li *ngFor="let registered of confirm.registeredTrainees"> {{registered.fullName}}</li>\n\t\t\t\t\t\t\t\t\t</ul>\n\t\t\t\t\t\t\t\t\t<strong *ngIf="confirm.failedTrainees.length">Unfortunately these trainee(s) failed to register:</strong>\n\t\t\t\t\t\t\t\t\t<ul class="no-style" *ngIf="confirm.failedTrainees.length">\n\t\t\t\t\t\t\t\t\t\t<li *ngFor="let failed of confirm.failedTrainees">{{failed.fullName}}</li>\n\t\t\t\t\t\t\t\t\t</ul>\n\t\t\t\t\t\t\t\t</small>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class="col-sm-5">\n\t\t\t\t\t\t\t\t<small>\n\t\t\t\t\t\t\t\t\t<strong>Shipping</strong>\n\t\t\t\t\t\t\t\t\t<ul class="no-style half-margin-bottom">\n\t\t\t\t\t\t\t\t\t\t<li>{{confirm.shippingAddress}}</li>\n\t\t\t\t\t\t\t\t\t\t<li>{{confirm.shippingMethod}}</li>\n\t\t\t\t\t\t\t\t\t\t<li *ngIf="confirm.finalDestinationAddress"><strong>Final Destination</strong></li>\n\t\t\t\t\t\t\t\t\t\t<li *ngIf="confirm.finalDestinationAddress"\n\t\t\t\t\t\t\t\t\t\t\t[innerHTML]="confirm.finalDestinationAddress | safeHtml"></li>\n\t\t\t\t\t\t\t\t\t\t<li *ngIf="confirm.order.poReference"><strong>PO Reference Number</strong>\n\t\t\t\t\t\t\t\t\t\t</li>\n\t\t\t\t\t\t\t\t\t\t<li *ngIf="confirm.order.poReference">\n\t\t\t\t\t\t\t\t\t\t\t<strong>{{confirm.order.poReference}}</strong>\n\t\t\t\t\t\t\t\t\t\t</li>\n\t\t\t\t\t\t\t\t\t</ul>\n\t\t\t\t\t\t\t\t\t<strong>Billing</strong>\n\t\t\t\t\t\t\t\t\t<ul class="no-style half-margin-bottom">\n\t\t\t\t\t\t\t\t\t\t<li [innerHTML]="confirm.billingAddress | safeHtml"></li>\n\t\t\t\t\t\t\t\t\t\t<li *ngIf="confirm.payment.creditCardNumber">{{confirm.payment.cardType}} {{confirm.payment.creditCardNumber}}</li>\n\t\t\t\t\t\t\t\t\t\t<li *ngIf="confirm.payment.creditCardNumber">{{confirm.payment.nameOnCard}} </li>\n\t\t\t\t\t\t\t\t\t\t<li *ngIf="!confirm.payment.creditCardNumber"> {{confirm.payment | paymentMethod}}</li>\n\t\t\t\t\t\t\t\t\t</ul>\n\t\t\t\t\t\t\t\t\t<div *ngIf="confirm.benefits && confirm.benefits.length">\n\t\t\t\t\t\t\t\t\t\t<strong>Promotions</strong>\n\t\t\t\t\t\t\t\t\t\t<ul class="no-style half-margin-bottom">\n\t\t\t\t\t\t\t\t\t\t\t<li *ngFor="let benefit of confirm.benefits">{{benefit}}</li>\n\t\t\t\t\t\t\t\t\t\t</ul>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t</small>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div> Please instruct these trainees to check their inbox for this email, including junk folders.\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t</div>\n\t\t<div class="col-sm-4">\n\t\t\t<div class="table">\n\t\t\t\t<c4-loading *ngIf="!displayTotals"></c4-loading>\n\t\t\t\t<div class="body" *ngIf="displayTotals">\n\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t<div class="col-6 bold">Subtotal</div>\n\t\t\t\t\t\t<div class="col-6 text-right">{{displayTotals.subtotal | currency:(currency$ | async)}} </div>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t<div class="col-6 bold">Taxes</div>\n\t\t\t\t\t\t<div class="col-6 text-right">{{displayTotals.taxTotal | currency:(currency$ | async)}}</div>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t<div class="col-6 bold">Shipping</div>\n\t\t\t\t\t\t<div class="col-6 text-right">{{displayTotals.shippingTotal | currency:(currency$ | async)}}</div>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t<div class="col-6 bold">Total</div>\n\t\t\t\t\t\t<div class="col-6 text-right"><b>{{displayTotals.grandTotal | currency:(currency$ | async)}}</b></div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t</div>\n\t</div>\n\t<div *ngIf="(certifiedTrainees?.length > 0 || registeredTrainees?.length > 0) && canPurchase">\n\t\t<h3 class="half-margin-top">Trainees</h3>\n\t\t<div class="row">\n\t\t\t<div class="col-sm-4">\n\t\t\t\t<ul class="no-style">\n\t\t\t\t\t<h4>C4CT<sup class="text-grey">&trade;</sup> Certified</h4>\n\t\t\t\t\t<li *ngFor="let trainee of certifiedTrainees"><i class="fal fa-check-circle text-success"></i> {{trainee.fullName}}</li>\n\t\t\t\t</ul>\n\t\t\t</div>\n\t\t\t<div class="col-sm-8" *ngIf="registeredTrainees && registeredTrainees.length">\n\t\t\t\t<ul class="no-style">\n\t\t\t\t\t<h4>Training in Progress</h4>\n\t\t\t\t\t<li *ngFor="let trainee of registeredTrainees"><i\n\t\t\t\t\t\t   class="fal fa-arrow-circle-right text-warning"></i> {{trainee.fullName}} </li>\n\t\t\t\t</ul>\n\t\t\t</div>\n\t\t</div>\n\t</div>\n</div>'},uXbc:function(t,e){t.exports=""},vkXM:function(t,e){t.exports='<div class="half-margin-top" style="max-width: 1200px;">\n\t<div *ngIf="sent" class="alert alert-success">\n\t\t<h3>Thank You</h3>\n\t\t<p>One Firefly will be contacting you shortly with more information about the UI University membership.</p>\n\t</div>\n\t<div class="form-wrapper" *ngIf="!sent">\n\t\t<form name="onefly" #onefly="ngForm" (ngSubmit)="submit()">\n\t\t\t<h3>Interested?</h3>\n\t\t\t<p>Help new and existing customers learn all the capabilities, features, and benefits of OS 3 with a One Firefly tutorial membership. This\n\t\t\t\tmembership gives you access to dozens of beautiful OS 3 how-to videos that you can host on your website and share with your customers. Click the\n\t\t\t\tlink to learn more.</p>\n\t\t\t<div class="row no-margin">\n\t\t\t\t<div class="col-sm-5">\n\t\t\t\t\t<input test-id="email" name="email" [(ngModel)]="email" placeholder="Email*" required="" type="email" email>\n\t\t\t\t</div>\n\t\t\t\t<div class="col-sm-5">\n\t\t\t\t\t<input test-id="phoneNumber" name="phoneNumber" [(ngModel)]="phone" placeholder="Phone" type="tel" phone>\n\t\t\t\t</div>\n\t\t\t\t<div class="col-sm-2">\n\t\t\t\t\t<button test-id="sendMoreInfoClick" type="submit" c4Track="Click" trackCategory="Form Submit" trackLabel="Dealer OneFireFly Leads"\n\t\t\t\t\t\t\t[disabled]="submitted || !onefly.valid">\n\t\t\t\t\t\t<i class="fal fa-check"></i>Send Me More Info </button>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t\t<div class="alert alert-warning" *ngIf="onefly.hasError(\'email\', \'email\')"> Must provide a valid email. </div>\n\t\t</form>\n\t</div>\n</div>'},vpJD:function(t,e){t.exports='<a routerLink="/education/pcna" fragment="register" class="c4btn" *ngIf="canPurchase">Register Your Techs</a>'},vyGo:function(t,e){t.exports=".status-col {\n  padding: 0px !important;\n}\n.status-col.active {\n  border: 2px solid;\n  border-top: 0;\n}\n.status-col.authorized.active {\n  border-color: rgba(138, 36, 50, 0.8);\n}\n.status-col.authorized .header {\n  background-color: rgba(138, 36, 50, 0.8);\n}\n.status-col.gold.active {\n  border-color: rgba(151, 117, 33, 0.8);\n}\n.status-col.gold .header {\n  background-color: rgba(151, 117, 33, 0.8);\n}\n.status-col.platinum.active {\n  border-color: rgba(0, 0, 0, 0.8);\n}\n.status-col.platinum .header {\n  background-color: rgba(0, 0, 0, 0.8);\n}\n.status-col.diamond.active {\n  border-color: rgba(34, 113, 203, 0.8);\n}\n.status-col.diamond .header {\n  background-color: rgba(34, 113, 203, 0.8);\n}\n.status-col .header {\n  color: white;\n}\n@media (min-width: 767px) {\n  div.table .row div[class^=col-]:not(:first-child) {\n    text-align: center;\n  }\n}"},yiOx:function(t,e){t.exports='<a routerLink="/education/c4ct" fragment="register" class="c4btn" *ngIf="canPurchase">Register Your Techs</a>'}}]);