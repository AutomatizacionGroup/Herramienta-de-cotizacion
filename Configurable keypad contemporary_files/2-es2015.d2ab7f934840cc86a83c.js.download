n: 0 0 5px 0;\n}"},"54DO":function(t,e){t.exports='<div>\n\t<p *ngIf="(brandName$ | async ) == \'Control4\'">\n\t\tPremier Control4 Dealers can easily earn a quarterly rebate on their Control4, Pakedge, and\n\t\tTriad audio purchases. No rebate is paid on Triad speakers which have their own loyalty programs. See <a\n\t\t\trouterLink="/programs/triad-loyalty">Triad\n\t\t\tSpeaker Loyalty programs</a> for details on how you can earn a rebate on Triad speaker purchases.\n\t</p>\n\t<p *ngIf="(brandName$ | async ) == \'Pakedge\'">\n\t\tPremier Pakedge Dealers can easily earn a quarterly rebate on their Pakedge purchases. No rebate is paid on\n\t\tTriad\n\t\tspeakers which have their own loyalty programs. See <a routerLink="/programs/triad-loyalty">Triad\n\t\t\tSpeaker Loyalty programs</a> for details on how you can earn a rebate on Triad speaker purchases.\n\t</p>\n\t<p *ngIf="(brandName$ | async ) == \'Triad\'">\n\t\tPremier Triad Dealers can easily earn a quarterly rebate on their Pakedge purchases. No rebate is paid on Triad\n\t\tspeakers which have their own loyalty programs. See <a routerLink="/programs/triad-loyalty">Triad Speaker\n\t\t\tLoyalty\n\t\t\tprograms</a> for details on how you can earn a rebate on Triad speaker purchases.\n\t</p>\n\t<div class="row no-margin">\n\t\t<div *ngFor="let tier of dealerRebate?.dealerRebateTiers" class="col-sm-4">\n\t\t\t<div class="table {{tier.tierName.toLowerCase()}}"\n\t\t\t\t[ngClass]="{\'active\' : tier.tierName.toLowerCase() == (currentStatus$ | async)}">\n\t\t\t\t<div class="head">\n\t\t\t\t\t<div class="row no-margin">\n\t\t\t\t\t\t<div class="col-12 text-center {{tier.tierName.toLowerCase()}} header">{{tier.tierName}}\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t<div class="col-sm-6 text-center">Quarterly<br>spend<small><sup>1</sup></small></div>\n\t\t\t\t\t\t<div class="col-sm-6">Dealer<br>rebate %<small><sup>2</sup></small> </div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class="body">\n\t\t\t\t\t<div class="row no-margin" [ngClass]="{\'active\': goal.active}" *ngFor="let goal of tier.goals">\n\t\t\t\t\t\t<div class="col-sm-6 text-center">\n\t\t\t\t\t\t\t{{goal.minimum | shortCurrency: (currencySymbol$ | async) : 1}}</div>\n\t\t\t\t\t\t<div class="col-sm-6 text-center">{{goal.reward | percent: \'1.1\'}}</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t</div>\n\t</div>\n</div>'},"6by4":function(t,e){t.exports=".background-clickable {\n  height: 100%;\n  color: #fff !important;\n  background-color: rgba(0, 0, 0, 0.8);\n  cursor: pointer;\n  -webkit-transition-duration: 0.8s;\n  transition-duration: 0.8s;\n}\n\n.background-clickable:hover {\n  background-color: rgba(195, 32, 50, 0.8);\n  -webkit-transition-duration: 0.2s;\n  transition-duration: 0.2s;\n}\n\n.background-clickable.active {\n  background-color: transparent;\n}\n\n.round-icon-outline {\n  display: inline-block;\n  height: 50px;\n  width: 50px;\n  font-size: 25px;\n  line-height: 50px;\n  text-align: center;\n  border: 1.5px solid #fff;\n  border-radius: 50%;\n  -webkit-transition-duration: 0.8s;\n  transition-duration: 0.8s;\n}\n\n.background-clickable.active .round-icon-outline {\n  border: 1.5px solid transparent;\n  background-color: #c32032;\n}\n\n.num-text {\n  padding-left: 150px;\n}"},"6nXd":function(t,e){t.exports='<div *ngIf="brandName$ | async as brandName">\n\t<h3>2020 PREMIER DEALER QUALIFICATION</h3>\n\t<div *ngIf="showAccountStatus$ | async">\n\t\t<p> Earn a premier status for 2020 by achieving each of the requirements below in 2019. </p>\n\t\t<div class="table">\n\t\t\t<div class="row no-padding-top">\n\t\t\t\t<div class="col-sm-4 ">\n\t\t\t\t\t<div class="head">\n\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t<div class="col-sm-12">&nbsp;</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="body">\n\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t<div class="col-sm-12">Annual NET purchases<sup>4</sup></div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class="row" *ngIf="brandName === \'Control4\'">\n\t\t\t\t\t\t\t<div class="col-sm-12">Min. annual controller purchases</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t<div class="col-sm-12">Approved demo facility</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class="row" *ngIf="brandName === \'Control4\' || brandName === \'Pakedge\'">\n\t\t\t\t\t\t\t<div class="col-sm-12">Trained technicians</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t<div class="col-sm-12">Good standing credit and tech support</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div *ngFor="let req of requirements$ | async"\n\t\t\t\t\t [ngClass]="[\'col-sm-2 status-col\', req.tierName.toLowerCase()]">\n\t\t\t\t\t<div class="head">\n\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t<div class="col-sm-12 header">{{req.tierName}}</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="body">\n\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t<div class="col-sm-12" *ngIf="req.minSalesAmount > 0">{{ req.minSalesAmount |\n\t\t\t\t\t\t\t\tshortCurrency: (currencySymbol$ | async)}}</div>\n\t\t\t\t\t\t\t<div class="col-sm-12" *ngIf="req.minSalesAmount == 0">&mdash;</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class="row" *ngIf="brandName === \'Control4\'">\n\t\t\t\t\t\t\t<div class="col-sm-12" *ngIf="req.minControllerPurchases > 0">{{\n\t\t\t\t\t\t\t\treq.minControllerPurchases }}</div>\n\t\t\t\t\t\t\t<div class="col-sm-12" *ngIf="req.minControllerPurchases == 0">&mdash;</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t<div class="col-sm-12" *ngIf="req.approvedDemoFacility"><i\n\t\t\t\t\t\t\t\t   class="fas fa-check text-success"></i></div>\n\t\t\t\t\t\t\t<div class="col-sm-12" *ngIf="!req.approvedDemoFacility">&mdash;</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class="row" *ngIf="brandName === \'Control4\' || brandName === \'Pakedge\'">\n\t\t\t\t\t\t\t<div class="col-sm-12"\n\t\t\t\t\t\t\t\t *ngIf="req.minApcTechniciansTrained > 0 && req.minPcnaTechniciansTrained > 0"> {{req.minApcTechniciansTrained}}\n\t\t\t\t\t\t\t\tAPC/{{req.minPcnaTechniciansTrained}} PCNA</div>\n\t\t\t\t\t\t\t<div class="col-sm-12"\n\t\t\t\t\t\t\t\t *ngIf="req.minApcTechniciansTrained > 0 && req.minPcnaTechniciansTrained == 0"> {{req.minApcTechniciansTrained}} APC</div>\n\t\t\t\t\t\t\t<div class="col-sm-12"\n\t\t\t\t\t\t\t\t *ngIf="req.minApcTechniciansTrained == 0 && req.minPcnaTechniciansTrained > 0"> {{req.minPcnaTechniciansTrained}} PCNA</div>\n\t\t\t\t\t\t\t<div class="col-sm-12"\n\t\t\t\t\t\t\t\t *ngIf="req.minApcTechniciansTrained == 0 && req.minPcnaTechniciansTrained == 0">&mdash; </div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t<div class="col-sm-12" *ngIf="req.goodStandingCreditAndTechSupport"><i\n\t\t\t\t\t\t\t\t   class="fas fa-check text-success"></i></div>\n\t\t\t\t\t\t\t<div class="col-sm-12" *ngIf="!req.goodStandingCreditAndTechSupport">&mdash;</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t</div>\n\t\t<p>\n\t\t\t<ng-container *ngIf="brandName === \'Control4\'">\n\t\t\t\t<ul class="no-style">\n\t\t\t\t\t<li><small><sup>1</sup> CEPro 100 Brand Analysis Whole-House Automation 2015, 2016, 2017, and 2018.</small></li>\n\t\t\t\t\t<li><small><sup>2</sup> With sales manager approval.</small></li>\n\t\t\t\t\t<li><small><sup>3</sup> Visit <a routerLink="/support/rma">Support RMA page</a> for full details on Control4\u2019s product replacement\n\t\t\t\t\t\t\tpolicies.</small></li>\n\t\t\t\t\t<li><small><sup>4</sup> Annual spend includes Control4, Pakedge, Triad speakers, Triad audio, and third-party product purchases through\n\t\t\t\t\t\t\tControl4\u2019s online store, less any returns or credits. <br /> APC&mdash;Automation Programmer Certification<br />\n\t\t\t\t\t\t\tPCNA&mdash;Professional Certified Network Administrator </small></li>\n\t\t\t\t</ul>\n\t\t\t</ng-container>\n\t\t\t<ng-container *ngIf="brandName === \'Pakedge\'">\n\t\t\t\t<ul class="no-style">\n\t\t\t\t\t<li><small><sup>1</sup> CEPro 100 Brand Analysis Whole-House Automation 2015, 2016, 2017, and 2018.</small></li>\n\t\t\t\t\t<li><small><sup>2</sup> With sales manager approval.</small></li>\n\t\t\t\t\t<li><small><sup>3</sup> Visit <a routerLink="/support/rma">Support RMA page</a> for full details on Control4\u2019s product replacement\n\t\t\t\t\t\t\tpolicies.</small></li>\n\t\t\t\t\t<li><small><sup>4</sup> Annual spend includes Control4, Pakedge, Triad speakers, Triad audio, and third-party product purchases through\n\t\t\t\t\t\t\tControl4\u2019s online store, less any returns or credits. <br /> PCNA&mdash;Professional Certified Network Administrator </small></li>\n\t\t\t\t</ul>\n\t\t\t</ng-container>\n\t\t\t<ng-container *ngIf="brandName === \'Triad\'">\n\t\t\t\t<ul class="no-style">\n\t\t\t\t\t<li><small><sup>1</sup> Annual spend includes Control4, Pakedge, Triad speakers, Triad audio, and third-party product purchases through\n\t\t\t\t\t\t\tControl4\u2019s online store, less any returns or credits. <br /> PCNA&mdash;Professional Certified Network Administrator </small></li>\n\t\t\t\t</ul>\n\t\t\t</ng-container>\n\t\t</p>\n\t</div>\n\t<div *ngIf="!(showAccountStatus$ | async)">Requirements will be available soon. </div>\n</div>'},"7i6/":function(t,e){t.exports='<div id="register" class="widget padding" *ngIf="canPurchase">\n\t<div class="alert alert-warning" *ngIf="pcnaTraineeInfoLoaded && pendingTrainees?.length">\n\t\t<ul class="no-style">\n\t\t\t<h4>These trainees have already been added to another cart</h4>\n\t\t\t<li *ngFor="let trainee of pendingTrainees">{{trainee.fullName}}</li>\n\t\t</ul>\n\t</div>\n\t<c4-loading *ngIf="!orderId"></c4-loading>\n\t<div class="row" *ngIf="orderId > 0">\n\t\t<div class="col-lg-8">\n\t\t\t<div class="form-wrapper form dark light-grey padding">\n\t\t\t\t<c4-loading *ngIf="!pcnaTraineeInfoLoaded || !product"></c4-loading>\n\t\t\t\t<ng-container *ngIf="confirmLoaded">\n\t\t\t\t\t<a href="javascript:;" class="c4close" test-id="resetDisplayTotalsClick" (click)="resetDisplayTotals()"></a>\n\t\t\t\t</ng-container>\n\t\t\t\t<div [hidden]="state !== \'trainees\' || !pcnaTraineeInfoLoaded" *ngIf="product">\n\t\t\t\t\t<h2 class="bold">{{title}}</h2>\n\t\t\t\t\t<form>\n\t\t\t\t\t\t<div class="row no-margin margin-bottom" *ngIf="availableTrainees?.length">\n\t\t\t\t\t\t\t<div [class]="((useNewPcnaChanges$ | async) && !disablePakedgeforPCNA && !isTriad) ? \'col-sm-6\' : \'col-sm-9\'">\n\t\t\t\t\t\t\t\t<select test-id="selectedTrainees" id="trainee-select" name="trainee" [(ngModel)]="selectedTrainee">\n\t\t\t\t\t\t\t\t\t<option [value]="undefined">Select Trainee(s)</option>\n\t\t\t\t\t\t\t\t\t<option *ngFor="let available of availableTrainees" [ngValue]="available">{{available.fullName + \' (\' + (available.email |\n\t\t\t\t\t\t\t\t\t\tlowercase) + \')\'}}</option>\n\t\t\t\t\t\t\t\t</select>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class="col-sm-3" *ngIf="(useNewPcnaChanges$ | async) && !disablePakedgeforPCNA && !isTriad">\n\t\t\t\t\t\t\t\t<select test-id="selectedPcnaType" id="pcna-type-select" name="pcnatype" [(ngModel)]="selectedPCNAType">\n\t\t\t\t\t\t\t\t\t<option disabled [value]="undefined">Select PCNA TYPE</option>\n\t\t\t\t\t\t\t\t\t<option ngValue="1">Pakedge</option>\n\t\t\t\t\t\t\t\t\t<option ngValue="2">Araknis</option>\n\t\t\t\t\t\t\t\t</select>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class="col-sm-3">\n\t\t\t\t\t\t\t\t<button test-id="addNewTraineeClick" class="block no-margin" (click)="addNewTrainee()"\n\t\t\t\t\t\t\t\t\t\t[disabled]="disablePcnaRegistration || !selectedTrainee || (((useNewPcnaChanges$ | async) && !isTriad) && !selectedPCNAType) || totals.modifying">Register\n\t\t\t\t\t\t\t\t\tUser</button>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div *ngIf="selectedTrainees?.length" class="half-margin-top">\n\t\t\t\t\t\t\t<h4>Trainee(s)</h4>\n\t\t\t\t\t\t\t<ul class="no-style half-margin-top half-margin-bottom half-padding-left">\n\t\t\t\t\t\t\t\t<li *ngFor="let selected of selectedTrainees"><i\n\t\t\t\t\t\t\t\t\t   *ngIf="((useNewPcnaChanges$ | async) && (!selected.pcnaType || (disablePakedgeforPCNA && selected.pcnaType == 1)))"\n\t\t\t\t\t\t\t\t\t   class="fas fa-exclamation-circle text-danger"></i>{{selected.fullName}}\n\t\t\t\t\t\t\t\t\t<small>({{selected.email}})</small>&nbsp;{{getPCNATypePrettyName(selected.pcnaType)}} &nbsp; <small><a\n\t\t\t\t\t\t\t\t\t\t   href="javascript:;"\n\t\t\t\t\t\t\t\t\t\t   (click)="removeTrainee(selected)">Remove</a></small></li>\n\t\t\t\t\t\t\t</ul>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<p><small><strong>Technicians must be registered with their legal name.</strong>&mdash; The PCNA exam is conducted by a 3rd party\n\t\t\t\t\t\t\t\tproctoring service and government issued ID will be used to verify the trainee\'s identity before testing. You can update your\n\t\t\t\t\t\t\t\ttechnicians name in the <a target="_blank"\n\t\t\t\t\t\t\t\t   routerLink="/account/usermanagement">User Management</a> section of the Dealer Portal. Trainees must be registered within\n\t\t\t\t\t\t\t\tportal user management prior to registration. If the user you wish to enroll does not appear in this list, please first <a\n\t\t\t\t\t\t\t\t   routerLink="/account/usermanagement"\n\t\t\t\t\t\t\t\t   target="_blank">Create New User in User Management</a>. Once complete, return to this page and <a href="javascript:;"\n\t\t\t\t\t\t\t\t   (click)="populate()">refresh this list</a>.</small></p>\n\t\t\t\t\t\t<c4-shipping-form [orderId]="totals.orderId" *ngIf="selectedTrainees?.length">\n\t\t\t\t\t\t</c4-shipping-form>\n\t\t\t\t\t\t<div class="alert alert-warning" *ngIf="((useNewPcnaChanges$ | async) && selectedTraineeHasOldPcna)">\n\t\t\t\t\t\t\t<p>Trainees marked with a <i class="fas fa-exclamation-circle text-danger"></i> must be removed and re-registered. The Pakedge\n\t\t\t\t\t\t\t\tversion of PCNA is no longer available.</p>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<button test-id="continueToPaymentClick" (click)="proceedToBilling()"\n\t\t\t\t\t\t\t\t[disabled]="disablePcnaRegistration || totals.modifying || !(selectedTrainees?.length && validShipping) || ((useNewPcnaChanges$ | async) && selectedTraineeHasOldPcna)"\n\t\t\t\t\t\t\t\tclass="half-margin-top">Continue to Payment <i class="fal fa-arrow-right"></i></button>\n\t\t\t\t\t</form>\n\t\t\t\t</div>\n\t\t\t\t<div *ngIf="state === \'billing\'">\n\t\t\t\t\t<div class="half-margin-bottom">\n\t\t\t\t\t\t<h4>Registration</h4>\n\t\t\t\t\t\t<div class="row half-margin-bottom">\n\t\t\t\t\t\t\t<div class="col-sm-4">\n\t\t\t\t\t\t\t\t<small>\n\t\t\t\t\t\t\t\t\t<strong>Trainee(s)</strong>\n\t\t\t\t\t\t\t\t\t<ul *ngFor="let row of summarySelectedTrainees" class="no-style">\n\t\t\t\t\t\t\t\t\t\t<li *ngFor="let selected of row"> {{selected}} </li>\n\t\t\t\t\t\t\t\t\t</ul>\n\t\t\t\t\t\t\t\t</small>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class="col-sm-4">\n\t\t\t\t\t\t\t\t<small>\n\t\t\t\t\t\t\t\t\t<strong>Shipping</strong>\n\t\t\t\t\t\t\t\t\t<ul class="no-style">\n\t\t\t\t\t\t\t\t\t\t<li *ngIf="selectedShippingAddress$ | async as address"> {{address.displayValue}}</li>\n\t\t\t\t\t\t\t\t\t\t<li>{{totals.shipping?.selectedShippingMethod?.name}}</li>\n\t\t\t\t\t\t\t\t\t</ul>\n\t\t\t\t\t\t\t\t</small>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<small><a href="javascript:;" test-id="backToTraineesAndShippingClick" (click)="state = \'trainees\'"><i\n\t\t\t\t\t\t\t\t   class="fa fa-long-arrow-left"></i> Back To Trainees and Shipping</a></small>\n\t\t\t\t\t</div>\n\t\t\t\t\t<c4-billing-form [orderId]="totals.orderId"></c4-billing-form>\n\t\t\t\t\t<p class="no-margin" [hidden]="!canProceed"><small>By placing this order, you agree to the <a\n\t\t\t\t\t\t\t   href="javascript:;" (click)="showTermsOfUse()">terms of use</a>.</small></p>\n\t\t\t\t\t<div class="half-padding-top">\n\t\t\t\t\t\t<button test-id="completePcnaRegistration" (click)="placeOrder()" [disabled]="!canProceed || totals.modifying"><i\n\t\t\t\t\t\t\t   class="fa fa-check"></i>Complete PCNA Registration</button>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div *ngIf="state === \'confirm\'">\n\t\t\t\t\t<c4-loading *ngIf="!confirmLoaded"></c4-loading>\n\t\t\t\t\t<div *ngIf="confirmLoaded">\n\t\t\t\t\t\t<h2>Registration Confirmed</h2>\n\t\t\t\t\t\t<p>You have successfully registered for the Professional<sup>&reg;</sup> PCNA Certification training. A confirmation email where you\n\t\t\t\t\t\t\tfind information on beginning the training has been sent to you and the following trainee(s):</p>\n\t\t\t\t\t\t<div class="row half-margin-bottom half-padding-left">\n\t\t\t\t\t\t\t<div class="col-sm-5">\n\t\t\t\t\t\t\t\t<small>\n\t\t\t\t\t\t\t\t\t<ul class="no-style">\n\t\t\t\t\t\t\t\t\t\t<li *ngFor="let registered of confirm.registeredTrainees"> {{registered.fullName}}</li>\n\t\t\t\t\t\t\t\t\t</ul>\n\t\t\t\t\t\t\t\t\t<strong *ngIf="confirm.failedTrainees.length">Unfortunately these trainee(s) failed to register:</strong>\n\t\t\t\t\t\t\t\t\t<ul class="no-style" *ngIf="confirm.failedTrainees.length">\n\t\t\t\t\t\t\t\t\t\t<li *ngFor="let failed of confirm.failedTrainees">{{failed.fullName}}</li>\n\t\t\t\t\t\t\t\t\t</ul>\n\t\t\t\t\t\t\t\t</small>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class="col-sm-5">\n\t\t\t\t\t\t\t\t<small>\n\t\t\t\t\t\t\t\t\t<strong>Shipping</strong>\n\t\t\t\t\t\t\t\t\t<ul class="no-style half-margin-bottom">\n\t\t\t\t\t\t\t\t\t\t<li>{{confirm.shippingAddress}}</li>\n\t\t\t\t\t\t\t\t\t\t<li>{{confirm.shippingMethod}}</li>\n\t\t\t\t\t\t\t\t\t\t<li *ngIf="confirm.finalDestinationAddress"><strong>Final Destination</strong></li>\n\t\t\t\t\t\t\t\t\t\t<li *ngIf="confirm.finalDestinationAddress"\n\t\t\t\t\t\t\t\t\t\t\t[innerHTML]="confirm.finalDestinationAddress | safeHtml"></li>\n\t\t\t\t\t\t\t\t\t\t<li *ngIf="confirm.order.poReference"><strong>PO Reference Number</strong>\n\t\t\t\t\t\t\t\t\t\t</li>\n\t\t\t\t\t\t\t\t\t\t<li *ngIf="confirm.order.poReference">\n\t\t\t\t\t\t\t\t\t\t\t<strong>{{confirm.order.poReference}}</strong>\n\t\t\t\t\t\t\t\t\t\t</li>\n\t\t\t\t\t\t\t\t\t</ul>\n\t\t\t\t\t\t\t\t\t<strong>Billing</strong>\n\t\t\t\t\t\t\t\t\t<ul class="no-style half-margin-bottom">\n\t\t\t\t\t\t\t\t\t\t<li [innerHTML]="confirm.billingAddress | safeHtml"></li>\n\t\t\t\t\t\t\t\t\t\t<li *ngIf="confirm.payment.creditCardNumber">{{confirm.payment.cardType}} {{confirm.payment.creditCardNumber}}</li>\n\t\t\t\t\t\t\t\t\t\t<li *ngIf="confirm.payment.creditCardNumber">{{confirm.payment.nameOnCard}} </li>\n\t\t\t\t\t\t\t\t\t\t<li *ngIf="!confirm.payment.creditCardNumber"> {{confirm.payment | paymentMethod}}</li>\n\t\t\t\t\t\t\t\t\t</ul>\n\t\t\t\t\t\t\t\t\t<div *ngIf="confirm.benefits && confirm.benefits.length">\n\t\t\t\t\t\t\t\t\t\t<strong>Promotions</strong>\n\t\t\t\t\t\t\t\t\t\t<ul class="no-style half-margin-bottom">\n\t\t\t\t\t\t\t\t\t\t\t<li *ngFor="let benefit of confirm.benefits">{{benefit}}</li>\n\t\t\t\t\t\t\t\t\t\t</ul>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t</small>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div> Please instruct these trainees to check their inbox for this email, including junk folders.\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t</div>\n\t\t<div class="col-sm-4">\n\t\t\t<div class="table">\n\t\t\t\t<c4-loading *ngIf="!displayTotals"></c4-loading>\n\t\t\t\t<div class="body" *ngIf="displayTotals">\n\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t<div class="col-6 bold">Subtotal</div>\n\t\t\t\t\t\t<div class="col-6 text-right">{{displayTotals.subtotal | currency:(currency$ | async)}} </div>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t<div class="col-6 bold">Taxes</div>\n\t\t\t\t\t\t<div class="col-6 text-right">{{displayTotals.taxTotal | currency:(currency$ | async)}}</div>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t<div class="col-6 bold">Shipping</div>\n\t\t\t\t\t\t<div class="col-6 text-right">{{displayTotals.shippingTotal | currency:(currency$ | async)}}</div>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t<div class="col-6 bold">Total</div>\n\t\t\t\t\t\t<div class="col-6 text-right"><b>{{displayTotals.grandTotal | currency:(currency$ | async)}}</b></div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t</div>\n\t</div>\n\t<div *ngIf="(certifiedTrainees?.length > 0 || registeredTrainees?.length > 0) && canPurchase">\n\t\t<h3 class="half-margin-top">Trainees</h3>\n\t\t<div class="row">\n\t\t\t<div class="col-sm-4" *ngIf="certifiedTrainees.length">\n\t\t\t\t<ul class="no-style">\n\t\t\t\t\t<h4>PCNA<sup class="text-grey">&trade;</sup> Certified</h4>\n\t\t\t\t\t<li *ngFor="let trainee of certifiedTrainees"><i class="fal fa-check-circle text-success"></i> {{trainee.fullName}}</li>\n\t\t\t\t</ul>\n\t\t\t</div>\n\t\t\t<div class="col-sm-8" *ngIf="registeredTrainees.length">\n\t\t\t\t<ul class="no-style">\n\t\t\t\t\t<h4>Training in Progress</h4>\n\t\t\t\t\t<li *ngFor="let trainee of registeredTrainees"><i\n\t\t\t\t\t\t   class="fal fa-arrow-circle-right text-warning"></i> {{trainee.fullName}} </li>\n\t\t\t\t</ul>\n\t\t\t</div>\n\t\t</div>\n\t</div>\n</div>'},"7yF6":function(t,e,n){"use strict";var s=n("SVse"),i=n("8Y7J"),a=n("s7LF"),r=n("HsOI"),o=n("ZwOa"),c=n("iInd"),l=n("iTUp"),d=n("G8jr"),h=n("m1S6"),p=n("KbOK"),u=n("DQLy"),m=n("XNiG"),f=n("1G5W"),g=function(t,e,n,s){var i,a=arguments.length,r=a<3?e:null===s?s=Object.getOwnPropertyDescriptor(e,n):s;if("object"==typeof Reflect&&"function"==typeof Reflect.decorate)r=Reflect.decorate(t,e,n,s);else for(var o=t.length-1;o>=0;o--)(i=t[o])&&(r=(a<3?i(r):a>3?i(e,n,r):i(e,n))||r);return a>3&&r&&Object.defineProperty(e,n,r),r},b=function(t,e){if("object"==typeof Reflect&&"function"==typeof Reflect.metadata)return Reflect.metadata(t,e)};let y=class{constructor(t,e){this.store=t,this.staticPageFormsService=e,this.destroyed$=new m.a}ngOnInit(){this.store.pipe(Object(u.m)(p.A),Object(f.a)(this.destroyed$)).subscribe(t=>{this.user=t,this.fullName=`${t.firstName} ${t.lastName}`})}ngOnDestroy(){this.destroyed$.next()}submit(){this.submitted=!0;const t={