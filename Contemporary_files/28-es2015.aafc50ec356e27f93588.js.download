<form name="relatedItem" #relatedItem="ngForm" class="col-sm-10">\n\t\t<mat-form-field>\n\t\t\t<input test-id="relatedTitle" matInput type="text" maxlength="255" name="relatedTitle" [(ngModel)]="item.title"\n\t\t\t\t   placeholder="Title"\n\t\t\t\t   required />\n\t\t</mat-form-field>\n\t\t<mat-form-field>\n\t\t\t<input test-id="relatedUrl" matInput type="text" maxlength="255" name="relatedUrl" [(ngModel)]="item.url" placeholder="URL"\n\t\t\t\t   required />\n\t\t</mat-form-field>\n\t</form>\n\t<div class="col-sm-2">\n\t\t<button test-id="saveRelatedContentItemClick" class="block" [disabled]="relatedItem.invalid" (click)="save()">Save</button>\n\t\t<button test-id="cancelRelatedContentItemEditClick" class="white block" (click)="closeEditing()">Cancel</button>\n\t</div>\n</div>\n<button test-id="addRelatedContentItemClick" type="button" class="grey" *ngIf="!isEditing && item.id === 0" (click)="toggleIsEditing()">Add Related\n\tContent</button>'},eUNB:function(t,e){t.exports='<div class="padding">\n\t<h1>Knowledgebase Management</h1>\n\t<div class="row">\n\t\t<div class="col-lg-9 col-md-8 col-sm-8">\n\t\t\t<form (submit)="searchArticles()">\n\t\t\t\t<div class="row no-margin" *ngIf="!editArticle">\n\t\t\t\t\t<div class="col-md-10 col-sm-9 col-8 form dark">\n\t\t\t\t\t\t<mat-form-field>\n\t\t\t\t\t\t\t<input test-id="articleSearch" matInput type="text" name="name" placeholder="Search articles by Id, Title, Tags"\n\t\t\t\t\t\t\t\t   [(ngModel)]="searchText">\n\t\t\t\t\t\t</mat-form-field>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="col-md-2 col-sm-3 col-4">\n\t\t\t\t\t\t<button test-id="searchKbArticleClick" type="submit" class="block grey" [disabled]="searching"><i\n\t\t\t\t\t\t\t   class="fal fa-search"></i></button>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</form>\n\t\t\t<div class="widget" *ngIf="searchedTerm && !editArticle && !editAnnouncements">\n\t\t\t\t<h3 class="widget-header-white">Results for "{{searchedTerm}}"</h3>\n\t\t\t\t<div class="padding">\n\t\t\t\t\t<c4-loading *ngIf="searching"></c4-loading>\n\t\t\t\t\t<div class="table">\n\t\t\t\t\t\t<div class="head d-xs-none">\n\t\t\t\t\t\t\t<div class="row no-margin" *ngIf="searchResults">\n\t\t\t\t\t\t\t\t<div class="col-sm-10">\n\t\t\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t\t\t<div class="col-sm-2">ID</div>\n\t\t\t\t\t\t\t\t\t\t<div class="col-sm-1"></div>\n\t\t\t\t\t\t\t\t\t\t<div class="col-sm-9">Title</div>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class="body" *ngIf="!searching">\n\t\t\t\t\t\t\t<div class="repeated-item row no-margin" *ngFor="let article of searchResults; index as i">\n\t\t\t\t\t\t\t\t<div class="col-sm-10">\n\t\t\t\t\t\t\t\t\t<div class="row" style="padding-right: 12.5px;">\n\t\t\t\t\t\t\t\t\t\t<div class="col-6 d-block d-sm-none">ID</div>\n\t\t\t\t\t\t\t\t\t\t<div class="col-sm-2 col-6"> {{article.id}} </div>\n\t\t\t\t\t\t\t\t\t\t<div class="col-sm-1">\n\t\t\t\t\t\t\t\t\t\t\t<i class="fal fa-check" *ngIf="isArticleVisible(article)"\n\t\t\t\t\t\t\t\t\t\t\t   title="Visible"></i>\n\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t\t<div class="col-6 d-block d-sm-none">Title</div>\n\t\t\t\t\t\t\t\t\t\t<div class="col-sm-9 col-6">\n\t\t\t\t\t\t\t\t\t\t\t<a routerLink="/knowledgebase/article/{{article.id}}"\n\t\t\t\t\t\t\t\t\t\t\t   target="_blank">{{article.title}}</a>\n\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<div class="row" style="padding-right: 12.5px;">\n\t\t\t\t\t\t\t\t\t\t<div class="col-sm-3">\n\t\t\t\t\t\t\t\t\t\t\t<p class="no-margin"><small><b>Created By</b><br />{{article.createdByUserId}}</small></p>\n\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t\t<div class="col-sm-6">\n\t\t\t\t\t\t\t\t\t\t\t<p class="no-margin"><small><b>Last Modified</b>\n\t\t\t\t\t\t\t\t\t\t\t\t\t<br />{{article.lastModifiedByUserId}} &mdash; {{article.lastModifiedDate | date: \'MMM dd, yyyy\'}}</small>\n\t\t\t\t\t\t\t\t\t\t\t</p>\n\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="col-sm-2 col-12">\n\t\t\t\t\t\t\t\t\t<a attr.test-id="beginEditArticleClick-{{i}}" class="c4btn transparent block no-margin clickable"\n\t\t\t\t\t\t\t\t\t   (click)="beginEditArticle(article.id)"><i class="fal fa-pen-alt"></i></a>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t\t<div class="widget" *ngIf="editArticle">\n\t\t\t\t<h3 class="widget-header-grey" *ngIf="editArticle.id > 0">Editing Article {{editArticle.id}}</h3>\n\t\t\t\t<h3 class="widget-header-grey" *ngIf="!editArticle.id">Creating Article</h3>\n\t\t\t\t<div class="padding">\n\t\t\t\t\t<button test-id="saveArticleClick" (click)="saveArticle()">Save<span\n\t\t\t\t\t\t\t  *ngIf="!editArticle.isApproved && hasSupportAdmin">&nbsp;&amp; Approve</span></button>\n\t\t\t\t\t<button test-id="cancelEditArticleClick" class="transparent" (click)="cancelEditArticle()">Cancel</button>\n\t\t\t\t\t<button test-id="deleteArticleClick" class="transparent" (click)="deleteArticle()">Delete</button>\n\t\t\t\t\t<form novalidate>\n\t\t\t\t\t\t<mat-form-field>\n\t\t\t\t\t\t\t<input test-id="articleTitle" matInput type="text" class="grey" placeholder="Title" name="title"\n\t\t\t\t\t\t\t\t   [(ngModel)]="editArticle.title" />\n\t\t\t\t\t\t</mat-form-field>\n\t\t\t\t\t\t<h4 class="half-padding-top">Article Summary</h4>\n\t\t\t\t\t\t<c4-ckeditor test-id="articleSummaryEditor" name="articleSummary" [(ngModel)]="editArticle.metadata.field1"></c4-ckeditor>\n\t\t\t\t\t\t<h4 class="half-padding-top">Quick Actions</h4>\n\t\t\t\t\t\t<c4-ckeditor test-id="quickActionsEditor" name="quickActions" [(ngModel)]="editArticle.metadata.field2"></c4-ckeditor>\n\t\t\t\t\t\t<h4 class="half-padding-top">Article Details</h4>\n\t\t\t\t\t\t<c4-ckeditor test-id="articleDetailsEditor" name="articleDetails" [(ngModel)]="editArticle.content"></c4-ckeditor>\n\t\t\t\t\t\t<h4 class="half-padding-top">Category</h4>\n\t\t\t\t\t\t<select test-id="selectedGroup" name="group" [(ngModel)]="selectedGroup" (ngModelChange)="addCategoryToArticle()">\n\t\t\t\t\t\t\t<option *ngFor="let group of groups" [ngValue]="group">{{group.groupName}}</option>\n\t\t\t\t\t\t</select>\n\t\t\t\t\t\t<span class="grey"\n\t\t\t\t\t\t\t  style="display: inline-block; padding: 10px; margin-right: 10px; margin-bottom: 3px"\n\t\t\t\t\t\t\t  *ngFor="let item of editArticle.groupMap"> {{item.group.groupName}} <i class="clickable fal fa-trash"\n\t\t\t\t\t\t\t   (click)="deleteCategoryFromArticle(item.group)"></i>\n\t\t\t\t\t\t</span>\n\t\t\t\t\t\t<h4 class="half-padding-top">Tags</h4>\n\t\t\t\t\t\t<c4-typeahead test-id="c4-typeahead-article-tag" placeholder="Add tag" [(ngModel)]="editArticleTag" [getItems]="tagsAutoComplete"\n\t\t\t\t\t\t\t\t\t  (selected)="tagSelected($event)" name="tag" ngDefaultControl [focus]="false"></c4-typeahead>\n\t\t\t\t\t\t<span class="grey" style="display: inline-block; padding: 10px; margin-right: 10px;"\n\t\t\t\t\t\t\t  *ngFor="let tag of editArticle.tags"> {{tag.tag}} <i class="clickable fal fa-trash" (click)="deleteTag(tag)"></i>\n\t\t\t\t\t\t</span>\n\t\t\t\t\t\t<div *ngIf="editArticle.id > 0">\n\t\t\t\t\t\t\t<h4 class="half-padding-top">Related Content</h4>\n\t\t\t\t\t\t\t<c4-related-content-item attr.test-id="c4-related-content-item-{{i}}" [item]="item"\n\t\t\t\t\t\t\t\t\t\t\t\t\t *ngFor="let item of contentItemRelatedContent; index as i"\n\t\t\t\t\t\t\t\t\t\t\t\t\t (updated)="relatedItemUpdated($event)" (removed)="relatedItemRemoved($event)">\n\t\t\t\t\t\t\t</c4-related-content-item>\n\t\t\t\t\t\t\t<c4-related-content-item [contentItemId]="editArticle.id" (added)="getRelatedContent()">\n\t\t\t\t\t\t\t</c4-related-content-item>\n\t\t\t\t\t\t\t<h4 class="half-padding-top">Attachments</h4>\n\t\t\t\t\t\t\t<c4-file-upload folder="kb-attachments/{{editArticle.id}}" maxFiles="5"\n\t\t\t\t\t\t\t\t\t\t\t(complete)="addAttachments($event)" classes="grey"></c4-file-upload>\n\t\t\t\t\t\t\t<p *ngIf="editMedia?.length <= 0">No attachments.</p>\n\t\t\t\t\t\t\t<div class="alert alert-warning" *ngIf="uploading">Uploading...</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div *ngIf="editMedia?.length > 0">\n\t\t\t\t\t\t\t<div *ngFor="let attachment of editMedia">\n\t\t\t\t\t\t\t\t<c4-cloudinary [media]="attachment"></c4-cloudinary>\n\t\t\t\t\t\t\t\t<small><a test-id="removeAttachmentClick" href="javascript:;" (click)="removeAttachment(attachment)"\n\t\t\t\t\t\t\t\t\t   class="fal fa-trash"></a></small>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class="half-padding-top row no-margin">\n\t\t\t\t\t\t\t<div class="col-sm-3">\n\t\t\t\t\t\t\t\t<h4>Availability</h4>\n\t\t\t\t\t\t\t\t<c4-enum-checkbox test-id="visibleInPortalsCheckboxes" [labelMap]="portalEnum" [(value)]="editArticle.visibleInPortals">\n\t\t\t\t\t\t\t\t</c4-enum-checkbox>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class="col-sm-9">\n\t\t\t\t\t\t\t\t<c4-scheduler [type]="editArticle.scheduleType" [start]="editArticle.visibleDate"\n\t\t\t\t\t\t\t\t\t\t\t  [end]="editArticle.endDate" (scheduleChange)="updateSchedule($event)">\n\t\t\t\t\t\t\t\t</c4-scheduler>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</form>\n\t\t\t\t\t<div class="half-padding-top">\n\t\t\t\t\t\t<button test-id="saveArticleClickBottom" type="button" (click)="saveArticle()">Save<span\n\t\t\t\t\t\t\t\t  *ngIf="!editArticle.isApproved && hasSupportAdmin">&nbsp;&amp; Approve</span></button>\n\t\t\t\t\t\t<button test-id="cancelArticleClickBottom" type="button" class="transparent" (click)="cancelEditArticle()">Cancel</button>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t\t<c4-kb-announcement-edit *ngIf="editAnnouncements" (close)="editAnnouncements = !$event">\n\t\t\t</c4-kb-announcement-edit>\n\t\t</div>\n\t\t<div class="col-lg-3 col-md-4 col-sm-4">\n\t\t\t<div class="widget" [ngClass]="{\'no-margin-top\': !hasSupportAdmin}" *ngIf="!editAnnouncements">\n\t\t\t\t<h3 class="widget-header-white">Article Tools</h3>\n\t\t\t\t<div class="padding">\n\t\t\t\t\t<ng-container *ngIf="!editArticle">\n\t\t\t\t\t\t<button test-id="createNewArticleClick" class="grey block" (click)="beginAddArticle()">Create New Article</button>\n\t\t\t\t\t\t<button test-id="viewRecentArticlesClick" class="light-grey block" (click)="viewRecentArticles()">Recently Modified\n\t\t\t\t\t\t\tArticles</button>\n\t\t\t\t\t\t<button test-id="viewDraftArticlesClick" class="light-grey block" (click)="viewDraftArticles()">Draft Articles</button>\n\t\t\t\t\t\t<button test-id="viewArticlesPendingApprovalClick" class="light-grey block" (click)="viewArticlesPendingApproval()">Articles Pending\n\t\t\t\t\t\t\tApproval</button>\n\t\t\t\t\t</ng-container>\n\t\t\t\t\t<a class="c4btn grey block" routerLink="/knowledgebase/article/{{editArticle.id}}" target="_blank"\n\t\t\t\t\t   *ngIf="editArticle">Preview Article</a>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t\t<div class="widget" *ngIf="hasSupportAdmin">\n\t\t\t\t<h3 class="widget-header-white">Announcement</h3>\n\t\t\t\t<div class="padding">\n\t\t\t\t\t<button test-id="manageAnnouncementClick" class="block grey no-margin" (click)="editAnnouncements = true"\n\t\t\t\t\t\t\t[disabled]="editArticle || editAnnouncements">Manage Announcement</button>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t</div>\n\t</div>\n</div>'},tJcv:function(t,e){t.exports=""},wV8X:function(t,e){t.exports='<div class="widget">\n\t<h3 class="widget-header-grey">Manage Announcement</h3>\n\t<div class="absolute top left block text-right d-xs-none">\n\t\t<a test-id="selectPortalClick" class="c4btn transparent " [class.grey]="selectedPortal == portal" (click)="selectPortal(portal)"\n\t\t   *ngFor="let portal of selectablePortals">{{getPortalName(portal)}}</a>\n\t</div>\n\t<h3 class="widget-header-grey d-block d-sm-none" style="padding: 0; line-height: 0;">\n\t\t<a class="c4btn block transparent no-border-radius-bottom no-margin" [class.grey]="selectedPortal == portal"\n\t\t   (click)="selectPortal(portal)" *ngFor="let portal of selectablePortals">{{portal}}</a>\n\t</h3>\n\t<c4-loading *ngIf="!announcement"></c4-loading>\n\t<div class="padding" *ngIf="announcement">\n\t\t<div>\n\t\t\t<button test-id="saveKbAnnouncementClick" type="button" (click)="save()">Save</button>\n\t\t\t<button test-id="closeKbAnnouncementEditClick" type="button" class="transparent" (click)="close.emit(true)">Close</button>\n\t\t</div>\n\t\t<form>\n\t\t\t<div class="half-padding-top">\n\t\t\t\t<h4>Content</h4>\n\t\t\t\t<c4-ckeditor test-id="pageSourceCodeEditor" name="pageSource" [(ngModel)]="announcement.pageSourceCode"></c4-ckeditor>\n\t\t\t</div>\n\t\t\t<div class="half-padding-top" *ngIf="announcement.pageSourceCode">\n\t\t\t\t<h4>Preview</h4>\n\t\t\t\t<div class="widget-fluid">\n\t\t\t\t\t<div id="kb-alert" class="alert alert-warning">\n\t\t\t\t\t\t<div [innerHTML]="announcement.pageSourceCode | safeHtml"></div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t\t<c4-scheduler [start]="announcement.releaseDate" [end]="announcement.expireDate"\n\t\t\t\t\t\t  [type]="announcement.scheduleType" (scheduleChange)="updateSchedule($event)"></c4-scheduler>\n\t\t</form>\n\t\t<div class="half-padding-top">\n\t\t\t<button test-id="saveKbAnnouncementClickBottom" type="button" [disabled]="!validSchedule" (click)="save()">Save</button>\n\t\t\t<button test-id="cancelKbAnnouncementClickBottom" type="button" class="transparent" (click)="close.emit(true)">Close</button>\n\t\t</div>\n\t</div>\n</div>'}}]);