[\u043a\u0443\u043d\u0438 \u0441\u043e\u0430\u0442] LT [\u0434\u0430]",lastDay:"[\u041a\u0435\u0447\u0430 \u0441\u043e\u0430\u0442] LT [\u0434\u0430]",lastWeek:"[\u0423\u0442\u0433\u0430\u043d] dddd [\u043a\u0443\u043d\u0438 \u0441\u043e\u0430\u0442] LT [\u0434\u0430]",sameElse:"L"},relativeTime:{future:"\u042f\u043a\u0438\u043d %s \u0438\u0447\u0438\u0434\u0430",past:"\u0411\u0438\u0440 \u043d\u0435\u0447\u0430 %s \u043e\u043b\u0434\u0438\u043d",s:"\u0444\u0443\u0440\u0441\u0430\u0442",ss:"%d \u0444\u0443\u0440\u0441\u0430\u0442",m:"\u0431\u0438\u0440 \u0434\u0430\u043a\u0438\u043a\u0430",mm:"%d \u0434\u0430\u043a\u0438\u043a\u0430",h:"\u0431\u0438\u0440 \u0441\u043e\u0430\u0442",hh:"%d \u0441\u043e\u0430\u0442",d:"\u0431\u0438\u0440 \u043a\u0443\u043d",dd:"%d \u043a\u0443\u043d",M:"\u0431\u0438\u0440 \u043e\u0439",MM:"%d \u043e\u0439",y:"\u0431\u0438\u0440 \u0439\u0438\u043b",yy:"%d \u0439\u0438\u043b"},week:{dow:1,doy:7}})}(n("wd/R"))},LrVz:function(t,e){t.exports='<button test-id="toggleChatClick" class="block grey" c4Track="Click" trackCategory="Support" trackLabel="Chat" (click)="toggleChat()">\n\t<i class="fal fa-comment"></i>Chat</button>'},Ltqe:function(t,e){t.exports='<div class="padding">\n\t<div class="widget">\n\t\t<div class="padding" *ngIf="loads">\n\t\t\t<h1>Lighting Compatibility</h1>\n\t\t\t<form class="half-padding-bottom">\n\t\t\t\t<div class="row">\n\t\t\t\t\t<div class="col-sm-4">\n\t\t\t\t\t\t<select test-id="selectedSku" [ngModel]="loadFilter.sku" (ngModelChange)="onSkuChange($event)" *ngIf="skuTypes"\n\t\t\t\t\t\t\t\tname="skuTypes">\n\t\t\t\t\t\t\t<option value="">Select a SKU</option>\n\t\t\t\t\t\t\t<option *ngFor="let sku of skuTypes" [value]="sku">{{ sku }}</option>\n\t\t\t\t\t\t</select>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="col-sm-4">\n\t\t\t\t\t\t<select test-id="selectedBrand" [ngModel]="loadFilter.brandName" (ngModelChange)="onBrandNameChange($event)"\n\t\t\t\t\t\t\t\t*ngIf="brandTypes" name="brandTypes">\n\t\t\t\t\t\t\t<option value="">Select a brand</option>\n\t\t\t\t\t\t\t<option *ngFor="let brand of brandTypes" [value]="brand">{{ brand }}</option>\n\t\t\t\t\t\t</select>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="col-sm-4">\n\t\t\t\t\t\t<select test-id="selectedBulbFixture" [ngModel]="loadFilter.bulbFixtureType" (ngModelChange)="onBulbFixtureTypeChange($event)"\n\t\t\t\t\t\t\t\t*ngIf="bulbFixtureTypes" name="bulbFixtures">\n\t\t\t\t\t\t\t<option value="">Select a bulb/fixture</option>\n\t\t\t\t\t\t\t<option *ngFor="let bulb of bulbFixtureTypes" [value]="bulb">{{ bulb }}</option>\n\t\t\t\t\t\t</select>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="col-sm-4">\n\t\t\t\t\t\t<select test-id="selectedTechnology" [ngModel]="loadFilter.technologyTypeName"\n\t\t\t\t\t\t\t\t(ngModelChange)="onTechnologyTypeChange($event)" *ngIf="technologyTypes"\n\t\t\t\t\t\t\t\tname="technologyTypes">\n\t\t\t\t\t\t\t<option value="">Select a technology</option>\n\t\t\t\t\t\t\t<option *ngFor="let tech of technologyTypes" [value]="tech">{{ tech }}</option>\n\t\t\t\t\t\t</select>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="col-sm-4">\n\t\t\t\t\t\t<select test-id="selectedVoltage" [ngModel]="loadFilter.voltage" (ngModelChange)="onVoltageChange($event)"\n\t\t\t\t\t\t\t\t*ngIf="voltageTypes" name="voltageTypes">\n\t\t\t\t\t\t\t<option value="">Select a voltage</option>\n\t\t\t\t\t\t\t<option *ngFor="let voltage of voltageTypes" [value]="voltage">{{ voltage }}</option>\n\t\t\t\t\t\t</select>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="col-sm-4" *ngIf="loads">\n\t\t\t\t\t\t<button test-id="clearLoadCompatibility" type="button" (click)="clearFilter()" class="light-grey">Clear</button>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</form>\n\t\t\t<div class="table">\n\t\t\t\t<div class="head d-xs-none d-sm-block">\n\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t<div class="col-4">Manufacturer</div>\n\t\t\t\t\t\t<div class="col-4">Bulb/Fixture Type</div>\n\t\t\t\t\t\t<div class="col-4">SKU</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class="padding" *ngIf="!loads">Loading...</div>\n\t\t\t\t<div class="body">\n\t\t\t\t\t<div class="row" *ngFor="let load of filteredLoads | orderBy:[\'light.brand.brandName\']; index as i">\n\t\t\t\t\t\t<div class="col-sm-4 col-6">\n\t\t\t\t\t\t\t<a href="javascript:void(0);" attr.test-id="showFilterDetailsClick-{{i}}" class="clickable"\n\t\t\t\t\t\t\t   title="{{ load.light.brand.brandName }}"\n\t\t\t\t\t\t\t   (click)="load.showDetails=!load.showDetails">\n\t\t\t\t\t\t\t\t<b>{{ load.light.brand.brandName }}</b>\n\t\t\t\t\t\t\t</a>\n\t\t\t\t\t\t\t<p class="d-sm-none">\n\t\t\t\t\t\t\t\t<small>\n\t\t\t\t\t\t\t\t\t<span>{{ load.sku }}</span>\n\t\t\t\t\t\t\t\t</small>\n\t\t\t\t\t\t\t</p>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class="col-sm-4 col-6"> {{ load.light.bulbType }} </div>\n\t\t\t\t\t\t<div class="col-sm-4 d-xs-none d-sm-block"> {{ load.sku }} </div>\n\t\t\t\t\t\t<div class="col-12" *ngIf="load.showDetails">\n\t\t\t\t\t\t\t<div class="row no-margin half-padding-top">\n\t\t\t\t\t\t\t\t<div class="col-sm-4 col-6" *ngIf="load.light.modelName">\n\t\t\t\t\t\t\t\t\t<b>Model</b>\n\t\t\t\t\t\t\t\t\t<br />\n\t\t\t\t\t\t\t\t\t<small>{{ load.light.modelName | uppercase }}</small>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="col-sm-4 col-6" *ngIf="load.light.modelNumber">\n\t\t\t\t\t\t\t\t\t<b>Model Number</b>\n\t\t\t\t\t\t\t\t\t<br />\n\t\t\t\t\t\t\t\t\t<small>{{ load.light.modelNumber | uppercase }}</small>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="col-sm-4 col-6" *ngIf="load.light.bulbType">\n\t\t\t\t\t\t\t\t\t<b>Fixture Type</b>\n\t\t\t\t\t\t\t\t\t<br />\n\t\t\t\t\t\t\t\t\t<small>{{ load.light.bulbType }}</small>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="col-sm-4 col-6" *ngIf="load.light.baseType">\n\t\t\t\t\t\t\t\t\t<b>Base Type</b>\n\t\t\t\t\t\t\t\t\t<br />\n\t\t\t\t\t\t\t\t\t<small>{{ load.light.baseType }}</small>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="col-sm-4 col-6" *ngIf="load.light.voltage">\n\t\t\t\t\t\t\t\t\t<b>Voltage</b>\n\t\t\t\t\t\t\t\t\t<br />\n\t\t\t\t\t\t\t\t\t<small>{{ load.light.voltage }}</small>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="col-sm-4 col-6" *ngIf="load.light.wattage">\n\t\t\t\t\t\t\t\t\t<b>Wattage</b>\n\t\t\t\t\t\t\t\t\t<br />\n\t\t\t\t\t\t\t\t\t<small>{{ load.light.wattage }}</small>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="col-sm-4 col-6" *ngIf="load.light.lumens">\n\t\t\t\t\t\t\t\t\t<b>Lumens</b>\n\t\t\t\t\t\t\t\t\t<br />\n\t\t\t\t\t\t\t\t\t<small>{{ load.light.lumens | number }}</small>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="col-sm-4 col-6" *ngIf="load.light.bulbLifeHours">\n\t\t\t\t\t\t\t\t\t<b>Bulb Life</b>\n\t\t\t\t\t\t\t\t\t<br />\n\t\t\t\t\t\t\t\t\t<small>{{ load.light.bulbLifeHours | number }}</small>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="col-sm-4 col-6" *ngIf="load.light.additionalModelInformation">\n\t\t\t\t\t\t\t\t\t<b>Additional Information</b>\n\t\t\t\t\t\t\t\t\t<br />\n\t\t\t\t\t\t\t\t\t<small>{{ load.light.additionalModelInformation }}</small>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="col-sm-4 col-6" *ngIf="load.minDimLevel || load.maxDimLevel">\n\t\t\t\t\t\t\t\t\t<b>Dim Level (min/max)</b>\n\t\t\t\t\t\t\t\t\t<br />\n\t\t\t\t\t\t\t\t\t<small>{{ load.minDimLevel }}/{{ load.maxDimLevel }}</small>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="col-sm-4 col-6"\n\t\t\t\t\t\t\t\t\t *ngIf="load.minDimLevelSwitchLeg || load.maxDimLevelSwitchLeg">\n\t\t\t\t\t\t\t\t\t<b>Switch Leg Dimming (min/max)</b>\n\t\t\t\t\t\t\t\t\t<br />\n\t\t\t\t\t\t\t\t\t<small>{{ load.minDimLevelSwitchLeg }}/{{ load.maxDimLevelSwitchLeg }}</small>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="col-sm-4 col-6"\n\t\t\t\t\t\t\t\t\t *ngIf="load.minDimLevelForwardPhase || load.maxDimLevelForwardPhase">\n\t\t\t\t\t\t\t\t\t<b>Forward Phase Dimming (min/max)</b>\n\t\t\t\t\t\t\t\t\t<br />\n\t\t\t\t\t\t\t\t\t<small>{{ load.minDimLevelForwardPhase }}/{{ load.maxDimLevelForwardPhase }}</small>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="col-sm-4 col-6"\n\t\t\t\t\t\t\t\t\t *ngIf="load.minDimLevelForwardPhaseSwitchLeg || load.maxDimLevelForwardPhaseSwitchLeg">\n\t\t\t\t\t\t\t\t\t<b>Forward Phase Switch Leg (min/max)</b>\n\t\t\t\t\t\t\t\t\t<br />\n\t\t\t\t\t\t\t\t\t<small>{{ load.minDimLevelForwardPhaseSwitchLeg }}/{{ load.maxDimLevelForwardPhaseSwitchLeg }}</small>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="col-sm-4 col-6"\n\t\t\t\t\t\t\t\t\t *ngIf="load.minDimLevelReversePhase || load.maxDimLevelReversePhase">\n\t\t\t\t\t\t\t\t\t<b>Reverse Phase Dimming (min/max)</b>\n\t\t\t\t\t\t\t\t\t<br />\n\t\t\t\t\t\t\t\t\t<small>{{ load.minDimLevelReversePhase }}/{{ load.maxDimLevelReversePhase }}</small>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="col-sm-4 col-6"\n\t\t\t\t\t\t\t\t\t *ngIf="load.minDimLevelReversePhaseSwitchLeg || load.maxDimLevelReversePhaseSwitchLeg">\n\t\t\t\t\t\t\t\t\t<b>Reverse Phase Switch Leg (min/max)</b>\n\t\t\t\t\t\t\t\t\t<br />\n\t\t\t\t\t\t\t\t\t<small>{{ load.minDimLevelReversePhaseSwitchLeg }}/{{ load.maxDimLevelReversePhaseSwitchLeg }}</small>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class="row no-margin half-padding-top">\n\t\t\t\t\t\t\t\t<div class="col-md-2 col-md-push-8">\n\t\t\t\t\t\t\t\t\t<a class="c4btn block" target="_blank"\n\t\t\t\t\t\t\t\t\t   [routerLink]="[\'/print/lighting-compatibility\', load.sku, load.lightId]">\n\t\t\t\t\t\t\t\t\t\t<i class="fal fa-print"></i>Print </a>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t</div>\n\t</div>\n\t<div class="widget">\n\t\t<h3 class="widget-header-grey">Control4 Lighting Compatibility Testing Service</h3>\n\t\t<div class="padding">\n\t\t\t<p>Control4 offers Compatibility Testing of light fixtures and bulbs sent in by dealers.</p>\n\t\t\t<ol>\n\t\t\t\t<li>A control4 lighting engineer will test a sample of a light fixture and bulb not in our database. </li>\n\t\t\t\t<li>This pro