lacingAndNewEngravingRadio" type="radio" name="legacyRadio" value="mixed" [(ngModel)]="engravingUse" /><span>This is a mix\n\t\t\t\t\tof replacement engravings and new engravings. <br /><small>If this is the case, please create an XML file for the legacy engraving and\n\t\t\t\t\t\tanother for the new engraving process.</small></span>\n\t\t\t</label>\n\t\t</div>\n\t\t<div class="alert alert-warning no-margin" *ngIf="!confirmationOrder.isValid">\n\t\t\t<p>This Composer XML is invalid and cannot be processed. The following keycap(s) exceed the bounds of engraving:</p>\n\t\t\t<ul class="no-margin">\n\t\t\t\t<li *ngFor="let room of invalidRooms"> {{room.name}} <ul class="no-margin">\n\t\t\t\t\t\t<li *ngFor="let keypad of invalidKeypads(room)"> {{keypad.name}} <ul class="no-margin">\n\t\t\t\t\t\t\t\t<li *ngFor="let button of invalidButtons(keypad)">\n\t\t\t\t\t\t\t\t\t<span *ngFor="let line of textLines(button.line1)">{{line.value}}</span>\n\t\t\t\t\t\t\t\t\t<span *ngIf="button.line2">\n\t\t\t\t\t\t\t\t\t\t<br />\n\t\t\t\t\t\t\t\t\t\t<span *ngFor="let line of textLines(button.line2)">{{line.value}}</span>\n\t\t\t\t\t\t\t\t\t</span>\n\t\t\t\t\t\t\t\t</li>\n\t\t\t\t\t\t\t</ul>\n\t\t\t\t\t\t</li>\n\t\t\t\t\t</ul>\n\t\t\t\t</li>\n\t\t\t</ul>\n\t\t</div>\n\t\t<div class="row no-margin" *ngIf="confirmationOrder.isValid">\n\t\t\t<div class="col-sm-9">\n\t\t\t\t<p class="no-margin">Complete: {{percentComplete() / 100 | percent}}</p>\n\t\t\t\t<progress class="gold" [value]="percentComplete()" max="100" style="width: 90%;"></progress>\n\t\t\t</div>\n\t\t\t<div class="col-sm-3">\n\t\t\t\t<button test-id="createSavedOrderClick" class="block"\n\t\t\t\t\t\t[disabled]="percentComplete()<100 || !confirmationOrder.isValid || creatingCart || (false && confirmationOrder.hasLegacyKeycaps && (!engravingUse || engravingUse === \'mixed\'))"\n\t\t\t\t\t\t(click)="createOrder()">Create Saved Order</button>\n\t\t\t</div>\n\t\t</div>\n\t\t<div *ngIf="confirmationOrder.isValid">\n\t\t\t<div class="row">\n\t\t\t\t<div class="col-sm-6 half-padding-bottom">\n\t\t\t\t\t<h3>Rooms</h3>\n\t\t\t\t\t<div *ngFor="let room of confirmationOrder.rooms">\n\t\t\t\t\t\t<div [ngClass]="{\'reviewed\':room.hasReviewed}">\n\t\t\t\t\t\t\t<span (click)="loadKeypads(room)"\n\t\t\t\t\t\t\t\t  style="cursor: pointer;">{{room.name | removeEncoding}}</span>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div>\n\t\t\t\t\t\t\t<i [ngClass]="{\'icon-check\': room.HasReviewed}" style="position: relative; top: 2px;"></i>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class="confirmKeypad col-md-5 col-sm-6">\n\t\t\t\t\t<h3>Keypads</h3>\n\t\t\t\t\t<div id="keypads" style="height: 400px; overflow-y: scroll; overflow-x: hidden;"\n\t\t\t\t\t\t *ngIf="sectionRoom">\n\t\t\t\t\t\t<div class="padding white" style="max-width: 400px; border: 1px solid #dedede;">\n\t\t\t\t\t\t\t<div class="half-padding-bottom" *ngFor="let keypad of sectionRoom.keypads"\n\t\t\t\t\t\t\t\t style="overflow: hidden; white-space: nowrap; text-overflow: ellipsis; -o-text-overflow: ellipsis; -webkit-text-overflow: ellipsis; display: inline-block; width: 170px; margin-right: 10px; vertical-align: top;">\n\t\t\t\t\t\t\t\t<h4 class="no-margin">{{keypad.name}}</h4>\n\t\t\t\t\t\t\t\t<ul class="no-style">\n\t\t\t\t\t\t\t\t\t<li *ngFor="let button of keypad.buttons">\n\t\t\t\t\t\t\t\t\t\t<img src="data:image/png;base64,{{button.previewImage}}" />\n\t\t\t\t\t\t\t\t\t</li>\n\t\t\t\t\t\t\t\t</ul>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t</div>\n\t</div>\n</c4-popup>'},dUpr:function(t,e,n){"use strict";n.d(e,"a",(function(){return s}));var r=n("CcnG"),i=n("soiQ"),o=function(t,e,n,r){var i,o=arguments.length,a=o<3?e:null===r?r=Object.getOwnPropertyDescriptor(e,n):r;if("object"==typeof Reflect&&"function"==typeof Reflect.decorate)a=Reflect.decorate(t,e,n,r);else for(var s=t.length-1;s>=0;s--)(i=t[s])&&(a=(o<3?i(a):o>3?i(e,n,a):i(e,n))||a);return o>3&&a&&Object.defineProperty(e,n,a)