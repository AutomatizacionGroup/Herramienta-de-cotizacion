ount && !product.isFlatDiscount" class="far fa-cubes"></i>\n\t\t\t\t\t\t<i *ngIf="product.hasPromo || (product.isFlatDiscount)" class="fal fa-tag"></i>\n\t\t\t\t\t\t<span\n\t\t\t\t\t\t\t  *ngIf="!vm.isMsrp"\n\t\t\t\t\t\t\t  test-id="priceWithDiscount">{{ product.displayPrice + product.productDiscount | currency: vm.currency}}&nbsp;</span>\n\t\t\t\t\t</span>\n\t\t\t\t\t<span\n\t\t\t\t\t\t  [ngClass]="(product.productDiscount && product.currencyHasDiscount) || (product.snapPrice && product.snapPrice < product.dealerPrice) ? \'strikethrough text-grey small\' : \'bold\'"\n\t\t\t\t\t\t  *ngIf="(vm.userCanViewPricing && !product.isDisplayOnly && product.dealerPrice) > 0 && !vm.isMsrp"\n\t\t\t\t\t\t  test-id="itemPrice">\n\t\t\t\t\t\t<i *ngIf="product.productDiscount === 0 && !product.isFlatDiscount && product.currencyHasDiscount"\n\t\t\t\t\t\t   class="far fa-cubes text-primary"></i>\n\t\t\t\t\t\t<i *ngIf="product.hasPromo && product.productDiscount === 0"\n\t\t\t\t\t\t   class="fal fa-tag text-primary"></i>{{ product.dealerPrice | currency: vm.currency }} </span>\n\t\t\t\t\t<ng-container *ngIf="vm.isMsrp">\n\t\t\t\t\t\t<span *ngIf="product.msrp"><small>MSRP</small><strong test-id="msrpPrice">{{product.msrp | currency: vm.currency }}</strong></span>\n\t\t\t\t\t\t<small *ngIf="!product.msrp">Price unavailable</small>\n\t\t\t\t\t</ng-container>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t</div>\n\t\t<div buttons class="row no-margin card-button" *ngIf="vm.userCanPurchase && productViewPricing">\n\t\t\t<div class="col-12 no-margin"\n\t\t\t\t [ngClass]="product.customizationRequiredForCustomer || !product.isBuiltToOrder? \'\' : \'col-md-7\'" style="min-height: 0">\n\t\t\t\t<c4-product-add-to-cart [product]="product" class="block no-margin"\n\t\t\t\t\t\t\t\t\t\t*ngIf="(!product.isBuiltToOrder || ignoreCustom || !product.customizationRequiredForCustomer)"\n\t\t\t\t\t\t\t\t\t\tclasses="block no-margin" [skus]="product.sku" [disabled]="vm.modifyingCart" [isInCart]="isInCart">\n\t\t\t\t</c