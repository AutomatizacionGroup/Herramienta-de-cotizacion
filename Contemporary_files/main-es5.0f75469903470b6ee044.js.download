ml"></p>\n\t\t\t\t<div class="table">\n\t\t\t\t\t<div class="head">\n\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t<div class="col-8">Order Totals</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="body">\n\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t<div class="col-4">Subtotal</div>\n\t\t\t\t\t\t\t<div class="col-6 text-right">{{ info.order.subtotal | currency: (currency$ |async) }}</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div *ngIf="info.order.discountAmount" class="row">\n\t\t\t\t\t\t\t<div class="col-4">Discount</div>\n\t\t\t\t\t\t\t<div class="col-6 text-right"> ({{ info.order.discountAmount | currency: (currency$ |async) }})</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t<div class="col-4"><span>{{ (isEmea$ | async) ? \'Freight\' : \'Shipping\' }}</span></div>\n\t\t\t\t\t\t\t<div class="col-6 text-right">{{ info.order.shippingAmount | currency: (currency$ |async) }} </div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t<div class="col-4"><span>{{ (isEmea$ | async) ? \'VAT\' : \'Tax\' }}</span></div>\n\t\t\t\t\t\t\t<div class="col-6 text-right">{{ info.order.taxAmount | currency: (currency$ |async) }} </div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t<div class="col-4"><b>Total</b></div>\n\t\t\t\t\t\t\t<div class="col-6 text-right">\n\t\t\t\t\t\t\t\t<b>{{ info.order.grandTotal | currency: (currency$ |async) }}</b></div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t</div>\n\t</div>\n\t<div class="widget">\n\t\t<h3 class="text-dark no-margin">Order Details</h3>\n\t\t<div class="head">\n\t\t\t<div class="row">\n\t\t\t\t<div [className]="(isEmea$ | async) ? \'col-7\' : \'col-5\'">Product</div>\n\t\t\t\t<div class="col-2">Price</div>\n\t\t\t\t<div class="col-1">Qty</div>\n\t\t\t\t<div class="col-2">Extended</div>\n\t\t\t\t<div class="col-2" *ngIf="!(isEmea$ | async)">Shipping</div>\n\t\t\t</div>\n\t\t</div>\n\t\t\x3c!-- cart --\x3e\n\t\t<div class="body">\n\t