t\t\t<div class="padding">\n\t\t\t\t\t<b>Invoice:</b> {{invoice.proformaNumber}}<br />\n\t\t\t\t\t<b>Account:</b> {{invoice.dealerAccount}}<br />\n\t\t\t\t\t<b>Date:</b> {{invoice.orderDate}}\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t</div>\n\t</div>\n\t<div class="row">\n\t\t<div class="col-6">\n\t\t\t<div class="widget">\n\t\t\t\t<h3 class="widget-header-white">Ship From</h3>\n\t\t\t\t<div class="padding">\n\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t<div class="col-4"><b>Company</b></div>\n\t\t\t\t\t\t<div class="col-8">Control4 Corporation</div>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t<div class="col-4"><b>Address</b></div>\n\t\t\t\t\t\t<div class="col-8"> 3612 West 1820 South<br /> Salt Lake City, UT 84104 </div>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t<div class="col-4"><b>Phone</b></div>\n\t\t\t\t\t\t<div class="col-8">801-501-8764</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t</div>\n\t\t<div class="col-6">\n\t\t\t<div class="widget">\n\t\t\t\t<h3 class="widget-header-white">Bill To</h3>\n\t\t\t\t<div class="padding">\n\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t<div class="col-4"><b>Company</b></div>\n\t\t\t\t\t\t<div class="col-8">{{invoice.billingAddress?.name}}</div>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t<div class="col-4"><b>Address</b></div>\n\t\t\t\t\t\t<div class="col-8" *ngIf="invoice.billingAddress">\n\t\t\t\t\t\t\t<div *ngIf="invoice.billingAddress.line1">{{invoice.billingAddress.line1}}</div>\n\t\t\t\t\t\t\t<div *ngIf="invoice.billingAddress.line2">{{invoice.billingAddress.line2}}</div>\n\t\t\t\t\t\t\t<div\n\t\t\t\t\t\t\t\t *ngIf="invoice.billingAddress.city || invoice.billingAddress.stateProvince || invoice.billingAddress.postalCode">\n\t\t\t\t\t\t\t\t<span *ngIf="invoice.billingAddress.city">{{invoice.billingAddress.city}}</span>\n\t\t\t\t\t\t\t\t<span *ngIf="invoice.billingAddress.stateProvince"><span\n\t\t\t\t\t\t\t\t\t\t  *ngIf="invoice.billingAddress.city">,&nbsp;</span>{{invoice.billingAddress.stateProvince}}</span>\n\t\t\t\t\t\t\t\t<span *ngIf="invoice.billingAddress.postalCode"><span\n\t\t\t\t\t\t\t\t\t\t  *ngIf="invoice.billingAddress.city || invoice.billingAddress.stateProvince">&nbsp;</span>{{invoice.billingAddress.postalCode}}</span>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div *ngIf="invoice.billingAddress.country">{{invoice.billingAddress.country}}</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t</div>\n\t</div>\n\t<div class="row">\n\t\t<div class="col-6">\n\t\t\t<div class="widget">\n\t\t\t\t<h3 class="widget-header-white">Ship To</h3>\n\t\t\t\t<div class="padding">\n\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t<div class="col-4"><b>Company</b></div>\n\t\t\t\t\t\t<div class="col-8">{{invoice.shippingAddress?.name}}</div>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t<div class="col-4"><b>Address</b></div>\n\t\t\t\t\t\t<div class="col-8" *ngIf="invoice.shippingAddress">\n\t\t\t\t\t\t\t<div *ngIf="invoice.shippingAddress.line1">{{invoice.shippingAddress.line1}}</div>\n\t\t\t\t\t\t\t<div *ngIf="invoice.shippingAddress.line2">{{invoice.shippingAddress.line2}}</div>\n\t\t\t\t\t\t\t<div\n\t\t\t\t\t\t\t\t *ngIf="invoice.shippingAddress.city || invoice.shippingAddress.stateProvince || invoice.shippingAddress.postalCode">\n\t\t\t\t\t\t\t\t<span *ngIf="invoice.shippingAddress.city">{{invoice.shippingAddress.city}}</span>\n\t\t\t\t\t\t\t\t<span *ngIf="invoice.shippingAddress.stateProvince"><span\n\t\t\t\t\t\t\t\t\t\t  *ngIf="invoice.shippingAddress.city">,&nbsp;</span>{{invoice.shippingAddress.stateProvince}}</span>\n\t\t\t\t\t\t\t\t<span *ngIf="invoice.shippingAddress.postalCode"><span\n\t\t\t\t\t\t\t\t\t\t  *ngIf="invoice.shippingAddress.city || invoice.shippingAddress.stateProvince">&nbsp;</span>{{invoice.shippingAddress.postalCode}}</span>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div *ngIf="invoice.shippingAddress.country">{{invoice.shippingAddress.country}}</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="row" *ngIf="invoice.shipToFax">\n\t\t\t\t\t\t<div class="col-4"><b>Contact</b></div>\n\t\t\t\t\t\t<div class="col-8">{{invoice.shipToFax}}</div>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="row" *ngIf="invoice.shipToPhone">\n\t\t\t\t\t\t<div class="col-4"><b>Phone</b></div>\n\t\t\t\t\t\t<div class="col-8">{{invoice.shipToPhone}}</div>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="row" *ngIf="invoice.shipToEmail">\n\t\t\t\t\t\t<div class="col-4"><b>Email</b></div>\n\t\t\t\t\t\t<div class="col-8">{{invoice.shipToEmail}}</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t</div>\n\t\t<div class="col-6">\n\t\t\t<div class="widget">\n\t\t\t\t<h3 class="widget-header-white">Consignee</h3>\n\t\t\t\t<div class="padding">\n\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t<div class="col-4"><b>Company</b></div>\n\t\t\t\t\t\t<div class="col-8">{{invoice.consigneeAddress.name}}</div>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t<div class="col-4"><b>Address</b></div>\n\t\t\t\t\t\t<div class="col-8" *ngIf="invoice.consigneeAddress">\n\t\t\t\t\t\t\t<div *ngIf="invoice.consigneeAddress.line1">{{invoice.consigneeAddress.line1}}</div>\n\t\t\t\t\t\t\t<div *ngIf="invoice.consigneeAddress.line2">{{invoice.consigneeAddress.line2}}</div>\n\t\t\t\t\t\t\t<div\n\t\t\t\t\t\t\t\t *ngIf="invoice.consigneeAddress.city || invoice.consigneeAddress.stateProvince || invoice.consigneeAddress.postalCode">\n\t\t\t\t\t\t\t\t<span *ngIf="invoice.consigneeAddress.city">{{invoice.consigneeAddress.city}}</span>\n\t\t\t\t\t\t\t\t<span *ngIf="invoice.consigneeAddress.stateProvince"><span\n\t\t\t\t\t\t\t\t\t\t  *ngIf="invoice.consigneeAddress.city">,&nbsp;</span>{{invoice.consigneeAddress.stateProvince}}</span>\n\t\t\t\t\t\t\t\t<span *ngIf="invoice.consigneeAddress.postalCode"><span\n\t\t\t\t\t\t\t\t\t\t  *ngIf="invoice.consigneeAddress.postalCode || invoice.consigneeAddress.stateProvince">&nbsp;</span>{{invoice.consigneeAddress.postalCode}}</span>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div *ngIf="invoice.consigneeAddress.country">{{invoice.consigneeAddress.country}}</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t</div>\n\t</div>\n\t<div class="widget">\n\t\t<h3 class="widget-header-white">Invoice Details</h3>\n\t\t<div class="padding">\n\t\t\t<div class="row">\n\t\t\t\t<div class="col-3"><b>Account</b></div>\n\t\t\t\t<div class="col-3"><b>{{invoice.dealerAccount}}</b></div>\n\t\t\t\t<div class="col-3"><b>Purchase Order</b></div>\n\t\t\t\t<div class="col-3"><b>{{invoice.poReference}}</b></div>\n\t\t\t\t<div class="col-3"><b>Payment Terms</b></div>\n\t\t\t\t<div class="col-3"><b>{{invoice.paymentTerms}}</b></div>\n\t\t\t\t<div class="col-3"><b>Sales Rep</b></div>\n\t\t\t\t<div class="col-3"><b>{{invoice.salesRep}}</b></div>\n\t\t\t\t<div class="col-3"><b>Ship Via</b></div>\n\t\t\t\t<div class="col-3"><b>{{invoice.shipMethod}}</b></div>\n\t\t\t\t<div class="col-3"><b>Date</b></div>\n\t\t\t\t<div class="col-3"><b>{{invoice.orderDate}}</b></div>\n\t\t\t\t<div class="col-3"><b>Inco Term</b></div>\n\t\t\t\t<div class="col-3"><b>EXW</b></div>\n\t\t\t\t<div class="col-3"><b>License if Required</b></div>\n\t\t\t\t<div class="col-3"><b>NLR</b></div>\n\t\t\t</div>\n\t\t</div>\n\t</div>\n\t<div class="row">\n\t\t<div class="col-6">\n\t\t\t<div class="widget">\n\t\t\t\t<h3 class="widget-header-white">Control4 Contact Info</h3>\n\t\t\t\t<div class="padding">\n\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t<div class="col-4"><b>Name</b></div>\n\t\t\t\t\t\t<div class="col-8">{{invoice.isaContact?.name}}</div>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t<div class="col-4"><b>Phome</b></div>\n\t\t\t\t\t\t<div class="col-8">{{invoice.isaContact?.phone}}</div>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t<div class="col-4"><b>Email</b></div>\n\t\t\t\t\t\t<div class="col-8">{{invoice.isaContact?.email}}</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t</div>\n\t\t<div class="col-6">\n\t\t\t<div class="widget">\n\t\t\t\t<h3 class="widget-header-white">Dealer Contact Info</h3>\n\t\t\t\t<div class="padding" *ngIf="invoice.dealerContact">\n\t\t\t\t\t<div class="row" *ngIf="invoice.dealerContact.name">\n\t\t\t\t\t\t<div class="col-4"><b>Name</b></div>\n\t\t\t\t\t\t<div class="col-8">{{invoice.dealerContact.name}}</div>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="row" *ngIf="invoice.dealerContact.phone">\n\t\t\t\t\t\t<div class="col-4"><b>Phome</b></div>\n\t\t\t\t\t\t<div class="col-8">{{invoice.dealerContact.phone}}</div>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="row" *ngIf="invoice.dealerContact.email">\n\t\t\t\t\t\t<div class="col-4"><b>Email</b></div>\n\t\t\t\t\t\t<div class="col-8">{{invoice.dealerContact.email}}</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t</div>\n\t</div>\n\t<div class="widget">\n\t\t<h3 class="widget-header-white">Order Details</h3>\n\t\t<div class="table">\n\t\t\t<div class="row">\n\t\t\t\t<div class="col-4">\n\t\t\t\t\t<b>Item</b>\n\t\t\t\t</div>\n\t\t\t\t<div class="col-2">\n\t\t\t\t\t<b>HTS Code</b>\n\t\t\t\t</div>\n\t\t\t\t<div class="col-1">\n\t\t\t\t\t<b>COO</b>\n\t\t\t\t</div>\n\t\t\t\t<div class="col-1 text-right">\n\t\t\t\t\t<b>Price</b>\n\t\t\t\t</div>\n\t\t\t\t<div class="col-1 text-right">\n\t\t\t\t\t<b>Qty</b>\n\t\t\t\t</div>\n\t\t\t\t<div class="col-2 text-right">\n\t\t\t\t\t<b>Subtotal</b>\n\t\t\t\t</div>\n\t\t\t\t<div class="col-1 text-right">\n\t\t\t\t\t<b>Tax</b>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t\t\x3c!-- cart --\x3e\n\t\t\t<div class="row" *ngFor="let item of invoice.items">\n\t\t\t\t\x3c!-- item --\x3e\n\t\t\t\t<div class="col-4">\n\t\t\t\t\t<b>{{item.name}}</b>\n\t\t\t\t\t<p><small>{{item.sku}}</small></p>\n\t\t\t\t</div>\n\t\t\t\t<div class="col-2"> {{item.htsCode}} </div>\n\t\t\t\t<div class="col-1"> {{item.countryOfOrigin}} </div>\n\t\t\t\t<div class="col-1 text-right">\n\t\t\t\t\t<p>{{item.dealerPrice | currency: (currency$ |async)}}</p>\n\t\t\t\t</div>\n\t\t\t\t<div class="col-1 text-right">\n\t\t\t\t\t<p>{{item.quantity}}</p>\n\t\t\t\t</div>\n\t\t\t\t<div class="col-2 text-right">\n\t\t\t\t\t<p>{{(item.dealerPrice * item.quantity) | currency: (currency$ |async)}}</p>\n\t\t\t\t</div>\n\t\t\t\t<div class="col-1 text-right" *ngIf="!(isEmea$ | async)">\n\t\t\t\t\t<p>{{item.lineTax | currency: (currency$ |async)}}</p>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t</div>\n\t</div>\n\t<div class="widget">\n\t\t<h3 class="widget-header-white">Order Totals</h3>\n\t\t<div class="table">\n\t\t\t<div class="row">\n\t\t\t\t<div class="col-3">\n\t\t\t\t\t<b>Discounts</b>\n\t\t\t\t</div>\n\t\t\t\t<div class="col-3">\n\t\t\t\t\t<b>Freight</b>\n\t\t\t\t</div>\n\t\t\t\t<div class="col-3">\n\t\t\t\t\t<b>Subtotal</b>\n\t\t\t\t</div>\n\t\t\t\t<div class="col-3">\n\t\t\t\t\t<b>TAX/VAT/HST/GST</b>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t\t\x3c!-- cart --\x3e\n\t\t\t<div class="row">\n\t\t\t\t\x3c!-- item --\x3e\n\t\t\t\t<div class="col-3"> {{invoice.discounts | currency: (currency$ |async)}} </div>\n\t\t\t\t<div class="col-3"> {{invoice.freight | currency: (currency$ |async)}} </div>\n\t\t\t\t<div class="col-3"> {{invoice.subtotal | currency: (currency$ |async)}} </div>\n\t\t\t\t<div class="col-3"> {{invoice.orderTax | currency: (currency$ |async)}} </div>\n\t\t\t</div>\n\t\t</div>\n\t\t<div class="padding">\n\t\t\t<h4> PLEASE REMIT THIS AMOUNT<br /> {{invoice.total | currency: (currency$ |async)}} </h4>\n\t\t</div>\n\t</div>\n\t<div class="widget">\n\t\t<h3 class="widget-header-white">Destination Control Statement</h3>\n\t\t<div class="padding">\n\t\t\t<small>These commodities, technology or software were exported from the United States in accordance with the Export Administration Regulations.\n\t\t\t\tDiversion contrary to U.S. Law is prohibited. A person or firm may not sell, transfer, export, re-export, finance, order, buy, remove, conceal,\n\t\t\t\tstore, use, loan, dispose of, transport, forward, or otherwise service, any items subject to the EAR and exported or to be exported with\n\t\t\t\tknowledge that a violation of the EAR, the Export Administration Act, order, license, license exception, or other authorization issued.</small>\n\t\t</div>\n\t</div>\n\t<div class="widget">\n\t\t<h3 class="widget-header-white">Remarks</h3>\n\t\t<div class="padding">\n\t\t\t<p>{{invoice.remarks}}</p>\n\t\t</div>\n\t</div>\n\t<div class="widget grey">\n\t\t<div class="row">\n\t\t\t<div class="col-4">\n\t\t\t\t<b>Note:</b>\n\t\t\t\t<ol>\n\t\t\t\t\t<li>All Amounts are in US Dollars</li>\n\t\t\t\t\t<li>This is only a quote. The final invoice may be different. The product prices are valid for 30 days from the Doc Date above. Taxes and\n\t\t\t\t\t\tShipping are subject to change.</li>\n\t\t\t\t</ol>\n\t\t\t</div>\n\t\t\t<div class="col-4">\n\t\t\t\t<b>Wire Instructions (Please reference your account)</b><br /> Bank of America, N.A.<br /> P.O. Box 1091<br /> Charlotte, NC 28254-3489<br />\n\t\t\t\tSWIFTCODE: BOFAUS3N<br /> ACH: 053000196 / Wire: 026009593<br /> ACCOUNT: 237025432989\n\t\t\t</div>\n\t\t\t<div class="col-4">\n\t\t\t\t<b>Please mail payment in US dollars to:</b><br /> Control4 Corporation<br /> Lockbox at Silicon Valley Bank<br /> Dept. CH 17556<br />\n\t\t\t\tPalatine, IL 600655-7556<br /> USA\n\t\t\t</div>\n\t\t</div>\n\t</div>\n</div>'},F809:function(t,e,n){var r=n("yNUO"),i=n("sunR"),o=n("DT56");t.exports=function(t,e){var n=r(t),a=r(e),s=o(n,a),c=Math.abs(i(n,a));return n.setMonth(n.getMonth()-s*c),s*(c-(o(n,a)===-s))}},FF6D:function(t,e,n){var r=n("yNUO");t.exports=function(t){var e=r(t);return e.setMilliseconds(999),e}},FFOo:function(t,e,n){"use strict";n.d(e,"a",(function(){return l}));var r=n("mrSG"),i=n("2Bdj"),o=n("6ahw"),a=n("pugT"),s=n("L/V9"),c=n("iLxQ"),u=n("DKTb"),l=function(t){function e(n,r,i){var a=t.call(this)||this;switch(a.syncErrorValue=null,a.syncErrorThrown=!1,a.syncErrorThrowable=!1,a.isStopped=!1,arguments.length){case 0:a.destination=o.a;break;case 1:if(!n){a.destination=o.a;break}if("object"==typeof n){n instanceof e?(a.syncErrorThrow