lified items</option>\n\t\t\t\t<option value="expense">Discount against Expense</option>\n\t\t\t\t<option value="coupon">Discount Rebate Form</option>\n\t\t\t</select>\n\t\t\t<div class="half-padding-top" *ngIf="benefit.benefitType === \'part\' || benefit.benefitType === \'expense\'">\n\t\t\t\t<h4>\n\t\t\t\t\t<span *ngIf="benefit.benefitType === \'part\'">Item to Add</span>\n\t\t\t\t\t<span *ngIf="benefit.benefitType === \'expense\'">Expense Type</span>\n\t\t\t\t</h4>\n\t\t\t\t<c4-typeahead test-id="c4-typeahead-product-skus" name="sku" [input]="benefit.benefitValue" placeholder=""\n\t\t\t\t\t\t\t  *ngIf="benefit.benefitType === \'part\'"\n\t\t\t\t\t\t\t  field="sku" (inputChanged)="benefit.benefitValue = $event" [getItems]="cmsProductService.searchProducts"\n\t\t\t\t\t\t\t  (selected)="selectProduct($event)"\n\t\t\t\t\t\t\t  (inputMatchesList)="valueMatchesList = $event">\n\t\t\t\t</c4-typeahead>\n\t\t\t\t<div class="alert alert-warning"\n\t\t\t\t\t *ngIf="benefit.benefitValue && benefit.benefitType === \'part\' && !valueMatchesList">Invalid Value </div>\n\t\t\t\t<select test-id="selectedBenefitValue" name="benValue" [(ngModel)]="benefit.benefitValue" *ngIf="benefit.benefitType === \'expense\'"\n\t\t\t\t\t\trequired>\n\t\t\t\t\t<option value="discount">Discount</option>\n\t\t\t\t\t<option value="shipping">Shipping</option>\n\t\t\t\t\t<option value="paymentmethod">Payment Method</option>\n\t\t\t\t</select>\n\t\t\t</div>\n\t\t\t<div class="half-padding-top"\n\t\t\t\t *ngIf="benefit.benefitType === \'part\' || benefit.benefitType === \'allconditions\' || benefit.benefitType === \'expense\'">\n\t\t\t\t<h4>\n\t\t\t\t\t<span *ngIf="benefit.benefitType === \'part\'">Quantity</span>\n\t\t\t\t\t<span *ngIf="benefit.benefitType === \'allconditions\'">Discount Item(s)</span>\n\t\t\t\t\t<span *ngIf="benefit.benefitValue === \'shipping\'">Shipping Rate</span>\n\t\t\t\t\t<span *ngIf="benefit.benefitValue === \'paymentmethod\'">Payment Option</span>\n\t\t\t\t</h4>\n\t\t\t\t<input test-id="benefitQuantity" type="number" name="quantity" [(ngModel)]="benefit.quantity" *ngIf="benefit.benefitType === \'part\'"\n\t\t\t\t\t   required />\n\t\t\t\t<select test-id="selectedCalcType" name="calcType" [(ngModel)]="benefit.calcType" *ngIf="benefit.benefitType === \'allconditions\'" required>\n\t\t\t\t\t<option value="lowcost">Least Expensive Part</option>\n\t\t\t\t\t<option value="lineitem">Each Qualified Item</option>\n\t\t\t\t</select>\n\t\t\t\t<select test-id="benefitValue2" name="benefitValue2" [(ngModel)]="benefit.benefitValue2" *ngIf="benefit.benefitValue === \'shipping\'"\n\t\t\t\t\t\trequired></select>\n\t\t\t\t<select test-id="selectedBenefitValue2" name="benefitValue2" [(ngModel)]="benefit.benefitValue2"\n\t\t\t\t\t\t*ngIf="benefit.benefitValue === \'paymentmethod\'"\n\t\t\t\t\t\trequired>\n\t\t\t\t\t<option value="6">On Account</option>\n\t\t\t\t</select>\n\t\t\t</div>\n\t\t\t<h4 class="half-padding-top">Price Type</h4>\n\t\t\t<select test-id="selectedPriceType" name="priceType" [(ngModel)]="benefit.priceType" required>\n\t\t\t\t<option value="subtract">Subtract</option>\n\t\t\t\t<option value="factor">Discount Percentage</option>\n\t\t\t</select>\n\t\t\t<h4 class="half-padding-top">\n\t\t\t\t<span *ngIf="benefit.priceType === \'subtract\'">Subtract from Price</span>\n\t\t\t\t<span *ngIf="benefit.priceType === \'factor\'">Discount by Percent</span>\n\t\t\t</h4>\n\t\t\t<input test-id="benefitIncrement" name="increment" type="number" [(ngModel)]="benefit.increment" *ngIf="benefit.priceType === \'subtract\'"\n\t\t\t\t   required />\n\t\t\t<input test-id="benefitFactor" name="factor" type="number" min="-1" max="100" [(ngModel)]="benefit.factor"\n\t\t\t\t   *ngIf="benefit.priceType === \'factor\'"\n\t\t\t\t   required />\n\t\t\t<div class="modal-footer">\n\t\t\t\t<button test-id="cancelPromotionBenefitEditClick" class="white" title="Cancel" (click)="cancelEditBenefit()">Cancel</button>\n\t\t\t\t<button test-id="removePromotionBenefitClick" style="