anCustomizeMount" [(mount)]="mount">\n\t\t\t\t</c4-product-customization-mount>\n\t\t\t\t<c4-product-customization-addon *ngIf="customGrill.addOnItem" [addon]="customGrill.addOnItem.sku">\n\t\t\t\t</c4-product-customization-addon>\n\t\t\t</div>\n\t\t\t<c4-product-customization-variant *ngIf="customOptions.customVariantOptions?.length"\n\t\t\t\t\t\t\t\t\t\t\t  [options]="customOptions.customVariantOptions" [(customizedSku)]="customizedSku">\n\t\t\t</c4-product-customization-variant>\n\t\t</div>\n\t</div>\n\t<div *ngIf="canPurchase || canViewPricing" class="padding">\n\t\t<c4-stock-status [product]="product" (showWarehousesChange)="showWarehouses = $event"></c4-stock-status>\n\t\t\x3c!-- pricing --\x3e\n\t\t<mat-expansion-panel [expanded]="!showWarehouses">\n\t\t\t<div *ngIf="!(isMsrp$ | async)" class="table table-sm half-margin-bottom">\n\t\t\t\t<div class="body">\n\t\t\t\t\t<div class="row" *ngIf="canViewMsrpPricing">\n\t\t\t\t\t\t<div class="col-7 small">MSRP</div>\n\t\t\t\t\t\t<div class="col-5 text-right small" test-id="msrp" *ngIf="product.msrp">{{product.msrp | currency: (currency$ |\tasync)}}</div>\n\t\t\t\t\t\t<div class="col-5 text-right small" *ngIf="!product.msrp">Unavailable</div>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t<div class="col-7 small">Dealer Price</div>\n\t\t\t\t\t\t<div class="col-5 text-right small" test-id="dealerPrice">{{product.dealerPrice | currency:(currency$ | async)}}</div>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="row" *ngIf="product.snapPrice && product.snapPrice < product.dealerPrice">\n\t\t\t\t\t\t<div class="col-7 bold truncate">\n\t\t\t\t\t\t\t<span> Snap One Rewards Discount <i class="fal fa-tag text-success"></i>\n\t\t\t\t\t\t\t</span>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class="col-5 text-right bold text-success" test-id="snapRewardDiscount">\n\t\t\t\t\t\t\t{{(product.snapPrice - product.dealerPrice) | currency:(currency$ | async)}}</div>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="row" *ngIf="product.productDiscount">\n\t\t\t\t\t\t<div class="col-7 bold">\n\t\t\t\t\t\t\t<span>Discount <i class="fal fa-tag text-success"></i>\n\t\t\t\t\t\t\t\t<c4-tooltip class="discount" test-id="discountName"> {{product.productDiscountName}} </c4-tooltip>\n\t\t\t\t\t\t\t</span>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class="col-5 text-right bold text-success" test-id="discount"> {{product.productDiscount | currency:(currency$ | async)}}</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t</mat-expansion-panel>\n\t\t\x3c!-- end pricing --\x3e\n\t\t<div class="row">\n\t\t\t<div class="col-4" *ngIf="canPurchase">\n\t\t\t\t<input test-id="quantity" type="number" name="qty" placeholder="QTY" value="1" min="1" [(ngModel)]="quantity"\n\t\t\t\t\t   [disabled]="product.dealerPrice === 0 || product.displayOnly || disableChanges">\n\t\t\t</div>\n\t\t\t<div class="col-8 align-self-center text-right">\n\t\t\t\t<div *ngIf="canViewPricing && isMsrp$ | async">\n\t\t\t\t\t<h2 class="no-margin" *ngIf="product.msrp">\n\t\t\t\t\t\t<strong>{{product.msrp | currency: (currency$ | async)}}</strong>\n\t\t\t\t\t\t<small class="block">MSRP</small>\n\t\t\t\t\t</h2>\n\t\t\t\t\t<h2 class="no-margin" style="text-transform: none" *ngIf="!product.msrp">\n\t\t\t\t\t\t<span style="font-size: 15px">Price unavailable</span>\n\t\t\t\t\t</h2>\n\t\t\t\t</div>\n\t\t\t\t<div *ngIf="canViewPricing && !(isMsrp$ | async)">\n\t\t\t\t\t<h2 class="bold no-margin" test-id="priceWithDiscount"> {{product.displayPrice + product.productDiscount | currency:(currency$ | async)}}\n\t\t\t\t\t</h2>\n\t\t\t\t\t<small *ngIf="canViewMsrpPricing && product.msrp && isShowEstimatedProfit()" class="block margin-bottom-xs" test-id="estimatedProfit">\n\t\t\t\t\t\t<no-br>Estimated Profit</no-br> {{product.msrp - ((product.displayPrice) + product.productDiscount) | currency:(currency$ | async)}}\n\t\t\t\t\t</small>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t</div>\n\t\t<c4-product-customization-agreements [width]="customWidth" [finish]="customFinish" [grill]="customGrill">\n\t\t</c4-product-customization-agreements>\n\t\t<div *ngIf="canPurchase">\n\t\t\t<p class="customizations-test hidden" [hidden]="enableAddToCart()">\n\t\t\t\t<small> *Must complete required fields before adding <no-br>to cart.</no-br>\n\t\t\t\t</small>\n\t\t\t</p>\n\t\t\t<c4-product-add-to-cart classes="block no-margin" [onClick]="addToCart" [skus]="product.sku"\n\t\t\t\t\t\t\t\t\t[disabled]="!enableAddToCart()" actionSource="ProductDetails" [editedCartItem]="editedCartItem">\n\t\t\t</c4-product-add-to-cart>\n\t\t\t<div class="half-margin-top" *ngIf="product.hasPromo && !(isMsrp$ | async)">\n\t\t\t\t<c4-loading *ngIf="!promos" size="x-small"></c4-loading>\n\t\t\t\t<div *ngFor="let promo of promos; let i = index;" class="half-padding-top">\n\t\t\t\t\t<i class="fal fa-tag text-success"></i>\n\t\t\t\t\t<span *ngFor="let header of promo.headerList">{{header.headerText}}</span>\n\t\t\t\t\t<p><small [innerHTML]="promo.summary | safeHtml"></small></p>\n\t\t\t\t\t<a routerLink="/promotions" [queryParams]="{sku: customizedSku}" class="c4btn grey no-margin"\n\t\t\t\t\t   target="_blank">Learn More</a>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t\t<div class="half-margin-top" *ngIf="(productDiscountBenefits | isVolumeDiscount) && !(isMsrp$ | async)">\n\t\t\t\t<p><i class="far fa-cubes text-primary" style="margin-left: 0;"></i>Volume Pricing</p>\n\t\t\t\t<div class="row no-margin" *ngFor="let benefit of productDiscountBenefits; let i = index;">\n\t\t\t\t\t<div class="col-4"><small>Qty&nbsp;</small>{{discountTierQtyRange(benefit, i)}}</div>\n\t\t\t\t\t<div class="col-8">\n\t\t\t\t\t\t<strong [class.text-primary]="benefit.discountAmount !== 0">{{discountTierEffectivePrice(benefit) |\n\t\t\t\t\t\t\tcurrency:(currency$ | async)}}</strong>\n\t\t\t\t\t\t<small\n\t\t\t\t\t\t\t   *ngIf="benefit.discountAmount !== 0 && benefit.discountType === \'percentage\'">&nbsp;{{discountTierPercentage(benefit)}}%\n\t\t\t\t\t\t\tOff</small>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div cla