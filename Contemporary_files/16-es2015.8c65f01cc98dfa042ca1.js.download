 trackLabel="Order/Customize" trackCategory="Products"\n\t\t\t\t\t\t\t\t\t   class="c4btn block grey"> Customize </a>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<small class="half-padding-left">*Alters product card\'s "add to cart" button</small>\n\t\t\t\t\t\t</li>\n\t\t\t\t\t</ul>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t\t<div class="col-sm-4">\n\t\t\t\t<div>\n\t\t\t\t\t<div class="block row text-center" style="margin: auto;">\n\t\t\t\t\t\t<div><strong>Current Customized Sku: </strong> {{customizedSku}}</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class="demo-box">\n\t\t\t\t\t<h2 class="text-center">Demo</h2>\n\t\t\t\t\t<c4-add-to-cart-widget *ngIf="product" class="widget" [customOptions]="customOptions"\n\t\t\t\t\t\t\t\t\t\t   [product]="product" [isCustomizing]="true" [(customizedSku)]="customizedSku">\n\t\t\t\t\t</c4-add-to-cart-widget>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t</div>\n\t</div>\n</c4-widget>'},i5ox:function(t,e){t.exports=""},kky9:function(t,e){t.exports='<div name="ranges" *ngIf="measurementType">\n\t<p style="margin: 5px;">{{measurementType}} Ranges</p>\n\t<ul class="tree">\n\t\t<li class="no-margin" *ngFor="let lengthOption of lengthOptions | orderBy: [\'max\']; let i = index;">\n\t\t\t<div class="row no-margin">\n\t\t\t\t<div class="col-sm-1"><input attr.test-id="minLength-{{i}}" matInput placeholder="min" class="small-input" type="number"\n\t\t\t\t\t\t   [(ngModel)]="lengthOption.min" min="0" name="min{{lengthOption.displayValue}}"\n\t\t\t\t\t\t   [step]="step" (focusout)="rangeAltered(lengthOption)">\n\t\t\t\t</div>\n\t\t\t\t<div class="col-sm-1"><input attr.test-id="maxLength-{{i}}" matInput placeholder="max" class="small-input" type="number"\n\t\t\t\t\t\t   [(ngModel)]="lengthOption.max" [min]="lengthOption.min"\n\t\t\t\t\t\t   name="max{{lengthOption.displayValue}}" [step]="step" (focusout)="rangeAltered(lengthOption)">\n\t\t\t\t</div>\n\t\t\t\t<div class="col-sm-3"><input attr.test-id="lengthSku-{{i}}" matInput placeholder="Length Sku" class="small-input" type="text"\n\t\t\t\t\t\t   [(ngModel)]="lengthOption.finalPartNumber" name="sku{{lengthOption.displayValue}}" (focusout)="rangeAltered(lengthOption)">\n\t\t\t\t</div>\n\t\t\t\t<div class="col-sm-3" *ngIf="veneerSelected"><input attr.test-id="lengthPlusVeneerSku-{{i}}" matInput placeholder="Length+Veneer Sku"\n\t\t\t\t\t\t   class="small-input" type="text"\n\t\t\t\t\t\t   [(ngModel)]="lengthOption.veneerSku" name="veneerSku{{lengthOption.displayValue}}" (focusout)="generateNewVeneers()">\n\t\t\t\t</div>\n\t\t\t\t<div class="col-sm-1" (click)="removeRange(i)"><button attr.test-id="removeLengthRangeClick-{{i}}"\n\t\t\t\t\t\t\tclass="c4btn transparent small-button"><i\n\t\t\t\t\t\t   class="fal fa-trash"></i></button></div>\n\t\t\t</div>\n\t\t</li>\n\t\t<li class="col-sm-1 no-margin" style="padding: 0">\n\t\t\t<button test-id="toggleNewRangeClick" class="dark-grey small-button" *ngIf="!newRange" (click)="newRange = !newRange;"><i\n\t\t\t\t   class="fal fa-plus"></i></button>\n\t\t</li>\n\t\t<li *ngIf="newRange" class="row no-margin">\n\t\t\t<div class="col-sm-1"><input test-id="newMinLength" matInput placeholder="min" class="small-input" type="number"\n\t\t\t\t\t   [(ngModel)]="newLengthOption.min" name="newMin" min="0" [step]="step"></div>\n\t\t\t<div class="col-sm-1"><input test-id="newMaxLength" matInput placeholder="max" class="small-input" [min]="newLengthOption.min"\n\t\t\t\t\t   type="number" [(ngModel)]="newLengthOption.max" name="newMax" [step]="step"></div>\n\t\t\t<div class="col-sm-3"><input test-id="newLengthSku" matInput placeholder="Length Sku" class="small-input" type="text"\n\t\t\t\t\t   [(ngModel)]="newLengthOption.finalPartNumber" name="newSku"></div>\n\t\t\t<div class="col-sm-3" *ngIf="veneerSelected"><input test-id="newLengthPlusVeneerSku" matInput placeholder="Length+Veneer Sku"\n\t\t\t\t\t   class="small-input" type="text"\n\t\t\t\t\t   [(ngModel)]="newLengthOption.veneerSku" name="newVeneerSku">\n\t\t\t</div>\n\t\t\t<div class="col-sm-1" (click)="clearNewRange()"><button test-id="clearNewRangeClick" class="c4btn transparent small-button"><i\n\t\t\t\t\t   class="fal fa-times"></i></button></div>\n\t\t\t<button test-id="addNewLengthRangeClick" [disabled]="newLengthOption.min == null || newLengthOption.max == null" (click)="addLengthRange()"\n\t\t\t\t\tclass="c4btn small-button col-sm-1"><i class="fal fa-check"></i></button>\n\t\t</li>\n\t</ul>\n</div>'},mb3c:function(t,e){t.exports='<c4-widget header="Firmware" [buttons]="firmwareButtons" [expand]="true" [expandable]="true">\n\t<div class="half-padding-top">\n\t\t<h4>Release Notes</h4>\n\t\t<c4-ckeditor test-id="productReleaseNotesEditor" [keyEventId]="keyEventId" [(ngModel)]="product.releaseNotes"\n\t\t\t\t\t (ngModelChange)="releaseNotesUpdated.emit(product.releaseNotes)"></c4-ckeditor>\n\t</div>\n\t<div class="half-padding-top">\n\t\t<h4>Firmware & Product File Downloads</h4>\n\t\t<c4-file-upload folder="firmware" maxFiles="5" (complete)="saveFirmware($event)" classes="grey">\n\t\t</c4-file-upload>\n\t\t<ul class="no-margin">\n\t\t\t<li class="clearfix" *ngFor="let item of firmware; index as i">\n\t\t\t\t<div *ngIf="firmware?.length">\n\t\t\t\t\t<a [href]="item | cloudinaryUrl" style="line-height: 50px">{{item.name}}</a>\n\t\t\t\t\t<div class="pull-right">\n\t\t\t\t\t\t<a attr.test-id="removeFirmwareClick-{{i}}" class="c4btn " (click)="deleteFirmware(item.id)">Remove</a>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</li>\n\t\t</ul>\n\t</div>\n</c4-widget>'},n0ih:function(t,e){t.exports=""},qCVI:function(t,e){t.exports="#scrollToTop {\n  position: fixed;\n  bottom: 12.5px;\n  right: 12.5px;\n  z-index: 999;\n}\n\n#scrollToTop.c4btn.light-grey:hover {\n  opacity: 1 !important;\n}"},s6Bs:function(t,e){t.exports=""},wX0i:function(t,e){t.exports='<c4-widget header="Description" [buttons]="descriptionButtons" [expand]="true" [expandable]="true">\n\t<c4-ckeditor test-id="productDescriptionEditor" [keyEventId]="keyEventId" [(ngModel)]="product.description">\n\t</c4-ckeditor>\n</c4-widget>'},"x1A/":function(t,e){t.exports=""},yj6u:function(t,e){t.exports='<div cdkDropListGroup class="row">\n\t<ng-container *ngIf="media">\n\t\t<div [class]="columnSize" cdkDropList (cdkDropListDropped)="drop($event)" [cdkDropListData]="i"\n\t\t\t *ngFor="let m of media; let i = index;">\n\t\t\t<span cdkDrag>\n\t\t\t\t<div [class]="cardClass">\n\t\t\t\t\t<a attr.test-id="removeMediaClick-{{i}}" class="c4close" (click)="remove.emit(m.id)" title="Remove"></a>\n\t\t\t\t\t<div class="padding white">\n\t\t\t\t\t\t<c4-cloudinary attr.test-id="c4-cloudinary-{{i}}" ngClass="img" [transformations]="transformations" [media]="m"></c4-cloudinary>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</span>\n\t\t</div>\n\t</ng-container>\n</div>'}}]);