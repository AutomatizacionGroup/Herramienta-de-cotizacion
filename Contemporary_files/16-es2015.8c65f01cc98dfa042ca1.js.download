(window.webpackJsonp=window.webpackJsonp||[]).push([[16],{"0oke":function(t,e){t.exports='<c4-widget header="Support" [expandable]="true" [expand]="false">\n\t<div buttons>\n\t\t<button test-id="saveSupportClick" class="light-grey" (click)="updateSupport()">Save</button>\n\t</div>\n\t<h3 class="no-margin">Select Portal</h3>\n\t<small class="half-padding-bottom">*Choose the portal you wish to edit</small>\n\t<c4-enum-radio-button test-id="selectedPortalRadioClicks" [labelMap]="portalEnum" [(value)]="selectedPortal" [hasSelectAll]="true">\n\t</c4-enum-radio-button>\n\t<div>\n\t\t<h3>Technical Support Information</h3>\n\t\t<c4-ckeditor test-id="techSupportInfoEditor" [keyEventId]="keyEventId" [(ngModel)]="support.techSupportInfo"></c4-ckeditor>\n\t\t<h3 class="half-padding-top">Warranty Information</h3>\n\t\t<c4-ckeditor test-id="warrantyInfoEditor" [keyEventId]="keyEventId" [(ngModel)]="support.warrantyInfo"></c4-ckeditor>\n\t\t<h3 class="half-padding-top">RMA Information</h3>\n\t\t<c4-ckeditor test-id="rmaInfoEditor" [keyEventId]="keyEventId" [(ngModel)]="support.rmaInfo"></c4-ckeditor>\n\t</div>\n</c4-widget>'},"3xUw":function(t,e){t.exports='<c4-widget header="Features" [expand]="true" [buttons]="featuresButtons" [expandable]="true">\n\t<c4-ckeditor test-id="productMarketingDescriptionEditor" [keyEventId]="keyEventId" [(ngModel)]="marketingDescription.features">\n\t</c4-ckeditor>\n</c4-widget>'},"6YLj":function(t,e){t.exports='<div class="padding">\n\t<h1>Product Management</h1>\n\t<form class="dark" (ngSubmit)="search()">\n\t\t<div class="row no-margin">\n\t\t\t<div class="col-sm-8 col-6">\n\t\t\t\t<c4-typeahead test-id="c4-typeahead-product-results" classs="block" [(input)]="sku" placeholder="Product" field="sku" [focus]="true"\n\t\t\t\t\t\t\t  [getItems]="getTypeaheadResults" (selected)="redirect($event)" [autoActiveFirstOption]="false">\n\t\t\t\t</c4-typeahead>\n\t\t\t</div>\n\t\t\t<div class="col-sm-3 col-6">\n\t\t\t\t<c4-category-select [categories]="categories" (searchingCategory)="searchingCategory = $event"\n\t\t\t\t\t\t\t\t\t(categoriesChange)="categoriesChange($event)" (select)="searchCategory = null">\n\t\t\t\t</c4-category-select>\n\t\t\t</div>\n\t\t\t<div class="col-sm-1 col-6">\n\t\t\t\t<button test-id="searchProductClick" type="submit" class="block grey" [disabled]="searching"><i class="fal fa-search"></i></button>\n\t\t\t</div>\n\t\t</div>\n\t</form>\n\t<div class="widget" *ngIf="!editing && (searching || searched) && !selectedProduct">\n\t\t<h3 class="widget-header-grey">Results</h3>\n\t\t<div class="padding">\n\t\t\t<h4 *ngIf="searching">Searching...</h4>\n\t\t\t<h4 *ngIf="products.length === 0 && searched">No results found.</h4>\n\t\t\t<div *ngIf="categories.length > 0">\n\t\t\t\t<c4-category-tags [(categories)]="categories" (categoriesChange)="categoriesChange($event)"\n\t\t\t\t\t\t\t\t  [removable]="true"></c4-category-tags>\n\t\t\t</div>\n\t\t\t<div class="table table-hover" *ngIf="products.length > 0">\n\t\t\t\t<div class="head d-none d-sm-block">\n\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t<div class="col-md-4 col-sm-4">Product</div>\n\t\t\t\t\t\t<div class="col-md-5 col-sm-3">Categories</div>\n\t\t\t\t\t\t<div class="col-sm-1 text-center">Active</div>\n\t\t\t\t\t\t<div class="col-md-1 col-sm-2"></div>\n\t\t\t\t\t\t<div class="col-md-1 col-sm-2"></div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class="body" *ngIf="!searching">\n\t\t\t\t\t<div class="row repeated-item" *ngFor="let product of products; index as i">\n\t\t\t\t\t\t<div class="col-md-4 col-sm-4">\n\t\t\t\t\t\t\t<b>{{product.name}}</b><br />\n\t\t\t\t\t\t\t<small>{{product.sku}}</small>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class="col-md-5 col-sm-3">\n\t\t\t\t\t\t\t<span [title]="flattenCategories(product.categories)" [innerHTML]="flattenCategories(product.categories) | safeHtml"></span>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class="col-sm-1 text-center">\n\t\t\t\t\t\t\t<i class="fal" [ngClass]="{\'fa-check\':product.isAvailable}" style="line-height: 50px;"></i>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class="col-md-1 col-sm-2 col-6">\n\t\t\t\t\t\t\t<a [href]="getUrl(product)" target="_blank"\n\t\t\t\t\t\t\t   class="c4btn block transparent no-margin" style="width: 100%"\n\t\t\t\t\t\t\t   title="preview"><i class="fal fa-external-link"></i></a>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class="col-md-1 col-sm-2 col-6">\n\t\t\t\t\t\t\t<button class="c4btn light-grey text-dark block no-margin"\n\t\t\t\t\t\t\t\t\t(click)="selectedProduct = product;" title="edit"><i\n\t\t\t\t\t\t\t\t   class="fal fa-pen-alt"></i></button>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t</div>\n\t</div>\n\t<c4-cms-product-edit class="block" *ngIf="selectedProduct" [sku]="selectedProduct.sku" (display)="clearEdit()">\n\t</c4-cms-product-edit>\n</div>'},"G+gn":function(t,e){t.exports=":host {\n  display: block;\n  width: 100%;\n}\n\n.cdk-drag-preview {\n  box-sizing: border-box;\n  opacity: 0.5;\n}\n\n.cdk-drag-animating {\n  -webkit-transition: unset;\n  transition: unset;\n}\n\n.cdk-drop-dragging .cdk-drag {\n  -webkit-transition: unset;\n  transition: unset;\n}\n\n.cdk-drag-placeholder {\n  display: none;\n}"},Ifxo:function(t,e){t.exports=""},Igxw:function(t,e){t.exports='<div class="widget">\n\t<div class="padding">\n\t\t<form>\n\t\t\t<div class="row">\n\t\t\t\t<div class="col-sm-8">\n\t\t\t\t\t<h4>Name</h4>\n\t\t\t\t\t<mat-form-field>\n\t\t\t\t\t\t<input test-id="productName" matInput placeholder="Name" type="text" name="name" [(ngModel)]="product.name" />\n\t\t\t\t\t</mat-form-field>\n\t\t\t\t</div>\n\t\t\t\t<div class="col-sm-4">\n\t\t\t\t\t<h4>Sort Code</h4>\n\t\t\t\t\t<input test-id="sortCode" type="number" name="sortCode" [(ngModel)]="product.marketingDescription.sortCode" />\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t\t<h4>Display Name</h4>\n\t\t\t<mat-form-field>\n\t\t\t\t<input test-id="prettyPartName" matInput type="text" placeholder="Display Name" name="prettyPartName"\n\t\t\t\t\t\t\t [(ngModel)]="product.prettyPartName" />\n\t\t\t</mat-form-field>\n\t\t\t<h4 id="search-terms" style="margin-top: 12px;">Search Terms</h4>\n\t\t\t<mat-form-field>\n\t\t\t\t<input test-id="searchTerms" matInput type="text" placeholder="Search Terms" name="searchTerms"\n\t\t\t\t\t\t\t [(ngModel)]="product.searchTerms" />\n\t\t\t</mat-form-field>\n\t\t\t<div class="row half-padding-bottom">\n\t\t\t\t<div class="col-sm-6 col-md-3">\n\t\t\t\t\t<h4>Visibility</h4>\n\t\t\t\t\t<label><input test-id="isAvailableCheckbox" type="checkbox" name="isAvailable" [(ngModel)]="product.isAvailable">Visible <small>active</small></label>\n\t\t\t\t\t<label><input test-id="displayOnlyCheckbox" type="checkbox" name="displayOnly" [(ngModel)]="stockStatus.isDisplayOnly"\n\t\t\t\t\t\t\t\t\t (ngModelChange)="stockingOptionChanged()">Unavailable for purchase <small>display only</small></label>\n\t\t\t\t\t<label><input test-id="requiesSnapRewardsCheckbox" type="checkbox" name="requiresSnapRewards" [(ngModel)]="product.requiresSnapRewards">Requires Snap\n\t\t\t\t\t\tRewards <small>otherwise unavailable</small></label>\n\t\t\t\t</div>\n\t\t\t\t<div class="col-sm-6 col-md-3">\n\t\t\t\t\t<h4>Portals</h4>\n\t\t\t\t\t<c4-enum-checkbox test-id="visibleInPortalsCheckboxes" [labelMap]="portalEnum" [(value)]="product.visibleInPortals">\n\t\t\t\t\t</c4-enum-checkbox>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t\t<div class="row" *ngIf="stockStatus">\n\t\t\t\t<div class="col-sm-6 col-md-3">\n\t\t\t\t\t<h4>Stocking</h4>\n\t\t\t\t\t<small *ngIf="stockStatus.isBuiltToOrder">Customized items must be built to order</small>\n\t\t\t\t\t<label><input test-id="stockOptionNoneRadio" type="radio" name="StockOptionNone"\n\t\t\t\t\t\t\t\t\t [(ngModel)]="selectedStockingOption" [value]="stockingOptions.None"\n\t\t\t\t\t\t\t\t\t (ngModelChange)="stockingOptionChanged()"><span>None</span></label>\n\t\t\t\t\t<label><input test-id="isWarehousedRadio" type="radio" name="stockOptionWarehoused"\n\t\t\t\t\t\t\t\t\t [(ngModel)]="selectedStockingOption" [value]="stockingOptions.Warehoused"\n\t\t\t\t\t\t\t\t\t (ngModelChange)="stockingOptionChanged()"><span>Warehoused <small>inventory tracked automatically</small></span></label>\n\t\t\t\t\t<label><input test-id="isBuiltToOrderRadio" type="radio"\n\t\t\t\t\t\t\t\t\t name="stockOptionBuiltToOrder"\n\t\t\t\t\t\t\t\t\t [(ngModel)]="selectedStockingOption" [value]="stockingOptions.BuiltToOrder"\n\t\t\t\t\t\t\t\t\t (ngModelChange)="stockingOptionChanged()"><span>Built to order </span></label>\n\t\t\t\t\t<label><input test-id="isPartnerRadio" type="radio" name="stockOptionPartner"\n\t\t\t\t\t\t\t\t\t [(ngModel)]="selectedStockingOption" [value]="stockingOptions.FulfilledByPartner"\n\t\t\t\t\t\t\t\t\t (ngModelChange)="stockingOptionChanged()"><span>Fulfilled by partner</span></label>\n\t\t\t\t\t<div class="half-padding-left" *ngIf="stockStatus.isPartner || stockStatus.isBuiltToOrder">\n\t\t\t\t\t\t<textarea test-id="hasShippingEstimateDescriptionRadio" placeholder="Shipping estimate*" name="shippingEstimateDescription"\n\t\t\t\t\t\t\t\t\t\t\t[(ngModel)]="stockStatus.shippingEstimateDescription"\n\t\t\t\t\t\t\t\t\t\t\t(ngModelChange)="updateStockStatus()"></textarea>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class="col-sm-6 col-md-3">\n\t\t\t\t\t<h4>Shipping Message Override</h4>\n\t\t\t\t\t<c4-enum-radio-button test-id="overrideOptionRadioClicks" name="overrideOptions" [labelMap]="overrideOptionsEnum"\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t[(value)]="selectedOverrideOption" (valueChange)="overrideOptionChanged()">\n\t\t\t\t\t</c4-enum-radio-button>\n\t\t\t\t</div>\n\t\t\t\t<div class="col-sm-6 col-md-3 half-padding-top">\n\t\t\t\t\t<div *ngIf="!stockStatus.isDisplayOnly && (stockStatus.showBackorderOverride || showCustomMessage)">\n\t\t\t\t\t\t<c4-date-time [(value)]="stockStatus.overrideEndDate" (valueChange)="updateCustomOverrideDate($event)"\n\t\t\t\t\t\t\t\t\t\t\t\t\tplaceholder="Override message end date"></c4-date-time>\n\t\t\t\t\t\t<div *ngIf="showCustomMessage">\n\t\t\t\t\t\t\t<textarea test-id="shippingEstimateDescriptionOverride" placeholder="Optional shipping estimate"\n\t\t\t\t\t\t\t\t\t\t\t\tname="shippingEstimateDescOverride"\n\t\t\t\t\t\t\t\t\t\t\t\t[(ngModel)]="stockStatus.shippingEstimateDescOverride"\n\t\t\t\t\t\t\t\t\t\t\t\t(ngModelChange)="updateStockStatus()"></textarea>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class="col-sm-6 col-md-3 half-padding-top" *ngIf="stockStatus">\n\t\t\t\t\t<div class="border padding">\n\t\t\t\t\t\t<c4-stock-status [product]="stockStatus" [sku]="product.sku"></c4-stock-status>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t\t<div><small *ngIf="selectedStockingOption != stockingOptions.BuiltToOrder && hasCustomizations">*This product is not built to order but still has\n\t\t\t\t\tcustomizations assigned</small></div><br>\n\t\t\t<div>\n\t\t\t\t<h4>Categories</h4>\n\t\t\t\t<div class="row">\n\t\t\t\t\t<div class="col-sm-6">\n\t\t\t\t\t\t<c4-category-select class="block" [categories]="categories" (categoriesChange)="categoriesChange.emit($event)"></c4-category-select>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="col-sm-6">\n\t\t\t\t\t\t<c4-category-tags class="block" [categories]="categories" (categoriesChange)="categoriesChange.emit($event)" [removable]="true"\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t[setPrimary]="true">\n\t\t\t\t\t\t</c4-category-tags>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t\t<div>\n\t\t\t\t<h4>Filters</h4>\n\t\t\t\t<div class="row">\n\t\t\t\t\t<div class="col-sm-6">\n\t\t\t\t\t\t<c4-filter-select class="block" (selected)="addFilter($event)"></c4-filter-select>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="col-sm-6">\n\t\t\t\t\t\t<c4-filter-tags class="block" [filters]="filters" (remove)="removeFilter($event)"\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t[removable]="true">\n\t\t\t\t\t\t</c4-filter-tags>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t</form>\n\t\t<div class="row no-margin">\n\t\t\t<div class="col-sm-2 offset-sm-8">\n\t\t\t\t<button test-id="cancelProductEditClick" class="c4btn transparent block" (click)="close.emit()"><i\n\t\t\t\t\t\t class="fal fa-times"></i>Cancel</button>\n\t\t\t</div>\n\t\t\t<div test-id="saveProductEditClick" class="col-sm-2">\n\t\t\t\t<button test-id="saveProductClick" class="c4btn block" (click)="save.emit()"><i class="fal fa-check"></i>Save</button>\n\t\t\t</div>\n\t\t</div>\n\t</div>\n</div>'},Ji7P:function(t,e){t.exports='<ng-container *ngIf="product && productView">\n\t<div class="widget" style="position: sticky; top: 0px; z-index: 9999; margin-bottom: 0px;">\n\t\t<h3 class="widget-header-white"> Modifying <strong>{{product.sku}}</strong> ({{product.name}}) </h3>\n\t\t<div class="absolute top right text-right">\n\t\t\t<button test-id="cancelProductEditClick" class="c4btn transparent" (click)="close()"><i class="fal fa-times"></i>Cancel</button>\n\t\t\t<a href="products/{{product.categories.length > 0? product.categories[0].id : 0}}/product/{{product.sku}}"\n\t\t\t   target="_blank" class="c4btn transparent"><i class="fal fa-external-link"></i>Preview</a>\n\t\t\t<button test-id="saveProductClick" class="c4btn" (click)="save()"><i class="fal fa-check"></i>Save</button>\n\t\t</div>\n\t</div>\n\t<c4-basic-product-edit [product]="product" [(stockStatus)]="stockStatus" [hasCustomizations]="hasCustomizations" [(categories)]="categories"\n\t\t\t\t\t\t   (save)="save()" (close)="close()">\n\t</c4-basic-product-edit>\n\t<c4-customizations *ngIf="productView?.customizations" [product]="productView" (customOptionsUpdated)="updateCustomizations($event)"></c4-customizations>\n\t<c4-description-edit [product]="product"></c4-description-edit>\n\t<c4-features-edit [marketingDescription]="product.marketingDescription" [sku]="product.sku"></c4-features-edit>\n\t<c4-widget header="Images" [expand]="true" [expandable]="true">\n\t\t<c4-media-list-edit type="Image" table="PartsMaster" [sku]="product.sku" cardType="product">\n\t\t</c4-media-list-edit>\n\t</c4-widget>\n\t<c4-widget header="Specifications" [expand]="true" [expandable]="true">\n\t\t<c4-media-list-edit type="SpecSheet" table="PartsMaster" [sku]="product.sku" cardType="spec">\n\t\t</c4-media-list-edit>\n\t</c4-widget>\n\t<c4-widget header="Downloads" [expand]="true" [expandable]="true">\n\t\t<c4-cms-download-list [sku]="product.sku"></c4-cms-download-list>\n\t</c4-widget>\n\t<c4-widget header="Videos" [expandable]="true" [expand]="false">\n\t\t<c4-cms-video-list [sku]="product.sku" [videos]="product.videos" (videoChange)="product.videos = $event">\n\t\t</c4-cms-video-list>\n\t</c4-widget>\n\t<c4-support-edit [sku]="product.sku" [(supportInfo)]="product.supportInfo">\n\t</c4-support-edit>\n\t<c4-widget header="Recommended Categories" [expand]="true" [expandable]="true">\n\t\t<c4-recommended-categories-edit [sku]="product.sku"></c4-recommended-categories-edit>\n\t</c4-widget>\n\t<c4-widget header="Recommended Products" [expand]="true" [expandable]="true">\n\t\t<c4-recommended-products-edit [sku]="product.sku"></c4-recommended-products-edit>\n\t</c4-widget>\n\t<c4-widget header="Suggested Products" [expand]="true" [expandable]="true">\n\t\t<c4-suggested-products-edit [sku]="product.sku"></c4-suggested-products-edit>\n\t</c4-widget>\n\t<c4-firmware-edit [product]="product"></c4-firmware-edit>\n</ng-container>\n<c4-loading *ngIf="!product || !productView"></c4-loading>'},Jppd:function(t,e){t.exports=""},Jzaq:function(t,e){t.exports='<c4-file-upload [folder]="type" maxFiles="20" fileFormats="jpeg,jpg,png" [disabled]="submitting"\n\t(complete)="save($event)" classes="grey"></c4-file-upload>\n<div class="row no-margin">\n\t<c4-media-grid [media]="items" (remove)="remove($event)" (sort)="sortMedia($event)"\n\t\t[transformations]="getTransforms()" [columnSize]="getColumns()" cardClass="{{cardType}}-card"></c4-media-grid>\n</div>'},LyPG:function(t,e){t.exports=""},"OV+r":function(t,e){t.exports='<div class="row">\n\t<div class="col-sm-8">\n\t\t<small>Suggested products are presented to the dealer in a mod