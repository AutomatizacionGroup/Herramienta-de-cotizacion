c-promos" *ngIf="loaded">\n\t\t<c4-promotion [promo]="promo" *ngFor="let promo of promos"></c4-promotion>\n\t</div>\n\n\t<c4-static-content id="promo-home-bottom"></c4-static-content>\n</div>'},tAOg:function(t,o){t.exports='<div [id]="promo.discountCode" class="widget">\n\t<div class="padding">\n\t\t<div class="row">\n\t\t\t<div class="col-lg-9 col-md-8 col-sm-7">\n\t\t\t\t<div *ngIf="promo.title">\n\t\t\t\t\t<h2 *ngIf="!(promo.title | isHtml)" class="bold text-primary half-margin-bottom">{{promo.title}} </h2>\n\t\t\t\t\t<div *ngIf="promo.title | isHtml" [innerHTML]="promo.title | safeHtml" class="half-margin-bottom">\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<ng-container *ngIf="!promo.title">\n\t\t\t\t\t<div *ngFor="let header of promo.headerList">\n\t\t\t\t\t\t<h2 [className]="header.headerStyle">{{header.headerText}}</h2>\n\t\t\t\t\t</div>\n\t\t\t\t</ng-container>\n\t\t\t\t<div [innerHTML]="promo.summary | safeHtml" class="half-margin-bottom half-margin-top"></div>\n\t\t\t\t<ul class="no-style">\n\t\t\t\t\t<li>Promo code: <span class="bold">{{promo.discountCode}}</span></li>\n\t\t\t\t</ul>\n\t\t\t</div>\n\t\t\t<div class="col-lg-3 col-md-4 col-sm-5 text-center" *ngIf="imageUrl">\n\t\t\t\t<img [src]="imageUrl">\n\t\t\t</div>\n\t\t</div>\n\t\t<div *ngIf="promo.buttonType === buttonType.Generated && promo.products?.length">\n\t\t\t\x3c!-- Button Per Product --\x3e\n\t\t\t<div class="table" *ngIf="!promo.shouldCombineProducts">\n\t\t\t\t<div class="body">\n\t\t\t\t\t<div class="row" *ngFor="let product of promo.products; index as i">\n\t\t\t\t\t\t<div class="col-sm-3" *ngIf="product.sku && product.name">{{product.sku}}</div>\n\t\t\t\t\t\t<div class="col-sm-6" *ngIf="product.sku && product.name">{{product.name}}</div>\n\t\t\t\t\t\t<div class="col-sm-3">\n\t\t\t\t\t\t\t<c4-product-add-to-cart attr.test-id="c4-product-add-to-cart-{{i}}" [skus]="product.sku" [quantity]="product.quantity"\n\t\t\t\t\t\t\t\t\t\t\t\t\t[promo]="promo.discountCode" classes="block grey no-margin" trackCategory="Promotions"\n\t\t\t\t\t\t\t\t\t\t\t\t\tc4Track="Add To Cart" [trackLabel]="promo.discountCode"></c4-product-add-to-cart>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t\t\x3c!-- Combined Product Buttons ??? --\x3e\n\t\t\t<div *ngIf="promo.shouldCombineProducts">\n\t\t\t\t<div class="table">\n\t\t\t\t\t<div class="body">\n\t\t\t\t\t\t<div class="row" *ngFor="let product of promo.products">\n\t\t\t\t\t\t\t<div class="col-sm-3" *ngIf="product.sku && product.name">{{product.sku}}</div>\n\t\t\t\t\t\t\t<div class="col-sm-9" *ngIf="product.sku && product.name">{{product.name}}</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class="row">\n\t\t\t\t\t<div class="col-sm-3" *ngIf="!promo.category">\n\t\t\t\t\t\t<c4-product-add-to-cart [skus]="delimitedProducts" [promo]="promo.discountCode"\n\t\t\t\t\t\t\t\t\t\t\t\tclasses="block grey no-margin" actionSource="promotions-page"\n\t\t\t\t\t\t\t\t\t\t\t\t[trackLabel]="promo.discountCode"></c4-product-add-to-cart>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t</div>\n\t\t\x3c!-- Custom Set Buttons from CMS --\x3e\n\t\t<div *ngIf="promo.buttonType === buttonType.Custom">\n\t\t\t<div class="table">\n\t\t\t\t<div class="body">\n\t\t\t\t\t<div class="row" *ngFor="let product of promo.products">\n\t\t\t\t\t\t<div class="col-sm-3" *ngIf="product.sku && product.name">{{product.sku}}</div>\n\t\t\t\t\t\t<div class="col-sm-9" *ngIf="product.sku && product.name">{{product.name}}</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t\t<div class="row" *ngIf="promo.buttonType === buttonType.Custom">\n\t\t\t\t<div class="col-sm-3" *ngFor="let button of promo.customButtons">\n\t\t\t\t\t<a class="c4btn grey block" [href]="button.url">{{button.label}}</a>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t</div>\n\t\t<small class="footnote">{{promo.footnote}}</small>\n\t</div>\n</div>'}}]);