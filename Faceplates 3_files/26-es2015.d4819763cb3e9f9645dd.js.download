.length-1;o>=0;o--)(s=t[o])&&(r=(a<3?s(r):a>3?s(e,n,r):s(e,n))||r);return a>3&&r&&Object.defineProperty(e,n,r),r}([Object(s.K)({imports:[i.b,ot,u.a,h.a,d.a,a.b,l.a,p.a,g.a,c.CheckoutModule,r.c,o.a],declarations:[Q,M,J,$,tt]})],ct)},Sz2k:function(t,e){t.exports='.row.active {\n  background-color: #F0EEEE;\n}\n\n.table.table-hover .body .row {\n  cursor: pointer;\n}\n\n.border-left {\n  padding-left: 5px;\n  border-left: 1px solid rgba(0, 0, 0, 0.1);\n}\n\n.widget.widget-fixed-height.home:hover {\n  z-index: 1;\n  box-shadow: 0 0 25px 0 rgba(0, 0, 0, 0.15);\n}\n\ndiv.table .head > div.row > div[class^=col-], div.table .head > .row > div[class^=col-], .table .head > div.row > div[class^=col-], .table .head > .row > div[class^=col-] {\n  padding-top: 0;\n}\n\nbody #left .row [class^=col-], body #left .row [class*=" col-"] {\n  padding: 12px;\n  text-overflow: ellipsis;\n}\n\n#left .row.selected {\n  background-color: #E2E0E0;\n  border: none;\n}\n\n.column-resize {\n  -webkit-transition: width 400ms;\n  transition: width 400ms;\n}\n\n.table.overflow {\n  max-height: 400px;\n  overflow-y: scroll;\n}'},XqKS:function(t,e){t.exports='\x3c!-- Slider --\x3e\n<div class="background"\n\t style="height: 300px; background-image: url(\'//res.cloudinary.com/control4/image/upload/v1503422858/pcna-banner-notext.jpg\'); background-position: left center;">\n\t<div class="padding-right margin-right vertically-center">\n\t\t<div class="row">\n\t\t\t<div class="offset-sm-6 col-sm-6 d-xs-none text-right">\n\t\t\t\t<h1 class="text-white no-margin uppercase">1500+ Registered</h1>\n\t\t\t\t<h1 class="pakedge-primary bold uppercase">Are You One of Them?</h1>\n\t\t\t\t<h3 class="text-grey">Become a Pakedge Certified Network Administrator</h3>\n\t\t\t</div>\n\t\t</div>\n\t</div>\n</div>\n<div class="padding">\n\t<h1>Become a Pakedge Certified Network Administrator</h1>\n\t<div *ngIf="myPcnaInfoLoaded" class="animate-show">\n\t\t\x3c!--User not registered, no purchasing--\x3e\n\t\t<div class="alert alert-warning" style="background-color: #fff;"\n\t\t\t *ngIf="myPcnaInfo.currentStatus == 0 && !canPurchase">\n\t\t\t<h4>Register for PCNA<sup class="text-grey">&trade;</sup> Now</h4>\n\t\t\t<p>Welcome! You must have purchasing permissions to register for the PCNA certification program. Please contact your dealer portal administrator\n\t\t\t\twith purchasing rights so they can register on your behalf. Once you have been registered, come back to this page to begin the courses.</p>\n\t\t</div>\n\t\t\x3c!--User registered, training incomplete--\x3e\n\t\t<div class="alert alert-warning" style="background-color: #fff;"\n\t\t\t *ngIf="myPcnaInfo.currentStatus >= 10 && myPcnaInfo.currentStatus < 20">\n\t\t\t<h4>\n\t\t\t\t<span *ngIf="!showBakpakCodes && myPcnaInfo.currentStatus == 10 && !beganCourses">Prepare For the PCNA Courses</span>\n\t\t\t\t<span *ngIf="!showBakpakCodes && myPcnaInfo.currentStatus >= 15 && !beganCourses">Begin Courses</span>\n\t\t\t\t<span *ngIf="!showBakpakCodes && beganCourses">Continue PCNA Courses</span>\n\t\t\t\t<span *ngIf="showBakpakCodes">Congratulations!</span>\n\t\t\t</h4>\n\t\t\t<p>\n\t\t\t\t<span *ngIf="!showBakpakCodes && myPcnaInfo.currentStatus == 10 && !beganCourses">You are registered for PCNA training and your box of network\n\t\t\t\t\tequipment will ship soon. Please wait until your PCNA network equipment has arrived before starting the courses.&nbsp;</span>\n\t\t\t\t<span *ngIf="!showBakpakCodes && myPcnaInfo.currentStatus >= 15 && !beganCourses">Your PCNA kit has been shipped. Once you have received it, you\n\t\t\t\t\tcan access the course material on the Education Portal.&nbsp;</span>\n\t\t\t\t<span *ngIf="!showBakpakCodes && beganCourses">You can access the course material on the Education Portal.&nbsp;</span>\n\t\t\t\t<span *ngIf="showBakpakCodes">You have successfully completed Course 4 - Wireless Access Points of your PCNA certification. To proceed with\n\t\t\t\t\tCourse 5 - Remote Monitoring &amp; Management, you must register for a Pakedge BakPak account. Please use the unique PCNA Technician code\n\t\t\t\t\tbelow to register your account on the Pakedge BakPak website to begin Course 5 - Remote Monitoring &amp; Management.&nbsp;</span>\n\t\t\t\t<span *ngIf="myPcnaInfo.currentStatus !== 10">{{rebateMessage}}</span>\n\t\t\t</p>\n\t\t\t<ul *ngIf="myPcnaInfo.courses.length" class="no-style half-margin-bottom">\n\t\t\t\t<li *ngFor="let course of myPcnaInfo.courses; let i = index;">\n\t\t\t\t\t<a [href]="course.url" class="text-dark">\n\t\t\t\t\t\t<i *ngIf="course.completed" class="fal fa-check-circle text-success"></i>\n\t\t\t\t\t\t<i *ngIf="course.status === \'in_progress\' || (i === 0 && course.status === \'not_started\')"\n\t\t\t\t\t\t   class="fal fa-arrow-circle-right text-warning"></i>\n\t\t\t\t\t\t<i *ngIf="course.status === \'not_started\' && i > 0" class="fal fa-circle text-white"></i> {{course.name}} </a>\n\t\t\t\t</li>\n\t\t\t</ul>\n\t\t\t<a class="c4btn" [href]="learningPathUrl">{{trainingButtonText}}</a>\n\t\t</div>\n\t\t\x3c!--User registered, training complete, test not scheduled--\x3e\n\t\t<div class="alert alert-warning" style="background-color: #fff;" *ngIf="myPcnaInfo.currentStatus == 20">\n\t\t\t<h4>Schedule the PCNA Certification Exam</h4>\n\t\t\t<p>You finished the PCNA courses! Complete the certification exam to become a Professional Certified Network Administrator. {{rebateMessage}} </p>\n\t\t\t<ul *ngIf="myPcnaInfo.courses.length" class="no-style half-margin-bottom">\n\t\t\t\t<li *ngFor="let course of myPcnaInfo.courses; let i = index;">\n\t\t\t\t\t<a [href]="course.url" class="text-dark">\n\t\t\t\t\t\t<i *ngIf="course.completed" class="fal fa-check-circle text-success"></i>\n\t\t\t\t\t\t<i *ngIf="course.status === \'in_progress\' || (i === 0 && course.status === \'not_started\')"\n\t\t\t\t\t\t   class="fal fa-arrow-circle-right text-warning"></i>\n\t\t\t\t\t\t<i *ngIf="course.status === \'not_started\' && i > 0" class="fal fa-circle text-white"></i> {{course.name}} </a>\n\t\t\t\t</li>\n\t\t\t</ul>\n\t\t\t<c4-proctor-u buttonText="Schedule Exam"></c4-proctor-u>\n\t\t\t<a class="c4btn grey" [href]="learningPathUrl">Review PCNA Courses</a>\n\t\t</div>\n\t\t\x3c!--User registered, test scheduled, Exam not started--\x3e\n\t\t<div class="alert alert-warning" style="background-color: #fff;"\n\t\t\t *ngIf="(myPcnaInfo.currentStatus == 30 && (!myPcnaInfo.examPartOne || (myPcnaInfo.examPartOne && !myPcnaInfo.examPartOne.completed)))">\n\t\t\t<h4>Take the PCNA Certification Exam</h4>\n\t\t\t<p>Your exam has been scheduled. When it is time for your exam, you can access it with the button below. {{rebateMessage}} </p>\n\t\t\t<c4-proctor-u *ngIf="!myPcnaInfo.examPartOne" buttonText="Begin Proctoring"></c4-proctor-u>\n\t\t\t<a class="c4btn" href="https://control4.learnupon.com/dashboard?display=my_courses"\n\t\t\t   *ngIf="trainingButtonText">{{trainingButtonText}}</a>\n\t\t\t<a class="c4btn grey" [href]="learningPathUrl">Review PCNA Courses</a>\n\t\t</div>\n\t\t\x3c!--User registered, test scheduled, Exam Part One failed--\x3e\n\t\t<div class="alert alert-warning" style="background-color: #fff;"\n\t\t\t *ngIf="(myPcnaInfo.currentStatus == 30 && myPcnaInfo.examPartOne && myPcnaInfo.examPartOne.completed && !myPcnaInfo.examPartOne.passed)">\n\t\t\t<h4>Exam Progress</h4>\n\t\t\t<p>Sorry, you did not successfully pass Part 1 of the PCNA exam. Therefore, you cannot proceed to Part 2. Please schedule another Exam Session.\n\t\t\t\t{{rebateMessage}}</p>\n\t\t\t<c4-proctor-u buttonText="Re-schedule Exam"></c4-proctor-u>\n\t\t\t<a class="c4btn grey" [href]="learningPathUrl">Review PCNA Courses</a>\n\t\t</div>\n\t\t\x3c!--User registered, test scheduled, Exam Part One passed--\x3e\n\t\t<div class="alert alert-warning" style="background-color: #fff;"\n\t\t\t *ngIf="(myPcnaInfo.currentStatus == 30 && myPcnaInfo.examPartOne && myPcnaInfo.examPartOne.passed)">\n\t\t\t<h4>Congratulations</h4>\n\t\t\t<p>You have successfully passed Part 1 of the PCNA Exam. Begin Part 2 of the Exam. {{rebateMessage}}</p>\n\t\t\t<a class="c4btn" href="https://control4.learnupon.com/dashboard?display=my_courses">Take Exam Part 2</a>\n\t\t</div>\n\t\t\x3c!--User registered, test comlete, not graded--\x3e\n\t\t<div class="alert alert-warning" style="background-color: #fff;" *ngIf="myPcnaInfo.currentStatus == 35">\n\t\t\t<h4>Exam Complete</h4>\n\t\t\t<p>You have completed Part 1 and Part 2 of the PCNA exam. Your exam is currently being reviewed.</p>\n\t\t\t<a class="c4btn grey" [href]="learningPathUrl">Review PCNA Courses</a>\n\t\t</div>\n\t\t\x3c!--User registered, test failed--\x3e\n\t\t<div class="alert alert-warning" style="background-color: #fff;" *ngIf="myPcnaInfo.currentStatus == 40">\n\t\t\t<h4>Re-schedule PCNA Certification Exam</h4>\n\t\t\t<p>You may retake the certification exam by scheduling another exam. Please note that a retake exam may result in a small fee. {{rebateMessage}}</p>\n\t\t\t<c4-proctor-u buttonText="Re-schedule Exam"></c4-proctor-u>\n\t\t\t<a class="c4btn grey" [href]="learningPathUrl">Review PCNA Courses</a>\n\t\t</div>\n\t\t\x3c!--Certified--\x3e\n\t\t<div class="alert alert-success" *ngIf="myPcnaInfo.currentStatus == 50">\n\t\t\t<h4>Congratulations!</h4>\n\t\t\t<p>It\u2019s official. You are a Pakedge Certified Network Administrator (PCNA).</p>\n\t\t\t<a class="c4btn grey" [href]="learningPathUrl">Review PCNA Courses</a>\n\t\t</div>\n\t</div>\n\t<div class="widget padding">\n\t\t<h2>Why PCNA?</h2>\n\t\t<div class="row">\n\t\t\t<div class="col-sm-6">\n\t\t\t\t<p>PCNA arms AV professionals with the technical knowledge and hands-on experience they need to design and install solid TCP/IP networks in\n\t\t\t\t\tconnected homes. A solid network foundation ensures customer satisfaction and mitigates support issues. Your business will benefit when you\n\t\t\t\t\traise your team\'s competency in networking. </p>\n\t\t\t\t<a routerLink="/education/pcna" fragment="register" class="c4btn" *ngIf="canPurchase">Register Your Techs</a>\n\t\t\t\t<div class="d-xs-none d-sm-none d-md-none half-padding-top">\n\t\t\t\t\t<h3>Engaging Online Content<br>&amp; Hands-on Education</h3>\n\t\t\t\t\t<p>Pakedge Certified Network Administrators gain a complete understanding of networking basics, network design, and configuration making\n\t\t\t\t\t\tthem more efficient and capable. This unique course blends online coursework with practical hands-on learning using the network devices\n\t\t\t\t\t\ttechnicians install every day. The online curriculum provides the educational and technical depth while the hands-on practice ensures\n\t\t\t\t\t\tmastery and knowledge retention. </p>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t\t<div class="col-sm-6">\n\t\t\t\t<c4-wistia-thumbnail-player wistiaId="2jmm9pdvpc"\n\t\t\t\t\t\t\t\t\t\t\tthumbnail="//res.cloudinary.com/control4/image/upload/c_scale,w_750/v1503422910/pcna-overview.png"\n\t\t\t\t\t\t\t\t\t\t\t[aspect]="">\n\t\t\t\t</c4-wistia-thumbnail-player>\n\t\t\t</div>\n\t\t</div>\n\t\t<div class="row half-padding-top">\n\t\t\t<div class="col-md-10 d-lg-none">\n\t\t\t\t<h3>Engaging Online Content<br>&amp; Hands-on Education</h3>\n\t\t\t\t<p>Pakedge Certified Network Administrators gain a complete understanding of networking basics, network design, and configuration making them\n\t\t\t\t\tmore efficient and capable. This unique course blends online coursework with practical hands-on learning using the network devices\n\t\t\t\t\ttechnicians install every day. The online curriculum provides the educational and technical depth while the hands-on practice ensures\n\t\t\t\t\tmastery and knowledge retention. </p>\n\t\t\t</div>\n\t\t</div>\n\t\t\x3c!-- course table --\x3e\n\t\t<div class="row margin-top">\n\t\t\t<div class="col-sm-6 border-right half-padding-right">\n\t\t\t\t<h3>PCNA Curriculum</h3>\n\t\t\t\t<p>The six course certification program covers the following topics:</p>\n\t\t\t\t<div class="table">\n\t\t\t\t\t<div class="body">\n\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t<div class="col-3 "><img\n\t\t\t\t\t\t\t\t\t src="//res.cloudinary.com/control4/image/upload/c_scale,w_100/v1504121547/PCNA-Crse-1.jpg" />\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class="col-9">\n\t\t\t\t\t\t\t\t<h4 class="no-margin">Course 1 - Essentials (Build Your First Network)</h4>\n\t\t\t\t\t\t\t\t<p><small>Build your first network, then use it to learn\u2014hands-on\u2014through the rest of the courses, starting with \u201ca host\u2019s-eye\n\t\t\t\t\t\t\t\t\t\tview\u201d of how TCP/IP networks work.</small></p>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t<div class="col-3"><img\n\t\t\t\t\t\t\t\t\t src="//res.cloudinary.com/control4/image/upload/c_scale,w_100/v1504121547/PCNA-Crse-2.jpg" />\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class="col-9">\n\t\t\t\t\t\t\t\t<h4 class="no-margin">Course 2 - Switches</h4>\n\t\t\t\t\t\t\t\t<p><small>Switches and cables don\'t just connect devices together. They expand a network, power devices, and streamline the\n\t\t\t\t\t\t\t\t\t\tmovement of data within the network.</small></p>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t<div class="col-3"><img\n\t\t\t\t\t\t\t\t\t src="//res.cloudinary.com/control4/image/upload/c_scale,w_100/v1504121547/PCNA-Crse-3.jpg" />\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class="col-9">\n\t\t\t\t\t\t\t\t<h4 class="no-margin">Course 3 - Routers</h4>\n\t\t\t\t\t\t\t\t<p><small>Routers do more than just connect a LAN to the Internet. They keep the bad guys out, allow secure external access to\n\t\t\t\t\t\t\t\t\t\tthe people who need it, and define the LAN\u2019s IP address space.</small></p>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t<div class="col-3"><img\n\t\t\t\t\t\t\t\t\t src="//res.cloudinary.com/control4/image/upload/c_scale,w_100/v1504121547/PCNA-Crse-4.jpg" />\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class="col-9">\n\t\t\t\t\t\t\t\t<h4 class="no-margin">Course 4 - Wireless Access Points</h4>\n\t\t\t\t\t\t\t\t<p><small>Many experienced pros find Wi-Fi the most difficult part of network design. This course shows a nearly fool-proof way\n\t\t\t\t\t\t\t\t\t\tto place and install wireless access points that takes care of almost any wireless networking job.</small></p>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t<div class="col-3"><img\n\t\t\t\t\t\t\t\t\t src="//res.cloudinary.com/control4/image/upload/c_scale,w_100/v1504121547/PCNA-Crse-5.jpg" />\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class="col-9">\n\t\t\t\t\t\t\t\t<h4 class="no-margin">Course 5 - Remote Monitoring &amp; Management</h4>\n\t\t\t\t\t\t\t\t<p><small>Connect your network to BakPak, and learn how to update, manage, and troubleshoot customer networks from anywhere in\n\t\t\t\t\t\t\t\t\t\tthe world.</small></p>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t<div class="col-3"><img\n\t\t\t\t\t\t\t\t\t src="//res.cloudinary.com/control4/image/upload/c_scale,w_100/v1504121547/PCNA-Crse-6.jpg" />\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class="col-9">\n\t\t\t\t\t\t\t\t<h4 class="no-margin">Course 6 - Network Planning</h4>\n\t\t\t\t\t\t\t\t<p><small>Plan and design networks for homes and small businesses, using all the concepts learned in the previous five\n\t\t\t\t\t\t\t\t\t\tcourses.</small></p>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t\t<div class="col-sm-6 half-padding-left">\n\t\t\t\t<h3> Hands-on Education Kit</h3>\n\t\t\t\t<p>An essential element of the PCNA course, trainees are provided with networking hardware for hands-on learning. The PCNA Kit includes:</p>\n\t\t\t\t<img class="block"\n\t\t\t\t\t src="//res.cloudinary.com/control4/image/upload/c_scale,w_500/v1503699630/PCNA-Guts-FNL.jpg" />\n\t\t\t\t<div class="row half-padding-top">\n\t\t\t\t\t<div class="col-6">\n\t\t\t\t\t\t<ul style="display: inline-block;">\n\t\t\t\t\t\t\t<li>Power Distribution Unit <no-br>(P2/P2E)</no-br>\n\t\t\t\t\t\t\t</li>\n\t\t\t\t\t\t\t<li>Switch <no-br>(SX-8P)</no-br>\n\t\t\t\t\t\t\t</li>\n\t\t\t\t\t\t\t<li>Router <no-br>(RK-1)</no-br>\n\t\t\t\t\t\t\t</li>\n\t\t\t\t\t\t</ul>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="col-6">\n\t\t\t\t\t\t<ul style="display: inline-block;">\n\t\t\t\t\t\t\t<li>Wireless Access Point <no-br>(WK-1-B)</no-br>\n\t\t\t\t\t\t\t</li>\n\t\t\t\t\t\t\t<li>Additional cables</li>\n\t\t\t\t\t\t\t<li>Brand Stickers</li>\n\t\t\t\t\t\t</ul>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t</div>\n\t</div>\n\t<div class="widget padding">\n\t\t<h2>Thoroughly Trained and Tested</h2>\n\t\t<div class="half-margin-bottom">\n\t\t\t<p> Trainees certify by passing an online exam. The exam is conducted by a third-party proctoring service, who verify the trainee\u2019s identity,\n\t\t\t\ttesting environment, and equipment, and then administer the exam. </p>\n\t\t</div>\n\t\t<a routerLink="/education/about-pcna-exam" class="dark-grey c4btn">More about exam</a>\n\t</div>\n\t\x3c!-- reviews --\x3e\n\t<div class="widget padding">\n\t\t<h2>PCNA is good for business</h2>\n\t\t<div class="row half-padding-bottom">\n\t\t\t<div class="col-md-5 col-sm-6">\n\t\t\t\t<div class="wistia_responsive_padding" style="padding:56.25% 0 0 0;position:relative;">\n\t\t\t\t\t<div class="wistia_responsive_wrapper"\n\t\t\t\t\t\t style="height:100%;left:0;position:absolute;top:0;width:100%;">\n\t\t\t\t\t\t<iframe src="https://fast.wistia.net/embed/iframe/1wtu8m58wb?videoFoam=true"\n\t\t\t\t\t\t\t\ttitle="Wistia video player" allowtransparency="true" frameborder="0" scrolling="no"\n\t\t\t\t\t\t\t\tclass="wistia_embed" name="wistia_embed" allowfullscreen mozallowfullscreen\n\t\t\t\t\t\t\t\twebkitallowfullscreen oallowfullscreen msallowfullscreen width="100%"\n\t\t\t\t\t\t\t\theight="100%"></iframe>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<script src="https://fast.wistia.net/assets/external/E-v1.js" async><\/script>\n\t\t\t</div>\n\t\t\t<div class="col-md-5 col-sm-6">\n\t\t\t\t<div class="wistia_responsive_padding" style="padding:56.25% 0 0 0;position:relative;">\n\t\t\t\t\t<div class="wistia_responsive_wrapper"\n\t\t\t\t\t\t style="height:100%;left:0;position:absolute;top:0;width:100%;">\n\t\t\t\t\t\t<iframe src="https://fast.wistia.net/embed/iframe/7d5cofcscx?videoFoam=true"\n\t\t\t\t\t\t\t\ttitle="Wistia video player" allowtransparency="true" frameborder="0" scrolling="no"\n\t\t\t\t\t\t\t\tclass="wistia_embed" name="wistia_embed" allowfullscreen mozallowfullscreen\n\t\t\t\t\t\t\t\twebkitallowfullscreen oallowfullscreen msallowfullscreen width="100%"\n\t\t\t\t\t\t\t\theight="100%"></iframe>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<script src="https://fast.wistia.net/assets/external/E-v1.js" async><\/script>\n\t\t\t</div>\n\t\t</div>\n\t\t<h3>Reviews from real technicians</h3>\n\t\t<div class="row half-padding-left">\n\t\t\t<div class="col-md-5 col-sm-6 half-padding-top">\n\t\t\t\t<blockquote>"I really did learn a lot from the PCNA course. It was really great. Before moved into the CI world, I worked at DIRECTV for 16\n\t\t\t\t\tyears. I worked my way up from being a tech to field engineer. Part of my job was to support and review training. I have to say this is the\n\t\t\t\t\tbest training course I have ever been through. There are so many people that could benefit from this training." <cite><span\n\t\t\t\t\t\t\t  style="color: #8e232d">Owen H.</span>, U.S.A.</cite>\n\t\t\t\t</blockquote>\n\t\t\t\t<blockquote>"We believe strongly in providing our clients with the best possible network for their home. When we heard about PCNA at CEDIA Expo\n\t\t\t\t\twe knew it was a great opportunity to ensure our engineers remain amongst the best in the industry." <cite><span style="color: #8e232d"><a\n\t\t\t\t\t\t\t   href="//www.control4.com/blog/2018/03/an-emphasis-on-trusted-how-network-certification-raises-the-bar-for-smart-home-services"\n\t\t\t\t\t\t\t   target="_blank">Andy Bell, Nottingham</a></span>, UK</cite>\n\t\t\t\t</blockquote>\n\t\t\t\t<blockquote>\u201cI wish PCNA had been around before I took my CEDIA ESC-N. I give the PCNA training 10/10 stars.\u201d <cite><span\n\t\t\t\t\t\t\t  style="color: #8e232d">Will D., Nebraska</span>, U.S.A.</cite>\n\t\t\t\t</blockquote>\n\t\t\t</div>\n\t\t\t<div class="col-md-5 col-sm-6 half-padding-top half-padding-bottom">\n\t\t\t\t<blockquote>\u201cPCNA finds the right balance by offering entertaining and well-paced curriculum that provides the necessary knowledge that AV and\n\t\t\t\t\thome automation techs need to be efficient and successful. Perhaps the best part of the training is that each tech gets their own hardware\n\t\t\t\t\tto work on, but also to live with, so they can continue learning even after the class is over.\u201d <cite><span\n\t\t\t\t\t\t\t  style="color: #8e232d"><a\n\t\t\t\t\t\t\t   href="//www.residentialsystems.com/technology/control4-launches-pcna-course"\n\t\t\t\t\t\t\t   target="_blank">John Sciacca, South Carolina</a></span>, U.S.A.</cite>\n\t\t\t\t</blockquote>\n\t\t\t\t<blockquote>\u201cI earned my IT degree 15 years ago and I have a few certificates, A+, Network+, and handful of AV oriented certs. PCNA was a great\n\t\t\t\t\trefresher which reinforces the basics." <cite><span style="color: #8e232d">Brian G., South Dakota</span>, U.S.A.</cite>\n\t\t\t\t</blockquote>\n\t\t\t\t<blockquote>\u201cI am a 20 year IT veteran and have deployed very successful networks. This training is outstanding. Every dealer should take this.\u201d\n\t\t\t\t\t<cite><span style="color: #8e232d">Jonathan L.,Texas</span>, U.S.A.</cite>\n\t\t\t\t</blockquote>\n\t\t\t</div>\n\t\t</div>\n\t</div>\n\t<div class="widget padding">\n\t\t<h2>Here\'s How it Works</h2>\n\t\t<p>A dealer portal administrator with purchasing rights may register one, or many, employees for PCNA. Portal administrators will be able to track the\n\t\t\tprogress for each registered technician and will be notified when a trainee passes the certification exam and becomes a verified Pakedge Certified\n\t\t\tNetwork Administrator (<a href="//www.control4.com/docs/product/pcna/all-dealer-faq/english/latest" target="_blank">Read FAQs</a>).</p>\n\t\t<a routerLink="/education/pcna" fragment="register" target="_self" c4Track="Training"\n\t\t   trackCategory="Register Techs">Register Your Techs</a>\n\t\t<p class="half-margin-top">Registration for the PCNA certification curriculum includes:</p>\n\t\t<ol>\n\t\t\t<li>Access to the six online courses</li>\n\t\t\t<li>Hands-on Education Kit with all networking hardware for the course</li>\n\t\t\t<li>BakPak account</li>\n\t\t\t<li>Access to Q&amp;A with the education team</li>\n\t\t\t<li>The cost of the proctored exam fee (first attempt)</li>\n\t\t</ol>\n\t\t\x3c!-- pricing table --\x3e\n\t\t<div class="row" *ngIf="canPurchase && product">\n\t\t\t<div class="col-md-8 col-sm-10">\n\t\t\t\t<h3>Registration Cost</h3>\n\t\t\t\t<div class="alert alert-success no-margin">\n\t\t\t\t\t<div class="table">\n\t\t\t\t\t\t<div class="body">\n\t\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t\t<div class="col-9">\n\t\t\t\t\t\t\t\t\t<p>PCNA Course + Education Kit</p>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="col-3 text-right">\n\t\t\t\t\t\t\t\t\t<p>{{product.dealerPrice | currency:(currency$ | async)}}</p>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class="row bold">\n\t\t\t\t\t\t\t\t<div class="col-9">\n\t\t\t\t\t\t\t\t\t<p>Final Cost per Technician</p>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="col-3 text-right">\n\t\t\t\t\t\t\t\t\t<p>{{technicianCost | currency:(currency$ | async)}}</p>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t</div>\n\t</div>\n\t<div id="register" class="widget padding" *ngIf="canPurchase">\n\t\t<div class="alert alert-warning" *ngIf="pcnaTraineeInfoLoaded && pendingTrainees?.length">\n\t\t\t<ul class="no-style">\n\t\t\t\t<h4>These trainees have already been added to another cart</h4>\n\t\t\t\t<li *ngFor="let trainee of pendingTrainees">{{trainee.fullName}}</li>\n\t\t\t</ul>\n\t\t</div>\n\t\t<c4-loading *ngIf="!orderId"></c4-loading>\n\t\t<div class="row" *ngIf="orderId > 0">\n\t\t\t<div class="col-lg-8">\n\t\t\t\t<div class="form-wrapper form dark light-grey padding">\n\t\t\t\t\t<c4-loading *ngIf="!pcnaTraineeInfoLoaded || !product"></c4-loading>\n\t\t\t\t\t<ng-container *ngIf="confirmLoaded">\n\t\t\t\t\t\t<a href="javascript:;" class="c4close" test-id="resetDisplayTotalsClick" (click)="resetDisplayTotals()"></a>\n\t\t\t\t\t</ng-container>\n\t\t\t\t\t<div [hidden]="state !== \'trainees\' || !pcnaTraineeInfoLoaded" *ngIf="product">\n\t\t\t\t\t\t<h2 class="bold">Register Now</h2>\n\t\t\t\t\t\t<form>\n\t\t\t\t\t\t\t<div class="row no-margin margin-bottom" *ngIf="availableTrainees?.length">\n\t\t\t\t\t\t\t\t<div class="col-sm-9">\n\t\t\t\t\t\t\t\t\t<select test-id="selectedTrainees" id="trainee-select" name="trainee" [(ngModel)]="selectedTrainee">\n\t\t\t\t\t\t\t\t\t\t<option [value]="undefined">Select Trainee(s)</option>\n\t\t\t\t\t\t\t\t\t\t<option *ngFor="let available of availableTrainees" [ngValue]="available">{{available.fullName + \' (\' + (available.email\n\t\t\t\t\t\t\t\t\t\t\t| lowercase) + \')\'}}</option>\n\t\t\t\t\t\t\t\t\t</select>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="col-sm-3">\n\t\t\t\t\t\t\t\t\t<button test-id="addNewTraineeClick" class="block no-margin" (click)="addNewTrainee()"\n\t\t\t\t\t\t\t\t\t\t\t[disabled]="!selectedTrainee || totals.modifying">Register User</button>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div *ngIf="selectedTrainees?.length" class="half-margin-top">\n\t\t\t\t\t\t\t\t<h4>Trainee(s)</h4>\n\t\t\t\t\t\t\t\t<ul class="no-style half-margin-top half-margin-bottom half-padding-left">\n\t\t\t\t\t\t\t\t\t<li *ngFor="let selected of selectedTrainees">{{selected.fullName}} <small>({{selected.email}})</small>&nbsp; <small><a\n\t\t\t\t\t\t\t\t\t\t\t   href="javascript:;"\n\t\t\t\t\t\t\t\t\t\t\t   (click)="removeTrainee(selected)">Remove</a></small></li>\n\t\t\t\t\t\t\t\t</ul>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<p><small><strong>Technicians must be registered with their legal name.</strong>&mdash; The PCNA exam is conducted by a 3rd party\n\t\t\t\t\t\t\t\t\tproctoring service and government issued ID will be used to verify the trainee\'s identity before testing. You can update\n\t\t\t\t\t\t\t\t\tyour technicians name in the <a target="_blank"\n\t\t\t\t\t\t\t\t\t   routerLink="/account/usermanagement">User Management</a> section of the Dealer Portal. Trainees must be registered within\n\t\t\t\t\t\t\t\t\tportal user management prior to registration. If the user you wish to enroll does not appear in this list, please first <a\n\t\t\t\t\t\t\t\t\t   routerLink="/account/usermanagement"\n\t\t\t\t\t\t\t\t\t   target="_blank">Create New User in User Management</a>. Once complete, return to this page and <a href="javascript:;"\n\t\t\t\t\t\t\t\t\t   (click)="populate()">refresh this list</a>.</small></p>\n\t\t\t\t\t\t\t<c4-shipping-form [orderId]="totals.orderId" *ngIf="selectedTrainees?.length">\n\t\t\t\t\t\t\t</c4-shipping-form>\n\t\t\t\t\t\t\t<button test-id="continueToPaymentClick" (click)="proceedToBilling()"\n\t\t\t\t\t\t\t\t\t[disabled]="totals.modifying || !(selectedTrainees?.length && validShipping)"\n\t\t\t\t\t\t\t\t\tclass="half-margin-top">Continue to Payment <i class="fal fa-arrow-right"></i></button>\n\t\t\t\t\t\t</form>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div *ngIf="state === \'billing\'">\n\t\t\t\t\t\t<div class="half-margin-bottom">\n\t\t\t\t\t\t\t<h4>Registration</h4>\n\t\t\t\t\t\t\t<div class="row half-margin-bottom">\n\t\t\t\t\t\t\t\t<div class="col-sm-4">\n\t\t\t\t\t\t\t\t\t<small>\n\t\t\t\t\t\t\t\t\t\t<strong>Trainee(s)</strong>\n\t\t\t\t\t\t\t\t\t\t<ul *ngFor="let row of summarySelectedTrainees" class="no-style">\n\t\t\t\t\t\t\t\t\t\t\t<li *ngFor="let selected of row"> {{selected}} </li>\n\t\t\t\t\t\t\t\t\t\t</ul>\n\t\t\t\t\t\t\t\t\t</small>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="col-sm-4">\n\t\t\t\t\t\t\t\t\t<small>\n\t\t\t\t\t\t\t\t\t\t<strong>Shipping</strong>\n\t\t\t\t\t\t\t\t\t\t<ul class="no-style">\n\t\t\t\t\t\t\t\t\t\t\t<li *ngIf="selectedShippingAddress$ | async as address"> {{address.displayValue}}</li>\n\t\t\t\t\t\t\t\t\t\t\t<li>{{totals.shipping?.selectedShippingMethod?.name}}</li>\n\t\t\t\t\t\t\t\t\t\t</ul>\n\t\t\t\t\t\t\t\t\t</small>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<small><a href="javascript:;" test-id="backToTraineesAndShippingClick" (click)="state = \'trainees\'"><i\n\t\t\t\t\t\t\t\t\t   class="fa fa-long-arrow-left"></i> Back To Trainees and Shipping</a></small>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<c4-billing-form [orderId]="totals.orderId"></c4-billing-form>\n\t\t\t\t\t\t<p class="no-margin" [hidden]="!canProceed"><small>By placing this order, you agree to the <a\n\t\t\t\t\t\t\t\t   href="javascript:;" (click)="showTermsOfUse()">terms of use</a>.</small></p>\n\t\t\t\t\t\t<div class="half-padding-top">\n\t\t\t\t\t\t\t<button test-id="completePcnaRegistration" (click)="placeOrder()" [disabled]="!canProceed || totals.modifying"><i\n\t\t\t\t\t\t\t\t   class="fa fa-check"></i>Complete PCNA Registration</button>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div *ngIf="state === \'confirm\'">\n\t\t\t\t\t\t<c4-loading *ngIf="!confirmLoaded"></c4-loading>\n\t\t\t\t\t\t<div *ngIf="confirmLoaded">\n\t\t\t\t\t\t\t<h2>Registration Confirmed</h2>\n\t\t\t\t\t\t\t<p>You have successfully registered for the Pakedge<sup>&reg;</sup> PCNA Certification training. A confirmation email where you find\n\t\t\t\t\t\t\t\tinformation on beginning the training has been sent to you and the following trainee(s):</p>\n\t\t\t\t\t\t\t<div class="row half-margin-bottom half-padding-left">\n\t\t\t\t\t\t\t\t<div class="col-sm-5">\n\t\t\t\t\t\t\t\t\t<small>\n\t\t\t\t\t\t\t\t\t\t<ul class="no-style">\n\t\t\t\t\t\t\t\t\t\t\t<li *ngFor="let registered of confirm.registeredTrainees"> {{registered.fullName}}</li>\n\t\t\t\t\t\t\t\t\t\t</ul>\n\t\t\t\t\t\t\t\t\t\t<strong *ngIf="confirm.failedTrainees.length">Unfortunately these trainee(s) failed to register:</strong>\n\t\t\t\t\t\t\t\t\t\t<ul class="no-style" *ngIf="confirm.failedTrainees.length">\n\t\t\t\t\t\t\t\t\t\t\t<li *ngFor="let failed of confirm.failedTrainees">{{failed.fullName}}</li>\n\t\t\t\t\t\t\t\t\t\t</ul>\n\t\t\t\t\t\t\t\t\t</small>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="col-sm-5">\n\t\t\t\t\t\t\t\t\t<small>\n\t\t\t\t\t\t\t\t\t\t<strong>Shipping</strong>\n\t\t\t\t\t\t\t\t\t\t<ul class="no-style half-margin-bottom">\n\t\t\t\t\t\t\t\t\t\t\t<li>{{confirm.shippingAddress}}</li>\n\t\t\t\t\t\t\t\t\t\t\t<li>{{confirm.shippingMethod}}</li>\n\t\t\t\t\t\t\t\t\t\t\t<li *ngIf="confirm.finalDestinationAddress"><strong>Final Destination</strong></li>\n\t\t\t\t\t\t\t\t\t\t\t<li *ngIf="confirm.finalDestinationAddress"\n\t\t\t\t\t\t\t\t\t\t\t\t[innerHTML]="confirm.finalDestinationAddress | safeHtml"></li>\n\t\t\t\t\t\t\t\t\t\t\t<li *ngIf="confirm.order.poReference"><strong>PO Reference Number</strong>\n\t\t\t\t\t\t\t\t\t\t\t</li>\n\t\t\t\t\t\t\t\t\t\t\t<li *ngIf="confirm.order.poReference">\n\t\t\t\t\t\t\t\t\t\t\t\t<strong>{{confirm.order.poReference}}</strong>\n\t\t\t\t\t\t\t\t\t\t\t</li>\n\t\t\t\t\t\t\t\t\t\t</ul>\n\t\t\t\t\t\t\t\t\t\t<strong>Billing</strong>\n\t\t\t\t\t\t\t\t\t\t<ul class="no-style half-margin-bottom">\n\t\t\t\t\t\t\t\t\t\t\t<li [innerHTML]="confirm.billingAddress | safeHtml"></li>\n\t\t\t\t\t\t\t\t\t\t\t<li *ngIf="confirm.payment.creditCardNumber">{{confirm.payment.cardType}} {{confirm.payment.creditCardNumber}}</li>\n\t\t\t\t\t\t\t\t\t\t\t<li *ngIf="confirm.payment.creditCardNumber">{{confirm.payment.nameOnCard}} </li>\n\t\t\t\t\t\t\t\t\t\t\t<li *ngIf="!confirm.payment.creditCardNumber"> {{confirm.payment | paymentMethod}}</li>\n\t\t\t\t\t\t\t\t\t\t</ul>\n\t\t\t\t\t\t\t\t\t\t<div *ngIf="confirm.benefits && confirm.benefits.length">\n\t\t\t\t\t\t\t\t\t\t\t<strong>Promotions</strong>\n\t\t\t\t\t\t\t\t\t\t\t<ul class="no-style half-margin-bottom">\n\t\t\t\t\t\t\t\t\t\t\t\t<li *ngFor="let benefit of confirm.benefits">{{benefit}}</li>\n\t\t\t\t\t\t\t\t\t\t\t</ul>\n\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t</small>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</div> Please instruct these trainees to check their inbox for this email, including junk folders.\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t\t<div class="col-sm-4">\n\t\t\t\t<div class="table">\n\t\t\t\t\t<c4-loading *ngIf="!displayTotals"></c4-loading>\n\t\t\t\t\t<div class="body" *ngIf="displayTotals">\n\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t<div class="col-6 bold">Subtotal</div>\n\t\t\t\t\t\t\t<div class="col-6 text-right">{{displayTotals.subtotal | currency:(currency$ | async)}} </div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t<div class="col-6 bold">Taxes</div>\n\t\t\t\t\t\t\t<div class="col-6 text-right">{{displayTotals.taxTotal | currency:(currency$ | async)}}</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t<div class="col-6 bold">Shipping</div>\n\t\t\t\t\t\t\t<div class="col-6 text-right">{{displayTotals.shippingTotal | currency:(currency$ | async)}}</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t<div class="col-6 bold">Total</div>\n\t\t\t\t\t\t\t<div class="col-6 text-right"><b>{{displayTotals.grandTotal | currency:(currency$ | async)}}</b></div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t</div>\n\t\t<div *ngIf="(certifiedTrainees?.length > 0 || registeredTrainees?.length > 0) && canPurchase">\n\t\t\t<h3 class="half-margin-top">Trainees</h3>\n\t\t\t<div class="row">\n\t\t\t\t<div class="col-sm-4" *ngIf="certifiedTrainees.length">\n\t\t\t\t\t<ul class="no-style">\n\t\t\t\t\t\t<h4>PCNA<sup class="text-grey">&trade;</sup> Certified</h4>\n\t\t\t\t\t\t<li *ngFor="let trainee of certifiedTrainees"><i class="fal fa-check-circle text-success"></i> {{trainee.fullName}}</li>\n\t\t\t\t\t</ul>\n\t\t\t\t</div>\n\t\t\t\t<div class="col-sm-8" *ngIf="registeredTrainees.length">\n\t\t\t\t\t<ul class="no-style">\n\t\t\t\t\t\t<h4>Training in Progress</h4>\n\t\t\t\t\t\t<li *ngFor="let trainee of registeredTrainees"><i\n\t\t\t\t\t\t\t   class="fal fa-arrow-circle-right text-warning"></i> {{trainee.fullName}}</li>\n\t\t\t\t\t</ul>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t</div>\n\t</div>\n\t<div class="widget padding">\n\t\t<h2>Resources</h2>\n\t\t<a href="//www.control4.com/docs/product/pcna/all-dealer-pe-one-sheets-us/english/latest"\n\t\t   class="half-padding-right" target="_blank">PCNA One Sheet</a>\n\t\t<a href="//www.control4.com/docs/product/pcna/all-dealer-study-guide/english/latest/" target="_blank">Study Guide</a>\n\t</div>\n\t<div class="widget padding">\n\t\t<h2>Awards</h2>\n\t\t<div class="row">\n\t\t\t<div class="col-sm-4">\n\t\t\t\t<h3>PCNA AWARDED 2018 TOP NEW <no-br>TECHNOLOGY AWARD</no-br>\n\t\t\t\t</h3>\n\t\t\t\t<p>Considered best new program to improve business operations.</p>\n\t\t\t\t<img src="//res.cloudinary.com/control4/image/upload/TNT-ISE_2018_winner2.jpg">\n\t\t\t</div>\n\t\t\t<div class="col-sm-4">\n\t\t\t\t<h3>PCNA AWARDED MARK OF EXCELLENCE AT <no-br>CES 2018</no-br>\n\t\t\t\t</h3>\n\t\t\t\t<p>Wins Best Education Program from Consumer Technology Association.</p>\n\t\t\t\t<img src="//res.cloudinary.com/control4/image/upload/Mark_of_Excellence_Award.jpg">\n\t\t\t</div>\n\t\t\t<div class="col-sm-4">\n\t\t\t\t<h3>PCNA AWARDED 2019 BEST BLENDED LEARNING SOLUTION</h3>\n\t\t\t\t<p>Wins The Learning Solutions Conference and Expo Best Blended Learning Solution in DemoFest.</p>\n\t\t\t\t<img class="half-padding-top" src="//res.cloudinary.com/control4/image/upload/BestBlended.png">\n\t\t\t</div>\n\t\t</div>\n\t</div>\n</div>'},Z1t4:function(t,e){t.exports=".my-tech-badge {\n  margin-top: 5px;\n  height: 50px;\n  width: 50px;\n}"},yhbZ:function(t,e){t.exports='<strong>{{header}}</strong>\n<progress [class]="barClass" [value]="certified" [max]="total"></progress>\n<div class="row no-margin" style="padding-bottom: 12.5px;">\n\t<div class="col-6">\n\t\t<small class="block text-light-grey clickable" [ngClass]="{ \'text-red\': registeredFilter === certType }"\n\t\t\t(click)="filterRegistered.next(certType)">\n\t\t\t{{registered}} Registered\n\t\t</small>\n\t</div>\n\t<div class="col-6">\n\t\t<small class="block text-right clickable" [ngClass]="{ \'text-red\': certifiedFilter === certType }"\n\t\t\t(click)="filterCertified.next(certType)">{{ certified }}<span\n\t\t\t\t[ngClass]="{ \'text-red\': certifiedFilter === certType, \'text-light-grey\': certifiedFilter !== certType }">/{{ total }}\n\t\t\t\tCertified</span>\n\t\t</small>\n\t</div>\n</div>'}}]);