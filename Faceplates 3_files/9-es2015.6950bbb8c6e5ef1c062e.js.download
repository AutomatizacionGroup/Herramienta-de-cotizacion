SubscriptionClick" class="transparent" (click)="toggleSubscription()"\n\t\t\t\t\t\t\ttitle="{{article.isSubscribed ? \'Unsubscribe\' : \'Subscribe\'}}">\n\t\t\t\t\t\t<i class="{{article.isSubscribed ? \'text-primary\' : \'\'}} fal fa-rss"></i>\n\t\t\t\t\t</button>\n\t\t\t\t\t<button test-id="toggleBookmarkClick" class="transparent" (click)="toggleBookmark()"\n\t\t\t\t\t\t\ttitle="{{isFavorite ? \'Remove from Bookmarks\' : \'Add to Bookmarks\'}}">\n\t\t\t\t\t\t<i class="{{isFavorite ? \'text-primary\' : \'\'}} fal fa-bookmark"></i>\n\t\t\t\t\t</button>\n\t\t\t\t\t<a *ngIf="canEditSupportContent" class="c4btn transparent" target="_blank"\n\t\t\t\t\t   routerLink="/cms/knowledgebase/{{article.id}}">\n\t\t\t\t\t\t<i class="fal fa-pen-alt"></i>\n\t\t\t\t\t</a>\n\t\t\t\t</div>\n\t\t\t\t<div class="padding" *ngIf="!loaded">\n\t\t\t\t\t<c4-loading [hidden]="loaded"></c4-loading>\n\t\t\t\t</div>\n\t\t\t\t<div *ngIf="loaded && !article" class="padding">\n\t\t\t\t\t<h1>Article not found</h1>\n\t\t\t\t\t<p>\n\t\t\t\t\t\t<a routerLink="/support">Return to Support</a>\n\t\t\t\t\t</p>\n\t\t\t\t</div>\n\t\t\t\t<div *ngIf="article" class="padding">\n\t\t\t\t\t<h1>{{article.title}}</h1>\n\t\t\t\t\t<div class="half-padding-bottom" *ngIf="article.articleSummary?.length">\n\t\t\t\t\t\t<div [innerHTML]="article.articleSummary | safeHtml"></div>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="half-padding-bottom" *ngIf="article.quickActions?.length">\n\t\t\t\t\t\t<h3 class="no-margin">Quick Actions</h3>\n\t\t\t\t\t\t<div [innerHTML]="article.quickActions | safeHtml"></div>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div *ngIf="article.content && article.content.length">\n\t\t\t\t\t\t<div [innerHTML]="article.content | safeHtml" c4RunScripts></div>\n\t\t\t\t\t</div>\n\t\t\t\t\t<small class="footnote">Copyright &copy;{{year}}, Wirepath Home Systems, LLC. All rights reserved. Control4 and their respective logos are\n\t\t\t\t\t\tregistered trademarks or trademarks of Wirepath Home SYstems, LCC, dba Control4 in th