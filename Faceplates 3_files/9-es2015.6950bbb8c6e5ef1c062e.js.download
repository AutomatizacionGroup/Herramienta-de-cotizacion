4btn block" test-id="subscribeAllClick" (click)="subscribeToAllArticles()">Subscribe All</a>\n\t\t</div>\n\t\t<div class="col-sm-2" *ngIf="!(isEmea$ | async)">\n\t\t\t<a class="c4btn grey block" test-id="unsubscribeAllClick" (click)="unsubscribeToAllArticles()">Unsubscribe All</a>\n\t\t</div>\n\t</div>\n\t<div class="widget">\n\t\t<div class="padding">\n\t\t\t<c4-loading *ngIf="loading"></c4-loading>\n\t\t\t<div *ngIf="!loading">\n\t\t\t\t<h4 *ngIf="!subscriptions?.length">You do not have any article subscriptions.</h4>\n\t\t\t\t<div class="table no-margin" *ngIf="subscriptions">\n\t\t\t\t\t<div class="body">\n\t\t\t\t\t\t<div class="row" *ngFor="let article of subscriptions | paging: pagingInfo; let i = index">\n\t\t\t\t\t\t\t<div class="col-sm-10">\n\t\t\t\t\t\t\t\t<h4>\n\t\t\t\t\t\t\t\t\t<a routerLink="/knowledgebase/article/{{article.id}}">{{article.title}}</a>\n\t\t\t\t\t\t\t\t</h4>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class="col-sm-2 text-right">\n\t\t\t\t\t\t\t\t<button attr.test-id="unsubscribeClick-{{i}}" class="c4btn grey block no-margin" title="Unsubscribe"\n\t\t\t\t\t\t\t\t\t\t(click)="unsubscribe(article.id, i)">\n\t\t\t\t\t\t\t\t\t<i class="fal fa-trash-alt"></i>\n\t\t\t\t\t\t\t\t</button>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class="col-sm-10" *ngIf="article?.contentSummary" [innerHTML]="article.contentSummary | safeHtml"></div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class="pagination">\n\t\t\t\t\t<c4-pager [(info)]="pagingInfo"></c4-pager>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t</div>\n\t</div>\n</div>'},Saqv:function(t,e){t.exports=".gradient-blue {\n  color: #000;\n  background: radial-gradient(circle, #dddddd, #aaaaaa);\n}\n\n.gradient-blue:hover {\n  background: radial-gradient(circle, #dddddd, #dddddd);\n}"},TdUP:function(t,e){t.exports=""},ZUsO:function(t,e){t.exports='<h3 class="text-dark" *ngIf="articles?.length">Popular Knowledge Base Articles</h3>\n<div class="row">\n\t<c4-loading *ngIf="!articles"></c4-loa