\t</h3>\n\t\t\t\t<div class="padding">\n\t\t\t\t\t<c4-loading [hidden]="loaded"></c4-loading>\n\t\t\t\t\t<p *ngIf="article">\n\t\t\t\t\t\t<small> Article ID: {{article.id}} <br /> Created By: {{article.createdByUser.firstName}} {{article.createdByUser.lastName}} <br />\n\t\t\t\t\t\t\tPublished: {{article.createdDate | fromNow}} <br /> Updated: {{article.lastModifiedDate | fromNow}} </small>\n\t\t\t\t\t</p>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t\t<div class="widget" *ngIf="attachments?.length">\n\t\t\t\t<h3 class="widget-header-white">\n\t\t\t\t\t<span class="text-grey">Article Attachments</span>\n\t\t\t\t</h3>\n\t\t\t\t<div class="padding">\n\t\t\t\t\t<p *ngFor="let attachment of attachments">\n\t\t\t\t\t\t<c4-cloudinary [media]="attachment"></c4-cloudinary>\n\t\t\t\t\t</p>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t\t<c4-kb-bookmarks-widget [article]="article" [isFavorite]=isFavorite (favoriteToggled)="isFavorite = $event">\n\t\t\t</c4-kb-bookmarks-widget>\n\t\t\t<c4-support-question></c4-support-question>\n\t\t\t<c4-kb-related-articles [article]="article"></c4-kb-related-articles>\n\t\t\t<c4-kb-related-content [article]="article"></c4-kb-related-content>\n\t\t</div>\n\t</div>\n</div>'},rePD:function(t,e){t.exports='<c4-widget header="Related Articles">\n\t<c4-loading *ngIf="!loaded"></c4-loading>\n\t<p class="no-margin" *ngIf="loaded && relatedArticles.length === 0">No related articles found.</p>\n\t<p *ngFor="let article of relatedArticles" [ngClass]="{\'no-margin\': $last}">\n\t\t<a routerLink="/knowledgebase/article/{{article.id}}">{{article.title}}</a>\n\t</p>\n</c4-widget>'},wUI4:function(t,e){t.exports='<div class="widget" *ngIf="article">\n\t<h3 class="widget-header-white">Related Content</h3>\n\t<div class="widget-content padding">\n\t\t<c4-loading *ngIf="!loaded"></c4-loading>\n\t\t<p class="no-margin" *ngIf="loaded && displayResults.length === 0">No related content found.</p>\n\t\t<p *ngFor="let p of displayResults" [ngClass]="{\'no-margin\': $last}">\n\t\t\t<a [href]="p.url" title="{{p.title | toPlainText}}" target="_blank">\n\t\t\t\t<span [innerHTML]="p.title | safeHtml"></span>\n\t\t\t</a>\n\t\t</p>\n\t</div>\n</div>'},y3FP:function(t,e){t.exports=""},y73b:function(t,e){t.exports=""}}]);