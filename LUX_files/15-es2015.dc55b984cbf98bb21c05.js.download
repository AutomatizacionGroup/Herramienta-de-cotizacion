oducts</button>\n\t\t\t</div>\n\t\t\t<div class="padding">\n\t\t\t\t<p *ngIf="searching">Searching...</p>\n\t\t\t\t<p *ngIf="!searchResults && searched">No results found.</p>\n\t\t\t\t<p *ngIf="!searching && searchResults && searched">Changes will be applied to all <b>{{searchResults.length}}</b> products listed below. </p>\n\t\t\t</div>\n\t\t\t<div class="padding">\n\t\t\t\t<div class="table" *ngIf="searchResults">\n\t\t\t\t\t<div class="head d-none d-sm-block">\n\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t<div class="col-md-6 col-sm-5">Product</div>\n\t\t\t\t\t\t\t<div class="col-md-5 col-sm-5">Categories</div>\n\t\t\t\t\t\t\t<div class="col-md-1 col-sm-2 text-center">Available</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="body" *ngIf="!searching">\n\t\t\t\t\t\t<div class="row repeated-item" *ngFor="let product of searchResults">\n\t\t\t\t\t\t\t<div class="col-md-6 col-sm-5">\n\t\t\t\t\t\t\t\t<b>{{product.name}}</b><br />\n\t\t\t\t\t\t\t\t<small>{{product.sku}}</small>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class="col-md-5 col-sm-4">\n\t\t\t\t\t\t\t\t<span [title]="flattenCategories(product.categories)">{{flattenCategories(product.categories)}}</span>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class="col-md-1 col-sm-2 col-6 text-center">\n\t\t\t\t\t\t\t\t<span class="fal" [ngClass]="{\'fa-check\':product.isAvailable}"></span>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t</div>\n\t</div>\n\t<c4-cms-bulk-product-edit class="block" *ngIf="editProduct" [editProduct]="editProduct"\n\t\t\t\t\t\t\t  (cancelEditProducts)=cancelEditProducts()>\n\t</c4-cms-bulk-product-edit>\n</div>'},nphk:function(t,e){t.exports=""},p4jg:function(t,e){t.exports=""},q80o:function(t,e){t.exports='<div class="widget">\n\t<h3 class="widget-header-grey">Shipping Estimate</h3>\n\t<div class="absolute top left block text-right d-xs-none">\n\t\t<button test-id="cancelBulkShippingEstimateClick" class="transparent " (click)="c