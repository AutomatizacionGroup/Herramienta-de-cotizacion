edia)="uploadBulkMedia($event)">\n\t</c4-bulk-download-edit>\n\t<c4-bulk-video-edit class="block" [editProduct]="editProduct" (cancel)="cancel()"></c4-bulk-video-edit>\n\t<c4-bulk-support-edit class="block" [editProduct]="editProduct" (cancel)="cancel()"></c4-bulk-support-edit>\n\t<c4-bulk-recommended-category-edit class="block" [editProduct]="editProduct" (cancel)="cancel()">\n\t</c4-bulk-recommended-category-edit>\n\t<c4-bulk-recommended-product-edit class="block" [editProduct]="editProduct" (cancel)="cancel()">\n\t</c4-bulk-recommended-product-edit>\n\t<div class="col-sm-12">\n\t\t<c4-widget header="SnapAV Import">\n\t\t\t<p><small>This will start processing the extended SnapAV product data. This includes product details, images, videos, spec sheets, and downloads.\n\t\t\t\t\tThe products must be synced from SAP before using this button. Control4 Products are not affected.</small></p>\n\t\t\t<button test-id="importSnapAvDataClick" (click)="importSnapAvData()" [disabled]="importDisabled">Import SnapAV Data</button>\n\t\t</c4-widget>\n\t</div>\n\t<c4-bulk-media-validation class="block" [skus]="editProduct.skus"></c4-bulk-media-validation>\n</div>'},vW8P:function(t,e){t.exports='<div>\n\t<h4>{{label}}</h4>\n\t<label>\n\t\t<input test-id="activeRadio" [name]="label" type="radio" [value]="true" [ngModel]="value"\n\t\t\t   (ngModelChange)="valueChange.emit($event)"><span>Active</span>\n\t</label>\n\t<label>\n\t\t<input test-id="inactiveRadio" [name]="label" type="radio" [value]="false" [ngModel]="value"\n\t\t\t   (ngModelChange)="valueChange.emit($event)"><span>Inactive</span>\n\t</label>\n\t<label>\n\t\t<input test-id="ignoreRadio" [name]="label" type="radio" [value]="undefined" [ngModel]="value"\n\t\t\t   (ngModelChange)="valueChange.emit($event)"><span>Ignore</span>\n\t</label>\n</div>'},wDOF:function(t,e){t.exports='<c4-widget header="Spec Sheets" [buttons]="specsButtons">\n\t<div>\n\t\t<h4>Upload File</h4>\n\t\t<c4-file-upload folder="spec-sheets" text="Upload Images" fileFormats="jpeg,jpg,png" (complete)="saveSpecs($event)"\n\t\t\tclasses="grey"></c4-file-upload>\n\t</div>\n</c4-widget>'},xIxz:function(t,e){t.exports='<c4-widget header="Media Validation">\n\t<p><small>This tool is used to validate whether the media exists in Cloudinary. Media stored in Cloudinary include images, spec sheets, and downloads. Safe\n\t\t\tmode will allow you to verify what images will be deleted before doing so.</small></p>\n\t<div class="alert alert-danger" *ngIf="!disabled && ran && hasResults">\n\t\t<p *ngIf="ranAsSafe">The following urls are missing in Cloudinary:</p>\n\t\t<p *ngIf="!ranAsSafe">The following urls were removed:</p>\n\t\t<ng-container *ngFor="let prod of missingMedia | keyvalue">\n\t\t\t<h3>{{prod.key}}</h3>\n\t\t\t<div *ngFor="let media of prod.value" class="row">\n\t\t\t\t<div class="col-3 col-sm-2 col-lg-1">{{media.mediaTypeId | map: mediaLabels}}</div>\n\t\t\t\t<div class="col-9 col-sm-10 col-lg-11">{{media.url}}</div>\n\t\t\t</div>\n\t\t</ng-container>\n\t</div>\n\t<div class="alert alert-warning" *ngIf="disabled"> Media validation is running... </div>\n\t<div class="alert alert-success" *ngIf="!disabled && ran && !hasResults"> No media files were missing! </div>\n\t<label><input test-id="safeModeCheckbox" type="checkbox" [(ngModel)]="safeMode"> Safe Mode</label>\n\t<button test-id="validateBulkMediaClick" (click)="validate()" [disabled]="disabled">Validate</button>\n</c4-widget>'},xNRj:function(t,e){t.exports='<div class="widget">\n\t<h3 class="widget-header-grey">Filters</h3>\n\t<div class="absolute top left block text-right d-xs-none">\n\t\t<button test-id="cancelBulkFilterEditClick" class="transparent" (click)="cancel.emit()">Cancel</button>\n\t\t<button test-id="saveBulkFilterClick" class="transparent" (click)="saveFilters()">Save</button>\n\t</div>\n\t<div class="padding">\n\t\t<c4-filter-select (selected)="addFilter($event)"></c4-filter-select>\n\t\t<c4-filter-tags [filters]="filters" (remove)="removeFilter($event)" [removable]="true"></c4-filter-tags>\n\t</div>\n</div>'},xsnN:function(t,e){t.exports='<div class="widget">\n\t<h3 class="widget-header-grey">Customizations</h3>\n\t<div class="absolute top left block text-right d-xs-none">\n\t\t<button test-id="cancelBulkCustomizationEditClick" class="transparent " (click)="cancel.emit()">Cancel</button>\n\t\t<button test-id="updateBulkCustomizationsClick" class="transparent " (click)="updateBulkCustomizations()" [disabled]="editProduct?.isCustomPaint == null && \n\t\t\teditProduct?.isCustomVeneer == null && editProduct?.isCustomWidth == null && editProduct?.isCustomHeight == null && \n\t\t\teditProduct?.isCustomGrill == null && editProduct?.isCustomizationRequiredForCustomer == null">Save</button>\n\t</div>\n\t<div class="padding">\n\t\t<div class="row">\n\t\t\t<div class="col-md-3 col-sm-6">\n\t\t\t\t<c4-bulk-product-radio-button label="Custom Paint" [(value)]="editProduct.isCustomPaint">\n\t\t\t\t</c4-bulk-product-radio-button>\n\t\t\t</div>\n\t\t\t<div class="col-md-3 col-sm-6">\n\t\t\t\t<c4-bulk-product-radio-button label="Custom Veneer" [(value)]="editProduct.isCustomVeneer">\n\t\t\t\t</c4-bulk-product-radio-button>\n\t\t\t</div>\n\t\t\t<div class="col-md-3 col-sm-6">\n\t\t\t\t<c4-bulk-product-radio-button label="Custom Width" [(value)]="editProduct.isCustomWidth">\n\t\t\t\t</c4-bulk-product-radio-button>\n\t\t\t</div>\n\t\t\t<div class="col-md-3 col-sm-6">\n\t\t\t\t<c4-bulk-product-radio-button label="Custom Height" [(value)]="editProduct.isCustomHeight">\n\t\t\t\t</c4-bulk-product-radio-button>\n\t\t\t</div>\n\t\t\t<div class="col-md-3 col-sm-6">\n\t\t\t\t<c4-bulk-product-radio-button label="Custom Grill" [(value)]="editProduct.isCustomGrill">\n\t\t\t\t</c4-bulk-product-radio-button>\n\t\t\t</div>\n\t\t\t<div class="col-md-3 col-sm-6">\n\t\t\t\t<c4-bulk-product-radio-button label="Customization Required"\n\t\t\t\t\t\t\t\t\t\t\t  [(value)]="editProduct.isCustomizationRequiredForCustomer">\n\t\t\t\t</c4-bulk-product-radio-