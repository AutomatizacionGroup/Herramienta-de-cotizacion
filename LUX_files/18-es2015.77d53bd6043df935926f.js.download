ss="row half-padding-top" *ngIf="!isFiltered()">\n\t\t\t\t<div class="col-md-6">\n\t\t\t\t\t<h4>Most popular documents</h4>\n\t\t\t\t\t<c4-loading *ngIf="!popularDocuments"></c4-loading>\n\t\t\t\t\t<div *ngFor="let doc of popularDocuments; index as i">\n\t\t\t\t\t\t<a attr.test-id="viewPopularDocument-{{i}}" (click)="viewDocument(doc.latestDownloadLink)">{{\n\t\t\t\t\t\t\tdoc.friendlyName }}</a>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class="col-md-6" *ngIf="!isPakedge">\n\t\t\t\t\t<h4>Categories</h4>\n\t\t\t\t\t<c4-loading *ngIf="!categories"></c4-loading>\n\t\t\t\t\t<div *ngFor="let category of categories; index as i">\n\t\t\t\t\t\t<a attr.test-id="selectCategory-{{i}}" href="javascript:;" (click)="selectCategory(category.value)">{{ category.value }}</a>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class="col-md-6" *ngIf="isPakedge">\n\t\t\t\t\t<h4>Doc Types</h4>\n\t\t\t\t\t<c4-loading *ngIf="!docTypes"></c4-loading>\n\t\t\t\t\t<div *ngFor="let docType of docTypes; index as i">\n\t\t\t\t\t\t<a href="javascript:;" attr.test-id="selectDocType-{{i}}" (click)="selectDocType(docType.value)">{{ docType.value }}</a>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t\t<div class="docs table" *ngIf="isFiltered()">\n\t\t\t\t<div class="body">\n\t\t\t\t\t<c4-loading *ngIf="!filteredDocuments"></c4-loading>\n\t\t\t\t\t<div class="row" *ngFor="let doc of filteredDocuments; index as i">\n\t\t\t\t\t\t<div class="col-6 col-sm-4">\n\t\t\t\t\t\t\t<a attr.test-id="viewFilteredDocumentClick-{{i}}" (click)="viewDocument(doc.latestDownloadLink)">\n\t\t\t\t\t\t\t\t<img [src]="doc.thumbnailUrl" style="max-height: 180px;">\n\t\t\t\t\t\t\t</a>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class="col-6 col-sm-5">\n\t\t\t\t\t\t\t<a attr.test-id="viewDocumentClick-{{i}}" (click)="viewDocument(doc.latestDownloadLink)">{{\n\t\t\t\t\t\t\t\tdoc.friendlyName }}</a> <a href="javascript:;" attr.test-id="toggleShowRevisions-{{i}}" (click)="doc.showRevisions=!doc.showRevisions"\n\t\t\t\t\t\t\t  