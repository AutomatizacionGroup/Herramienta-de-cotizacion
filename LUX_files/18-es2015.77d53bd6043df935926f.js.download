t\t<div class="col-md-2">\n\t\t\t\t\t\t<h4>Publish Date</h4>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="col-md-6">\n\t\t\t\t\t\t<h4>Release Notes</h4>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t\t<div class="body">\n\t\t\t\t<div class="row" *ngFor="let version of firmware.versions">\n\t\t\t\t\t<div class="col-md-4 col-6"><a [href]="version.downloadUrl" download>Version {{ version.label }}</a></div>\n\t\t\t\t\t<div class="col-md-2 col-6">{{ version.releaseDate | date: \'MMMM dd, yyyy\'}}</div>\n\t\t\t\t\t<div class="col-md-6 col-12" [innerHTML]="version.releaseNotes | safeHtml"></div>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t</div>\n\t</div>\n</c4-widget>'},psYx:function(t,e){t.exports='<div class="row no-margin form dark border-bottom">\n\t<div class="col-9">\n\t\t<mat-form-field class="no-margin">\n\t\t\t<input test-id="searchDrivers" matInput type="text" class="no-margin" placeholder="Search Drivers" [ngModel]="filter.searchText"\n\t\t\t\t   (ngModelChange)="onSearchChange($event)" />\n\t\t</mat-form-field>\n\t</div>\n\t<div class="col-3">\n\t\t<button test-id="driverFilterSearchClick" class="light-grey text-dark block no-margin"><i class="fal fa-search"></i></button>\n\t</div>\n</div>\n<div class="d-xs-none no-margin">\n\t<div class="widget">\n\t\t<button test-id="clearFiltersClick" class="block transparent border-bottom no-margin" (click)="clearFilters()" title="Clear Filters">\n\t\t\t<i class="fal fa-times"></i>Clear Filters </button>\n\t\t<div class="padding filter-container">\n\t\t\t<div *ngFor="let grouping of groupings | orderBy: [\'label\']; index as i">\n\t\t\t\t<ng-container *ngIf="grouping.filters?.length > 1">\n\t\t\t\t\t<h3>{{grouping.label}}</h3>\n\t\t\t\t\t<label *ngFor="let flag of grouping.filters | orderBy: [\'value\']; index as j">\n\t\t\t\t\t\t<ng-container>\n\t\t\t\t\t\t\t<input attr.test-id="filterFlagCheckbox-{{i}}-{{j}}" type="checkbox" [ngModel]="filter | hasDriverFilter: grouping: flag"\n\t\t\t\t\t\t\t\t   (ngModelChange)="onFilterFlagChange(grouping, flag)" />\n\t\t\t\t\t\t\t<i class="fal fa-check text-primary"></i>\n\t\t\t\t\t\t\t<span>{{flag.label}} <small>{{flag.count || 0}}</small></span>\n\t\t\t\t\t\t</ng-container>\n\t\t\t\t\t</label>\n\t\t\t\t</ng-container>\n\t\t\t</div>\n\t\t</div>\n\t</div>\n</div>'},sK5Y:function(t,e){t.exports=""},zGbd:function(t,e){t.exports='<ng-container *ngIf="vm$ | async as vm">\n\t<div *ngIf="vm.toggle" style="z-index: 1">\n\t\t<button test-id="showNewChangedClick" style="position: absolute; top: 10px; right: 10px" [class.grey]="!vm.show20"\n\t\t\t\t(click)="showNewChanged.next(!vm.show20)">Firmware 2.0 {{vm.show20 ? \'On\' : \'Off\'}}</button>\n\t</div>\n\t<c4-firmware-new-page *ngIf="vm.show20"></c4-firmware-new-page>\n\t<c4-firmware-old-page *ngIf="!vm.show20"></c4-firmware-old-page>\n</ng-container>'}}]);