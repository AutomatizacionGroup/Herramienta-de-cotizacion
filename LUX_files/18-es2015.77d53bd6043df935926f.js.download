heck text-success"></i>certified </span></div>\n\t\t\t\t\t\t\t\t<div class="col-6 d-sm-none bold">Device Info</div>\n\t\t\t\t\t\t\t\t<div class="col-sm-3 col-6">{{driver.primaryProxy}}\n\t\t\t\t\t\t\t\t\t<br /><small>{{driver.controlMethod | uppercase}}</small></div>\n\t\t\t\t\t\t\t\t<div class="col-6 d-sm-none bold">Date Modified</div>\n\t\t\t\t\t\t\t\t<div class="col-sm-2 col-6">{{driver.dateLastModified | date: \'MMM dd, yyyy\'}}\n\t\t\t\t\t\t\t\t\t<br /><small *ngIf="driver.version">Version\n\t\t\t\t\t\t\t\t\t\t{{driver.version}}</small></div>\n\t\t\t\t\t\t\t\t<div class="col-6 d-sm-none bold"></div>\n\t\t\t\t\t\t\t\t<div class="col-sm-3 col-6"><a [title]="driver.name" [download]="driver.filename"\n\t\t\t\t\t\t\t\t\t\t[href]="driver.url" class="c4btn light-grey text-dark block no-margin dark"\n\t\t\t\t\t\t\t\t\t\ttarget="_blank">Download</a> </div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<c4-pager [(info)]="pagingInfo" (pageChange)="onPageChange()"></c4-pager>\n\t\t\t</div>\n\t\t</div>\n\t</div>\n</div>'},YYP4:function(t,e){t.exports='<div class="padding">\n\t<h1>Firmware</h1>\n\t<div class="widget">\n\t\t<div class="padding">\n\t\t\t<h2>Legacy Products</h2>\n\t\t\t<p> Looking for firmware for older products? <a routerLink="/support/legacy-firmware">Check here.</a>\n\t\t\t</p>\n\t\t</div>\n\t</div>\n\t<c4-loading *ngIf="loading"></c4-loading>\n\t<div *ngIf="!loading">\n\t\t<div class="widget" *ngFor="let category of categories">\n\t\t\t<div class="padding">\n\t\t\t\t<h2>{{category.name}}</h2>\n\t\t\t\t<div class="table">\n\t\t\t\t\t<div class="head">\n\t\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t\t<div class="col-sm-8">\n\t\t\t\t\t\t\t\t<h3>Product</h3>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class="col-sm-4">\n\t\t\t\t\t\t\t\t<h3>Firmware & Product Files</h3>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="body">\n\t\t\t\t\t\t<div class="row" *ngFor="let product of category.products