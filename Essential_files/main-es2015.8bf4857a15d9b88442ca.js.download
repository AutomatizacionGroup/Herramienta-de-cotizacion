s" [value]="sku">{{ sku }}</option>\n\t\t\t\t\t\t</select>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="col-sm-4">\n\t\t\t\t\t\t<select test-id="selectedBrand" [ngModel]="loadFilter.brandName" (ngModelChange)="onBrandNameChange($event)"\n\t\t\t\t\t\t\t\t*ngIf="brandTypes" name="brandTypes">\n\t\t\t\t\t\t\t<option value="">Select a brand</option>\n\t\t\t\t\t\t\t<option *ngFor="let brand of brandTypes" [value]="brand">{{ brand }}</option>\n\t\t\t\t\t\t</select>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="col-sm-4">\n\t\t\t\t\t\t<select test-id="selectedBulbFixture" [ngModel]="loadFilter.bulbFixtureType" (ngModelChange)="onBulbFixtureTypeChange($event)"\n\t\t\t\t\t\t\t\t*ngIf="bulbFixtureTypes" name="bulbFixtures">\n\t\t\t\t\t\t\t<option value="">Select a bulb/fixture</option>\n\t\t\t\t\t\t\t<option *ngFor="let bulb of bulbFixtureTypes" [value]="bulb">{{ bulb }}</option>\n\t\t\t\t\t\t</select>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="col-sm-4">\n\t\t\t\t\t\t<select test-id="selectedTechnology" [ngModel]="loadFilter.technologyTypeName"\n\t\t\t\t\t\t\t\t(ngModelChange)="onTechnologyTypeChange($event)" *ngIf="technologyTypes"\n\t\t\t\t\t\t\t\tname="technologyTypes">\n\t\t\t\t\t\t\t<option value="">Select a technology</option>\n\t\t\t\t\t\t\t<option *ngFor="let tech of technologyTypes" [value]="tech">{{ tech }}</option>\n\t\t\t\t\t\t</select>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="col-sm-4">\n\t\t\t\t\t\t<select test-id="selectedVoltage" [ngModel]="loadFilter.voltage" (ngModelChange)="onVoltageChange($event)"\n\t\t\t\t\t\t\t\t*ngIf="voltageTypes" name="voltageTypes">\n\t\t\t\t\t\t\t<option value="">Select a voltage</option>\n\t\t\t\t\t\t\t<option *ngFor="let voltage of voltageTypes" [value]="voltage">{{ voltage }}</option>\n\t\t\t\t\t\t</select>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="col-sm-4" *ngIf="loads">\n\t\t\t\t\t\t<button test-id="clearLoadCompatibility" type="button" (click)="clearFilter()" class="light-grey">Clear</button>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</form>\n\t\t\t<div class="table">\n\t\t\t\t<div class="head d-xs-none d-sm-block">\n\t\t\t\t\t<div class="row">\n\t\t\t\t\t\t<div class="col-4">Manufacturer</div>\n\t\t\t\t\t\t<div class="col-4">Bulb/Fixture Type</div>\n\t\t\t\t\t\t<div class="col-4">SKU</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class="padding" *ngIf="!loads">Loading...</div>\n\t\t\t\t<div class="body">\n\t\t\t\t\t<div class="row" *ngFor="let load of filteredLoads | orderBy:[\'light.brand.brandName\']; index as i">\n\t\t\t\t\t\t<div class="col-sm-4 col-6">\n\t\t\t\t\t\t\t<a href="javascript:void(0);" attr.test-id="showFilterDetailsClick-{{i}}" class="clickable"\n\t\t\t\t\t\t\t   title="{{ load.light.brand.brandName }}"\n\t\t\t\t\t\t\t   (click)="load.showDetails=!load.showDetails">\n\t\t\t\t\t\t\t\t<b>{{ load.light.brand.brandName }}</b>\n\t\t\t\t\t\t\t</a>\n\t\t\t\t\t\t\t<p class="d-sm-none">\n\t\t\t\t\t\t\t\t<small>\n\t\t\t\t\t\t\t\t\t<span>{{ load.sku }}</span>\n\t\t\t\t\t\t\t\t</small>\n\t\t\t\t\t\t\t</p>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class="col-sm-4 col-6"> {{ load.light.bulbType }} </div>\n\t\t\t\t\t\t<div class="col-sm-4 d-xs-none d-sm-block"> {{ load.sku }} </div>\n\t\t\t\t\t\t<div class="col-12" *ngIf="load.showDetails">\n\t\t\t\t\t\t\t<div class="row no-margin half-padding-top">\n\t\t\t\t\t\t\t\t<div class="col-sm-4 col-6" *ngIf="load.light.modelName">\n\t\t\t\t\t\t\t\t\t<b>Model</b>\n\t\t\t\t\t\t\t\t\t<br />\n\t\t\t\t\t\t\t\t\t<small>{{ load.light.modelName | uppercase }}</small>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="col-sm-4 col-6" *ngIf="load.light.modelNumber">\n\t\t\t\t\t\t\t\t\t<b>Model Number</b>\n\t\t\t\t\t\t\t\t\t<br />\n\t\t\t\t\t\t\t\t\t<small>{{ load.light.modelNumber | uppercase }}</small>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class="col-sm-4 col-6" *ngIf="load.light.bulbType">\n\t\t\t\t\t\t\t\t\t<b>Fixture Type</b>\n\t\t\t\t\t\t\t\t\t<br />\n\t\t\t\t\t\t\t\t\t<small>{{ load.light.bulbType }}</small>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\