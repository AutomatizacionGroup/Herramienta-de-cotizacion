i> {{error}}</p>\n\t\t</div>\n\t\t<button test-id="loginSubmitClick" type="submit" class="block" id="login-submit"\n\t\t\t\t[disabled]="addingUser"> Sign Up <i\n\t\t\t   class="fal fa-arrow-right"\n\t\t\t   *ngIf="!addingUser"></i>\n\t\t\t<i class="fal fa-circle-notch fa-spin" *ngIf="addingUser"></i>\n\t\t</button>\n\t</form>\n\t<small class="pull-right">\n\t\t<a routerLink="/login" href="" class="text-grey">Login</a> | <a test-id="showNeedHelpClick" href="javascript:;" class="text-grey"\n\t\t   (click)="showNeedHelp = true">Need Help?</a>\n\t</small>\n</div>\n<div *ngIf="showNeedHelp">\n\t<h2>Need Employee Registration Help?</h2>\n\t<p>This registration form is for employees only. If you\'re using your work email address and not receiving a registration email after submission, please\n\t\temail <a *ngIf="(useWebhelpEmail$ | async)" href="mailto:webhelp@control4.com">webhelp@control4.com</a>\n\t\t<a *ngIf="!(useWebhelpEmail$ | async)" href="mailto:onlineordering@control4.com">onlineordering@control4.com</a>.</p>\n\t<small class="pull-right">\n\t\t<a test-id="hideNeedHelpClick" href="javascript:;" class="text-grey" (click)="showNeedHelp = false">Back</a>\n\t</small>\n</div>\n<div *ngIf="showSuccess">\n\t<h2>Employee Registration Successful</h2>\n\t<p>You have successfully registered for the dealer portal. You will receive an email shortly with a link to complete setup of your account.</p>\n\t<small class="pull-right">\n\t\t<a routerLink="/login" href="" class="text-grey">Login</a>\n\t</small>\n</div>'},WDmH:function(t,e,n){"use strict";n.d(e,"a",(function(){return s}));var r=n("DRwZ");const s=Object(r.a)({selectId:t=>t.accountId})},WMd4:function(t,e,n){"use strict";n.d(e,"a",(function(){return a}));var r,s=n("EY2u"),i=n("LRne"),o=n("z6cu");!function(t){t.NEXT="N",t.ERROR="E",t.COMPLETE="C"}(r||(r={}));class a{constructor(t,e,n){this.kind=t,this.value=e,this.error=n,this.hasValue="N"===t}observe(t){switch(this.kind){case"N":return t.next&&t.next(this.value);case"E":re