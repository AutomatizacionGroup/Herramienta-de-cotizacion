ss="half-padding-top">Description</h4>\n\t\t\t<mat-form-field>\n\t\t\t\t<input test-id="benefitDescription" matInput name="description" type="text" [(ngModel)]="benefit.description" maxlength="50" required />\n\t\t\t</mat-form-field>\n\t\t\t<h4 class="half-padding-top">Type</h4>\n\t\t\t<select test-id="selectedBenefitType" name="benefitType" [(ngModel)]="benefit.benefitType" required>\n\t\t\t\t<option value="subtotal">Discount against Subtotal</option>\n\t\t\t\t<option value="part">Item</option>\n\t\t\t\t<option value="allconditions">Discount against all qualified items</option>\n\t\t\t\t<option value="expense">Discount against Expense</option>\n\t\t\t\t<option value="coupon">Discount Rebate Form</option>\n\t\t\t</select>\n\t\t\t<div class="half-padding-top" *ngIf="benefit.benefitType === \'part\' || benefit.benefitType === \'expense\'">\n\t\t\t\t<h4>\n\t\t\t\t\t<span *ngIf="benefit.benefitType === \'part\'">Item to Add</span>\n\t\t\t\t\t<span *ngIf="benefit.benefitType === \'expense\'">Expense Type</span>\n\t\t\t\t</h4>\n\t\t\t\t<c4-typeahead test-id="c4-typeahead-product-skus" name="sku" [input]="benefit.benefitValue" placeholder=""\n\t\t\t\t\t\t\t  *ngIf="benefit.benefitType === \'part\'"\n\t\t\t\t\t\t\t  field="sku" (inputChanged)="benefit.benefitValue = $event" [getItems]="cmsProductService.searchProducts"\n\t\t\t\t\t\t\t  (selected)="selectProduct($event)"\n\t\t\t\t\t\t\t  (inputMatchesList)="valueMatchesList = $event">\n\t\t\t\t</c4-typeahead>\n\t\t\t\t<div class="alert alert-warning"\n\t\t\t\t\t *ngIf="benefit.benefitValue && benefit.benefitType === \'part\' && !valueMatchesList">Invalid Value </div>\n\t\t\t\t<select test-id="selectedBenefitValue" name="benValue" [(ngModel)]="benefit.benefitValue" *ngIf="benefit.benefitType === \'expense\'"\n\t\t\t\t\t\trequired>\n\t\t\t\t\t<option value="discount">Discount</option>\n\t\t\t\t\t<option value="shipping">Shipping</option>\n\t\t\t\t\t<option value="paymentmethod">Payment Method</option>\n\t\t\t\t</select>\n\t\t\