(input)]="condition.conditionValue" placeholder=""\n\t\t\t\t\t\t\t  *ngIf="condition.conditionType === \'category\'"\n\t\t\t\t\t\t\t  field="categoryPath" [getItems]="cmsProductService.getCategoriesByPartialName" (selected)="selectCategory($event)"></c4-typeahead>\n\t\t\t\t<c4-typeahead test-id="c4-typeahead-manufacturer" name="name" [(input)]="condition.conditionValue" placeholder=""\n\t\t\t\t\t\t\t  *ngIf="condition.conditionType === \'manf\'"\n\t\t\t\t\t\t\t  field="name" [getItems]="cmsProductService.getManufacturersByName" (selected)="selectManufacturer($event)"></c4-typeahead>\n\t\t\t\t<c4-typeahead test-id="c4-typeahead-product" name="sku" [(input)]="condition.conditionValue" placeholder=""\n\t\t\t\t\t\t\t  *ngIf="condition.conditionType === \'part\'"\n\t\t\t\t\t\t\t  (inputChange)="valueMatchesList = false"\n\t\t\t\t\t\t\t  [autoclear]="false" [getItems]="cmsProductService.searchSkus"\n\t\t\t\t\t\t\t  (inputMatchesList)="valueMatchesList = $event"></c4-typeahead>\n\t\t\t</div>\n\t\t\t<div class="alert alert-warning"\n\t\t\t\t *ngIf="condition.conditionValue && condition.conditionType === \'part\' && !valueMatchesList">Invalid Value </div>\n\t\t\t<div class="half-padding-top" *ngIf="condition.conditionType && condition.conditionType != \'subtotal\'">\n\t\t\t\t<h4>Quantity</h4>\n\t\t\t\t<input test-id="conditionQuantity" name="quantity" type="number" min="1" max="9999" [(ngModel)]="condition.quantity" required />\n\t\t\t</div>\n\t\t\t<div class="half-padding-top">\n\t\t\t\t<h4>Error Expression</h4>\n\t\t\t\t<mat-form-field>\n\t\t\t\t\t<input test-id="errorMessage" matInput name="errorMessage" type="text" maxlength="255" [(ngModel)]="condition.errorMessage" required />\n\t\t\t\t</mat-form-field>\n\t\t\t</div>\n\t\t\t<div class="modal-footer">\n\t\t\t\t<button test-id="cancelPromotionConditionClick" class="white" title="Cancel" (click)="cancelEditCondition()">Cancel</button>\n\t\t\t\t<button test-id="removePromotionConditionClick" style="margin: 5px;" (click)="r