oms</h3>\n\t\t\t\t\t<div *ngFor="let room of confirmationOrder.rooms">\n\t\t\t\t\t\t<div [ngClass]="{\'reviewed\':room.hasReviewed}">\n\t\t\t\t\t\t\t<span (click)="loadKeypads(room)"\n\t\t\t\t\t\t\t\t  style="cursor: pointer;">{{room.name | removeEncoding}}</span>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div>\n\t\t\t\t\t\t\t<i [ngClass]="{\'icon-check\': room.HasReviewed}" style="position: relative; top: 2px;"></i>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class="confirmKeypad col-md-5 col-sm-6">\n\t\t\t\t\t<h3>Keypads</h3>\n\t\t\t\t\t<div id="keypads" style="height: 400px; overflow-y: scroll; overflow-x: hidden;"\n\t\t\t\t\t\t *ngIf="sectionRoom">\n\t\t\t\t\t\t<div class="padding white" style="max-width: 400px; border: 1px solid #dedede;">\n\t\t\t\t\t\t\t<div class="half-padding-bottom" *ngFor="let keypad of sectionRoom.keypads"\n\t\t\t\t\t\t\t\t style="overflow: hidden; white-space: nowrap; text-overflow: ellipsis; -o-text-overflow: ellipsis; -webkit-text-overflow: ellipsis; display: inline-block; width: 170px; margin-right: 10px; vertical-align: top;">\n\t\t\t\t\t\t\t\t<h4 class="no-margin">{{keypad.name}}</h4>\n\t\t\t\t\t\t\t\t<ul class="no-style">\n\t\t\t\t\t\t\t\t\t<li *ngFor="let button of keypad.buttons">\n\t\t\t\t\t\t\t\t\t\t<img src="data:image/png;base64,{{button.previewImage}}" />\n\t\t\t\t\t\t\t\t\t</li>\n\t\t\t\t\t\t\t\t</ul>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t</div>\n\t</div>\n</c4-popup>'},dUpr:function(t,e,n){"use strict";n.d(e,"a",(function(){return o}));var r=n("8Y7J"),s=n("soiQ"),i=function(t,e){if("object"==typeof Reflect&&"function"==typeof Reflect.metadata)return Reflect.metadata(t,e)};let o=class{constructor(){this.notFoundUrl="https://res.cloudinary.com/control4/#transforms#/C4-ImageNotAvailable-DarkerLogo",this.realPersonTags=["Human","Person"],this.blockedTags=["Child","Baby"]}getUrl(t,e,n=!1){let r;r=t&&((n?t.thumbnailUrl:t.url)||t.url)||this.notFoundUrl;let s=