n\t<div class="modal-header padding half-padding-bottom">\n\t\t<p> Thank you for upgrading the Control4 system of <strong>{{customer.consumerName | camelize }}</strong>. As a reminder: </p>\n\t\t<ul>\n\t\t\t<li> Any Control4, Pakedge, or Triad products in this upgrade cart qualify for 15% off up front and free ground shipping. </li>\n\t\t\t<li> We recommend that you run the OS 3 Upgrade Advisor and discuss any possible expansion opportunities before checkout as each customer qualifies\n\t\t\t\tfor only one discounted upgrade. </li>\n\t\t\t<li> Every unique product purchased (MAC ID) using the 15% discount in this upgrade cart must be installed in\n\t\t\t\t<strong>{{customer.consumerName | camelize }}</strong>\'s project within 90 days. If we identify that these products are installed outside of\n\t\t\t\tthis specific project or not within 90 days, Control4 reserves the right to bill your account the equivalent of the 15% discount that was\n\t\t\t\tprovided to you at time of sale. </li>\n\t\t</ul>\n\t</div>\n\t<div class="modal-footer">\n\t\t<div class="row">\n\t\t\t<div class="col-sm-12 text-right">\n\t\t\t\t<a routerLink="/products" test-id="continueShoppingClick" (click)="close()" class="c4btn light-grey">Continue Shopping for Upgrade</a>\n\t\t\t\t<button test-id="placeOrderClick" class="grey" (click)="placeOrder()">Place Order<i class="fal fa-arrow-right"></i></button>\n\t\t\t</div>\n\t\t</div>\n\t</div>\n</c4-popup>'},uXdd:function(t,e){t.exports=""},uXwI:function(t,e,n){!function(t){"use strict";var e={ss:"sekundes_sekund\u0113m_sekunde_sekundes".split("_"),m:"min\u016btes_min\u016bt\u0113m_min\u016bte_min\u016btes".split("_"),mm:"min\u016btes_min\u016bt\u0113m_min\u016bte_min\u016btes".split("_"),h:"stundas_stund\u0101m_stunda_stundas".split("_"),hh:"stundas_stund\u0101m_stunda_stundas".split("_"),d:"dienas_dien\u0101m_diena_dienas".split("_"),dd:"dienas_dien\u0101m_diena_dienas".split("_"),M:"m\u0113ne\u0161a_m\u0113ne\u0161iem_m\u0113nesis_m\u0113ne\u0161i".