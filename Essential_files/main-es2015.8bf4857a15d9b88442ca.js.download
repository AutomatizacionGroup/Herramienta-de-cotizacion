t\t\t\t</div>\n\t\t\t\t\t\t\t<div class="col-xl-4 col-lg-6 col-md-6">\n\t\t\t\t\t\t\t\t<h4 class="no-margin">Accounting Team</h4>\n\t\t\t\t\t\t\t\t<p class="no-margin"><a href="tel:18884004072">888-400-4072 (opt 2)</a></p>\n\t\t\t\t\t\t\t\t<p class="half-padding-bottom truncate"><a href="mailto:CreditDepartment@snapav.com">CreditDepartment@snapav.com</a></p>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</ng-container>\n\t\t\t\t\t\t<ng-container *ngIf="isEmea">\n\t\t\t\t\t\t\t<div class="col-xl-4 col-lg-6 col-md-6">\n\t\t\t\t\t\t\t\t<h4 class="no-margin">Sales Support Team</h4>\n\t\t\t\t\t\t\t\t<p class="no-margin"><a href="tel:4408001217702">+44 (0) 800 121 7702 (opt 2)</a></p>\n\t\t\t\t\t\t\t\t<p class="half-padding-bottom truncate"><a href="mailto:International@adiglobal.com">International@adiglobal.com</a></p>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class="col-xl-4 col-lg-6 col-md-6">\n\t\t\t\t\t\t\t\t<h4 class="no-margin">Accounting Team</h4>\n\t\t\t\t\t\t\t\t<p class="no-margin"><a href="tel:4408001217702">+44 (0) 800 121 7702 (opt 4)</a></p>\n\t\t\t\t\t\t\t\t<p class="half-padding-bottom truncate"><a href="mailto:accountsemea@control4.com">accountsemea@control4.com</a></p>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</ng-container>\n\t\t\t\t\t\t<div class="col-xl-4 col-lg-6 col-md-6" *ngIf="salesContacts.coreInsideRep">\n\t\t\t\t\t\t\t<h4 class="no-margin">{{salesContacts.coreInsideRep.firstName}} {{salesContacts.coreInsideRep.lastName}}</h4>\n\t\t\t\t\t\t\t<small>Inside Sales Manager</small>\n\t\t\t\t\t\t\t<br>\n\t\t\t\t\t\t\t<p class="no-margin"><a href="tel:{{salesContacts.coreInsideRep.phone}}">{{salesContacts.coreInsideRep.phone}}</a></p>\n\t\t\t\t\t\t\t<p class="half-padding-bottom truncate"><a\n\t\t\t\t\t\t\t\t   href="mailto:{{salesContacts.coreInsideRep.email}}">{{salesContacts.coreInsideRep.email}}</a></p>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div *ngIf="salesContacts.coreOutsideRep" class="col-xl-4 col-lg-6 col-md-6">\n\t\t\t\t\t\t\t<h4 class="no-margin">{{salesContacts