RP</small>\n\t\t\t\t</ng-container>\n\t\t\t\t<ng-container *ngIf="!product.msrp"><small>MSRP unavailable</small>\n\t\t\t\t</ng-container>\n\t\t\t</div>\n\t\t\t<div class="text-right" *ngIf="!(isMsrp$ | async)">\n\t\t\t\t<span class="bold text-red block" [title]="product.productDiscountName"\n\t\t\t\t\t  *ngIf="(product.productDiscount && product.currencyHasDiscount) || (product.snapPrice && product.snapPrice < product.dealerPrice)">\n\t\t\t\t\t<i *ngIf="product.productDiscount && !product.isFlatDiscount" class="far fa-cubes"></i>\n\t\t\t\t\t<i *ngIf="product.hasPromo || (product.isFlatDiscount)" class="fal fa-tag"></i>\n\t\t\t\t\t{{product.displayPrice + product.productDiscount | currency: (currency$ | async)}}</span>\n\t\t\t\t<span\n\t\t\t\t\t  [class]="(product.productDiscount && product.currencyHasDiscount) || (product.snapPrice && product.snapPrice < product.dealerPrice) ? \'strikethrough small\' : \'\'">\n\t\t\t\t\t<i *ngIf="product.productDiscount === 0 && !product.isFlatDiscount && product.currencyHasDiscount"\n\t\t\t\t\t   class="far fa-cubes text-primary"></i>\n\t\t\t\t\t<i *ngIf="product.hasPromo && product.productDiscount === 0"\n\t\t\t\t\t   class="fal fa-tag text-primary"></i> {{product.dealerPrice | currency: (currency$ | async)}}</span>\n\t\t\t\t<small class="block">Dealer Price</small>\n\t\t\t</div>\n\t\t</div>\n\t\t<div class="col-md-4 col-sm-9 col-12">\n\t\t\t<div *ngIf="(canPurchase$ | async) && !product.isBuiltToOrder">\n\t\t\t\t<div class="row no-margin">\n\t\t\t\t\t<div class="col-md-12 d-none d-md-block" [class.col-xl-4]="!product.isDisplayOnly && product.dealerPrice > 0">\n\t\t\t\t\t\t<button test-id="toggleQuickViewPopupClick"\n\t\t\t\t\t\t\t\tclass="block light-grey"\n\t\t\t\t\t\t\t\t*ngIf="!hideQuickView"\n\t\t\t\t\t\t\t\t(click)="openQuickView()"\n\t\t\t\t\t\t\t\ttrackCategory="Products" c4Track="Quick View" [trackLabel]="product.sku"> Quick View </button>\n\t\t\t\t\t</div>\n\t\t\t\t\t<ng-container *ngIf="!product.isDisplayOnly && product