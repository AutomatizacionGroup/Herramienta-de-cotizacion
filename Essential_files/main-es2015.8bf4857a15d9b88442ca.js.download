\t\t\t<br>\n\t\t\t\t\t\t\t<p class="no-margin"><a href="tel:{{salesContacts.nationalRep.phone}}">{{salesContacts.nationalRep.phone}}</a></p>\n\t\t\t\t\t\t\t<p class="half-padding-bottom truncate"><a href="mailto:{{salesContacts.nationalRep.email}}">{{salesContacts.nationalRep.email}}</a>\n\t\t\t\t\t\t\t</p>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div *ngIf="salesContacts.securityBdm" class="col-xl-4 col-lg-6 col-md-6">\n\t\t\t\t\t\t\t<h4 class="no-margin">{{salesContacts.securityBdm.firstName}} {{salesContacts.securityBdm.lastName}}</h4>\n\t\t\t\t\t\t\t<small>Outside Sales Manager</small>\n\t\t\t\t\t\t\t<br>\n\t\t\t\t\t\t\t<p class="no-margin"><a href="tel:{{salesContacts.securityBdm.phone}}">{{salesContacts.securityBdm.phone}}</a></p>\n\t\t\t\t\t\t\t<p class="half-padding-bottom truncate"><a href="mailto:{{salesContacts.securityBdm.email}}">{{salesContacts.securityBdm.email}}</a>\n\t\t\t\t\t\t\t</p>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div *ngIf="salesContacts.securityRep" class="col-xl-4 col-lg-6 col-md-6">\n\t\t\t\t\t\t\t<h4 class="no-margin">{{salesContacts.securityRep.firstName}} {{salesContacts.securityRep.lastName}}</h4>\n\t\t\t\t\t\t\t<small>Outside Sales Manager</small>\n\t\t\t\t\t\t\t<br>\n\t\t\t\t\t\t\t<p class="no-margin"><a href="tel:{{salesContacts.securityRep.phone}}">{{salesContacts.securityRep.phone}}</a></p>\n\t\t\t\t\t\t\t<p class="half-padding-bottom truncate"><a\n\t\t\t\t\t\t\t\t   href="mailto:{{salesContacts.securityRep.email}}">{{salesContacts.securityRep.email}}</a>\n\t\t\t\t\t\t\t</p>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t\t<div class="col-sm-3">\n\t\t\t\t<h4>Portal Help</h4>\n\t\t\t\t<c4-portal-contact-us-form [close]="close"></c4-portal-contact-us-form>\n\t\t\t</div>\n\t\t</div>\n\t</div>'},BVg3:function(t,e,n){!function(t){"use strict";function e(t){return t%100==11||t%10!=1}function n(t,n,r,s){var i=t+" ";switch(r){case"s":return n||s?"nokkrar sek\xfandur":"nokkrum sek\xfandum";case"ss":return e(t)?i+(n||s?"sek