(window.webpackJsonp=window.webpackJsonp||[]).push([[25],{"/yzk":function(t,e){t.exports=""},"2Ls3":function(t,e){t.exports=""},"8t7p":function(t,e){t.exports='<div class="padding">\n\t<h1>Brochures</h1>\n\t<div class="widget">\n\t\t<div class="padding">\n\t\t\t<p>Below is a selection of brochures and literature that you can use to promote a variety of Control4 solutions and benefits. Click <i>Download</i>\n\t\t\t\tto view and download a PDF optimized for use on your website and email distribution. We do not offer personalization but, if you would like to\n\t\t\t\tadd your logo and contact information to a brochure, contact us at <a\n\t\t\t\t   href="mailto:filerequest@control4.com">filerequest@control4.com</a> and we will send you the native files so that your marketing department\n\t\t\t\tor printer can do so. Please reference the brochure title so that we send you the correct files.</p>\n\t\t\t<a href="/products/656" class="c4btn grey"><i class="fal fa-shopping-cart"></i>Purchase Printed Materials</a>\n\t\t</div>\n\t</div>\n\t<c4-loading size="large" *ngIf="loading"></c4-loading>\n\t<ng-container *ngIf="!loading">\n\t\t<div class="widget padding" *ngIf="brochures.dealerLiterature?.length">\n\t\t\t<h2>Control4</h2>\n\t\t\t<c4-brochure-list [brochures]="brochures.dealerLiterature"></c4-brochure-list>\n\t\t</div>\n\t\t<div class="widget padding" *ngIf="brochures.pakedgeLiterature?.length">\n\t\t\t<h2>Pakedge</h2>\n\t\t\t<c4-brochure-list [brochures]="brochures.pakedgeLiterature"></c4-brochure-list>\n\t\t</div>\n\t\t<div class="widget padding" *ngIf="brochures.triadLiterature?.length">\n\t\t\t<h2>Triad</h2>\n\t\t\t<c4-brochure-list [brochures]="brochures.triadLiterature"></c4-brochure-list>\n\t\t</div>\n\t\t<div class="widget padding">\n\t\t\t<p *ngIf="!brochures.hasBrochures">No brochures available</p>\n\t\t\t<small class="block"><b>*Marketing Agreement</b>\u2014By using these materials, you agree to abide by the <a\n\t\t\t\t   routerLink="/marketing/usage-agreement">Control4 Image Copyright and Usage Agreement</a>.</small>\n\t\t</div>\n\t</ng-container>\n</div>'},HBcM:function(t,e){t.exports='<div class="padding ng-scope">\n\t<h1>Logos</h1>\n\t<div class="widget padding">\n\t\t<h3 class="half-margin-bottom">{{brand}} Logo<span *ngIf="isControl4">s</span> & Guidelines</h3>\n\t\t<p>\n\t\t\tThe {{brand}} logo is a key asset of our brand.\n\t\t\t<span *ngIf="isControl4">It is the primary visual element that identifies our\n\t\t\t\tcompany and it\n\t\t\t\tshould be used on all external,\n\t\t\t\tinternal, and third party/channel provider communications. The Pakedge and Triad brands are key\n\t\t\t\tassets\n\t\t\t\tof Control4.</span> To maintain consistent use and ensure the integrity of the\n\t\t\tbrand<span *ngIf="isControl4">s</span>,\n\t\t\tdownload the approved logo file<span *ngIf="isControl4">s</span> along with the logo guidelines below.\n\t\t</p>\n\t\t<div class="table">\n\t\t\t<div class="body">\n\t\t\t\t<div class="row" *ngIf="isControl4">\n\t\t\t\t\t<div class="col-sm-3">\n\t\t\t\t\t\t<img\n\t\t\t\t\t\t\tsrc="//res.cloudinary.com/control4/image/upload/c_scale,w_160/Logos/Control4-logonotag-highres-RGB.png">\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="col-sm-4 half-padding-right">\n\t\t\t\t\t\t<a class="c4btn light-grey block no-margin" download="control4-logo"\n\t\t\t\t\t\t\thref="//www.control4.com/docs/product/control4/internal-logo/english/latest"><i\n\t\t\t\t\t\t\t\tclass="fal fa-arrow-to-bottom"></i>Download\n\t\t\t\t\t\t\tControl4 Logo</a>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="col-sm-5">\n\t\t\t\t\t\t<a class="c4btn light-grey block no-margin" target="_blank"\n\t\t\t\t\t\t\thref="https://www.control4.com/docs/product/control4/style-guide/english/latest"><i\n\t\t\t\t\t\t\t\tclass="fal fa-arrow-to-bottom"></i>Download\n\t\t\t\t\t\t\tControl4 Brand Guidelines</a>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class="row" *ngIf="isControl4 || brand === \'Pakedge\'">\n\t\t\t\t\t<div class="col-sm-3">\n\t\t\t\t\t\t<img src="//res.cloudinary.com/control4/image/upload/c_scale,w_160/Logos/1/PakedgeLogo.png">\n\t\t\t\t\t</div>\n\n\t\t\t\t\t<div class="col-sm-4 half-padding-right">\n\t\t\t\t\t\t<a class="c4btn light-grey block no-margin" download="pakedge-logo"\n\t\t\t\t\t\t\thref="//www.control4.com/docs/product/pakedge/internal-logo/english/latest"><i\n\t\t\t\t\t\t\t\tclass="fal fa-arrow-to-bottom"></i>Download\n\t\t\t\t\t\t\tPakedge Logo</a>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="col-sm-5">\n\t\t\t\t\t\t<a class="c4btn light-grey block no-margin" target="_blank"\n\t\t\t\t\t\t\thref="https://www.control4.com/docs/product/pakedge/style-guide/english/latest"><i\n\t\t\t\t\t\t\t\tclass="fal fa-arrow-to-bottom"></i>Download\n\t\t\t\t\t\t\tPakedge Brand Guidelines</a>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class="row" *ngIf="isControl4 || brand === \'Triad\'">\n\t\t\t\t\t<div class="col-sm-3">\n\t\t\t\t\t\t<img src="//res.cloudinary.com/control4/image/upload/c_scale,w_160/logos/triad-logo.jpg">\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="col-sm-4 half-padding-right">\n\t\t\t\t\t\t<a class="c4btn light-grey block no-margin" download="triad-logo"\n\t\t\t\t\t\t\thref="//www.control4.com/docs/product/triad/internal-logo/english/latest"><i\n\t\t\t\t\t\t\t\tclass="fal fa-arrow-to-bottom"></i>Download\n\t\t\t\t\t\t\tTriad Logo</a>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class="col-sm-5">\n\t\t\t\t\t\t<a class="c4btn light-grey block no-margin" target="_blank"\n\t\t\t\t\t\t\thref="https://www.control4.com/docs/product/triad/style-guide/english/latest"><i\n\t\t\t\t\t\t\t\tclass="fal fa-arrow-to-bottom"></i>Download\n\t\t\t\t\t\t\tTriad Brand Guidelines</a>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t</div>\n\n\t\t<div *ngIf="!(isMergedLoyaltyProgram$ | async) && (showAccountStatus$ | async)">\n\t\t\t<h3 class="margin-top half-margin-bottom">Dealer Status Badges</h3>\n\t\t\t<div class="table">\n\t\t\t\t<div class="body">\n\t\t\t\t\t<div class="row" *ngIf="account?.premierStatus | status