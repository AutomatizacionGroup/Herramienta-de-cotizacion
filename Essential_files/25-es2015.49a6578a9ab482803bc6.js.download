nes"></c4-loading>\n\t\t\t<div class="row">\n\t\t\t\t<div class="col-12 col-sm-4 col-md-3 col-lg-2 half-padding-bottom" *ngFor="let magazine of magazines">\n\t\t\t\t\t<div class="product-card">\n\t\t\t\t\t\t<a [href]="magazine.hsh_pdf_preview" title="download" trackCategory="Marketing Magazine"\n\t\t\t\t\t\t\tc4Track="Download" trackLabel="Fall 2016">\n\t\t\t\t\t\t\t<div class="block aspect magazine background"\n\t\t\t\t\t\t\t\t[ngStyle]="{\'background-image\': \'url(\'+magazine.hsh_magazine_image+\')\' }"></div>\n\t\t\t\t\t\t</a><a [href]="magazine.hsh_pdf_preview"\n\t\t\t\t\t\t\tclass="c4btn grey block no-border-radius-top">{{magazine.sub_title}}</a>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t\t<small class="footnote"><b>*Marketing Agreement</b>\u2014By using these materials, you agree to abide by the <a\n\t\t\t\t\trouterLink="/marketing/usage-agreement">Control4\n\t\t\t\t\tImage Copyright and Usage Agreement</a>.</small>\n\t\t</div>\n\t</div>\n</div>'}}]);